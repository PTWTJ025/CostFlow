                        class="absolute bottom-0 right-0 block h-2 w-2 rounded-full bg-emerald-500 ring-2 ring-white">
                    </span>
                </div>
                <div class="profile-name-role flex flex-col text-left shrink-0">
                    <span
                        class="text-xs font-bold text-slate-800 leading-none group-hover:text-primary transition-colors mb-0.5">
                        @fullName
                    </span>
                    <span class="text-[9px] text-slate-500 font-semibold leading-none">@roleName</span>
                </div>
                <!-- Chevron Dropdown Indicator -->
                <svg class="profile-chevron w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-colors ml-0.5 shrink-0"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>

            <!-- Dropdown Menu -->
            <div id="profile-dropdown"
                 class="hidden absolute right-0 top-full mt-2 w-52 bg-white rounded-lg shadow-lg border border-slate-200 py-1 z-50">
