    <!-- Profile Photo Lightbox Modal -->
    <div id="profile-photo-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 transition-all duration-300 opacity-0 pointer-events-none">
        <div id="profile-photo-card" class="relative max-w-sm w-full bg-white rounded-lg shadow-2xl overflow-hidden transform scale-95 transition-all duration-300 border border-slate-100">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100 bg-slate-50/70">
                <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                    </svg>
                    รูปโปรไฟล์
                </h3>
                <button id="close-profile-photo-modal" type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Modal Body (Image Container) -->
            <div class="p-6 flex flex-col items-center justify-center bg-gradient-to-b from-slate-50 to-slate-100/80">
                <div class="relative w-48 h-48 sm:w-56 sm:h-56 rounded-lg overflow-hidden border-2 border-white shadow-md bg-slate-200">
                    <img id="modal-profile-photo-img" src="@profilePic" alt="@fullName profile photo" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"/>
                </div>

                <div class="mt-4 text-center">
                    <h4 class="text-base font-bold text-slate-800">@fullName</h4>
                    <span class="inline-block mt-1 px-3 py-1 rounded-lg text-xs font-semibold bg-primary/10 text-primary">
                        @roleName
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Render Body: overflow-y-auto allows normal document pages (Report, Home, Index) to scroll naturally.
    App-shell pages like Detail.cshtml use h-full min-h-0 overflow-hidden on their root container to contain their own inner scroll table without triggering this outer scrollbar. -->
    <div class="flex-1 flex flex-col min-h-0 overflow-y-auto" id="main-content-scroll">
        @RenderBody()
    </div>

    <!-- Footer
    <footer class="w-full py-md border-t border-slate-200 bg-white text-center text-xs text-slate-400 font-sans flex flex-col sm:flex-row items-center justify-between px-lg select-none gap-2">
        <span>&copy; @DateTime.Now.Year - CostFlow. All rights reserved.</span>
    </footer> -->
</main>

<script>
    // Global notification handlers exposed on window (prevents ReferenceError on inline onclicks)
    window.openRowActionMenu = window.openRowActionMenu || function(e, id) {};
    window.closeRowActionMenu = window.closeRowActionMenu || function() {};
    window.toggleRowReadStatusFromMenu = window.toggleRowReadStatusFromMenu || function() {};
    window.deleteRowFromMenu = window.deleteRowFromMenu || function() {};
    window.handleNotifItemClick = window.handleNotifItemClick || function(el, e) {};
    window.toggleNotifMoreMenu = window.toggleNotifMoreMenu || function(e) {};
    window.closeNotifMoreMenu = window.closeNotifMoreMenu || function() {};
    window.markAllNotifsAsRead = window.markAllNotifsAsRead || function() {};
    window.filterNotifsTab = window.filterNotifsTab || function(m) {};
    window.loadOlderNotifications = window.loadOlderNotifications || function() {};

    document.addEventListener("DOMContentLoaded", function () {
        // Profile Dropdown
        const profileDropdownBtn = document.getElementById("profile-dropdown-btn");
        const profileDropdown = document.getElementById("profile-dropdown");

        // Profile Photo Lightbox Modal
        const profilePicTrigger = document.getElementById("profile-pic-trigger");
        const viewProfilePicBtn = document.getElementById("view-profile-pic-btn");
        const profilePhotoModal = document.getElementById("profile-photo-modal");
        const profilePhotoCard = document.getElementById("profile-photo-card");
        const closeProfilePhotoModalBtn = document.getElementById("close-profile-photo-modal");

        function openProfilePhotoModal() {
            if (!profilePhotoModal) return;
            if (profileDropdown) profileDropdown.classList.add("hidden");
            profilePhotoModal.classList.remove("hidden");
            profilePhotoModal.classList.add("flex");
            setTimeout(() => {
                profilePhotoModal.classList.remove("opacity-0", "pointer-events-none");
                profilePhotoCard.classList.remove("scale-95");
                profilePhotoCard.classList.add("scale-100");
            }, 10);
        }

        function closeProfilePhotoModal() {
            if (!profilePhotoModal) return;
            profilePhotoModal.classList.add("opacity-0", "pointer-events-none");
            profilePhotoCard.classList.remove("scale-100");
            profilePhotoCard.classList.add("scale-95");
            setTimeout(() => {
                profilePhotoModal.classList.remove("flex");
                profilePhotoModal.classList.add("hidden");
            }, 300);
        }

        if (profilePicTrigger) {
            profilePicTrigger.addEventListener("click", function (e) {
                e.stopPropagation();
                openProfilePhotoModal();
            });
        }

        if (viewProfilePicBtn) {
            viewProfilePicBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                openProfilePhotoModal();
            });
        }

        if (closeProfilePhotoModalBtn) {
            closeProfilePhotoModalBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                closeProfilePhotoModal();
            });
        }

        if (profilePhotoModal) {
            profilePhotoModal.addEventListener("click", function (e) {
                if (e.target === profilePhotoModal) {
                    closeProfilePhotoModal();
                }
            });
        }

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && profilePhotoModal && !profilePhotoModal.classList.contains("hidden")) {
                closeProfilePhotoModal();
            }
        });

        // Purchase System Menu Dropdown
        const purchaseMenuToggle = document.getElementById("purchase-menu-toggle");
        const purchaseDropdown = document.getElementById("purchase-dropdown");
        const purchaseChevron = document.getElementById("purchase-chevron");
        let isPurchaseMenuOpen = false;

        if (purchaseMenuToggle && purchaseDropdown) {
            purchaseMenuToggle.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                isPurchaseMenuOpen = !isPurchaseMenuOpen;

                if (isPurchaseMenuOpen) {
                    purchaseDropdown.style.display = "block";
                    setTimeout(() => {
                        purchaseDropdown.classList.add("purchase-dropdown-open");
                        purchaseChevron.style.transform = "rotate(180deg)";
                    }, 10);
                } else {
                    purchaseDropdown.classList.remove("purchase-dropdown-open");
                    purchaseChevron.style.transform = "rotate(0deg)";
                    setTimeout(() => {
                        purchaseDropdown.style.display = "none";
                    }, 200);
                }
            });

            // Close when clicking outside
            document.addEventListener("click", function (e) {
                if (!purchaseMenuToggle.contains(e.target) && !purchaseDropdown.contains(e.target)) {
                    if (isPurchaseMenuOpen) {
                        isPurchaseMenuOpen = false;
                        purchaseDropdown.classList.remove("purchase-dropdown-open");
                        purchaseChevron.style.transform = "rotate(0deg)";
                        setTimeout(() => {
                            purchaseDropdown.style.display = "none";
                        }, 200);
                    }
                }
            });
        }

        if (profileDropdownBtn && profileDropdown) {
            profileDropdownBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                if (typeof notifDropdown !== 'undefined' && notifDropdown) {
                    notifDropdown.classList.add("hidden");
                    if (typeof notifDropdownBtn !== 'undefined' && notifDropdownBtn) notifDropdownBtn.classList.remove("is-active");
                }
                profileDropdown.classList.toggle("hidden");
            });

            document.addEventListener("click", function (e) {
                if (!profileDropdownBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add("hidden");
                }
            });
        }

        // Facebook-Style Notification Dropdown Logic
        const notifDropdownBtn = document.getElementById("notif-dropdown-btn");
        const notifDropdown = document.getElementById("notif-dropdown");
        const notifBadge = document.getElementById("notif-badge");
        const notifMoreMenu = document.getElementById("notif-more-menu");

        if (notifDropdownBtn && notifDropdown) {
            notifDropdownBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                if (profileDropdown) profileDropdown.classList.add("hidden");
                closeNotifMoreMenu();
                closeRowActionMenu();
                const willOpen = notifDropdown.classList.contains("hidden");
                notifDropdown.classList.toggle("hidden");
                notifDropdownBtn.classList.toggle("is-active", willOpen);
            });

            document.addEventListener("click", function (e) {
                if (!notifDropdownBtn.contains(e.target) && !notifDropdown.contains(e.target)) {
                    notifDropdown.classList.add("hidden");
                    notifDropdownBtn.classList.remove("is-active");
                    closeNotifMoreMenu();
                    closeRowActionMenu();
                }
            });
        }

        function toggleNotifMoreMenu(e) {
            if (e) e.stopPropagation();
            closeRowActionMenu();
            if (notifMoreMenu) {
                notifMoreMenu.classList.toggle("hidden");
            }
        }

        function closeNotifMoreMenu() {
            if (notifMoreMenu) {
                notifMoreMenu.classList.add("hidden");
            }
        }

        function mockNotifSettings() {
            alert("⚙️ การตั้งค่าการแจ้งเตือน: เปิดรับการแจ้งเตือนพัสดุและสต๊อกสินค้าครบทุกหมวดหมู่");
        }

        let activeRowActionItemId = null;
        const notifRowMenu = document.getElementById("notif-row-menu");

        function updateUnreadCount() {
            const unreadItems = document.querySelectorAll('.notif-item[data-unread="true"]');
            const count = unreadItems.length;
            
            // Header bell badge
            if (notifBadge) {
                if (count > 0) {
                    notifBadge.textContent = count;
                    notifBadge.classList.remove('hidden');
                } else {
                    notifBadge.classList.add('hidden');
                }
            }

            // Tab unread counter pill
            const tabUnreadBadge = document.getElementById('notif-tab-unread-badge');
            if (tabUnreadBadge) {
                tabUnreadBadge.textContent = count;
                tabUnreadBadge.style.display = count > 0 ? 'inline-flex' : 'none';
            }
        }

        function handleNotifItemClick(el, event) {
            if (!el) return;
            // If the options menu or row menu is open, dismiss the menu without navigating
            if (notifMoreMenu && !notifMoreMenu.classList.contains("hidden")) {
                closeNotifMoreMenu();
                if (event) event.stopPropagation();
                return;
            }
            if (notifRowMenu && !notifRowMenu.classList.contains("hidden")) {
                closeRowActionMenu();
                if (event) event.stopPropagation();
                return;
            }
            const notifId = el.getAttribute('data-id');
            if (notifId) {
                fetch('/api/notification/' + notifId + '/read', { method: 'POST' }).catch(() => {});
            }
            markSingleNotifAsRead(el);

            // Deep link navigation: if data-href is non-empty, navigate; if empty/null, stay on page!
            const targetUrl = el.getAttribute('data-href');
            if (targetUrl && targetUrl.trim() !== '') {
                setTimeout(() => {
                    window.location.href = targetUrl;
                }, 120);
            }
        }

        function markSingleNotifAsRead(el) {
            if (el && el.getAttribute('data-unread') === 'true') {
                el.setAttribute('data-unread', 'false');
                el.classList.remove('unread');
                const dot = el.querySelector('.notif-dot');
                if (dot) {
                    dot.classList.remove('is-unread');
                }
                const timeEl = el.querySelector('.notif-time');
                if (timeEl) {
                    timeEl.classList.remove('text-slate-500');
                    timeEl.classList.remove('text-amber-600');
                    timeEl.classList.add('text-slate-400');
                }
                updateUnreadCount();

                const tabUnread = document.getElementById('notif-tab-unread');
                if (tabUnread && tabUnread.classList.contains('is-active')) {
                    el.classList.add('hidden');
                    checkEmptyState();
                }
            }
        }

        function markAllNotifsAsRead() {
            fetch('/api/notification/read-all', { method: 'POST' }).catch(() => {});
            const unreadItems = document.querySelectorAll('.notif-item[data-unread="true"]');
            unreadItems.forEach(el => {
                el.setAttribute('data-unread', 'false');
                el.classList.remove('unread');
                const dot = el.querySelector('.notif-dot');
                if (dot) {
                    dot.classList.remove('is-unread');
                }
                const timeEl = el.querySelector('.notif-time');
                if (timeEl) {
                    timeEl.classList.remove('text-slate-500');
                    timeEl.classList.remove('text-amber-600');
                    timeEl.classList.add('text-slate-400');
                }
            });
            updateUnreadCount();
            closeNotifMoreMenu();

            const tabUnread = document.getElementById('notif-tab-unread');
            if (tabUnread && tabUnread.classList.contains('is-active')) {
                unreadItems.forEach(el => el.classList.add('hidden'));
                checkEmptyState();
            }
        }

        function openRowActionMenu(event, itemId) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            closeNotifMoreMenu();
            activeRowActionItemId = itemId;
            const itemEl = document.getElementById(itemId);
            if (!itemEl || !notifRowMenu) return;

            const isUnread = itemEl.getAttribute('data-unread') === 'true';
            const toggleText = document.getElementById('notif-row-menu-toggle-text');
            const toggleIcon = document.getElementById('notif-row-menu-toggle-icon');

            if (toggleText) {
                toggleText.textContent = isUnread ? 'ทำเครื่องหมายว่าอ่านแล้ว' : 'ทำเครื่องหมายว่ายังไม่ได้อ่าน';
            }
            if (toggleIcon) {
                if (isUnread) {
                    toggleIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />';
                    toggleIcon.setAttribute('class', 'w-4 h-4 text-emerald-600 shrink-0');
                } else {
                    toggleIcon.innerHTML = '<circle cx="12" cy="12" r="6" fill="#2563eb" />';
                    toggleIcon.setAttribute('class', 'w-4 h-4 text-blue-600 shrink-0');
                }
            }

            // Calculate position relative to container
            const listContainer = document.getElementById('notif-items-list');
            if (listContainer) {
                const triggerBtn = event.currentTarget;
                const triggerRect = triggerBtn.getBoundingClientRect();
                const containerRect = listContainer.getBoundingClientRect();

                let topPos = (triggerRect.bottom - containerRect.top) + listContainer.scrollTop + 4;
                let rightPos = (containerRect.right - triggerRect.right) + 8;

                notifRowMenu.style.top = topPos + 'px';
                notifRowMenu.style.right = rightPos + 'px';
                notifRowMenu.classList.remove('hidden');
            }
        }

        function closeRowActionMenu() {
            if (notifRowMenu) {
                notifRowMenu.classList.add('hidden');
            }
            activeRowActionItemId = null;
        }

        function toggleRowReadStatusFromMenu() {
            if (!activeRowActionItemId) return;
            const itemEl = document.getElementById(activeRowActionItemId);
            if (!itemEl) return;

            const isUnread = itemEl.getAttribute('data-unread') === 'true';
            const notifId = itemEl.getAttribute('data-id');

            if (isUnread) {
                if (notifId) fetch('/api/notification/' + notifId + '/read', { method: 'POST' }).catch(() => {});
                markSingleNotifAsRead(itemEl);
            } else {
                // Mark unread
                itemEl.setAttribute('data-unread', 'true');
                itemEl.classList.add('unread');
                const dot = itemEl.querySelector('.notif-dot');
                if (dot) {
                    dot.classList.add('is-unread');
                }
                const timeEl = itemEl.querySelector('.notif-time');
                if (timeEl) {
                    timeEl.classList.remove('text-slate-400');
                    timeEl.classList.add('text-slate-500');
                }
                updateUnreadCount();
            }
            closeRowActionMenu();
        }

        function deleteRowFromMenu() {
            if (!activeRowActionItemId) return;
            const itemEl = document.getElementById(activeRowActionItemId);
            if (!itemEl) return;
            const notifId = itemEl.getAttribute('data-id');
            if (notifId) {
                fetch('/api/notification/' + notifId, { method: 'DELETE' }).catch(() => {});
            }

            itemEl.style.transition = 'all 0.2s ease';
            itemEl.style.opacity = '0';
            itemEl.style.transform = 'scale(0.95)';
            setTimeout(() => {
                itemEl.remove();
                updateUnreadCount();
                checkEmptyState();
            }, 200);

            closeRowActionMenu();
        }

        function getNotifIconHtml(type) {
            switch (type) {
                case 'MONTHLY_COST':
                    return `
                        <div class="notif-avatar-circle" style="background-color: #fef3c7; color: #d97706; border-color: #fde68a;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock-fading preview-icon"><path d="M12 2a10 10 0 0 1 7.38 16.75"/><path d="M12 6v6l4 2"/><path d="M2.5 8.875a10 10 0 0 0-.5 3"/><path d="M2.83 16a10 10 0 0 0 2.43 3.4"/><path d="M4.636 5.235a10 10 0 0 1 .891-.857"/><path d="M8.644 21.42a10 10 0 0 0 7.631-.38"/></svg>
                        </div>`;
                case 'ORDER_TRACKING':
                    return `
                        <div class="notif-avatar-circle" style="background-color: #eff6ff; color: #2563eb; border-color: #bfdbfe;">
                            <svg style="width: 22px; height: 22px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75a1.125 1.125 0 0 0-1.125-1.125H3.375A1.125 1.125 0 0 0 2.25 3.75v10.5h12M16.5 7.5h3.75" />
                            </svg>
                        </div>`;
                case 'STOCK_RECEIVE':
                    return `
                        <div class="notif-avatar-circle" style="background-color: #ecfdf5; color: #059669; border-color: #a7f3d0;">
                            <svg style="width: 22px; height: 22px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3.75 2.25 2.25 4.5-4.5" />
                            </svg>
                        </div>`;
                case 'STOCK_UPDATE':
                default:
                    return `
                        <div class="notif-avatar-circle" style="background-color: #f3e8ff; color: #7c3aed; border-color: #ddd6fe;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save-check preview-icon"><path d="M12.5 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h10.2a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4v4.35"/><path d="m16 19 2 2 4-4"/><path d="M17 15.13V14a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg>
                        </div>
                        `;
            }
        }

        function normalizeNotifItem(item) {
            if (!item) return item;
            if (item.title === 'หน้างานขอสั่งของจุกจิก') {
                item.title = 'สั่งซื้อสินค้าทั่วไป';
            }
            if (item.targetUrl === '/MonthlyCost') {
                item.targetUrl = '/MonthlyCost/Detail/กันยายน 2569';
            }
            return item;
        }

        function createNotifItemElement(item) {
            item = normalizeNotifItem(item);
            const isUnread = !item.isRead;
            const div = document.createElement('div');
            div.className = `notif-item ${isUnread ? 'unread' : ''} group animate-in fade-in duration-200`;
            div.id = `notif-item-${item.id}`;
            div.setAttribute('data-id', item.id);
            div.setAttribute('data-unread', isUnread ? 'true' : 'false');
            div.setAttribute('data-href', item.targetUrl || '');
            div.onclick = function(e) { handleNotifItemClick(this, e); };

            const timeClass = isUnread ? 'text-slate-500 font-semibold' : 'text-slate-400 font-normal';

            div.innerHTML = `
                <div class="notif-avatar-wrap">
                    ${getNotifIconHtml(item.type)}
                </div>
                <div class="flex-1 min-w-0 pr-1">
                    <p class="text-[13px] leading-snug text-slate-800 line-clamp-3">
                        <span class="font-bold text-slate-950">${escapeHtml(item.title)}</span> ${escapeHtml(item.message)}
                    </p>
                    <span class="inline-block text-[12px] mt-1 notif-time ${timeClass}">${escapeHtml(item.timeAgo)}</span>
                </div>
                <div class="notif-right-action-wrap" onclick="event.stopPropagation()">
                    <span class="notif-dot ${isUnread ? 'is-unread' : ''}"></span>
                    <button type="button" 
                            class="notif-row-action-btn" 
                            title="ตัวเลือกเพิ่มเติม"
                            onclick="openRowActionMenu(event, 'notif-item-${item.id}')">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <circle cx="5" cy="12" r="2" />
                            <circle cx="12" cy="12" r="2" />
                            <circle cx="19" cy="12" r="2" />
                        </svg>
                    </button>
                </div>
            `;
            return div;
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/[&<>"']/g, function(m) {
                switch(m) {
                    case '&': return '&amp;';
                    case '<': return '&lt;';
                    case '>': return '&gt;';
                    case '"': return '&quot;';
                    case "'": return '&#039;';
                    default: return m;
                }
            });
        }

        function prependNotificationItem(item) {
            const secNew = document.getElementById('notif-section-new');
            const itemsList = document.getElementById('notif-items-list');
            if (!secNew || !itemsList) return;

            const existing = document.getElementById(`notif-item-${item.id}`);
            if (existing) existing.remove();

            const itemEl = createNotifItemElement(item);
            const firstChild = secNew.querySelector('.notif-item');
            if (firstChild) {
                secNew.insertBefore(itemEl, firstChild);
            } else {
                secNew.appendChild(itemEl);
            }

            secNew.classList.remove('hidden');
            const emptyEl = document.getElementById('notif-empty-state');
            if (emptyEl) emptyEl.classList.add('hidden');

            updateUnreadCount();
        }

        async function syncNotificationsFromApi() {
            try {
                const resp = await fetch('/api/notification');
                if (!resp.ok) return;
                const data = await resp.json();
                if (data && data.success && Array.isArray(data.items) && data.items.length > 0) {
                    const secNew = document.getElementById('notif-section-new');
                    const secEarlier = document.getElementById('notif-section-earlier');
                    if (secNew) {
                        secNew.querySelectorAll('.notif-item').forEach(el => el.remove());
                        if (secEarlier) secEarlier.querySelectorAll('.notif-item').forEach(el => el.remove());

                        data.items.forEach((it, idx) => {
                            const el = createNotifItemElement(it);
                            if (idx < 2) {
                                secNew.appendChild(el);
                            } else if (secEarlier) {
                                secEarlier.appendChild(el);
                            } else {
                                secNew.appendChild(el);
                            }
                        });
                        updateUnreadCount();
                    }
                }
            } catch (err) {
                console.warn('[Notifications] Sync error:', err);
            }
        }

        function initNotificationSignalR() {
            if (typeof signalR === 'undefined') return;
            try {
                const hub = new signalR.HubConnectionBuilder()
                    .withUrl("/dashboardHub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000])
                    .build();

                hub.on("ReceiveNotification", function(data) {
                    if (data && data.item) {
                        prependNotificationItem(data.item);
                        if (typeof data.unreadCount === 'number') {
                            if (notifBadge) {
                                if (data.unreadCount > 0) {
                                    notifBadge.textContent = data.unreadCount;
                                    notifBadge.classList.remove('hidden');
                                } else {
                                    notifBadge.classList.add('hidden');
                                }
                            }
                        } else {
                            updateUnreadCount();
                        }
                    }
                });

                hub.start().catch(err => console.log('[SignalR Hub] Notification listener status:', err.message || err));
            } catch (e) {
                console.warn('[SignalR Hub] Init error:', e);
            }
        }

        function checkEmptyState() {
            const emptyEl = document.getElementById('notif-empty-state');
            const unreadItems = document.querySelectorAll('.notif-item[data-unread="true"]');
            const allItems = document.querySelectorAll('.notif-item');
            const tabUnread = document.getElementById('notif-tab-unread');
            const isUnreadTab = tabUnread && tabUnread.classList.contains('is-active');

            if (emptyEl) {
                if (isUnreadTab) {
                    if (unreadItems.length === 0) {
                        emptyEl.classList.remove('hidden');
                    } else {
                        emptyEl.classList.add('hidden');
                    }
                } else {
                    if (allItems.length === 0) {
                        emptyEl.classList.remove('hidden');
                    } else {
                        emptyEl.classList.add('hidden');
                    }
                }
            }
        }

        function filterNotifsTab(mode) {
            closeNotifMoreMenu();
            closeRowActionMenu();
            const tabAll = document.getElementById('notif-tab-all');
            const tabUnread = document.getElementById('notif-tab-unread');
            const items = document.querySelectorAll('.notif-item');
            const secNew = document.getElementById('notif-section-new');
            const secEarlier = document.getElementById('notif-section-earlier');

            if (mode === 'ALL') {
                if (tabAll) {
                    tabAll.classList.add('is-active');
                    tabAll.classList.remove('is-inactive');
                }
                if (tabUnread) {
                    tabUnread.classList.add('is-inactive');
                    tabUnread.classList.remove('is-active');
                }
                items.forEach(el => el.classList.remove('hidden'));
                if (secNew) secNew.classList.remove('hidden');
                if (secEarlier) secEarlier.classList.remove('hidden');
                const emptyEl = document.getElementById('notif-empty-state');
                if (emptyEl) emptyEl.classList.add('hidden');
            } else {
                if (tabUnread) {
                    tabUnread.classList.add('is-active');
                    tabUnread.classList.remove('is-inactive');
                }
                if (tabAll) {
                    tabAll.classList.add('is-inactive');
                    tabAll.classList.remove('is-active');
                }
                items.forEach(el => {
                    const isUnread = el.getAttribute('data-unread') === 'true';
                    el.classList.toggle('hidden', !isUnread);
                });

                if (secNew) {
                    const hasNewVisible = secNew.querySelectorAll('.notif-item:not(.hidden)').length > 0;
                    secNew.classList.toggle('hidden', !hasNewVisible);
                }
                if (secEarlier) {
                    const hasEarlierVisible = secEarlier.querySelectorAll('.notif-item:not(.hidden)').length > 0;
                    secEarlier.classList.toggle('hidden', !hasEarlierVisible);
                }

                checkEmptyState();
            }
        }

        async function loadOlderNotifications() {
            if (notifMoreMenu && !notifMoreMenu.classList.contains("hidden")) {
                closeNotifMoreMenu();
                return;
            }
            if (notifRowMenu && !notifRowMenu.classList.contains("hidden")) {
                closeRowActionMenu();
                return;
            }
            const notifDropdown = document.getElementById('notif-dropdown');
            const skeletonLoader = document.getElementById('notif-skeleton-loader');
            const footerBtn = document.getElementById('btn-load-older-notifs');
            const listContainer = document.getElementById('notif-items-list');

            if (notifDropdown) {
                notifDropdown.classList.add('is-expanded');
            }

            if (footerBtn) {
                footerBtn.innerHTML = `
                    <svg class="animate-spin h-3.5 w-3.5 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>กำลังโหลดการแจ้งเตือนก่อนหน้า...</span>
                `;
                footerBtn.disabled = true;
            }

            if (skeletonLoader) {
                skeletonLoader.classList.remove('hidden');
            }

            if (listContainer) {
                listContainer.scrollTo({ top: listContainer.scrollHeight, behavior: 'smooth' });
            }

            try {
                // Fetch from API with small intentional delay for smooth skeleton UX
                const [result] = await Promise.all([
                    fetch('/api/notification?limit=50').then(res => res.json()).catch(() => null),
                    new Promise(resolve => setTimeout(resolve, 600))
                ]);

                if (skeletonLoader) {
                    skeletonLoader.classList.add('hidden');
                }

                injectMockHistoricalNotifs();

                if (footerBtn) {
                    footerBtn.innerHTML = `<span>แสดงประวัติการแจ้งเตือนทั้งหมดแล้ว</span>`;
                    footerBtn.classList.add('opacity-70', 'cursor-default');
                    footerBtn.disabled = true;
                }
            } catch (err) {
                console.warn('Error loading older notifications:', err);
                if (skeletonLoader) skeletonLoader.classList.add('hidden');
                if (footerBtn) {
                    footerBtn.innerHTML = `<span>ดูการแจ้งเตือนก่อนหน้า</span>`;
                    footerBtn.disabled = false;
                }
            }
        }

        function injectMockHistoricalNotifs() {
            const secEarlier = document.getElementById('notif-section-earlier');
            if (!secEarlier) return;

            const historicalItems = [
                {
                    id: 'hist-1',
                    type: 'MONTHLY_COST',
                    title: 'สรุปค่าใช้จ่ายงวดเดือนก่อน',
                    message: 'ระบบปิดงวดบัญชีสิงหาคม 2569 เรียบร้อยแล้ว ยอดรวม 248,500 บาท',
                    timeAgo: '3 วันที่แล้ว',
                    href: '/MonthlyCost/Detail/สิงหาคม 2569',
                    isUnread: false
                },
                {
                    id: 'hist-2',
                    type: 'STOCK_RECEIVE',
                    title: 'ตรวจรับพัสดุเรียบร้อย',
                    message: 'รับใบสั่งซื้อ PO2608-0112 อะไหล่เซนเซอร์ตรวจจับความร้อน 4 ตัว เข้าคลังหลัก',
                    timeAgo: '5 วันที่แล้ว',
                    href: '',
                    isUnread: false
                },
                {
                    id: 'hist-3',
                    type: 'ORDER_TRACKING',
                    title: 'สั่งซื้อสินค้าทั่วไป',
                    message: 'ฝ่ายซ่อมบำรุงขอจัดซื้อสเปรย์หล่อลื่น WD-40 จำนวน 12 กระป๋อง สถานะ: อนุมัติแล้ว',
                    timeAgo: '1 สัปดาห์ที่แล้ว',
                    href: '/OrderTracking',
                    isUnread: false
                }
            ];

            historicalItems.forEach(item => {
                if (document.getElementById('notif-item-' + item.id)) return;
                const iconHtml = getNotifIconHtml(item.type);
                const el = document.createElement('div');
                el.className = 'notif-item group';
                el.id = 'notif-item-' + item.id;
                el.setAttribute('data-id', item.id);
                el.setAttribute('data-unread', 'false');
                el.setAttribute('data-href', item.href);
                el.onclick = function(e) { handleNotifItemClick(this, e); };

                el.innerHTML = `
                    <div class="notif-avatar-wrap">${iconHtml}</div>
                    <div class="flex-1 min-w-0 pr-1">
