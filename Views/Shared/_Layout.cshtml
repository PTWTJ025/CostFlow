                        <span class="inline-block text-[12px] font-normal text-slate-400 mt-1 notif-time">${item.timeAgo}</span>
                    </div>
                    <div class="notif-right-action-wrap" onclick="event.stopPropagation()">
                        <span class="notif-dot"></span>
                        <button type="button" 
                                class="notif-row-action-btn" 
                                title="ตัวเลือกเพิ่มเติม"
                                onclick="openRowActionMenu(event, 'notif-item-${item.id}')">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                <circle cx="5" cy="12" r="2" />
                                <circle cx="12" cy="12" r="2" />
                                <circle cx="19" cy="12" r="2" />
                            </svg>
                        </button>
                    </div>
                `;
                secEarlier.appendChild(el);
            });
        }

        // Expose notification functions to window for inline HTML onclick handlers
        window.openRowActionMenu = openRowActionMenu;
        window.closeRowActionMenu = closeRowActionMenu;
        window.toggleRowReadStatusFromMenu = toggleRowReadStatusFromMenu;
        window.deleteRowFromMenu = deleteRowFromMenu;
        window.handleNotifItemClick = handleNotifItemClick;
        window.toggleNotifMoreMenu = toggleNotifMoreMenu;
        window.closeNotifMoreMenu = closeNotifMoreMenu;
        window.markAllNotifsAsRead = markAllNotifsAsRead;
        window.filterNotifsTab = filterNotifsTab;
        window.mockNotifSettings = mockNotifSettings;
        window.loadOlderNotifications = loadOlderNotifications;

        // Global capture-phase dismiss for popovers inside notification dropdown
        document.addEventListener('click', function(e) {
            // 1. Three-dots header menu dismiss (#notif-more-menu)
            if (notifMoreMenu && !notifMoreMenu.classList.contains('hidden')) {
                const moreBtn = document.getElementById('notif-more-options-btn');
                if (!notifMoreMenu.contains(e.target) && (!moreBtn || !moreBtn.contains(e.target))) {
                    closeNotifMoreMenu();
                    // If clicked inside notifDropdown, prevent accidental click on items/buttons
                    if (notifDropdown && notifDropdown.contains(e.target)) {
                        e.stopPropagation();
                        e.preventDefault();
                    }
                }
            }

            // 2. Row context menu dismiss (#notif-row-menu)
            if (notifRowMenu && !notifRowMenu.classList.contains('hidden')) {
                if (!notifRowMenu.contains(e.target) && !e.target.closest('.notif-row-action-btn')) {
                    closeRowActionMenu();
                    // If clicked inside notifDropdown, prevent accidental click on items/buttons
                    if (notifDropdown && notifDropdown.contains(e.target)) {
                        e.stopPropagation();
                        e.preventDefault();
                    }
                }
            }
        }, true);

        // Keyboard Escape dismiss for notification menus and dropdown
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (notifMoreMenu && !notifMoreMenu.classList.contains('hidden')) {
                    closeNotifMoreMenu();
                    return;
                }
                if (notifRowMenu && !notifRowMenu.classList.contains('hidden')) {
                    closeRowActionMenu();
                    return;
                }
                if (notifDropdown && !notifDropdown.classList.contains('hidden')) {
                    notifDropdown.classList.add('hidden');
                    if (notifDropdownBtn) notifDropdownBtn.classList.remove('is-active');
                    closeNotifMoreMenu();
                    closeRowActionMenu();
                }
            }
        });

        // Desktop: Sidebar toggle logic using the chart icon
        const sidebarToggleIcon = document.getElementById("sidebar-toggle-icon");
        if (sidebarToggleIcon) {
            sidebarToggleIcon.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();

                const isCollapsed = document.body.classList.toggle("sidebar-collapsed");
                localStorage.setItem("costflow_sidebar_collapsed", isCollapsed);
            });
        }

        // Mobile: Logo Menu Dropdown Toggle (Smooth Transition)
        const mobileMenuBtn = document.getElementById("mobile-logo-menu-btn");
        const mobileNavDropdown = document.getElementById("mobile-nav-dropdown");
        const mobileNavBackdrop = document.getElementById("mobile-nav-backdrop");
        const mobileMenuChevron = document.getElementById("mobile-menu-chevron");

        function toggleMobileMenu(open) {
            if (!mobileNavDropdown) return;
            const willOpen = (typeof open === "boolean") ? open : !mobileNavDropdown.classList.contains("is-open");
            
            if (willOpen) {
                mobileNavDropdown.classList.add("is-open");
                if (mobileNavBackdrop) mobileNavBackdrop.classList.add("is-open");
                if (mobileMenuChevron) mobileMenuChevron.style.transform = "rotate(180deg)";
            } else {
                mobileNavDropdown.classList.remove("is-open");
                if (mobileNavBackdrop) mobileNavBackdrop.classList.remove("is-open");
                if (mobileMenuChevron) mobileMenuChevron.style.transform = "rotate(0deg)";
            }
        }

        if (mobileMenuBtn && mobileNavDropdown) {
            mobileMenuBtn.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                toggleMobileMenu();
            });

            if (mobileNavBackdrop) {
                mobileNavBackdrop.addEventListener("click", function () {
                    toggleMobileMenu(false);
                });
            }

            document.addEventListener("click", function (e) {
                if (!mobileNavDropdown.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
                    toggleMobileMenu(false);
                }
            });
        }

        // Initialize Notifications system on page load
        updateUnreadCount();
        initNotificationSignalR();
        syncNotificationsFromApi();
    });
</script>

