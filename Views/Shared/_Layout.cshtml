@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject UserManager<CostFlow.Models.ApplicationUser> UserManager
@inject CostFlow.Services.IDateTimeProvider DateTimeProvider
@{
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "Home";

    string fullName = "ผู้ใช้งาน";
    string roleName = "ผู้ใช้งาน";
    bool isAdmin = false;
    bool isStaff = false;
    bool isDev = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        var appUser = await UserManager.GetUserAsync(User);
        fullName = User.FindFirstValue("FullName") ?? appUser?.FullName ?? User.Identity.Name ?? "ผู้ใช้งาน";

        string userName = User.Identity?.Name ?? appUser?.UserName ?? "";

        isAdmin = User.IsInRole("Admin") || userName.Equals("ADMIN01", StringComparison.OrdinalIgnoreCase);
        isStaff = User.IsInRole("Staff") || userName.Equals("STAFF01", StringComparison.OrdinalIgnoreCase);
        isDev = User.IsInRole("Dev") || userName.Equals("DEV01", StringComparison.OrdinalIgnoreCase);

        // ตั้ง roleName ก่อน override isAdmin
        roleName = isDev ? "ทีม Dev (Testing)" : isAdmin ? "ผู้ดูแลระบบ (Admin)" : isStaff ? "เจ้าหน้าที่ฝ่ายช่าง (Staff)" : "ผู้ใช้งาน";
        // Dev เห็นหน้าเดียวกับ Admin เพื่อใช้ทดสอบได้ครบทุกหน้า
        if (isDev) isAdmin = true;
    }

    string profilePic = User.FindFirstValue("ProfilePictureUrl") ?? "";
    if (string.IsNullOrEmpty(profilePic))
    {
        if (isStaff)
        {
            string[] staffCatPics = new[]
            {
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTDukEND1o9OJ0ERT0Csbm9mFK5WxJENappr_X5SaViAoIlbiwGHhI4xb6x&s=10",
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRLFz54uCaYL0tyhkyi171ZW8Obs49WiToB3BWlzpVHpF75ASK0vo9z2b0&s=10",
                "https://png.pngtree.com/background/20230613/original/pngtree-cat-in-mechanic-suit-repairing-motorcycle-ai-generated-picture-image_3393337.jpg",
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRXwZtGgdCZRdhuxT-xIiN0Y1_scCSemWjZmposELosRUJDHD83_foRdYsj&s=10",
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT7uIQzGaZnwYjDcOPmdQ7v6RXLt57pQLMcQ27_KBjRHwAn-DOMAUBJlxBn&s=10"
            };
            var rnd = new Random();
            profilePic = staffCatPics[rnd.Next(staffCatPics.Length)];
        }
        else
        {
            profilePic = "https://img.favpng.com/9/17/18/3d-woman-avatar-cartoon-woman-with-bright-glasses-and-friendly-smile-wtuATRW2.jpg";
        }
    }

    string GetNavClass(string targetController, string targetAction = "")
    {
        var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? "Index";
        bool isActive = string.Equals(controllerName, targetController, StringComparison.OrdinalIgnoreCase);
        if (isActive && !string.IsNullOrEmpty(targetAction))
        {
            isActive = string.Equals(actionName, targetAction, StringComparison.OrdinalIgnoreCase);
        }

        return isActive
            ? "group relative cursor-pointer flex items-center gap-2 px-3 py-2 rounded-sm text-primary font-bold border-r-4 border-primary bg-primary-container/10 transition-all font-body-md"
            : "group relative cursor-pointer flex items-center gap-2 px-3 py-2 rounded-sm text-secondary hover:text-primary hover:bg-secondary-container/50 transition-all font-body-md";
    }
}
