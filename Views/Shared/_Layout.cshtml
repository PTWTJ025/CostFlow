        /* Modern UX/UI Safe Area & Dynamic Viewport Height for Tablet/Mobile System Bars */
        :root {
            --sat: env(safe-area-inset-top, 0px);
            --sar: env(safe-area-inset-right, 0px);
            --sab: env(safe-area-inset-bottom, 0px);
            --sal: env(safe-area-inset-left, 0px);
        }
    
        .pb-safe {
            padding-bottom: max(1.5rem, var(--sab, 24px)) !important;
