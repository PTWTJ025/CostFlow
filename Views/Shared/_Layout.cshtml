@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject UserManager<CostFlow.Models.ApplicationUser> UserManager
@inject CostFlow.Services.IDateTimeProvider DateTimeProvider
@{
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "Home";

    string fullName = "ผู้ใช้งาน";
    string roleName = "ผู้ใช้งาน";
    bool isAdmin = false;
    bool isStaff = false;
    bool isDev = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        var appUser = await UserManager.GetUserAsync(User);
        fullName = User.FindFirstValue("FullName") ?? appUser?.FullName ?? User.Identity.Name ?? "ผู้ใช้งาน";

        string userName = User.Identity?.Name ?? appUser?.UserName ?? "";

        isAdmin = User.IsInRole("Admin") || userName.Equals("ADMIN01", StringComparison.OrdinalIgnoreCase);
        isStaff = User.IsInRole("Staff") || userName.Equals("STAFF01", StringComparison.OrdinalIgnoreCase);
        isDev = User.IsInRole("Dev") || userName.Equals("DEV01", StringComparison.OrdinalIgnoreCase);

        // ตั้ง roleName ก่อน override isAdmin
        roleName = isDev ? "ทีม Dev (Testing)" : isAdmin ? "ผู้ดูแลระบบ (Admin)" : isStaff ? "เจ้าหน้าที่ฝ่ายช่าง (Staff)" : "ผู้ใช้งาน";
        // Dev เห็นหน้าเดียวกับ Admin เพื่อใช้ทดสอบได้ครบทุกหน้า
        if (isDev) isAdmin = true;
    }

    string profilePic = User.FindFirstValue("ProfilePictureUrl") ?? "";
    if (string.IsNullOrEmpty(profilePic))
    {
        if (isStaff)
        {
            string[] staffCatPics = new[]
            {
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTDukEND1o9OJ0ERT0Csbm9mFK5WxJENappr_X5SaViAoIlbiwGHhI4xb6x&s=10",
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRLFz54uCaYL0tyhkyi171ZW8Obs49WiToB3BWlzpVHpF75ASK0vo9z2b0&s=10",
                "https://png.pngtree.com/background/20230613/original/pngtree-cat-in-mechanic-suit-repairing-motorcycle-ai-generated-picture-image_3393337.jpg",
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRXwZtGgdCZRdhuxT-xIiN0Y1_scCSemWjZmposELosRUJDHD83_foRdYsj&s=10",
                "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT7uIQzGaZnwYjDcOPmdQ7v6RXLt57pQLMcQ27_KBjRHwAn-DOMAUBJlxBn&s=10"
            };
            var rnd = new Random();
            profilePic = staffCatPics[rnd.Next(staffCatPics.Length)];
        }
        else
        {
            profilePic = "https://img.favpng.com/9/17/18/3d-woman-avatar-cartoon-woman-with-bright-glasses-and-friendly-smile-wtuATRW2.jpg";
        }
    }

    string GetNavClass(string targetController, string targetAction = "")
    {
        var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? "Index";
        bool isActive = string.Equals(controllerName, targetController, StringComparison.OrdinalIgnoreCase);
        if (isActive && !string.IsNullOrEmpty(targetAction))
        {
            isActive = string.Equals(actionName, targetAction, StringComparison.OrdinalIgnoreCase);
        }

        return isActive
            ? "group relative cursor-pointer flex items-center gap-2 px-3 py-2 rounded-sm text-primary font-bold border-r-4 border-primary bg-primary-container/10 transition-all font-body-md"
            : "group relative cursor-pointer flex items-center gap-2 px-3 py-2 rounded-sm text-secondary hover:text-primary hover:bg-secondary-container/50 transition-all font-body-md";
    }
}
<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CostFlow</title>

    <!-- Static Compiled & Minified Tailwind CSS -->
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true"/>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        /* Arbitrary font-size fallbacks for static Tailwind CSS */
        .text-\[11px\] {
            font-size: 11px !important;
        }
    
        .text-\[12px\] {
            font-size: 12px !important;
        }
    
        .text-\[13px\] {
            font-size: 13px !important;
        }
    
        .text-\[14px\] {
            font-size: 14px !important;
        }
    
        .text-\[15px\] {
            font-size: 15px !important;
        }
    
        .text-\[16px\] {
            font-size: 16px !important;
        }
    
        /* Custom Scrollbar for tables */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
    
        ::-webkit-scrollbar-track {
            background: transparent;
        }
    
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }
    
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
    
        /* Sidebar overlay for mobile/tablet */
        #sidebar-overlay {
            display: none;
        }
    
        /* Sidebar transition and state styling */
        #sidebar {
            transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    
        main {
            transition: margin-left 0.2s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    
        /* Desktop collapsed state (controlled by .sidebar-collapsed class on body) */
        body.sidebar-collapsed #sidebar {
            width: 56px;
            overflow: visible !important;
        }
    
        body.sidebar-collapsed main {
            margin-left: 56px !important;
        }
    
        @@media (min-width: 1280px) {
            body.sidebar-collapsed main {
                max-width: calc(100vw - 56px) !important;
            }
        }
    
        #sidebar span,
        #sidebar div.text-\[10px\],
        #sidebar hr,
        #sidebar .h-\[64px\] div {
            transition: opacity 0.15s ease-out, width 0.2s cubic-bezier(0.4, 0, 0.2, 1), margin 0.2s, padding 0.2s;
            white-space: nowrap;
            overflow: hidden;
            opacity: 1;
        }

        body.sidebar-collapsed #sidebar span,
        body.sidebar-collapsed #sidebar div.text-\[10px\],
        body.sidebar-collapsed #sidebar hr,
        body.sidebar-collapsed #sidebar .h-\[64px\] div {
            opacity: 0 !important;
            width: 0 !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            pointer-events: none;
        }

        #sidebar a {
            transition: padding 0.2s cubic-bezier(0.4, 0, 0.2, 1), justify-content 0.2s;
        }

        body.sidebar-collapsed #sidebar a {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }
    
        body.sidebar-collapsed #sidebar .px-md {
            padding-left: 8px;
            padding-right: 8px;
        }
    
        body.sidebar-collapsed #sidebar .h-\[64px\] {
            padding-left: 0 !important;
            padding-right: 0 !important;
            justify-content: center !important;
            gap: 0 !important;
        }
    
        /* Impeccable Guide Tooltip on Hover when Sidebar Collapsed */
        body.sidebar-collapsed #sidebar a[data-guide]:hover::after {
            content: attr(data-guide);
            position: absolute;
            left: calc(100% + 14px);
            top: 50%;
            transform: translateY(-50%);
            background-color: #0F172A;
            color: #FFFFFF;
            font-size: 13.5px;
            font-weight: 600;
            padding: 7px 14px;
            border-radius: 8px;
            white-space: nowrap;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.25), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
            z-index: 99999;
            pointer-events: none;
            animation: guideTooltipFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
    
        body.sidebar-collapsed #sidebar a[data-guide]:hover::before {
            content: '';
            position: absolute;
            left: calc(100% + 8px);
            top: 50%;
            transform: translateY(-50%);
            border-width: 6px;
            border-style: solid;
            border-color: transparent #0F172A transparent transparent;
            z-index: 99999;
            pointer-events: none;
            animation: guideTooltipFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    
        @@keyframes guideTooltipFadeIn {
            0% {
                opacity: 0;
                transform: translateY(-50%) scale(0.92) translateX(-6px);
            }
    
            100% {
                opacity: 1;
                transform: translateY(-50%) scale(1) translateX(0);
            }
        }
    
        /* iPad / tablet: sidebar icon-only, hover to expand */
        @@media (min-width: 768px) and (max-width: 1023px) {
            #sidebar {
                width: 56px;
                overflow: hidden;
            }
    
            #sidebar:hover {
                width: 256px;
                overflow: visible;
            }
    
            #sidebar a span {
                opacity: 0;
                white-space: nowrap;
                transition: opacity 0.15s;
            }
    
            #sidebar:hover a span {
                opacity: 1;
            }
    
            main {
                margin-left: 56px !important;
            }
        }
    
        /* Desktop large (≥ 1280px) */
        @@media (min-width: 1280px) {
            main {
                max-width: calc(100vw - 256px);
            }
        }
    
        /* Modern UX/UI Safe Area & Dynamic Viewport Height for Tablet/Mobile System Bars */
        :root {
            --sat: env(safe-area-inset-top, 0px);
            --sar: env(safe-area-inset-right, 0px);
            --sab: env(safe-area-inset-bottom, 0px);
            --sal: env(safe-area-inset-left, 0px);
        }
    
        .pb-safe {
            padding-bottom: max(1.5rem, var(--sab, 24px)) !important;
        }
    
        .pr-safe {
            padding-right: max(1.5rem, var(--sar, 24px)) !important;
        }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@100;200;300;400;500;600;700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <!-- Lucide Icons (Local Embedded) -->
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="icon" type="image/png" href="~/favicon.png"/>
    <link rel="shortcut icon" href="~/favicon.ico"/>
</head>

<body class="sidebar-collapsed text-on-surface flex h-[100dvh] overflow-hidden bg-[#F8FAFC] font-sans">
<script>
    (function () {
        const savedCollapsed = localStorage.getItem('costflow_sidebar_collapsed');
        if (savedCollapsed === 'false') {
            document.body.classList.remove('sidebar-collapsed');
        } else {
            document.body.classList.add('sidebar-collapsed');
        }
    })();
</script>
