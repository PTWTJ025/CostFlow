<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CostFlow</title>

    <!-- Static Compiled & Minified Tailwind CSS -->
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true"/>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <style>
        /* Arbitrary font-size fallbacks for static Tailwind CSS */
        .text-\[11px\] {
            font-size: 11px !important;
        }
    
        .text-\[12px\] {
            font-size: 12px !important;
        }
    
        .text-\[13px\] {
            font-size: 13px !important;
        }
    
        .text-\[14px\] {
            font-size: 14px !important;
        }
    
        .text-\[15px\] {
            font-size: 15px !important;
        }
    
        .text-\[16px\] {
            font-size: 16px !important;
        }
    
        /* Custom Scrollbar for tables */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
    
        ::-webkit-scrollbar-track {
            background: transparent;
        }
    
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }
    
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
    
        /* Sidebar overlay for mobile/tablet */
        #sidebar-overlay {
            display: none;
        }
    
        /* Sidebar transition and state styling */
        #sidebar {
            transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    
        main {
            transition: margin-left 0.2s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    
        /* Desktop collapsed state (controlled by .sidebar-collapsed class on body) */
        body.sidebar-collapsed #sidebar {
            width: 56px;
            overflow: visible !important;
        }
    
        body.sidebar-collapsed main {
            margin-left: 56px !important;
        }
    
        @@media (min-width: 1280px) {
            body.sidebar-collapsed main {
                max-width: calc(100vw - 56px) !important;
            }
        }
    
        #sidebar span,
        #sidebar div.text-\[10px\],
        #sidebar hr,
        #sidebar .h-\[64px\] div {
            transition: opacity 0.15s ease-out, width 0.2s cubic-bezier(0.4, 0, 0.2, 1), margin 0.2s, padding 0.2s;
            white-space: nowrap;
            overflow: hidden;
            opacity: 1;
        }

        body.sidebar-collapsed #sidebar span,
        body.sidebar-collapsed #sidebar div.text-\[10px\],
        body.sidebar-collapsed #sidebar hr,
        body.sidebar-collapsed #sidebar .h-\[64px\] div {
            opacity: 0 !important;
            width: 0 !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            pointer-events: none;
        }

        #sidebar a {
            transition: padding 0.2s cubic-bezier(0.4, 0, 0.2, 1), justify-content 0.2s;
        }

        body.sidebar-collapsed #sidebar a {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }
    
        body.sidebar-collapsed #sidebar .px-md {
            padding-left: 8px;
            padding-right: 8px;
        }
    
        body.sidebar-collapsed #sidebar .h-\[64px\] {
            padding-left: 0 !important;
            padding-right: 0 !important;
            justify-content: center !important;
            gap: 0 !important;
        }
    
        /* Impeccable Guide Tooltip on Hover when Sidebar Collapsed */
        body.sidebar-collapsed #sidebar a[data-guide]:hover::after {
            content: attr(data-guide);
            position: absolute;
            left: calc(100% + 14px);
            top: 50%;
            transform: translateY(-50%);
            background-color: #0F172A;
            color: #FFFFFF;
            font-size: 13.5px;
            font-weight: 600;
            padding: 7px 14px;
            border-radius: 8px;
            white-space: nowrap;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.25), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
            z-index: 99999;
            pointer-events: none;
            animation: guideTooltipFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
    
        body.sidebar-collapsed #sidebar a[data-guide]:hover::before {
            content: '';
            position: absolute;
            left: calc(100% + 8px);
            top: 50%;
            transform: translateY(-50%);
            border-width: 6px;
            border-style: solid;
            border-color: transparent #0F172A transparent transparent;
            z-index: 99999;
            pointer-events: none;
            animation: guideTooltipFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    
        @@keyframes guideTooltipFadeIn {
            0% {
                opacity: 0;
                transform: translateY(-50%) scale(0.92) translateX(-6px);
            }
    
            100% {
                opacity: 1;
                transform: translateY(-50%) scale(1) translateX(0);
            }
        }
    
        /* Responsive Controls (Desktop vs Mobile) */
        @@media (min-width: 768px) {
            #mobile-logo-menu-btn {
                display: none !important;
            }
            #mobile-nav-dropdown {
                display: none !important;
            }
            #mobile-nav-backdrop {
