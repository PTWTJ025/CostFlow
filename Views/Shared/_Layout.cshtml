                        isActive = string.Equals(actName, targetAct, StringComparison.OrdinalIgnoreCase);
                    }
                    return isActive 
                        ? "flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-bold text-primary bg-primary/10 border-l-2 border-primary" 
                        : "flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors";
