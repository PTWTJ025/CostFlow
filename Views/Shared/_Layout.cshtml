                <span>คำนวณค่าใช้จ่าย</span>
                <span class="text-[9px] font-bold text-red-400 ml-1">[รอลบทิ้ง]</span>
            </a>
            *@
        }
    </div>
    <!-- Footer Links: Reduced spacing and simplified -->
    <div class="px-md flex flex-col gap-xs mt-auto mb-2">
        @if (isAdmin)
        {
            <div class="purchase-system-menu-container relative w-full">
                <!-- Purchase System Collapsible Menu (Admin Only) -->
                <button id="purchase-menu-toggle"
                    class="purchase-menu-trigger group relative cursor-pointer flex items-center gap-2 px-3 py-2 rounded-sm text-slate-500 hover:text-slate-700 hover:bg-slate-50 transition-all font-body-md w-full"
                    data-guide="ระบบจัดซื้อ (เครื่องมือเสริม)">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
                </svg>
                <span class="text-[13px] font-medium">ระบบจัดซื้อ</span>
                <svg id="purchase-chevron" class="w-4 h-4 ml-auto transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>

            <!-- Dropdown Menu -->
            <div id="purchase-dropdown" class="purchase-dropdown" style="display: none;">
                <a asp-controller="PriceReference" asp-action="Index"
                   class="purchase-dropdown-item group flex items-center gap-2 px-3 py-2 ml-3 mr-1 rounded-sm text-slate-600 hover:text-primary hover:bg-primary-container/10 transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h16.5m-18 3h18M3.75 10.5h16.5M3.75 13.5h16.5M7.5 12h-.008v.008H7.5V12Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm-.375 3h-.008v.008H7.5V15Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm9.625-3h-.008v.008h-.008V12Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm-.375 3h-.008v.008h-.008V15Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Z"/>
                    </svg>
                    <span class="text-[12px] font-medium">ราคากลางอ้างอิง</span>
                </a>
                <a asp-controller="ProductSearch" asp-action="Index"
                   class="purchase-dropdown-item group flex items-center gap-2 px-3 py-2 ml-3 mr-1 rounded-sm text-slate-600 hover:text-primary hover:bg-primary-container/10 transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                    </svg>
                    <span class="text-[12px] font-medium">คีย์ข้อมูลจัดซื้อ</span>
                </a>
                <a asp-controller="ProductSearch" asp-action="SavedOrders"
                   class="purchase-dropdown-item group flex items-center gap-2 px-3 py-2 ml-3 mr-1 rounded-sm text-slate-600 hover:text-primary hover:bg-primary-container/10 transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.03 0 1.9.693 2.166 1.638m-7.377 2.24a4.008 4.008 0 0 1 1.953-3.238"/>
                    </svg>
                    <span class="text-[12px] font-medium">ดูรายการที่บันทึก</span>
                </a>
                <a asp-controller="OrderTracking" asp-action="Index"
                   class="purchase-dropdown-item group flex items-center gap-2 px-3 py-2 ml-3 mr-1 rounded-sm text-slate-600 hover:text-primary hover:bg-primary-container/10 transition-all">
                    <!-- Heroicon: archive-box -->
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H2.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                    </svg>
                    <span class="text-[12px] font-medium">ติดตามสินค้า</span>
                </a>
            </div>
            </div>
            
        }

        @if (isAdmin)
        {
            <a class="@GetNavClass("Home", "Settings")" data-guide="ตั้งค่า" asp-controller="Home"
               asp-action="Settings">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.43l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
                </svg>
                <span>ตั้งค่า</span>
            </a>
        }
        else if (isStaff)
        {
            <a asp-controller="Account" asp-action="Logout"
               class="group relative cursor-pointer flex items-center gap-2 px-3 py-2 rounded-sm text-red-500 hover:text-red-600 hover:bg-red-50 transition-all font-body-md w-full"
               data-guide="ออกจากระบบ">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75"/>
                </svg>
                <span>ออกจากระบบ</span>
            </a>
        }
    </div>
</nav>

<!-- Main Content Area -->
<main class="flex-1 md:ml-64 flex flex-col h-[100dvh] max-h-[100dvh] min-h-0 overflow-hidden">
    <!-- TopAppBar -->
    <header
        class="h-[64px] flex justify-between items-center px-4 md:px-6 w-full sticky top-0 z-30 bg-white border-b border-slate-200">
        <div class="flex items-center gap-3">
            <h2 class="text-lg font-semibold text-slate-800 truncate">@ViewData["HeaderTitle"]</h2>
        </div>
        <!-- Redesigned Profile Info Pill with Dropdown -->
        <div class="flex items-center gap-sm relative">
            <button id="profile-dropdown-btn"
                    class="group flex items-center gap-2.5 hover:bg-slate-50 hover:shadow-sm border border-slate-200/70 transition-all pl-1.5 pr-3.5 py-1 rounded-full bg-white select-none">
                <div
                    class="relative w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200 overflow-hidden shrink-0">
                    <img alt="User profile photo"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                         src="@profilePic"/>
                    <!-- Online Status Badge -->
                    <span
                        class="absolute bottom-0 right-0 block h-2 w-2 rounded-full bg-emerald-500 ring-2 ring-white">
                    </span>
                </div>
                <div class="flex flex-col text-left shrink-0">
                    <span
                        class="text-xs font-bold text-slate-800 leading-none group-hover:text-primary transition-colors mb-0.5">
                        @fullName
                    </span>
                    <span class="text-[9px] text-slate-500 font-semibold leading-none">@roleName</span>
                </div>
                <!-- Chevron Dropdown Indicator -->
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-colors ml-0.5 shrink-0"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>

            <!-- Dropdown Menu -->
            <div id="profile-dropdown"
                 class="hidden absolute right-0 top-full mt-2 w-52 bg-white rounded-lg shadow-lg border border-slate-200 py-1 z-50">
                <div class="px-4 py-2.5 border-b border-slate-100">
                    <p class="text-xs font-bold text-slate-800 truncate">@fullName</p>
                    <p class="text-[10px] text-slate-500 font-medium">@roleName</p>
                </div>
                <a asp-controller="Account" asp-action="Logout"
                   class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75"/>
                    </svg>
                    <span>ออกจากระบบ</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Render Body: overflow-y-auto allows normal document pages (Report, Home, Index) to scroll naturally.
    App-shell pages like Detail.cshtml use h-full min-h-0 overflow-hidden on their root container to contain their own inner scroll table without triggering this outer scrollbar. -->
    <div class="flex-1 flex flex-col min-h-0 overflow-y-auto" id="main-content-scroll">
        @RenderBody()
    </div>

    <!-- Footer
    <footer class="w-full py-md border-t border-slate-200 bg-white text-center text-xs text-slate-400 font-sans flex flex-col sm:flex-row items-center justify-between px-lg select-none gap-2">
        <span>&copy; @DateTime.Now.Year - CostFlow. All rights reserved.</span>
    </footer> -->
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Profile Dropdown
        const profileDropdownBtn = document.getElementById("profile-dropdown-btn");
        const profileDropdown = document.getElementById("profile-dropdown");

        // Purchase System Menu Dropdown
        const purchaseMenuToggle = document.getElementById("purchase-menu-toggle");
        const purchaseDropdown = document.getElementById("purchase-dropdown");
        const purchaseChevron = document.getElementById("purchase-chevron");
        let isPurchaseMenuOpen = false;

        if (purchaseMenuToggle && purchaseDropdown) {
            purchaseMenuToggle.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                isPurchaseMenuOpen = !isPurchaseMenuOpen;

                if (isPurchaseMenuOpen) {
                    purchaseDropdown.style.display = "block";
                    setTimeout(() => {
                        purchaseDropdown.classList.add("purchase-dropdown-open");
                        purchaseChevron.style.transform = "rotate(180deg)";
                    }, 10);
                } else {
                    purchaseDropdown.classList.remove("purchase-dropdown-open");
                    purchaseChevron.style.transform = "rotate(0deg)";
                    setTimeout(() => {
                        purchaseDropdown.style.display = "none";
                    }, 200);
                }
            });

            // Close when clicking outside
            document.addEventListener("click", function (e) {
                if (!purchaseMenuToggle.contains(e.target) && !purchaseDropdown.contains(e.target)) {
                    if (isPurchaseMenuOpen) {
                        isPurchaseMenuOpen = false;
                        purchaseDropdown.classList.remove("purchase-dropdown-open");
                        purchaseChevron.style.transform = "rotate(0deg)";
                        setTimeout(() => {
                            purchaseDropdown.style.display = "none";
                        }, 200);
                    }
                }
            });
        }

        if (profileDropdownBtn && profileDropdown) {
            profileDropdownBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                profileDropdown.classList.toggle("hidden");
            });

            document.addEventListener("click", function (e) {
                if (!profileDropdownBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add("hidden");
                }
            });
        }

        // Sidebar toggle logic using the chart icon
        const sidebarToggleIcon = document.getElementById("sidebar-toggle-icon");
        if (sidebarToggleIcon) {
            sidebarToggleIcon.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();

                const isCollapsed = document.body.classList.toggle("sidebar-collapsed");
                localStorage.setItem("costflow_sidebar_collapsed", isCollapsed);
            });
        }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
