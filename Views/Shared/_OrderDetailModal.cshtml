<!-- Shared Order Detail Modal -->
<div id="detail-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(2px);">
    
    <!-- Modal Card -->
    <div class="w-full bg-white border border-slate-200 shadow-2xl overflow-hidden font-sans"
         style="max-width: 680px; max-height: 90vh; display: flex; flex-direction: column; border-radius: 12px;">

        <!-- Header (fixed) -->
        <div style="padding: 20px 24px; border-bottom: 1px solid #f1f5f9; flex-shrink: 0;">
            <div style="display: flex; align-items: flex-start; justify-content: space-between;">
                <div>
                    <h3 style="font-size: 18px; font-weight: 700; color: #1e293b; line-height: 1.3;">รายละเอียดข้อมูลแผนผลิต</h3>
                    <p style="font-size: 13px; color: #94a3b8; margin-top: 4px;">ข้อมูลใบสั่งและประวัติความคืบหน้ารายสัปดาห์</p>
                </div>
                <button id="btn-close-detail-modal"
                        style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; color: #94a3b8; border: none; background: transparent; cursor: pointer;"
                        onmouseover="this.style.background='#f1f5f9'; this.style.color='#475569';"
                        onmouseout="this.style.background='transparent'; this.style.color='#94a3b8';">
                    <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Scrollable Body (single scroll area) -->
        <div id="detail-content" style="flex: 1; overflow-y: auto; padding: 0 24px 24px 24px;">
            
            <!-- Section 1: Info Table -->
            <table style="width: 100%; text-align: left; border-collapse: collapse; table-layout: fixed;">
                <tbody>
                    <!-- สถานะใบสั่ง -->
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8;">สถานะใบสั่ง</td>
                        <td style="width: 65%; padding: 14px 0;"><div id="detail-order-status-badge">-</div></td>
                    </tr>
                    <!-- แผนก -->
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8;">แผนก</td>
                        <td style="width: 65%; padding: 14px 0; font-size: 13px; font-weight: 700; color: #1e293b;" id="detail-department">-</td>
                    </tr>
                    <!-- เลขที่อนุมัติในไฟล์ -->
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8;">เลขที่อนุมัติในไฟล์</td>
                        <td style="width: 65%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #334155;" id="detail-po-number">-</td>
                    </tr>
                    <!-- เป้าหมายส่งมอบ -->
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8;">เป้าหมายส่งมอบ</td>
                        <td style="width: 65%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #334155;" id="detail-delivery-target">-</td>
                    </tr>
                    <!-- ราคาที่ผู้ผลิตเสนอ -->
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8;">ราคาที่ผู้ผลิตเสนอ</td>
                        <td style="width: 65%; padding: 14px 0; font-size: 13px; font-weight: 700; color: #1e293b;" id="detail-weekly-price">-</td>
                    </tr>
                    <!-- ชื่อใบสั่ง -->
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8; vertical-align: top;">ชื่อใบสั่ง</td>
                        <td style="width: 65%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #334155; line-height: 1.6;" id="detail-order-name">-</td>
                    </tr>
                    <!-- ชื่อไฟล์ล่าสุด -->
                    <tr>
                        <td style="width: 35%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #94a3b8; vertical-align: top;">ชื่อไฟล์ล่าสุด</td>
                        <td style="width: 65%; padding: 14px 0; font-size: 13px; font-weight: 500; color: #2563eb; word-break: break-all; cursor: pointer;" id="detail-file-name" title="-">-</td>
                    </tr>
                </tbody>
            </table>

            <!-- Section 2: History Accordion -->
            <div style="border-top: 1px solid #f1f5f9; margin-top: 20px; padding-top: 16px;">
                <button id="btn-toggle-history" 
                        style="width: 100%; display: flex; align-items: center; justify-content: space-between; background: none; border: none; cursor: pointer; padding: 0; color: #334155;"
                        onmouseover="this.style.color='#0f172a';" onmouseout="this.style.color='#334155';">
                    <span style="font-size: 14px; font-weight: 600;">ประวัติความคืบหน้าแผนผลิต (รายสัปดาห์)</span>
                    <svg id="chevron-history" style="width: 16px; height: 16px; color: #94a3b8; transition: transform 0.2s ease;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <!-- History items container (starts hidden) -->
                <div id="history-wrapper" style="display: none; margin-top: 16px;">
                    <div id="detail-history-container">
                        <!-- Timeline items will be rendered dynamically here by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer (fixed) -->
        <div style="padding: 16px 24px; border-top: 1px solid #f1f5f9; background: #f8fafc; flex-shrink: 0; display: flex; justify-content: flex-end;">
            <button id="btn-close-detail"
                    style="padding: 8px 20px; border-radius: 8px; font-size: 13px; font-weight: 500; color: #475569; background: white; border: 1px solid #e2e8f0; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: all 0.15s;"
                    onmouseover="this.style.background='#f1f5f9'; this.style.color='#1e293b';"
                    onmouseout="this.style.background='white'; this.style.color='#475569';">
                ปิด
            </button>
        </div>
    </div>
</div>
