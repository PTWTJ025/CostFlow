@model List<CostFlow.Controllers.TrackingBatchViewModel>
@{
    ViewData["Title"] = "ติดตามสถานะสินค้า";
    ViewData["HeaderTitle"] = "ติดตามสถานะการรับสินค้า";
}

<div class="flex-1 py-md md:py-lg flex flex-col gap-md w-full h-full min-h-0 overflow-hidden bg-background" style="padding-left: clamp(1.5rem, 6vw, 6rem); padding-right: clamp(1.5rem, 6vw, 6rem);">

    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-on-surface-variant shrink-0">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5">
            <!-- Heroicon: home -->
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
            </svg>
            <span>หน้าแรก</span>
        </a>
        <svg class="w-3 h-3 text-outline opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="font-semibold text-on-surface">ติดตามสินค้า</span>
    </div>

    <!-- Page Title -->
    <div class="shrink-0">
        <h1 class="text-2xl font-bold text-on-surface mb-2 tracking-tight">ติดตามสถานะการรับสินค้า</h1>
        <p class="text-sm text-on-surface-variant">
            ตรวจสอบและอัปเดตสถานะการรับสินค้าของแต่ละแผ่นงาน
        </p>
    </div>

    <!-- Content Card -->
    <div class="flex-1 bg-white rounded-xl border border-outline-variant shadow-sm flex flex-col min-h-0 overflow-hidden">

        <!-- Toolbar -->
        <div class="shrink-0 p-4 border-b border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row sm:items-center justify-between gap-4">

            <!-- Filters -->
            <form method="get" id="filter-form" class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                <!-- Month Filter -->
                <div class="relative">
                    <select name="month" onchange="document.getElementById('filter-form').submit();"
                            class="appearance-none pl-3 pr-8 py-2 border border-slate-300 rounded text-[13px] font-medium text-slate-600 outline-none cursor-pointer bg-white hover:border-slate-400 focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all h-[36px]">
                        <option value="">ทุกเดือน</option>
                        @{
                            string[] thaiMonths = { "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };
                            int? selectedMonth = ViewData["SelectedMonth"] as int?;
                            for (int i = 1; i <= 12; i++)
                            {
                                if (selectedMonth == i)
                                {
                                    <option value="@i" selected>@thaiMonths[i - 1]</option>
                                }
                                else
                                {
                                    <option value="@i">@thaiMonths[i - 1]</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Year Filter -->
                <div class="relative">
                    <select name="year" onchange="document.getElementById('filter-form').submit();"
                            class="appearance-none pl-3 pr-8 py-2 border border-slate-300 rounded text-[13px] font-medium text-slate-600 outline-none cursor-pointer bg-white hover:border-slate-400 focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all h-[36px]">
                        <option value="">ทุกปี</option>
                        @{
                            var years = ViewData["AvailableYears"] as List<int> ?? new List<int>();
                            int? selectedYear = ViewData["SelectedYear"] as int?;
                            foreach (var y in years)
                            {
                                if (selectedYear == y)
                                {
                                    <option value="@y" selected>@(y + 543)</option>
                                }
                                else
                                {
                                    <option value="@y">@(y + 543)</option>
                                }
                            }
                        }
                    </select>
                </div>
            </form>

            <!-- Search -->
            <div class="relative w-full sm:w-72 sm:mt-0">
                <input type="text" id="search-input" placeholder="ค้นหาชื่อแผ่นงาน..."
                       class="w-full pl-8 pr-3 py-2 h-[36px] text-[13px] bg-white border border-slate-300 rounded text-slate-600 placeholder-slate-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all"/>
            </div>
        </div>

        <!-- Table -->
        <div class="flex-1 overflow-auto relative min-h-0">
            <table class="w-full text-[13px]">
                <thead>
                <tr class="text-[11px] font-semibold text-on-surface-variant">
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-left">ชื่อแผ่นงาน</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-left">เวลาที่บันทึก</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-right">รายการ</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-center">สถานะรับสินค้า</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-center">การจัดการ</th>
                </tr>
                </thead>
                <tbody id="batch-tbody">
                @if (Model != null && Model.Any())
                {
                    string selectedBatch = (ViewData["SelectedBatch"] as string) ?? "";

                    foreach (var batch in Model)
                    {
                        string highlightClass = batch.BatchName == selectedBatch ? "bg-primary/5 border-l-4 border-l-primary" : "";

                        <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors batch-row @highlightClass"
                            data-name="@batch.BatchName">
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-2">
                                    <!-- Heroicon: document-text -->
                                    <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                                    </svg>
                                    <a href="/OrderTracking/Detail?batchName=@Uri.EscapeDataString(batch.BatchName)" class="font-semibold text-primary hover:underline transition-colors">@batch.BatchName</a>
                                </div>
                            </td>
                            <td class="py-3 px-4 text-on-surface-variant font-mono text-xs">
                                @(batch.CreatedAt == default ? "-" : batch.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                            <td class="py-3 px-4 text-right">
                                <span class="inline-flex items-center justify-center min-w-[44px] px-2 py-0.5 rounded text-[12px] font-semibold text-on-surface-variant"> @batch.TotalItems </span>
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (batch.IsReceived)
                                {
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                        </svg>
                                        <span class="text-[11px] font-bold">รับสินค้าครบแล้ว</span>
                                    </div>
                                }
                                else if (batch.ReceivedItems > 0)
                                {
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-50 text-blue-700 border border-blue-200">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        <span class="text-[11px] font-bold">รับแล้ว @batch.ReceivedItems/@batch.TotalItems รายการ</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-50 text-amber-700 border border-amber-200">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        <span class="text-[11px] font-bold">รอรับสินค้า</span>
                                    </div>
                                }
                            </td>
                            <td class="py-3 px-4 text-center">
                                <a href="/OrderTracking/Detail?batchName=@Uri.EscapeDataString(batch.BatchName)"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded text-[12px] font-semibold text-primary bg-primary/10 hover:bg-primary/20 transition-all">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                                    </svg>
                                    ดูรายการสินค้า
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="pt-28 pb-16 text-center">
                            <div class="flex flex-col items-center gap-3">
                                <!-- Heroicon: inbox -->
                                <svg class="w-10 h-10 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"/>
                                </svg>
                                <div>
                                    <p class="font-semibold text-on-surface text-sm">ไม่พบรายการสินค้า</p>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                <tr id="no-search-results" class="hidden">
                    <td colspan="5" class="py-10 text-center text-xs text-on-surface-variant">
                        <div class="flex flex-col items-center gap-2">
                            <svg class="w-8 h-8 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                            </svg>
                            <span class="font-semibold text-on-surface text-sm">ไม่พบข้อมูลที่ค้นหา</span>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Focus highlighted batch if any
            const highlightedRow = document.querySelector('.batch-row.bg-primary\\/5');
            if (highlightedRow) {
                highlightedRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            // Search Filter
            const searchInput = document.getElementById('search-input');
            const rows = Array.from(document.querySelectorAll('.batch-row'));
            const noResults = document.getElementById('no-search-results');

            if (searchInput) {
                searchInput.addEventListener('input', () => {
                    const query = searchInput.value.trim().toLowerCase();
                    let visibleCount = 0;
                    rows.forEach(row => {
                        const name = (row.dataset.name || '').toLowerCase();
                        const matches = name.includes(query);
                        row.style.display = matches ? '' : 'none';
                        if (matches) visibleCount++;
                    });
                    if (noResults) {
                        noResults.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
                    }
                });
            });
    </script>
    <style>
        .swal-popup-custom {
            border-radius: 12px !important;
            font-family: 'Poppins', 'IBM Plex Sans Thai', sans-serif !important;
        }
    
        .swal-btn-primary {
            background: #00288e !important;
            border-radius: 6px !important;
            padding: 10px 24px !important;
        }
    
        .swal-btn-cancel {
            background: #f1f5f9 !important;
            color: #475569 !important;
            border-radius: 6px !important;
            padding: 10px 24px !important;
        }
    </style>
    }
