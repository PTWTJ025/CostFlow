@model List<CostFlow.Controllers.FlatOrderItemViewModel>
@{
    ViewData["Title"] = "ติดตามสถานะสินค้า";
    ViewData["HeaderTitle"] = "ติดตามสถานะการรับสินค้า";
    int totalItems = Model?.Count ?? 0;
}

<div class="flex-1 py-md md:py-lg flex flex-col gap-md w-full h-full min-h-0 overflow-hidden bg-background" style="padding-left: clamp(1.5rem, 6vw, 6rem); padding-right: clamp(1.5rem, 6vw, 6rem);">

    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-on-surface-variant shrink-0">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
            </svg>
            <span>หน้าแรก</span>
        </a>
        <svg class="w-3 h-3 text-outline opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="font-semibold text-on-surface">ติดตามสินค้า</span>
    </div>

    <!-- Page Title -->
    <div class="shrink-0">
        <h1 class="text-xl font-bold text-on-surface mb-1 tracking-tight">ติดตามสถานะการรับสินค้า</h1>
        <p class="text-sm text-on-surface-variant">
            ตรวจสอบสถานะการรับสินค้าของแต่ละรายการ เรียงตามใหม่สุด
        </p>
    </div>

    <!-- Content Card -->
    <div class="flex-1 bg-white rounded-xl border border-outline-variant shadow-sm flex flex-col min-h-0 overflow-hidden">

        <!-- Toolbar -->
        <div class="shrink-0 p-3.5 border-b border-outline-variant bg-white flex items-center justify-between gap-3 flex-wrap">

            <!-- Filters: left side -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Month Filter (client-side) -->
                <select id="month-filter"
                        class="pl-3 pr-4 border border-slate-200 rounded-md text-xs font-medium text-slate-700 outline-none cursor-pointer bg-white hover:border-slate-300 focus:border-primary transition-all h-[32px] w-auto shadow-2xs">
                    <option value="">ทุกเดือน</option>
                    @{
                        string[] thaiMonths = { "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };
                        for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@thaiMonths[i - 1]</option>
                        }
                    }
                </select>

                <!-- Year Filter (client-side) -->
                <select id="year-filter"
                        class="pl-3 pr-3 border border-slate-200 rounded-md text-xs font-medium text-slate-700 outline-none cursor-pointer bg-white hover:border-slate-300 focus:border-primary transition-all h-[32px] w-auto shadow-2xs">
                    <option value="">ทุกปี</option>
                    @{
                        var years = ViewData["AvailableYears"] as List<int> ?? new List<int>();
                        foreach (var y in years)
                        {
                            <option value="@y">@(y + 543)</option>
                        }
                    }
                </select>

                <!-- Status Filter (client-side) -->
                <select id="status-filter"
                        class="pl-3 pr-3 border border-slate-200 rounded-md text-xs font-medium text-slate-700 outline-none cursor-pointer bg-white hover:border-slate-300 focus:border-primary transition-all h-[32px] w-auto shadow-2xs">
                    <option value="">ทุกสถานะ</option>
                    <option value="received">รับแล้ว</option>
                    <option value="pending">ยังไม่รับ</option>
                </select>
            </div>

            <!-- Search: right side -->
            <div class="w-64 sm:w-72">
                <input type="text" id="search-input" placeholder="ค้นหาชื่อสินค้า, รหัสสินค้า..."
                       class="w-full px-3 py-1.5 h-[32px] text-xs bg-white border border-slate-200 rounded-md text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary shadow-2xs transition-all"/>
            </div>
        </div>

        <!-- Row count & Bulk Actions Bar -->
        <div class="shrink-0 px-4 py-2 border-b border-outline-variant bg-slate-50/70 flex items-center justify-between gap-3 flex-wrap">
            <!-- Left: Counts & Selection badge -->
            <div class="flex items-center gap-3">
                <span class="text-[12px] text-on-surface-variant">แสดง <span id="visible-count" class="font-semibold text-on-surface">@totalItems</span> รายการ</span>
                <span id="selected-divider" class="text-slate-300 hidden">|</span>
                <span id="selected-badge" class="inline-flex items-center gap-1 text-[12px] font-semibold text-primary bg-primary/10 px-2 py-0.5 rounded-full border border-primary/20 hidden">
                    <svg class="w-3 h-3 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                    </svg>
                    เลือกแล้ว <span id="selected-count" class="font-bold">0</span> รายการ
                </span>
            </div>

            <!-- Right: Action Buttons -->
            <div class="flex items-center gap-2">
                <!-- Select All (Pending) -->
                <button type="button" id="btn-select-all" onclick="selectAllPending()"
                        class="px-2.5 py-1 rounded-md text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 hover:border-slate-300 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>เลือกทั้งหมด</span>
                </button>

                <!-- Clear Selection -->
                <button type="button" id="btn-clear-selection" onclick="clearSelection()" style="display: none;"
                        class="px-2.5 py-1 rounded text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 active:scale-95 transition-all flex items-center gap-1 cursor-pointer shadow-2xs">
                    <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-rose-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    <span>ล้างการเลือก</span>
                </button>

                <!-- Bulk Receive Button -->
                <button type="button" id="btn-bulk-receive" onclick="openBulkReceiveModal()" disabled
                        class="px-3 py-1 rounded text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white disabled:bg-slate-200 disabled:text-slate-400 disabled:border-slate-200 disabled:cursor-not-allowed border border-emerald-600 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm disabled:shadow-none">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                    </svg>
                    <span>รับสินค้าที่เลือก</span>
                    <span id="btn-bulk-count" class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/25 text-white font-bold hidden">0</span>
                </button>
            </div>
        </div>

        <!-- Table -->
        <div class="flex-1 overflow-auto relative min-h-0">
            <table class="w-full text-[13px]">
                <thead>
                <tr class="text-[11px] font-semibold text-on-surface-variant">
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-3 text-center w-10">
                        <input type="checkbox" id="check-all-header" title="เลือกทั้งหมด (เฉพาะรายการที่ยังไม่รับและแสดงอยู่)"
                               class="rounded border-slate-300 text-primary focus:ring-primary w-4 h-4 cursor-pointer align-middle transition-all">
                    </th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-left whitespace-nowrap">รหัสสินค้า</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-left whitespace-nowrap">ชื่อสินค้า</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-right whitespace-nowrap">จำนวน</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-left whitespace-nowrap">หน่วย</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-center whitespace-nowrap">สถานะ</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-left whitespace-nowrap">เวลาที่บันทึก</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-right whitespace-nowrap">จำนวนรายการ</th>
                    <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-2.5 px-4 text-right whitespace-nowrap">ราคารวม</th>
                </tr>
                </thead>
                <tbody id="item-tbody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string statusVal = item.IsReceived ? "received" : "pending";
                        <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors item-row"
                            data-search="@((item.ProductCode + " " + item.ProductName).ToLower())"
                            data-status="@statusVal"
                            data-date="@item.BatchCreatedAt.ToString("yyyy-MM")"
                            data-id="@item.ItemId"
                            data-batch="@item.BatchName"
                            data-code="@item.ProductCode"
                            data-name="@item.ProductName"
                            data-qty="@item.Quantity"
                            data-unit="@item.Unit">
                            
                            <!-- Checkbox cell -->
                            <td class="py-2.5 px-3 text-center">
                                @if (!item.IsReceived)
                                {
                                    <input type="checkbox" class="row-checkbox rounded border-slate-300 text-primary focus:ring-primary w-4 h-4 cursor-pointer align-middle transition-all"
                                           data-id="@item.ItemId"
                                           data-batch="@item.BatchName"
                                           data-code="@item.ProductCode"
                                           data-name="@item.ProductName"
                                           data-qty="@item.Quantity"
                                           data-unit="@item.Unit" />
                                }
                                else
                                {
                                    <span class="inline-block w-4 h-4 text-slate-300 select-none">-</span>
                                }
                            </td>

                            <td class="py-2.5 px-4 font-mono text-[12px] text-on-surface-variant font-medium">@item.ProductCode</td>
                            <td class="py-2.5 px-4 text-on-surface max-w-[240px] truncate" title="@item.ProductName">@item.ProductName</td>
                            <td class="py-2.5 px-4 text-right font-semibold text-on-surface">@item.Quantity</td>
                            <td class="py-2.5 px-4 text-on-surface-variant text-[12px]">@item.Unit</td>
                            <td class="py-2.5 px-4 text-center status-col">
                                @if (item.IsReceived)
                                {
                                    <span class="inline-flex flex-col items-center gap-0.5">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                            </svg>
                                            รับแล้ว
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.ReceiveDate))
                                        {
                                            <span class="text-[10px] text-emerald-600 font-mono">@item.ReceiveDate</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn-receive inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 hover:border-amber-400 transition-all cursor-pointer">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        ยังไม่รับ
                                    </button>
                                }
                            </td>
                            <td class="py-2.5 px-4 text-on-surface-variant font-mono text-[12px] whitespace-nowrap">
                                @(item.BatchCreatedAt == default ? "-" : item.BatchCreatedAt.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                            <td class="py-2.5 px-4 text-right text-on-surface-variant">@item.BatchTotalItems</td>
                            <td class="py-2.5 px-4 text-right font-mono font-bold text-primary text-[13px] whitespace-nowrap">
                                ฿@item.BatchTotalAmount.ToString("N2")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="pt-28 pb-16 text-center">
                            <div class="flex flex-col items-center gap-3">
                                <svg class="w-10 h-10 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"/>
                                </svg>
                                <p class="font-semibold text-on-surface text-sm">ไม่พบรายการสินค้า</p>
                            </div>
                        </td>
                    </tr>
                }
                <tr id="no-search-results" class="hidden">
                    <td colspan="9" class="py-10 text-center text-xs text-on-surface-variant">
                        <div class="flex flex-col items-center gap-2">
                            <svg class="w-8 h-8 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                            </svg>
                            <span class="font-semibold text-on-surface text-sm">ไม่พบข้อมูลที่ค้นหา</span>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('search-input');
            const statusFilter = document.getElementById('status-filter');
            const monthFilter = document.getElementById('month-filter');
            const yearFilter = document.getElementById('year-filter');
            const rows = Array.from(document.querySelectorAll('.item-row'));
            const noResults = document.getElementById('no-search-results');
            const visibleCountEl = document.getElementById('visible-count');

            // Bulk action elements
            const checkAllHeader = document.getElementById('check-all-header');
            const selectedBadge = document.getElementById('selected-badge');
            const selectedDivider = document.getElementById('selected-divider');
            const selectedCountEl = document.getElementById('selected-count');
            const btnClearSelection = document.getElementById('btn-clear-selection');
            const btnBulkReceive = document.getElementById('btn-bulk-receive');
            const btnBulkCount = document.getElementById('btn-bulk-count');

            // ---- Filter / Search ----
            function applyFilters() {
                const query = (searchInput?.value || '').trim().toLowerCase();
                const status = statusFilter?.value || '';
                const month = monthFilter?.value || '';
                const year = yearFilter?.value || '';
                let visibleCount = 0;

                rows.forEach(row => {
                    const matchesSearch = !query || (row.dataset.search || '').includes(query);
                    const matchesStatus = !status || row.dataset.status === status;
                    const rowDate = row.dataset.date || '';
                    const [rowYear, rowMonth] = rowDate.split('-');
                    const matchesMonth = !month || parseInt(rowMonth) === parseInt(month);
                    const matchesYear  = !year  || parseInt(rowYear)  === parseInt(year);
                    const visible = matchesSearch && matchesStatus && matchesMonth && matchesYear;
                    
                    row.style.display = visible ? '' : 'none';
                    if (visible) visibleCount++;
                });

                if (visibleCountEl) visibleCountEl.textContent = visibleCount;
                if (noResults) noResults.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);

                updateSelectionUI();
            }

            if (searchInput) searchInput.addEventListener('input', applyFilters);
            if (statusFilter) statusFilter.addEventListener('change', applyFilters);
            if (monthFilter) monthFilter.addEventListener('change', applyFilters);
            if (yearFilter) yearFilter.addEventListener('change', applyFilters);

            // ---- Selection Management ----
            function getVisibleCheckboxes() {
                return rows
                    .filter(r => r.style.display !== 'none')
                    .map(r => r.querySelector('.row-checkbox'))
                    .filter(cb => cb !== null);
            }

            function updateSelectionUI() {
                const visibleCbs = getVisibleCheckboxes();
                const checkedCbs = visibleCbs.filter(cb => cb.checked);
                const count = checkedCbs.length;

                if (selectedCountEl) selectedCountEl.textContent = count;
                if (btnBulkCount) btnBulkCount.textContent = count;

                if (count > 0) {
                    selectedBadge?.classList.remove('hidden');
                    selectedDivider?.classList.remove('hidden');
                    if (btnClearSelection) btnClearSelection.style.display = 'flex';
                    if (btnBulkReceive) btnBulkReceive.disabled = false;
                    btnBulkCount?.classList.remove('hidden');
                } else {
                    selectedBadge?.classList.add('hidden');
                    selectedDivider?.classList.add('hidden');
                    if (btnClearSelection) btnClearSelection.style.display = 'none';
                    if (btnBulkReceive) btnBulkReceive.disabled = true;
                    btnBulkCount?.classList.add('hidden');
                }

                // Update row highlight
                rows.forEach(r => {
                    const cb = r.querySelector('.row-checkbox');
                    if (cb && cb.checked) {
                        r.classList.add('bg-primary/5');
                    } else {
                        r.classList.remove('bg-primary/5');
                    }
                });

                // Update master checkbox
                if (checkAllHeader) {
                    if (visibleCbs.length > 0 && checkedCbs.length === visibleCbs.length) {
                        checkAllHeader.checked = true;
                        checkAllHeader.indeterminate = false;
                    } else if (checkedCbs.length > 0) {
                        checkAllHeader.checked = false;
                        checkAllHeader.indeterminate = true;
                    } else {
                        checkAllHeader.checked = false;
                        checkAllHeader.indeterminate = false;
                    }
                }
            }

            // Header master checkbox change
            if (checkAllHeader) {
                checkAllHeader.addEventListener('change', () => {
                    const visibleCbs = getVisibleCheckboxes();
                    visibleCbs.forEach(cb => {
                        cb.checked = checkAllHeader.checked;
                    });
                    updateSelectionUI();
                });
            }

            // Row checkbox change (delegated)
            document.getElementById('item-tbody')?.addEventListener('change', (e) => {
                if (e.target.classList.contains('row-checkbox')) {
                    updateSelectionUI();
                }
            });

            // Global functions for buttons
            window.selectAllPending = function() {
                const visibleCbs = getVisibleCheckboxes();
                if (visibleCbs.length === 0) return;
                const allChecked = visibleCbs.every(cb => cb.checked);
                visibleCbs.forEach(cb => {
                    cb.checked = !allChecked;
                });
                updateSelectionUI();
            };

            window.clearSelection = function() {
                const allCbs = document.querySelectorAll('.row-checkbox');
                allCbs.forEach(cb => cb.checked = false);
                if (checkAllHeader) {
                    checkAllHeader.checked = false;
                    checkAllHeader.indeterminate = false;
                }
                updateSelectionUI();
            };

            function todayISO() {
                const d = new Date();
                return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
            }

            // ---- Bulk Receive Flow ----
            window.openBulkReceiveModal = async function() {
                const visibleCbs = getVisibleCheckboxes();
                const checkedCbs = visibleCbs.filter(cb => cb.checked);
                if (checkedCbs.length === 0) return;

                const items = checkedCbs.map(cb => ({
                    itemId: parseInt(cb.dataset.id || '0'),
                    batchName: cb.dataset.batch || '',
                    productCode: cb.dataset.code || '',
                    productName: cb.dataset.name || '',
                    qty: cb.dataset.qty || '',
                    unit: cb.dataset.unit || ''
                }));

                const previewListHtml = items.slice(0, 5).map(it => `
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid #f1f5f9;font-size:12px;">
                        <span style="color:#1e293b;font-weight:500;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${it.productName}</span>
                        <span style="color:#64748b;font-family:monospace;white-space:nowrap;">${it.qty} ${it.unit}</span>
                    </div>
                `).join('');

                const moreText = items.length > 5 ? `<p style="font-size:11px;color:#94a3b8;margin-top:4px;text-align:center;">... และอีก ${items.length - 5} รายการ</p>` : '';

                const { value: dateVal, isConfirmed } = await Swal.fire({
                    title: `รับสินค้า (${items.length} รายการ)`,
                    html: `
                        <div style="text-align:left;margin-bottom:14px;background:#f8fafc;padding:10px 14px;border-radius:8px;border:1px solid #e2e8f0;max-height:160px;overflow-y:auto;">
                            <p style="font-size:11px;font-weight:700;color:#64748b;margin-bottom:6px;text-transform:uppercase;">รายการที่เลือก (${items.length} รายการ)</p>
                            ${previewListHtml}
                            ${moreText}
                        </div>
                        <div style="text-align:left;">
                            <label style="font-size:12px;font-weight:600;color:#475569;display:block;margin-bottom:6px;">วันที่รับสินค้า</label>
                            <input id="swal-bulk-date" type="date" value="${todayISO()}"
                                style="width:100%;border:1px solid #cbd5e1;border-radius:6px;padding:8px 12px;font-size:13px;outline:none;">
                        </div>`,
                    showCancelButton: true,
                    confirmButtonText: `✓ ยืนยันรับสินค้า (${items.length})`,
                    cancelButtonText: 'ยกเลิก',
                    customClass: {
                        popup: 'swal-popup-custom',
                        confirmButton: 'swal-btn-primary',
                        cancelButton: 'swal-btn-cancel'
                    },
                    buttonsStyling: false,
                    preConfirm: () => {
                        const d = document.getElementById('swal-bulk-date').value;
                        if (!d) { Swal.showValidationMessage('กรุณาเลือกวันที่'); return false; }
                        const [y, m, dd] = d.split('-');
                        return `${dd}/${m}/${y}`;
                    }
                });

                if (!isConfirmed || !dateVal) return;

                Swal.fire({
                    title: 'กำลังบันทึกการรับสินค้า...',
                    text: 'กรุณารอสักครู่',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                try {
                    const res = await fetch('/OrderTracking/MarkBulkReceived', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            items: items.map(i => ({ itemId: i.itemId, batchName: i.batchName, productCode: i.productCode })),
                            receiveDate: dateVal
                        })
                    });
                    const data = await res.json();

                    if (data.success) {
                        // Update UI of corresponding rows
                        checkedCbs.forEach(cb => {
                            const row = cb.closest('tr');
                            if (!row) return;

                            row.dataset.status = 'received';
                            
                            // Replace checkbox with '-'
                            const checkTd = cb.closest('td');
                            if (checkTd) checkTd.innerHTML = '<span class="inline-block w-4 h-4 text-slate-300 select-none">-</span>';

                            // Update status badge
                            const statusTd = row.querySelector('.status-col');
                            if (statusTd) {
                                statusTd.innerHTML = `
                                    <span class="inline-flex flex-col items-center gap-0.5">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                            </svg>
                                            รับแล้ว
                                        </span>
                                        <span class="text-[10px] text-emerald-600 font-mono">${dateVal}</span>
                                    </span>`;
                            }
                        });

                        updateSelectionUI();
                        applyFilters();

                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ!',
                            text: `บันทึกการรับสินค้าเรียบร้อยแล้ว (${items.length} รายการ)`,
                            timer: 2000,
                            showConfirmButton: false,
                            customClass: { popup: 'swal-popup-custom' }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: data.error || 'ไม่สามารถบันทึกได้',
                            customClass: { popup: 'swal-popup-custom' }
                        });
                    }
                } catch (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้',
                        customClass: { popup: 'swal-popup-custom' }
                    });
                }
            };

            // ---- Inline Single Receive ----
            document.getElementById('item-tbody')?.addEventListener('click', async (e) => {
                const btn = e.target.closest('.btn-receive');
                if (!btn) return;

                const row = btn.closest('tr');
                const batchName = row.dataset.batch;
                const productCode = row.dataset.code;
                const productName = row.dataset.name;
                const qty = row.dataset.qty;
                const unit = row.dataset.unit;
                const itemId = parseInt(row.dataset.id || '0');

                const { value: dateVal, isConfirmed } = await Swal.fire({
                    title: 'รับสินค้า',
                    html: `
                        <div style="text-align:left;margin-bottom:12px;">
                            <p style="font-size:13px;color:#475569;margin-bottom:2px;">สินค้า</p>
                            <p style="font-size:14px;font-weight:600;color:#1e293b;">${productName}</p>
                            <p style="font-size:12px;color:#64748b;margin-top:2px;">จำนวน: ${qty} ${unit} &nbsp;|&nbsp; รหัส: ${productCode}</p>
                        </div>
                        <div style="text-align:left;">
                            <label style="font-size:12px;font-weight:600;color:#475569;display:block;margin-bottom:6px;">วันที่รับสินค้า</label>
                            <input id="swal-date" type="date" value="${todayISO()}"
                                style="width:100%;border:1px solid #cbd5e1;border-radius:6px;padding:8px 12px;font-size:13px;outline:none;">
                        </div>`,
                    showCancelButton: true,
                    confirmButtonText: '✓ ยืนยันรับสินค้า',
                    cancelButtonText: 'ยกเลิก',
                    customClass: {
                        popup: 'swal-popup-custom',
                        confirmButton: 'swal-btn-primary',
                        cancelButton: 'swal-btn-cancel'
                    },
                    buttonsStyling: false,
                    preConfirm: () => {
                        const d = document.getElementById('swal-date').value;
                        if (!d) { Swal.showValidationMessage('กรุณาเลือกวันที่'); return false; }
                        const [y, m, dd] = d.split('-');
                        return `${dd}/${m}/${y}`;
                    }
                });

                if (!isConfirmed || !dateVal) return;

                btn.disabled = true;
                btn.style.opacity = '0.5';

                try {
                    const res = await fetch('/OrderTracking/MarkBulkReceived', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            items: [{ itemId: itemId, batchName: batchName, productCode: productCode }],
                            receiveDate: dateVal
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        row.dataset.status = 'received';
                        
                        // Replace checkbox with '-'
                        const cb = row.querySelector('.row-checkbox');
                        if (cb) {
                            const checkTd = cb.closest('td');
                            if (checkTd) checkTd.innerHTML = '<span class="inline-block w-4 h-4 text-slate-300 select-none">-</span>';
                        }

                        const statusTd = btn.closest('td');
                        if (statusTd) {
                            statusTd.innerHTML = `
                                <span class="inline-flex flex-col items-center gap-0.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                        </svg>
                                        รับแล้ว
                                    </span>
                                    <span class="text-[10px] text-emerald-600 font-mono">${dateVal}</span>
                                </span>`;
                        }

                        updateSelectionUI();
                        applyFilters();
                    } else {
                        Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: data.error || 'ไม่สามารถบันทึกได้', customClass: { popup: 'swal-popup-custom' } });
                        btn.disabled = false;
                        btn.style.opacity = '1';
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', customClass: { popup: 'swal-popup-custom' } });
                    btn.disabled = false;
                    btn.style.opacity = '1';
                }
            });
        });
    </script>
    <style>
        .swal-popup-custom {
            border-radius: 12px !important;
            font-family: 'Poppins', 'IBM Plex Sans Thai', sans-serif !important;
        }
        .swal-btn-primary {
            background: #00288e !important;
            color: #fff !important;
            border-radius: 6px !important;
            padding: 10px 24px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
        }
        .swal-btn-cancel {
            background: #f1f5f9 !important;
            color: #475569 !important;
            border-radius: 6px !important;
            padding: 10px 24px !important;
            font-size: 13px !important;
        }
        .btn-receive:hover {
            transform: scale(1.04);
        }
    </style>
}
