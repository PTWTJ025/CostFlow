@model IEnumerable<CostFlow.Controllers.TrackingItemViewModel>
@{
    ViewData["Title"] = "รายละเอียดแผ่นงาน - ติดตามสินค้า";
    var batchName = ViewData["BatchName"] as string ?? "ไม่ระบุแผ่นงาน";
}

<div class="flex-1 py-md md:py-lg flex flex-col gap-md w-full h-full min-h-0 overflow-hidden bg-background" style="padding-left: clamp(1.5rem, 6vw, 6rem); padding-right: clamp(1.5rem, 6vw, 6rem);">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-on-surface-variant shrink-0">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5">
            <!-- Heroicon: home -->
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
            </svg>
            <span>หน้าแรก</span>
        </a>
        <svg class="w-3 h-3 text-outline opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
        <a asp-action="Index" class="hover:text-primary transition-colors">ติดตามสินค้า</a>
        <svg class="w-3 h-3 text-outline opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="font-semibold text-on-surface">รายละเอียด</span>
    </div>

    <!-- Page Title -->
    <div class="shrink-0">
        <h1 class="text-xl font-black text-on-surface">รายละเอียด: @batchName</h1>
        <p class="text-[13px] text-on-surface-variant mt-1">เลือกรายการสินค้าที่ได้รับแล้ว และกดบันทึกสถานะ</p>
    </div>

    <!-- Table Section -->
    <div class="bg-white border border-outline-variant rounded-xl shadow-sm flex-1 overflow-hidden flex flex-col min-h-0 relative">
        <div class="overflow-auto flex-1">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 sticky top-0 z-10">
                <tr>
                    <th class="py-3 px-4 border-b border-slate-200 w-12 text-center">
                        <input type="checkbox" id="selectAll" class="w-4 h-4 text-primary bg-gray-100 border-gray-300 rounded focus:ring-primary focus:ring-2 cursor-pointer rounded-sm"/>
                    </th>
                    <th class="py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">รหัสสินค้า</th>
                    <th class="py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">ชื่อสินค้า</th>
                    <th class="py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200 text-right">จำนวน</th>
                    <th class="py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200 text-center">หน่วย</th>
                    <th class="py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200 text-center">สถานะ</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isReceived = item.IsReceived;
                        <tr class="hover:bg-slate-50/50 transition-colors @(isReceived ? "bg-slate-50 opacity-70" : "item-row")">
                            <td class="py-3 px-4 text-center">
                                @if (!isReceived)
                                {
                                    <input type="checkbox" class="item-checkbox w-4 h-4 text-primary bg-gray-100 border-gray-300 rounded focus:ring-primary focus:ring-2 cursor-pointer rounded-sm" data-code="@item.ProductCode"/>
                                }
                                else
                                {
                                    <svg class="w-5 h-5 text-green-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                    </svg>
                                }
                            </td>
                            <td class="py-3 px-4 font-mono text-slate-600 text-xs">@item.ProductCode</td>
                            <td class="py-3 px-4 font-medium text-slate-800">@item.ProductName</td>
                            <td class="py-3 px-4 text-right font-medium">@item.Quantity</td>
                            <td class="py-3 px-4 text-center text-slate-500 text-xs">@item.Unit</td>
                            <td class="py-3 px-4 text-center">
                                @if (isReceived)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-green-50 text-green-700 border border-green-200">
                                        รับแล้ว @item.ReceiveDate
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                        รอรับสินค้า
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="py-14 text-center">
                            <div class="flex flex-col items-center gap-3">
                                <svg class="w-10 h-10 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"/>
                                </svg>
                                <div>
                                    <p class="font-semibold text-on-surface text-sm">ไม่พบรายการสินค้า</p>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Sticky Footer Action Bar -->
        <div class="bg-white border-t border-slate-200 p-4 flex items-center justify-between shrink-0">
            <div class="text-sm font-medium text-slate-600">
                เลือก <span id="selectedCount" class="text-primary font-bold">0</span> รายการ
            </div>
            <button id="btn-save-tracking" type="button" disabled
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-[14px] font-bold text-white bg-primary hover:bg-primary/90 transition-all shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"/>
                </svg>
                บันทึกและระบุวันที่
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/air-datepicker@3/air-datepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/air-datepicker@3"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const selectAllCheckbox = document.getElementById('selectAll');
            const itemCheckboxes = document.querySelectorAll('.item-checkbox');
            const selectedCountSpan = document.getElementById('selectedCount');
            const btnSave = document.getElementById('btn-save-tracking');
            const batchName = '@Html.Raw(batchName)';

            function updateSelectionState() {
                const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
                const count = checkedBoxes.length;
                selectedCountSpan.textContent = count;

                btnSave.disabled = count === 0;

                if (itemCheckboxes.length > 0) {
                    selectAllCheckbox.checked = (count === itemCheckboxes.length);
                    selectAllCheckbox.indeterminate = count > 0 && count < itemCheckboxes.length;
                }
            }

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', (e) => {
                    const isChecked = e.target.checked;
                    itemCheckboxes.forEach(cb => cb.checked = isChecked);
                    updateSelectionState();
                });
            }

            itemCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateSelectionState);
            });

            // Handle Save Action
            if (btnSave) {
                btnSave.addEventListener('click', async () => {
                    const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
                    if (checkedBoxes.length === 0) return;

                    const productCodes = Array.from(checkedBoxes).map(cb => cb.dataset.code);
                    const today = new Date().toISOString().split('T')[0];

                    const { value: dateStr, isConfirmed } = await Swal.fire({
                        title: 'ระบุวันที่รับสินค้า',
                        html: `
                                <p class="text-[13px] text-slate-600 mb-2">แผ่นงาน: <strong>${batchName}</strong></p>
                                <p class="text-[13px] text-primary font-semibold mb-3">รายการที่เลือก: ${productCodes.length} รายการ</p>
                                <input type="hidden" id="receive-date" value="${today}">
                                <div id="adp-inline-container"></div>
                                <p class="text-[12px] text-slate-500 mt-2">วันที่เลือก: <strong id="adp-selected-text">${today}</strong></p>
                            `,
                        showCancelButton: true,
                        confirmButtonText: 'บันทึก',
                        cancelButtonText: 'ยกเลิก',
                        focusConfirm: false,
                        width: 380,
                        didOpen: () => {
                            const thLocale = {
                                days: ['อาทิตย์', 'จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์', 'เสาร์'],
                                daysShort: ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'],
                                daysMin: ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'],
                                months: ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'],
                                monthsShort: ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'],
                                today: 'วันนี้',
                                clear: 'ล้าง',
                                dateFormat: 'yyyy-MM-dd',
                                firstDay: 0
                            };
                            new AirDatepicker('#adp-inline-container', {
                                locale: thLocale,
                                inline: true,
                                selectedDates: [today],
                                dateFormat: 'yyyy-MM-dd',
                                onSelect: ({ formattedDate }) => {
                                    document.getElementById('receive-date').value = formattedDate;
                                    document.getElementById('adp-selected-text').textContent = formattedDate;
                                }
                            });
                        },
                        preConfirm: () => {
                            const dateInput = document.getElementById('receive-date').value;
                            if (!dateInput) {
                                Swal.showValidationMessage('กรุณาระบุวันที่');
                            }
                            return dateInput;
                        },
                        customClass: {
                            popup: 'swal-popup-custom',
                            confirmButton: 'swal-btn-primary',
                            cancelButton: 'swal-btn-cancel'
                        }
                    });

                    if (isConfirmed && dateStr) {
                        Swal.fire({
                            title: 'กำลังบันทึกข้อมูล...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        try {
                            const response = await fetch('/OrderTracking/MarkItemsReceived', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    BatchName: batchName,
                                    ProductCodes: productCodes,
                                    ReceiveDate: dateStr
                                })
                            });
                            const result = await response.json();

                            if (result.success) {
                                await Swal.fire({
                                    icon: 'success',
                                    title: 'บันทึกสำเร็จ',
                                    text: 'บันทึกสถานะการรับสินค้าเรียบร้อยแล้ว',
                                    confirmButtonText: 'ตกลง'
                                });
                                window.location.href = '/OrderTracking';
                            } else {
                                throw new Error(result.error || 'เกิดข้อผิดพลาดในการบันทึก');
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'ผิดพลาด',
                                text: error.message
                            });
                        }
                    }
                });
            }
        });
    </script>
    <style>
        .swal-popup-custom {
            border-radius: 16px !important;
            padding: 24px !important;
        }
    
        .swal-btn-primary {
            background-color: #3B82F6 !important;
            border-radius: 8px !important;
            padding: 10px 24px !important;
            font-weight: 600 !important;
        }
    
        .swal-btn-cancel {
            background-color: #F1F5F9 !important;
            color: #475569 !important;
            border-radius: 8px !important;
            padding: 10px 24px !important;
            font-weight: 600 !important;
        }
    
        .swal2-input {
            border-radius: 8px !important;
            border: 1px solid #E2E8F0 !important;
        }
    
        .swal2-input:focus {
            border-color: #3B82F6 !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
        }

        /* ==========================================
           Air Datepicker 3 — Custom Theme (#00288e)
        ========================================== */
        #adp-inline-container .air-datepicker {
            --adp-font-family: 'Chakra Petch', sans-serif;
            --adp-font-size: 13px;
            --adp-width: 320px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0, 40, 142, 0.10);
        }
        #adp-inline-container .air-datepicker-nav {
            background: #00288e;
            border-bottom: none;
            padding: 10px 8px;
        }
        #adp-inline-container .air-datepicker-nav--title,
        #adp-inline-container .air-datepicker-nav--title i {
            color: #fff;
            font-weight: 700;
            font-size: 14px;
        }
        #adp-inline-container .air-datepicker-nav--title:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
            border-radius: 6px;
        }
        #adp-inline-container .air-datepicker-nav--action svg path {
            stroke: #fff;
        }
        #adp-inline-container .air-datepicker-nav--action:hover {
            background: rgba(255,255,255,0.15);
            border-radius: 6px;
        }
        #adp-inline-container .air-datepicker-body--day-names {
            background: #001f6e;
            margin: 0;
            padding: 6px 4px;
        }
        #adp-inline-container .air-datepicker-body--day-name {
            color: #bfdbfe;
            font-weight: 600;
            font-size: 11px;
        }
        #adp-inline-container .air-datepicker-body--cells.-days- {
            padding: 8px 4px;
        }
        #adp-inline-container .air-datepicker-cell.-day- {
            border-radius: 8px;
            font-size: 13px;
            height: 36px;
            line-height: 36px;
            transition: background 0.15s, color 0.15s;
            color: #1e293b;
        }
        #adp-inline-container .air-datepicker-cell.-day-:not(.-selected-):not(.-disabled-):hover {
            background: #dbeafe;
            color: #00288e;
        }
        #adp-inline-container .air-datepicker-cell.-current- {
            color: #00288e !important;
            font-weight: 700;
            border: 1.5px solid #00288e;
        }
        #adp-inline-container .air-datepicker-cell.-selected- {
            background: #00288e !important;
            color: #fff !important;
            font-weight: 700;
            border-color: #00288e !important;
        }
        #adp-inline-container .air-datepicker-cell.-selected-:hover {
            background: #001f6e !important;
        }
        #adp-inline-container .air-datepicker-cell.-other-month- {
            color: #cbd5e1;
        }</style>
}
