@{
    ViewData["Title"] = "About";
    ViewData["HeaderTitle"] = "About ( WOSync / CostFlow )";
}

<div class="flex-grow p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full animate-fade-in">
    <!-- Welcome Header / Hero Banner -->
    <div class="bg-gradient-to-r from-primary to-primary-container text-white rounded border border-outline-variant shadow-sm p-lg relative overflow-hidden flex justify-between items-center fade-in-up">
        <div class="z-10 max-w-xl">
            <h2 class="font-headline-md text-headline-md font-bold mb-xs">About WOSync CostFlow</h2>
            <p class="text-xs text-white/80 leading-relaxed font-sans">
                Manufacturing Cost Analysis & Spare Parts Procurement System. Designed for tracking production sheets, comparing approval orders, and referencing purchase prices.
            </p>
        </div>
        <div class="hidden lg:block z-0 opacity-10 absolute right-10 top-0 bottom-0 flex items-center">
            <svg class="w-48 h-48 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.083.852l-.041.02m-1.083-.852A.75.75 0 0012 11.25v.041a.75.75 0 11-1.083-.852l.041-.02M12 21a9 9 0 100-18 9 9 0 000 18z" />
            </svg>
        </div>
    </div>

    <!-- Bento Grid Content -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg fade-in-up delay-75">
        <!-- System Description Card -->
        <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg flex flex-col gap-sm">
            <h3 class="font-headline-sm text-headline-sm text-on-surface">System Overview</h3>
            <p class="text-xs text-secondary leading-relaxed">
                ระบบบริหารจัดการและวิเคราะห์ต้นทุนการผลิตชิ้นส่วนและจัดซื้ออะไหล่โรงงาน (CostFlow) ออกแบบมาเพื่อเป็นเครื่องมือสนับสนุนการทำงานของแผนกจัดซื้อและฝ่ายผลิต ช่วยในการควบรวม เปรียบเทียบ และตรวจสอบข้อมูลราคากลางอ้างอิงของโรงงานอย่างเป็นระบบ
            </p>
            <div class="mt-md border-t border-slate-100 pt-md flex flex-col gap-2">
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-primary/70 shrink-0"></span>
                    <span class="text-slate-700 font-semibold">Version:</span>
                    <span class="text-slate-500 font-mono">1.2.0 (Stable Release)</span>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/70 shrink-0"></span>
                    <span class="text-slate-700 font-semibold">Database Engine:</span>
                    <span class="text-slate-500 font-mono">SQLite (Encrypted local storage)</span>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-500/70 shrink-0"></span>
                    <span class="text-slate-700 font-semibold">Framework:</span>
                    <span class="text-slate-500 font-mono">ASP.NET Core MVC (net9.0)</span>
                </div>
            </div>
        </div>

        <!-- Key Modules -->
        <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg flex flex-col gap-sm">
            <h3 class="font-headline-sm text-headline-sm text-on-surface">Core Modules</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-sm mt-xs">
                <div class="p-sm border border-slate-100 rounded bg-slate-50/50 flex flex-col gap-1">
                    <span class="font-bold text-slate-800 text-xs">Cost Comparison</span>
                    <p class="text-[10px] text-slate-500 leading-relaxed">ระบบวิเคราะห์ข้อมูลแผนผลิตประจำสัปดาห์เทียบกับใบขออนุมัติจัดซื้อชิ้นส่วน</p>
                </div>
                <div class="p-sm border border-slate-100 rounded bg-slate-50/50 flex flex-col gap-1">
                    <span class="font-bold text-slate-800 text-xs">Order Draft</span>
                    <p class="text-[10px] text-slate-500 leading-relaxed">ฟังก์ชันสำหรับจดบันทึกแบบร่างใบสั่งซื้ออะไหล่โรงงานพร้อมระบบตรวจสอบราคา</p>
                </div>
                <div class="p-sm border border-slate-100 rounded bg-slate-50/50 flex flex-col gap-1">
                    <span class="font-bold text-slate-800 text-xs">Price Reference</span>
                    <p class="text-[10px] text-slate-500 leading-relaxed">สืบค้นฐานข้อมูลราคากลางจัดซื้ออะไหล่ย้อนหลังแบบทันใจ (AJAX Search)</p>
                </div>
                <div class="p-sm border border-slate-100 rounded bg-slate-50/50 flex flex-col gap-1">
                    <span class="font-bold text-slate-800 text-xs">ClosedXML Export</span>
                    <p class="text-[10px] text-slate-500 leading-relaxed">ระบบส่งออกรายงานในรูปแผ่นงานตาราง Excel จัดรูปแบบพรีเมียม สไตล์เป็นทางการ</p>
                </div>
            </div>
        </div>
    </div>
</div>
