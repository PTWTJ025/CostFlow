@model CostFlow.Models.ApplicationUser
@{
    ViewData["Title"] = "ตั้งค่า & สำรองข้อมูล";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Breadcrumbs / Top Actions -->
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-xs text-xs text-secondary">
            <a href="/" class="hover:text-primary transition-colors">หน้าหลัก</a>
            <span>/</span>
            <span class="text-slate-700 font-semibold">ตั้งค่า & สำรองข้อมูล</span>
        </div>
        <button onclick="window.history.back();" class="text-xs text-slate-600 hover:text-slate-800 hover:bg-slate-100 px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 border border-slate-200 cursor-pointer">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            <span>ย้อนกลับ</span>
        </button>
    </div>

    <!-- Section 1: Full Database Backup Section -->
    <div class="bg-white rounded-lg border border-slate-200/80 shadow-sm p-md md:p-lg">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-bold text-sm md:text-base text-slate-800 mb-0.5">
                    สำรองฐานข้อมูลฉบับเต็ม (Full Backup & Download)
                </h3>
                <p class="text-xs text-slate-500">ดาวน์โหลดไฟล์ฐานข้อมูลครบทุกตาราง (คำสั่งผลิต, ค่าใช้จ่าย, คลังสินค้า, ประวัติรับ-เบิกของ และบัญชีผู้ใช้) ในไฟล์ .ZIP เดียว</p>
            </div>
            <span class="text-[11px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-md">
                ครอบคลุมฐานข้อมูล 100% (Full Schema)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ตารางที่ครอบคลุมทั้งหมด</span>
                    <span class="text-xs font-bold text-slate-800">TiDB Cloud (costflow_db & test)</span>
                    <div class="text-[11px] text-slate-600 mt-2 space-y-0.5">
                        <div>• ระบบคลังสินค้า: <strong>StockItems, ItemMappings, StockLogs</strong></div>
                        <div>• ข้อมูลระบบ: <strong>Users, Roles, ProductPrices</strong></div>
                        <div>• ระบบผลิตและค่าใช้จ่าย: <strong>Reports, Orders, Plans, Actions</strong></div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">กวาดทุกตารางในฐานข้อมูลครบถ้วน 100%</span>
            </div>

            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">โครงสร้างไฟล์สำรองใน ZIP</span>
                    <span class="text-xs font-mono font-bold text-slate-700 break-all">CostFlow_FullBackup_*.zip</span>
                    <div class="text-[11px] text-slate-600 mt-2 space-y-0.5">
                        <div>1. <span class="font-mono text-slate-700">TiDB_CostFlowCore_*.json</span> (ตารางหลักทั้งหมด)</div>
                        <div>2. <span class="font-mono text-slate-700">TiDB_StockSystem_*.json</span> (ระบบสต็อกโดยเฉพาะ)</div>
                        <div>3. <span class="font-mono text-slate-700">TiDB_SavedOrders_*.json</span> (ชุดสั่งซื้ออะไหล่)</div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">บีบอัดฐานข้อมูลระบบทั้งหมดใน ZIP เดียว</span>
            </div>

            <div class="bg-blue-50/60 p-md rounded-md border border-blue-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-blue-800 font-semibold uppercase block mb-1">คำสั่งสำรองข้อมูลฉบับเต็ม</span>
                    <span class="text-xs text-blue-950 font-bold block">ดาวน์โหลดฐานข้อมูลทุกตารางมาเก็บในเครื่องทันที (.ZIP)</span>
                    <p class="text-[11px] text-blue-800 mt-1">แนะนำให้ดาวน์โหลดเก็บไว้ทุกสัปดาห์หรือก่อนการล้างข้อมูลประจำปี</p>
                </div>
                <form id="backup-form" method="post" action="/Home/BackupDatabase">
                    @Html.AntiForgeryToken()
                    <button type="button" onclick="executeBackup()" id="backup-btn"
                        class="mt-3 font-bold text-xs px-4 py-2.5 rounded-md shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 transition-opacity border-none"
                        style="background-color: #2563eb; color: #ffffff;">
                        <span style="color: #ffffff !important; font-weight: 700;">ดาวน์โหลด Backup ทั้งหมด (.ZIP)</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Section 2: Restore Database Section (Safe-Guard Protected) -->
    <div class="bg-white rounded-lg border border-slate-200/80 shadow-sm p-md md:p-lg">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-bold text-sm md:text-base text-slate-800 mb-0.5">
                    กู้คืนฐานข้อมูล (Restore Database)
                </h3>
                <p class="text-xs text-slate-500">นำเข้าไฟล์สำรองเพื่อตรวจสอบความสมบูรณ์และเตรียมกู้คืนฐานข้อมูล (มีระบบ Safe-Guard ล็อคการเขียนทับเพื่อความปลอดภัย)</p>
            </div>
            <span class="text-[11px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-3 py-1 rounded-md">
                ระบบความปลอดภัย Safe-Guard
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">รูปแบบไฟล์ที่รองรับ</span>
                    <span class="text-xs font-bold text-slate-800">.ZIP หรือ .JSON จาก CostFlow</span>
                    <p class="text-[11px] text-slate-600 mt-2 leading-relaxed">
                        รองรับไฟล์ Backup ที่ดาวน์โหลดจากระบบ ซึ่งมีข้อมูลครบ 100% ทั้งตารางระบบหลัก, สต็อกสินค้า, และผู้ใช้งาน
                    </p>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ตรวจสอบความถูกต้องของ Schema อัตโนมัติ</span>
            </div>

            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">เลือกไฟล์สำรองสำหรับกู้คืน</span>
                    <input type="file" id="restore-file-input" accept=".zip,.json" onchange="handleRestoreFileChosen(event)" class="hidden" />
                    <button type="button" onclick="document.getElementById('restore-file-input').click()" 
                        class="w-full mt-1 border border-dashed border-slate-300 hover:border-indigo-400 hover:bg-indigo-50/20 rounded-md p-3 text-left transition-all cursor-pointer bg-white">
                        <div class="overflow-hidden">
                            <span id="restore-file-name" class="text-xs font-semibold text-slate-700 block truncate">คลิกเลือกไฟล์ .ZIP หรือ .JSON</span>
                            <span id="restore-file-size" class="text-[10px] text-slate-400 block mt-0.5">ยังไม่ได้เลือกไฟล์สำรอง</span>
                        </div>
                    </button>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">รองรับ CostFlow_FullBackup_*.zip</span>
            </div>

            <div class="bg-indigo-50/50 p-md rounded-md border border-indigo-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-indigo-800 font-semibold uppercase block mb-1">คำสั่งกู้คืนข้อมูล</span>
                    <span class="text-xs text-indigo-950 font-bold block">เริ่มตรวจสอบและเตรียมการกู้คืนข้อมูล</span>
                    <p class="text-[11px] text-indigo-800 mt-1">ระบบจะแสดงรายละเอียดและล็อคการเขียนทับอัตโนมัติเพื่อความปลอดภัย</p>
                </div>
                <button type="button" onclick="triggerRestoreAction()" id="restore-btn"
                    class="mt-3 font-bold text-xs px-4 py-2.5 rounded-md shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 transition-opacity border-none"
                    style="background-color: #4338ca; color: #ffffff;">
                    <span style="color: #ffffff !important; font-weight: 700;">ตรวจสอบไฟล์สำรอง (Restore)</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Section 3: Google Sheets Sync (Dual Sheet) -->
    <div class="bg-white rounded-lg border border-slate-200/80 shadow-sm p-md md:p-lg">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-bold text-sm md:text-base text-slate-800 mb-0.5">
                    ส่งออก & สำรองข้อมูลลง Google Sheets ทั้ง 2 ไฟล์ (Dual Sheet Sync)
                </h3>
                <p class="text-xs text-slate-500">ส่งข้อมูลทั้งหมดจากฐานข้อมูล TiDB & MySQL ไปยัง Google Sheets แยกเป็น 2 ไฟล์ (รวม 9 แท็บ) ทันทีในคลิกเดียว</p>
            </div>
            <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-md">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ข้อมูลที่จะส่งออก (แยก 2 ไฟล์ รวม 9 แท็บ)</span>
                    <div class="text-xs text-slate-800 space-y-1.5 mt-1">
                        <div><span class="font-bold text-slate-900">ชีทที่ 1 (ข้อมูลหลัก 5 แท็บ):</span> บันทึกรับของ, ประวัติสั่งซื้อ, ติดตามรับของ, คลังสินค้า, ราคากลาง</div>
                        <div><span class="font-bold text-slate-900">ชีทที่ 2 (แผนผลิต & ประวัติ 4 แท็บ):</span> แผนผลิตประจำสัปดาห์, ประวัติสต็อก, รายงานภาพรวม, AI Mapping</div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ตัด Internal PK/FK ออกทั้งหมด เก็บเฉพาะ Business Columns & เวลาทำรายการ</span>
            </div>

            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">Google Sheets ปลายทาง</span>
                    <div class="space-y-1 mt-1">
                        <a href="https://docs.google.com/spreadsheets/d/1DJeeOYd1hGFAaRZ7emkdgLys7G88T13cylayh6Za1xc/edit?usp=sharing" target="_blank" class="text-xs font-bold text-emerald-700 hover:text-emerald-900 hover:underline block">
                            เปิดดู Google Sheet 1 (ข้อมูลหลัก) &rarr;
                        </a>
                        <a href="https://docs.google.com/spreadsheets/d/1RFXMLRLjidiH6z9C6-DFHZcf8pP_K4TskJJcMVzPS5w/edit?usp=sharing" target="_blank" class="text-xs font-bold text-blue-700 hover:text-blue-900 hover:underline block">
                            เปิดดู Google Sheet 2 (แผนผลิต & ประวัติ) &rarr;
                        </a>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">อัปเดตพร้อมกันทั้ง 2 ไฟล์ชีทในการกดเพียงครั้งเดียว</span>
            </div>

            <div class="bg-emerald-50/60 p-md rounded-md border border-emerald-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-emerald-800 font-semibold uppercase block mb-1">คำสั่งส่งข้อมูลลง 2 Sheets</span>
                    <span class="text-xs text-emerald-950 font-bold block">ส่งข้อมูลล่าสุดจาก Database ไปบันทึกลงทั้ง 2 ชีท</span>
                    <p class="text-[11px] text-emerald-800 mt-1">ไม่ลบหรือกระทบข้อมูลเดิมในฐานข้อมูลระบบ</p>
                </div>
                <button type="button" onclick="executeSyncToGoogleSheets()" id="sync-sheet-btn"
                    class="mt-3 font-bold text-xs px-4 py-2.5 rounded-md shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 transition-opacity border-none"
                    style="background-color: #059669; color: #ffffff;">
                    <span id="sync-sheet-btn-text" style="color: #ffffff !important; font-weight: 700;">ส่งข้อมูลลง Google Sheets</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Section 4: Database Archival & Maintenance Section -->
    <div class="bg-white rounded-lg border border-slate-200/80 shadow-sm p-md md:p-lg">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-bold text-sm md:text-base text-slate-800 mb-0.5">
                    การจัดการฐานข้อมูลและการสำรองข้อมูล (Archive & Database Maintenance)
                </h3>
                <p class="text-xs text-slate-500">ดาวน์โหลดไฟล์สำรองฐานข้อมูล (.ZIP แยกตามตาราง) เก็บไว้ในเครื่อง และลบข้อมูลเก่าเกิน 2 ปีออกจาก TiDB เพื่อรักษาความเร็วสูงสุดของระบบ</p>
            </div>
            <span class="text-[11px] font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-md">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ระยะเวลาเก็บข้อมูลในระบบ</span>
                    <span class="text-sm font-bold text-slate-800">24 เดือน (2 ปี)</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ข้อมูลที่เก่ากว่า 2 ปี จะถูกดาวน์โหลดเป็น .ZIP สำรองและลบออกจากระบบ</span>
            </div>

            <div class="bg-slate-100/70 p-md rounded-md border border-slate-200 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ไฟล์สำรองปลายทาง (.ZIP ในเครื่อง)</span>
                    <span class="text-xs font-mono font-bold text-slate-700 break-all block">CostFlow_PurgedArchive_*.zip</span>
                    <div class="text-[11px] text-slate-600 mt-2 space-y-0.5">
                        <div>• แยกตาราง JSON 5 ไฟล์ (StockLogs, Cost, Plans, Orders, Metadata)</div>
                        <div>• เก็บในเครื่องโดยตรง ไม่รบกวนชีท และไม่ติด Timeout</div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ความปลอดภัยสูงสุด ข้อมูลอยู่ในความควบคุมของคุณ 100%</span>
            </div>

            <div class="bg-amber-50/60 p-md rounded-md border border-amber-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-amber-800 font-semibold uppercase block mb-1">คำสั่งสำรองและล้างข้อมูล</span>
                    <span class="text-xs text-amber-950 font-bold block">ดาวน์โหลดไฟล์สำรอง .ZIP และลบข้อมูลเก่า</span>
                    <p class="text-[11px] text-amber-800 mt-1">มีระบบ Database Transaction ป้องกันข้อมูลสูญหาย</p>
                </div>
                <button type="button" onclick="openArchiveModal()" class="mt-3 font-bold text-xs px-4 py-2.5 rounded-md shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 transition-opacity border-none"
                    style="background-color: #d97706; color: #ffffff;">
                    <span style="color: #ffffff !important; font-weight: 700;">สำรองและลบข้อมูลเก่า (.ZIP)</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal ยืนยันการสำรองและลบข้อมูล (Clean Layout) -->
<div id="archive-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 border border-slate-200 animate-in fade-in zoom-in duration-150">
        <div class="mb-3">
            <h4 class="text-base font-bold text-slate-800">ยืนยันการสำรองและลบข้อมูลเก่า (.ZIP)</h4>
            <p class="text-xs text-slate-500 mt-0.5">ระบบจะรวบรวมข้อมูลเก่าเกิน 24 เดือนมาจัดเก็บในเครื่องและทำความสะอาดระบบ</p>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed mb-2">
            ข้อมูลที่มีอายุเก่ากว่า <strong class="text-slate-900">2 ปี (24 เดือน)</strong> ได้แก่:
        </p>
        <ul class="text-xs text-slate-600 mb-3 list-disc pl-5 space-y-1">
            <li>แผนผลิตและคำสั่งซื้อ (WeeklyPlans & OrderTrackingMasters)</li>
            <li>บันทึกค่าใช้จ่ายและการรับของประจำเดือน (MonthlyOrderActions)</li>
            <li>ประวัติการรับ-เบิกสต็อกสินค้า (StockLogs)</li>
        </ul>
        <p class="text-xs text-slate-600 leading-relaxed mb-4">
            ข้อมูลจะถูกบีบอัดเป็นไฟล์สำรอง <b>.ZIP</b> (บรรจุ JSON แยกตาราง 5 ไฟล์) และดาวน์โหลดลงเครื่องคอมพิวเตอร์ของคุณโดยตรง จากนั้นจึงลบข้อมูลออกจากฐานข้อมูล TiDB เพื่อเพิ่มความเร็วระบบ
        </p>
        <div class="bg-amber-50 border border-amber-200 rounded-md p-3 mb-5 text-[11px] text-amber-900 leading-relaxed">
            <strong class="text-amber-950">ระบบความปลอดภัย (Fail-Safe Database Transaction):</strong> ระบบจะสร้างไฟล์ .ZIP ให้เสร็จสมบูรณ์ก่อน และทำการลบข้อมูลภายใต้ Transaction หากเกิดข้อผิดพลาดใดๆ ระบบจะทำการ Rollback ทันที ข้อมูลในฐานข้อมูลจะไม่สูญหาย
        </div>
        <div class="flex justify-end gap-2">
