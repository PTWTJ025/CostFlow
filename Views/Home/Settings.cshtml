@model CostFlow.Models.ApplicationUser
@{
    ViewData["Title"] = "ตั้งค่าโปรไฟล์";
    ViewData["HeaderTitle"] = "ตั้งค่าโปรไฟล์ผู้ใช้งาน (User Profile Settings)";
    var roleName = ViewData["RoleName"] as string ?? "Staff";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Breadcrumbs / Top Actions -->
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-xs text-xs text-secondary">
            <a href="/" class="hover:text-primary transition-colors">หน้าหลัก</a>
            <span>/</span>
            <span class="text-slate-700 font-semibold">ตั้งค่าโปรไฟล์</span>
        </div>
        <button onclick="window.history.back();" class="text-xs text-slate-600 hover:text-slate-800 hover:bg-slate-100 px-md py-1.5 rounded transition-all flex items-center gap-xs border border-slate-200">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            ย้อนกลับ
        </button>
    </div>

    <!-- Redesigned Profile Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg items-start">
        
        <!-- Left Side: Profile Summary Card (4 Cols) -->
        <div class="lg:col-span-4 bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg flex flex-col items-center gap-md relative overflow-hidden">
            <!-- Decorative colored top accent -->
            <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary to-primary-container"></div>
            
            <!-- Avatar Section with Upload Mock Badge -->
            <div class="relative mt-2">
                <div class="w-24 h-24 rounded-full bg-slate-100 border-4 border-slate-200/50 overflow-hidden flex items-center justify-center shadow-sm">
                    <img alt="User profile photo" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuClsteqi-YK02c9Vk9jcpsMVloDL39QjYkSap1SuZJ8EfsLBHBT1o8wyfqeSLysYaC7bvbaZsN-7DlVfuia1UvWQGeODGTwnf7Lp6HjxxHh8SQHi9D62HrlY8d6SDbvbJtzn6VhZh_Ty7_rdnHoQ-TwkrVX1K3Vs1rgwZkh6xUShdweHFaQ1sAUoAPxQcWeJHDwmkmgcrZ-jBd5pfUrdfglE0LNA2_cEaw9Njy4rk3KYDQgiZTLF2z5"/>
                </div>
                <button class="absolute bottom-0 right-0 bg-primary text-white p-1.5 rounded-full hover:scale-110 transition-transform shadow-md border-2 border-white cursor-pointer" title="อัปโหลดรูปภาพใหม่">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
                    </svg>
                </button>
            </div>
 
            <!-- Name and Status Tag -->
            <div class="text-center w-full">
                <h4 class="font-bold text-slate-800 text-sm">@Model.FullName</h4>
                <span class="text-[10px] text-slate-500 font-semibold bg-slate-100 border border-slate-200/60 px-2.5 py-0.5 rounded-full inline-block mt-1">
                    @(roleName == "Admin" ? "ผู้ดูแลระบบจัดซื้อ (Admin)" : "เจ้าหน้าที่จัดซื้อ (Staff)")
                </span>
            </div>
 
            <hr class="w-full border-slate-100" />
 
            <!-- Stats info block -->
            <div class="w-full grid grid-cols-2 gap-sm text-center">
                <div class="bg-slate-50 p-sm border border-slate-100 rounded">
                    <span class="text-[9px] text-slate-400 block mb-0.5 uppercase tracking-wide">สิทธิ์การทำงาน</span>
                    <span class="text-[11px] font-bold text-primary">@roleName.ToUpper()</span>
                </div>
                <div class="bg-slate-50 p-sm border border-slate-100 rounded">
                    <span class="text-[9px] text-slate-400 block mb-0.5 uppercase tracking-wide">สถานะบัญชี</span>
                    <span class="text-[11px] font-bold @(Model.IsActive ? "text-emerald-600" : "text-rose-600")">@(Model.IsActive ? "ACTIVE" : "INACTIVE")</span>
                </div>
            </div>
        </div>
 
        <!-- Right Side: Edit Details Form Card (8 Cols) -->
        <div class="lg:col-span-8 bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
            <div class="border-b border-slate-100 pb-md mb-lg">
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">แก้ไขข้อมูลส่วนตัว</h3>
                <p class="text-xs text-secondary">กรอกรายละเอียดสำหรับการติดต่อในระบบจัดซื้อชิ้นส่วนโรงงาน</p>
            </div>
 
            <form id="settings-form" class="flex flex-col gap-md">
                
                <!-- Input groups grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                    <!-- Name input with Icon -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">ชื่อ-นามสกุล</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-slate-400">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                </svg>
                            </span>
                            <input id="input-fullname" class="w-full pl-9 pr-3 py-2 border border-outline-variant rounded text-xs outline-none focus:ring-1 focus:ring-primary focus:border-primary bg-white" type="text" value="@Model.FullName" required />
                        </div>
                    </div>
 
                    <!-- Email input with Icon -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">อีเมลติดต่อ</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-slate-400">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                                </svg>
                            </span>
                            <input id="input-email" class="w-full pl-9 pr-3 py-2 border border-outline-variant rounded text-xs outline-none focus:ring-1 focus:ring-primary focus:border-primary bg-white" type="email" value="@Model.Email" placeholder="เช่น somchai.j@factory.co.th" />
                        </div>
                    </div>
 
                    <!-- Readonly employee ID -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">รหัสพนักงาน</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-slate-400">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm-1.25 5.875c0-1.036-1.008-1.875-2.25-1.875s-2.25.839-2.25 1.875v.5c0 .276.224.5.5.5h3.5a.5 0 0 0 .5-.5v-.5Z" />
                                </svg>
                            </span>
                            <input class="w-full pl-9 pr-3 py-2 border border-outline-variant rounded text-xs outline-none bg-slate-50/70 text-slate-500 cursor-not-allowed font-mono" type="text" value="@Model.EmployeeCode" readonly />
                        </div>
                        <span class="text-[9px] text-slate-400 mt-1 block">รหัสพนักงานตั้งมาจากแผนกบุคคล ไม่สามารถแก้ไขได้</span>
                    </div>
 
                    <!-- Readonly department -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">แผนกที่สังกัด</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-slate-400">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                                </svg>
                            </span>
                            <input class="w-full pl-9 pr-3 py-2 border border-outline-variant rounded text-xs outline-none bg-slate-50/70 text-slate-500 cursor-not-allowed" type="text" value="ฝ่ายจัดซื้อและคุมคลังอะไหล่ (Procurement)" readonly />
                        </div>
                    </div>
                </div>
 
                <!-- Submit Action Buttons -->
                <div class="flex justify-end gap-sm pt-sm border-t border-slate-100 mt-md">
                    <button type="button" onclick="window.history.back();" class="px-md py-2 border border-slate-200 rounded text-xs font-semibold text-slate-600 bg-white hover:bg-slate-50 transition-colors">
                        ยกเลิก
                    </button>
                    <button type="submit" id="save-settings-btn" class="bg-primary hover:bg-primary/95 text-on-primary text-xs font-bold px-lg py-2 rounded transition-colors shadow-sm">
                        บันทึกการตั้งค่า
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>
 
<script>
document.addEventListener("DOMContentLoaded", function() {
    // Premium Toast Notification Helper
    function showToast(message, type = 'error') {
        const container = document.getElementById("toast-container");
        const toast = document.createElement("div");
        toast.className = `px-4 py-3 rounded shadow-lg text-xs font-semibold flex items-center gap-2 transform translate-y-2 opacity-0 transition-all duration-300 pointer-events-auto max-w-sm ${
            type === 'success' 
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
                : 'bg-rose-50 text-rose-800 border border-rose-200'
        }`;
        
        const icon = type === 'success'
            ? `<svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            : `<svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
 
        toast.innerHTML = `${icon}<span>${message}</span>`;
        container.appendChild(toast);
 
        setTimeout(() => {
            toast.classList.remove("translate-y-2", "opacity-0");
        }, 10);
 
        setTimeout(() => {
            toast.classList.add("opacity-0", "translate-y-2");
            setTimeout(() => {
                toast.remove();
            }, 300);
        }, 3000);
    }
 
    // Handle actual submit via AJAX
    document.getElementById("settings-form").addEventListener("submit", function(e) {
        e.preventDefault();
        const fullName = document.getElementById("input-fullname").value.trim();
        const email = document.getElementById("input-email").value.trim();
 
        const btn = document.getElementById("save-settings-btn");
        btn.disabled = true;
        btn.textContent = "กำลังบันทึก...";
 
        fetch('/Home/SaveSettings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ fullName, email })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.textContent = "บันทึกการตั้งค่า";
            if (data.success) {
                showToast("บันทึกการตั้งค่าโปรไฟล์สำเร็จแล้ว!", "success");
                // Update left card name and sidebar/header profile names dynamically
                document.querySelector(".lg:col-span-4 h4").textContent = fullName;
                
                // Update header profile display text
                const headerProfileName = document.querySelector("header .flex.flex-col span.text-xs.font-bold");
                if (headerProfileName) headerProfileName.textContent = fullName;
            } else {
                showToast(data.error || "เกิดข้อผิดพลาดในการบันทึก", "error");
            }
        })
        .catch(() => {
            btn.disabled = false;
            btn.textContent = "บันทึกการตั้งค่า";
            showToast("ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้", "error");
        });
    });
});
</script>
