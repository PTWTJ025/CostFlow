<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

<script>
function executeBackup() {
    const btn = document.getElementById("backup-btn");
    btn.disabled = true;
    btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span style="color:#ffffff;font-weight:700;">กำลังสำรองข้อมูล...</span>`;

    fetch('/Home/BackupDatabase', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(async response => {
        if (!response.ok) {
            const err = await response.json().catch(() => ({ error: 'เกิดข้อผิดพลาดในการดาวน์โหลด' }));
            throw new Error(err.error || 'Server error ' + response.status);
        }
        const disposition = response.headers.get('Content-Disposition') || '';
        let filename = 'CostFlow_Backup.zip';
        const match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
        if (match && match[1]) {
            filename = match[1].replace(/['"]/g, '');
        }
        return response.blob().then(blob => ({ blob, filename }));
    })
    .then(({ blob, filename }) => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(url);

        btn.disabled = false;
        btn.innerHTML = `<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg><span style="color:#ffffff;font-weight:700;">ดาวน์โหลด Backup ทั้งหมด (.ZIP)</span>`;
        if (typeof showToast === 'function') showToast('ดาวน์โหลด Backup สำเร็จ! (' + filename + ')', 'success');
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg><span style="color:#ffffff;font-weight:700;">ดาวน์โหลด Backup ฐานข้อมูล</span>`;
        if (typeof showToast === 'function') showToast(err.message || 'เกิดข้อผิดพลาดในการ Backup', 'error');
        else alert(err.message || 'เกิดข้อผิดพลาดในการ Backup');
    });
}

function executeSyncToGoogleSheets() {
    const btn = document.getElementById("sync-sheet-btn");
    const originalHtml = btn.innerHTML;

    if (typeof Swal !== 'undefined') {
        Swal.fire({
            title: 'ส่งข้อมูลลง Google Sheets ทั้ง 2 ไฟล์?',
            html: `
                <div class="text-left text-xs text-slate-600 space-y-2 mt-2 leading-relaxed">
                    <p>ระบบจะกวาดข้อมูลทั้งหมดจาก Database ไปอัปเดตบน Google Sheets 2 ไฟล์ (รวม 9 แท็บ) พร้อมกันทันที:</p>
                    <div class="p-2.5 bg-emerald-50 rounded border border-emerald-200 text-emerald-950 font-medium">
                        <div>📂 <b>ชีทที่ 1 (ข้อมูลหลัก):</b> บันทึกรับของ, ประวัติสั่งซื้อ, ติดตามรับของ, คลังสินค้า, ราคากลาง</div>
                        <div class="mt-1">📁 <b>ชีทที่ 2 (แผนผลิต/ประวัติ):</b> แผนผลิตประจำสัปดาห์, ประวัติสต็อก, รายงานภาพรวม, AI Mapping</div>
                    </div>
                    <p class="text-slate-500 italic text-[11px]">* หมายเหตุ: ระบบจะไม่ลบข้อมูลใดๆ ในฐานข้อมูล</p>
                </div>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '🚀 เริ่มส่งข้อมูลทั้ง 2 ชีท',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#059669',
            cancelButtonColor: '#64748b'
        }).then((result) => {
            if (result.isConfirmed) {
                performSync();
            }
        });
    } else {
        if (confirm("ต้องการส่งข้อมูลทั้งหมดไปยัง Google Sheets ทั้ง 2 ไฟล์ (รวม 9 แท็บ) หรือไม่?")) {
            performSync();
        }
    }

    function performSync() {
        btn.disabled = true;
        btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span style="color:#ffffff;font-weight:700;">กำลังส่งข้อมูลไปยัง Google Sheets ทั้ง 2 ไฟล์...</span>`;

        fetch('/Home/SyncAllToGoogleSheets', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;

            if (data.success) {
                const s1 = data.details?.sheet1 || {};
                const s2 = data.details?.sheet2 || {};

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'ส่งข้อมูลลง Google Sheets สำเร็จครบทั้ง 2 ไฟล์!',
                        html: `
                            <div class="text-left text-xs text-slate-700 space-y-3 mt-3">
                                <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-200">
                                    <div class="font-bold text-emerald-900 text-sm mb-1.5 flex items-center gap-1.5">
                                        <span>📂 ชีทที่ 1 (ข้อมูลหลัก - Core Operations)</span>
                                    </div>
                                    <ul class="list-disc pl-5 space-y-0.5 text-emerald-800 text-[11px]">
                                        <li>บันทึกการรับของประจำเดือน: <b>${s1.actions ?? 0}</b> รายการ</li>
                                        <li>ประวัติการสั่งซื้อ: <b>${s1.orderHistory ?? 0}</b> รายการ</li>
                                        <li>ติดตามการรับสินค้า: <b>${s1.receivedTracking ?? 0}</b> รายการ</li>
                                        <li>คลังสินค้า / สต็อกคงเหลือ: <b>${s1.stockItems ?? 0}</b> รายการ</li>
                                        <li>ราคากลางสินค้า: <b>${s1.productPrices ?? 0}</b> รายการ</li>
                                    </ul>
                                </div>

                                <div class="p-3 bg-indigo-50 rounded-lg border border-indigo-200">
                                    <div class="font-bold text-indigo-900 text-sm mb-1.5 flex items-center gap-1.5">
                                        <span>📁 ชีทที่ 2 (แผนผลิตและประวัติ - Secondary & History)</span>
                                    </div>
                                    <ul class="list-disc pl-5 space-y-0.5 text-indigo-800 text-[11px]">
                                        <li>แผนผลิตประจำสัปดาห์: <b>${s2.weeklyPlans ?? 0}</b> รายการ</li>
                                        <li>ประวัติการเคลื่อนไหวสต็อก: <b>${s2.stockLogs ?? 0}</b> รายการ</li>
                                        <li>รายงานสรุปภาพรวมคำสั่งซื้อ: <b>${s2.reports ?? 0}</b> รายการ</li>
                                        <li>หน่วยความจำ AI จับคู่สินค้า: <b>${s2.itemMappings ?? 0}</b> รายการ</li>
                                    </ul>
                                </div>

                                <div class="text-emerald-700 font-semibold text-center text-xs">
                                    ✅ ข้อมูลทั้ง 9 แท็บใน 2 ไฟล์ชีทได้รับการอัปเดตเรียบร้อยแล้ว
                                </div>
                            </div>
                        `,
                        confirmButtonColor: '#059669',
                        confirmButtonText: 'ตกลง'
                    });
                } else if (typeof showToast === 'function') {
                    showToast(data.message || 'ส่งข้อมูลลง Google Sheets สำเร็จครบทั้ง 2 ไฟล์!', 'success');
                }
            } else {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาดในการส่งข้อมูล',
                        text: data.error || 'ไม่สามารถส่งข้อมูลไปยัง Google Sheet ได้'
                    });
                } else if (typeof showToast === 'function') {
                    showToast(data.error || 'ไม่สามารถส่งข้อมูลไปยัง Google Sheet ได้', 'error');
                }
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'เชื่อมต่อล้มเหลว',
                    text: err.message || 'เกิดข้อผิดพลาดในการเชื่อมต่อเครือข่าย'
                });
            } else if (typeof showToast === 'function') {
                showToast(err.message || 'เกิดข้อผิดพลาดในการเชื่อมต่อเครือข่าย', 'error');
            }
        });
    }
}

function openArchiveModal() {
    document.getElementById("archive-modal").classList.remove("hidden");
}

function closeArchiveModal() {
    document.getElementById("archive-modal").classList.add("hidden");
}

function executeArchiveAndPurge() {
    const btn = document.getElementById("confirm-archive-btn");
    btn.disabled = true;
    btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span style="color:#ffffff;">กำลังประมวลผล...</span>`;

    fetch('/Home/ArchiveAndPurge', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
        btn.disabled = false;
        btn.innerHTML = `<span style="color: #ffffff !important; font-weight: 700;">ยืนยันการสำรองและลบข้อมูล</span>`;
        closeArchiveModal();

        if (data.success) {
            // กรณีไม่มีข้อมูลที่เก่าเกิน 2 ปี (ไม่มีอะไรต้องลบ)
            if (data.purged === 0 && data.archived === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'info',
                        title: 'ไม่พบข้อมูลที่เก่าเกิน 2 ปี',
                        html: `
                            <div class="text-left text-xs text-slate-600 space-y-2 mt-2 leading-relaxed">
                                <p>ข้อมูลทั้งหมดในฐานข้อมูลของคุณอยู่ในช่วง <b>24 เดือนล่าสุด</b> ยังไม่มีรายการเก่าที่ต้องย้ายลง Google Sheet หรือลบออกจากระบบครับ</p>
                                <p class="text-slate-400 text-[11px] mt-2">* หากต้องการดาวน์โหลดสำรองข้อมูลปัจจุบันทั้งหมด สามารถกดปุ่ม <b>"ดาวน์โหลด Backup ทั้งหมด (.ZIP)"</b> ด้านบนได้ทันทีครับ</p>
                            </div>
                        `,
                        confirmButtonColor: '#2563eb'
                    });
                } else if (typeof showToast === 'function') {
                    showToast("ไม่พบข้อมูลเก่าเกิน 2 ปีในระบบ", "info");
                }
                return;
            }

            let directDownloadLink = '';

            // 💾 ดาวน์โหลดไฟล์สำรอง .ZIP อัตโนมัติลงเครื่องทันที (Purged Archive ZIP)
            if (data.zipBase64) {
                const byteCharacters = atob(data.zipBase64);
                const byteNumbers = new Array(byteCharacters.length);
                for (let i = 0; i < byteCharacters.length; i++) {
                    byteNumbers[i] = byteCharacters.charCodeAt(i);
                }
                const byteArray = new Uint8Array(byteNumbers);
                const blob = new Blob([byteArray], { type: 'application/zip' });
                const url = URL.createObjectURL(blob);
                const dlName = data.zipFileName || 'CostFlow_PurgedArchive.zip';

                const a = document.createElement('a');
                a.href = url;
                a.download = dlName;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    a.remove();
                }, 1000);

                directDownloadLink = `
                    <div class="mt-3 pt-2.5 border-t border-slate-200 flex items-center justify-between">
                        <span class="text-[11px] text-slate-500">หากเบราว์เซอร์ไม่ดาวน์โหลดอัตโนมัติ:</span>
                        <a href="${url}" download="${dlName}" class="text-xs font-bold text-amber-700 hover:text-amber-900 underline flex items-center gap-1">
                            📥 คลิกดาวน์โหลดไฟล์สำรอง (.ZIP)
                        </a>
                    </div>
                `;
            }

            if (typeof Swal !== 'undefined') {
                const d = data.details || {};
                Swal.fire({
                    icon: 'success',
                    title: 'สำรองและล้างข้อมูลสำเร็จ!',
                    html: `
                        <div class="text-left text-xs text-slate-600 space-y-2 mt-2">
                            <p><b>💾 ไฟล์สำรอง .ZIP:</b> <span class="text-amber-800 font-mono bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200 font-bold">${data.zipFileName || 'CostFlow_PurgedArchive.zip'}</span> (ดาวน์โหลดลงเครื่องแล้ว)</p>
                            <p><b>🗑️ รวมลบข้อมูลเก่าออกจาก TiDB:</b> <strong class="text-slate-900">${data.purged || 0} รายการ</strong></p>
                            <div class="bg-slate-50 border border-slate-200 rounded p-2 text-[11px] text-slate-700 space-y-0.5">
                                <div>• แผนผลิต (Weekly Plans): <b>${d.weeklyPlanRows || 0}</b> แถว</div>
                                <div>• ค่าใช้จ่ายรับของ (Monthly Actions): <b>${d.monthlyCostRows || 0}</b> แถว</div>
                                <div>• ประวัติสต็อก (Stock Logs): <b>${d.stockLogRows || 0}</b> แถว</div>
                                <div>• รายงาน & คำสั่งซื้อ: <b>${(d.reportsPurged || 0) + (d.ordersPurged || 0)}</b> รายการ</div>
                            </div>
                            ${directDownloadLink}
                        </div>
                    `,
                    confirmButtonColor: '#d97706',
                    confirmButtonText: 'รับทราบ'
                });
            } else if (typeof showToast === 'function') {
                showToast(data.message || "สำรองข้อมูลลง .ZIP และลบรายการเก่าเรียบร้อยแล้ว!", "success");
            }
        } else {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: data.error || 'เกิดข้อผิดพลาดในการสำรองข้อมูล'
                });
            } else if (typeof showToast === 'function') {
                showToast(data.error || "เกิดข้อผิดพลาดในการสำรองข้อมูล", "error");
            }
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = `<span style="color: #ffffff !important; font-weight: 700;">ยืนยันการสำรองและลบข้อมูล</span>`;
        closeArchiveModal();
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาดในการเชื่อมต่อ',
                text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'
            });
        } else if (typeof showToast === 'function') {
            showToast("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์", "error");
        }
    });
}

// -------------------------------------------------------------
// ระบบ Restore Database (Safe-Guard Protected)
// -------------------------------------------------------------
let selectedRestoreFile = null;

function handleRestoreFileChosen(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;

    selectedRestoreFile = file;
    const nameEl = document.getElementById("restore-file-name");
    const sizeEl = document.getElementById("restore-file-size");

    nameEl.innerText = file.name;
    const sizeKb = (file.size / 1024).toFixed(1);
    const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
    sizeEl.innerText = file.size > 1024 * 1024 ? `${sizeMb} MB • พร้อมตรวจสอบ` : `${sizeKb} KB • พร้อมตรวจสอบ`;

    if (typeof showToast === 'function') {
        showToast(`เลือกไฟล์สำรอง: ${file.name} เรียบร้อยแล้ว`, 'success');
    }
}

function triggerRestoreAction() {
    const modalFilename = document.getElementById("modal-restore-filename");
    if (selectedRestoreFile) {
        modalFilename.innerText = selectedRestoreFile.name;
    } else {
        modalFilename.innerText = "CostFlow_FullBackup_*.zip";
    }

    openRestoreModal();
}

function openRestoreModal() {
    document.getElementById("restore-guard-modal").classList.remove("hidden");
}

function closeRestoreModal() {
    document.getElementById("restore-guard-modal").classList.add("hidden");
}

document.addEventListener("DOMContentLoaded", function() {
    function showToast(message, type = 'error') {
        const container = document.getElementById("toast-container");
        const toast = document.createElement("div");
        toast.className = `px-4 py-3 rounded shadow-lg text-xs font-semibold flex items-center gap-2 transform translate-y-2 opacity-0 transition-all duration-300 pointer-events-auto max-w-sm ${
            type === 'success' 
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
                : 'bg-rose-50 text-rose-800 border border-rose-200'
        }`;
        
        const icon = type === 'success'
            ? `<svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            : `<svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;

        toast.innerHTML = `${icon}<span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(() => {
            toast.classList.remove("translate-y-2", "opacity-0");
        }, 10);

        setTimeout(() => {
            toast.classList.add("opacity-0", "translate-y-2");
            setTimeout(() => {
                toast.remove();
            }, 300);
        }, 3000);
    }
    window.showToast = showToast;
});
</script>
