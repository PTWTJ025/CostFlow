@model CostFlow.Models.ApplicationUser
@{
    ViewData["Title"] = "ตั้งค่า & สำรองข้อมูล";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Breadcrumbs / Top Actions -->
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-xs text-xs text-secondary">
            <a href="/" class="hover:text-primary transition-colors">หน้าหลัก</a>
            <span>/</span>
            <span class="text-slate-700 font-semibold">ตั้งค่า & สำรองข้อมูล</span>
        </div>
        <button onclick="window.history.back();" class="text-xs text-slate-600 hover:text-slate-800 hover:bg-slate-100 px-md py-1.5 rounded transition-all flex items-center gap-xs border border-slate-200 cursor-pointer">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            ย้อนกลับ
        </button>
    </div>

    <!-- SQLite & TiDB Database Backup Section -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    สำรองฐานข้อมูลฉบับเต็ม (Full Backup & Download)
                </h3>
                <p class="text-xs text-secondary">ดาวน์โหลดไฟล์ฐานข้อมูลครบทุกตาราง (คำสั่งผลิต, ค่าใช้จ่าย, คลังสินค้า, ประวัติรับ-เบิกของ, และบัญชีผู้ใช้) ในไฟล์ .ZIP เดียว</p>
            </div>
            <span class="text-[11px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded">
                ครอบคลุมฐานข้อมูล 100% (Full Schema)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ตารางที่ครอบคลุมทั้งหมด</span>
                    <span class="text-sm font-bold text-slate-800">TiDB Cloud (costflow_db & test)</span>
                    <div class="text-[11px] text-slate-600 mt-2 space-y-0.5">
                        <div>• ระบบคลังสินค้า: <strong>StockItems, ItemMappings, StockLogs</strong></div>
                        <div>• ข้อมูลระบบ: <strong>Users, Roles, ProductPrices</strong></div>
                        <div>• ระบบผลิตและค่าใช้จ่าย: <strong>Reports, Orders, Plans, Actions</strong></div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">กวาดทุกตารางในฐานข้อมูลครบถ้วน 100%</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">โครงสร้างไฟล์สำรองใน ZIP</span>
                    <span class="text-xs font-mono font-bold text-slate-700 break-all">CostFlow_FullBackup_*.zip</span>
                    <div class="text-[11px] text-slate-600 mt-2 space-y-0.5">
                        <div>1. <span class="font-mono text-slate-700">TiDB_CostFlowCore_*.json</span> (ตารางหลักทั้งหมด)</div>
                        <div>2. <span class="font-mono text-slate-700">TiDB_StockSystem_*.json</span> (ระบบสต็อกโดยเฉพาะ)</div>
                        <div>3. <span class="font-mono text-slate-700">TiDB_SavedOrders_*.json</span> (ชุดสั่งซื้ออะไหล่)</div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">บีบอัดฐานข้อมูลระบบทั้งหมดใน ZIP เดียว</span>
            </div>

            <div class="bg-blue-50/60 p-md rounded border border-blue-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-blue-800 font-semibold uppercase block mb-1">คำสั่งสำรองข้อมูลฉบับเต็ม</span>
                    <span class="text-xs text-blue-900 font-medium block">ดาวน์โหลดฐานข้อมูลทุกตารางมาเก็บในเครื่องทันที (.ZIP)</span>
                    <p class="text-[11px] text-blue-700 mt-1">แนะนำให้ดาวน์โหลดเก็บไว้ทุกสัปดาห์หรือก่อนการล้างข้อมูลประจำปี</p>
                </div>
                <form id="backup-form" method="post" action="/Home/BackupDatabase">
                    @Html.AntiForgeryToken()
                    <button type="button" onclick="executeBackup()" id="backup-btn"
                        class="mt-3 font-bold text-xs px-4 py-2.5 rounded shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 border-none transition-all"
                        style="background-color: #2563eb; color: #ffffff;">
                        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                        <span style="color: #ffffff; font-weight: 700;">ดาวน์โหลด Backup ทั้งหมด (.ZIP)</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Restore Database Section (Mockup / Safety Guarded) -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    กู้คืนฐานข้อมูล (Restore Database)
                </h3>
                <p class="text-xs text-secondary">นำเข้าไฟล์สำรองเพื่อตรวจสอบความสมบูรณ์และเตรียมกู้คืนฐานข้อมูล (มีระบบ Safe-Guard ล็อคการเขียนทับเพื่อความปลอดภัย)</p>
            </div>
            <span class="text-[11px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-3 py-1 rounded flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                ระบบความปลอดภัย Safe-Guard
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">รูปแบบไฟล์ที่รองรับ</span>
                    <span class="text-sm font-bold text-slate-800">.ZIP หรือ .JSON จาก CostFlow</span>
                    <p class="text-[11px] text-slate-600 mt-2 leading-relaxed">
                        รองรับไฟล์ Backup ที่ดาวน์โหลดจากระบบ ซึ่งมีข้อมูลครบ 100% ทั้งตารางระบบหลัก, สต็อกสินค้า, และผู้ใช้งาน
                    </p>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ตรวจสอบความถูกต้องของ Schema อัตโนมัติ</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">เลือกไฟล์สำรองสำหรับกู้คืน</span>
                    <input type="file" id="restore-file-input" accept=".zip,.json" onchange="handleRestoreFileChosen(event)" class="hidden" />
                    <button type="button" onclick="document.getElementById('restore-file-input').click()" 
                        class="w-full mt-1 border border-dashed border-slate-300 hover:border-indigo-400 hover:bg-indigo-50/30 rounded p-3 text-left transition-all cursor-pointer bg-white">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                            </svg>
                            <div class="overflow-hidden">
                                <span id="restore-file-name" class="text-xs font-semibold text-slate-700 block truncate">คลิกเลือกไฟล์ .ZIP หรือ .JSON</span>
                                <span id="restore-file-size" class="text-[10px] text-slate-400 block">ยังไม่ได้เลือกไฟล์สำรอง</span>
                            </div>
                        </div>
                    </button>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">รองรับ CostFlow_FullBackup_*.zip</span>
            </div>

            <div class="bg-indigo-50/50 p-md rounded border border-indigo-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-indigo-800 font-semibold uppercase block mb-1">คำสั่งกู้คืนข้อมูล</span>
                    <span class="text-xs text-indigo-900 font-medium block">เริ่มตรวจสอบและเตรียมการกู้คืนข้อมูล</span>
                    <p class="text-[11px] text-indigo-700 mt-1">ระบบจะแสดงรายละเอียดและล็อคการเขียนทับอัตโนมัติเพื่อความปลอดภัย</p>
                </div>
                <button type="button" onclick="triggerRestoreAction()" id="restore-btn"
                    class="mt-3 font-bold text-xs px-4 py-2.5 rounded shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 border-none transition-all"
                    style="background-color: #4338ca; color: #ffffff;">
                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    <span style="color: #ffffff; font-weight: 700;">เริ่มการกู้คืนข้อมูล (Restore)</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Google Sheets Manual Sync & Backup Section (One-Click Dual-Sheet Sync) -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 a5.25 5.25 0 0 1 10.233-2.33 a3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z"/>
                    </svg>
                    ส่งออก & สำรองข้อมูลลง Google Sheet ทั้ง 2 ไฟล์ (One-Click Dual Sheet Sync)
                </h3>
                <p class="text-xs text-secondary">ส่งข้อมูลทั้งหมดจากฐานข้อมูล TiDB & MySQL ไปยัง Google Sheets แยกเป็น 2 ไฟล์ (รวม 9 แท็บ) ทันทีในคลิกเดียว (ไม่ลบข้อมูลในระบบ)</p>
            </div>
            <span class="text-[11px] font-bold text-emerald-700 px-3 py-1">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ข้อมูลที่จะส่งออก (แยก 2 ไฟล์ รวม 9 แท็บ)</span>
                    <div class="text-xs text-slate-800 space-y-1 mt-1">
                        <div><strong class="text-emerald-800">📂 ชีทที่ 1 (ข้อมูลหลัก 5 แท็บ):</strong> บันทึกรับของ, ประวัติสั่งซื้อ, ติดตามรับของ, คลังสินค้า, ราคากลาง</div>
                        <div><strong class="text-indigo-800">📁 ชีทที่ 2 (แผนผลิต & ประวัติ 4 แท็บ):</strong> แผนผลิตประจำสัปดาห์, ประวัติสต็อก, รายงานภาพรวม, AI Mapping</div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ตัด Internal PK/FK ออกทั้งหมด เก็บเฉพาะ Business Columns & เวลาทำรายการ</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">Google Sheet ปลายทาง</span>
                    <a href="https://docs.google.com/spreadsheets/d/1RFXMLRLjidiH6z9C6-DFHZcf8pP_K4TskJJcMVzPS5w/edit?usp=sharing" target="_blank" class="text-xs font-bold text-emerald-600 hover:underline flex items-center gap-1 mb-1">
                        📂 เปิดดู Google Sheet 1 (ข้อมูลหลัก)
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                    </a>
                    <span class="text-[11px] text-slate-600 block">📁 Google Sheet 2 (แผนผลิต/ประวัติ): เชื่อมโยงผ่าน Apps Script แยกไฟล์</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">อัปเดตพร้อมกันทั้ง 2 ไฟล์ชีทในการกดเพียงครั้งเดียว</span>
            </div>

            <div class="bg-emerald-50/60 p-md rounded border border-emerald-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-emerald-800 font-semibold uppercase block mb-1">คำสั่งส่งข้อมูลลง 2 Sheets</span>
                    <span class="text-xs text-emerald-900 font-medium block">ส่งข้อมูลล่าสุดจาก Database ไปบันทึกลงทั้ง 2 ชีท</span>
                </div>
                <button type="button" onclick="executeSyncToGoogleSheets()" id="sync-sheet-btn"
                    class="mt-3 font-bold text-xs px-4 py-2.5 rounded shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 border-none transition-all"
                    style="background-color: #059669; color: #ffffff;">
                    <span id="sync-sheet-btn-text" style="color: #ffffff; font-weight: 700;">🚀 ส่งข้อมูลลง Google Sheet ทันที</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Database Archival & Maintenance Section -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                    การจัดการฐานข้อมูลและการสำรองข้อมูล (Archive & Database Maintenance)
                </h3>
                <p class="text-xs text-secondary">ดาวน์โหลดไฟล์สำรองฐานข้อมูล (.ZIP แยกตามตาราง) เก็บไว้ในเครื่อง และลบข้อมูลเก่าเกิน 2 ปีออกจาก TiDB เพื่อรักษาความเร็วสูงสุดของระบบ</p>
            </div>
            <span class="text-[11px] font-bold text-amber-700 px-3 py-1">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ระยะเวลาเก็บข้อมูลในระบบ</span>
                    <span class="text-base font-bold text-slate-800">24 เดือน (2 ปี)</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ข้อมูลที่เก่ากว่า 2 ปี จะถูกดาวน์โหลดเป็น .ZIP สำรองและลบออกจากระบบ</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ไฟล์สำรองปลายทาง (.ZIP ในเครื่อง)</span>
                    <span class="text-xs font-mono font-bold text-amber-900 break-all block">CostFlow_PurgedArchive_*.zip</span>
                    <div class="text-[11px] text-slate-600 mt-2 space-y-0.5">
                        <div>• แยกตาราง JSON 5 ไฟล์ (StockLogs, Cost, Plans, Orders, Metadata)</div>
                        <div>• เก็บในเครื่องโดยตรง ไม่รบกวนชีท และไม่ติด Timeout</div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ความปลอดภัยสูงสุด ข้อมูลอยู่ในความควบคุมของคุณ 100%</span>
