@model CostFlow.Models.ApplicationUser
@{
    ViewData["Title"] = "ตั้งค่า & สำรองข้อมูล";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Breadcrumbs / Top Actions -->
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-xs text-xs text-secondary">
            <a href="/" class="hover:text-primary transition-colors">หน้าหลัก</a>
            <span>/</span>
            <span class="text-slate-700 font-semibold">ตั้งค่า & สำรองข้อมูล</span>
        </div>
        <button onclick="window.history.back();" class="text-xs text-slate-600 hover:text-slate-800 hover:bg-slate-100 px-md py-1.5 rounded transition-all flex items-center gap-xs border border-slate-200 cursor-pointer">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            ย้อนกลับ
        </button>
    </div>

    <!-- SQLite & TiDB Database Backup Section -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    สำรองฐานข้อมูล (Backup & Download)
                </h3>
                <p class="text-xs text-secondary">ดาวน์โหลดไฟล์ฐานข้อมูลเพื่อสำรองข้อมูลไว้ในเครื่อง แนะนำให้ทำทุกเดือนหลังปิดยอด</p>
            </div>
            <span class="text-[11px] font-bold text-blue-700 px-3 py-1">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ประเภทฐานข้อมูลในระบบ</span>
                    <span class="text-base font-bold text-slate-800">TiDB Cloud & SQLite</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ระบบหลัก (costflow_db) + จัดซื้อสั่งอะไหล่ (test)</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ไฟล์รวมสำรองข้อมูล</span>
                    <span class="text-xs font-mono font-bold text-slate-700 break-all">CostFlow_FullBackup_*.zip</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">บีบอัดฐานข้อมูลระบบใน ZIP เดียว</span>
            </div>

            <div class="bg-blue-50/60 p-md rounded border border-blue-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-blue-800 font-semibold uppercase block mb-1">คำสั่งสำรองข้อมูลทั้งหมด</span>
                    <span class="text-xs text-blue-900 font-medium block">ดาวน์โหลดทั้ง 2 DB มาเก็บในเครื่อง (ZIP)</span>
                </div>
                <form id="backup-form" method="post" action="/Home/BackupDatabase">
                    @Html.AntiForgeryToken()
                    <button type="button" onclick="executeBackup()" id="backup-btn"
                        class="mt-3 font-bold text-xs px-4 py-2.5 rounded shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 border-none transition-all"
                        style="background-color: #2563eb; color: #ffffff;">
                        <span style="color: #ffffff; font-weight: 700;">ดาวน์โหลด Backup ทั้งหมด (.ZIP)</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Google Sheets Manual Sync & Backup Section -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 a5.25 5.25 0 0 1 10.233-2.33 a3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z"/>
                    </svg>
                    ส่งออก & สำรองข้อมูลลง Google Sheet (Manual Sync to Google Sheet)
                </h3>
                <p class="text-xs text-secondary">ส่งข้อมูลค่าใช้จ่ายและบันทึกการรับของประจำเดือนทั้งหมดจากฐานข้อมูลไปยัง Google Sheet ทันที (ไม่ลบข้อมูลในระบบ)</p>
            </div>
            <span class="text-[11px] font-bold text-emerald-700 px-3 py-1">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ข้อมูลที่จะส่งออก (3 แท็บหลัก)</span>
                    <span class="text-xs font-bold text-slate-800 block">1. บันทึกการรับของประจำเดือน</span>
                    <span class="text-xs font-bold text-slate-800 block">2. ประวัติการสั่งซื้อ (ชุดสั่งซื้อ)</span>
                    <span class="text-xs font-bold text-slate-800 block">3. ติดตามการรับสินค้า</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">กวาดข้อมูลจาก MySQL & TiDB ครบทุกชุด</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">Google Sheet ปลายทาง</span>
                    <a href="https://docs.google.com/spreadsheets/d/1RFXMLRLjidiH6z9C6-DFHZcf8pP_K4TskJJcMVzPS5w/edit?usp=sharing" target="_blank" class="text-xs font-bold text-emerald-600 hover:underline flex items-center gap-1">
                        เปิดดู Google Sheet ฐานข้อมูล
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                    </a>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">อัปเดตพร้อมกันทั้ง 3 แท็บในไฟล์เดียว</span>
            </div>

            <div class="bg-emerald-50/60 p-md rounded border border-emerald-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-emerald-800 font-semibold uppercase block mb-1">คำสั่งส่งข้อมูลลง Sheet</span>
                    <span class="text-xs text-emerald-900 font-medium block">ส่งข้อมูลล่าสุดจาก Database ไปบันทึกลงชีท</span>
                </div>
                <button type="button" onclick="executeSyncToGoogleSheets()" id="sync-sheet-btn"
                    class="mt-3 font-bold text-xs px-4 py-2.5 rounded shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 border-none transition-all"
                    style="background-color: #059669; color: #ffffff;">
                    
                    <span id="sync-sheet-btn-text" style="color: #ffffff; font-weight: 700;">ส่งข้อมูลลง Google Sheet ทันที</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Database Archival & Maintenance Section -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="border-b border-slate-100 pb-md mb-md flex flex-wrap justify-between items-center gap-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                    การจัดการฐานข้อมูลและการสำรองข้อมูล (Archive & Database Maintenance)
                </h3>
                <p class="text-xs text-secondary">ย้ายข้อมูลเก่าเกิน 2 ปีลง Google Sheet สำรอง และลบออกจากฐานข้อมูลเพื่อเพิ่มความเร็วของระบบ</p>
            </div>
            <span class="text-[11px] font-bold text-amber-700 px-3 py-1">
                สำหรับผู้ดูแลระบบ (Admin Only)
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ระยะเวลาเก็บข้อมูลในระบบ</span>
                    <span class="text-base font-bold text-slate-800">24 เดือน (2 ปี)</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ข้อมูลที่เก่ากว่า 2 ปี จะถูกย้ายลง Google Sheet</span>
            </div>

            <div class="bg-slate-50 p-md rounded border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-slate-500 font-semibold uppercase block mb-1">ไฟล์สำรองปลายทาง</span>
                    <a href="https://docs.google.com/spreadsheets/d/1RFXMLRLjidiH6z9C6-DFHZcf8pP_K4TskJJcMVzPS5w/edit?gid=572126532#gid=572126532" target="_blank" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                        เปิดดู Google Sheet สำรอง
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                    </a>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">ฐานข้อมูลสำรองย้อนหลัง 2 ปี (WeeklyPlan & MonthlyCost)</span>
            </div>

            <div class="bg-amber-50/60 p-md rounded border border-amber-200/80 flex flex-col justify-between">
                <div>
                    <span class="text-[10px] text-amber-800 font-semibold uppercase block mb-1">คำสั่งล้างข้อมูล</span>
                    <span class="text-xs text-amber-900 font-medium block">ย้ายข้อมูลย้อนหลังเกิน 2 ปีลง Sheet และลบออก</span>
                </div>
                <button type="button" onclick="openArchiveModal()" style="background-color: #d97706; color: #ffffff !important;" class="mt-3 font-bold text-xs px-4 py-2.5 rounded shadow-sm flex items-center justify-center gap-1.5 w-full cursor-pointer hover:opacity-90 border-none transition-all">
                    <span style="color: #ffffff !important; font-weight: 700;">สำรองและลบข้อมูลเก่า (เกิน 2 ปี) ทันที</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal ยืนยันการสำรองและลบข้อมูล -->
<div id="archive-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 border border-slate-200 animate-in fade-in zoom-in duration-200">
        <div class="flex items-center gap-3 text-amber-600 mb-3">
            <div class="p-2 bg-amber-100 rounded-full">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h4 class="text-base font-bold text-slate-800">ยืนยันการสำรองและลบข้อมูลเก่า</h4>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed mb-4">
            ระบบจะทำการย้ายข้อมูลที่มีอายุเก่ากว่า <strong class="text-slate-900">2 ปี (24 เดือน)</strong> ไปบันทึกเก็บไว้ใน Google Sheet สำรองอย่างปลอดภัย พร้อมดาวน์โหลดไฟล์สำรองเก็บไว้ในเครื่อง และลบออกจากฐานข้อมูลเพื่อเพิ่มความเร็วของระบบ
        </p>
        <div class="bg-amber-50 border border-amber-200 rounded p-3 mb-5 text-[11px] text-amber-800">
            <strong>⚠️ ปลอดภัยสูง (Fail-Safe):</strong> หาก Google Sheet บันทึกไม่สำเร็จ ระบบจะยกเลิกการลบใน Database ทันที ข้อมูลจะไม่สูญหาย
        </div>
        <div class="flex justify-end gap-2">
            <button type="button" onclick="closeArchiveModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded border border-slate-200 transition-colors cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" id="confirm-archive-btn" onclick="executeArchiveAndPurge()" style="background-color: #d97706; color: #ffffff !important;" class="px-4 py-2 text-xs font-bold rounded shadow-sm transition-all flex items-center gap-1.5 cursor-pointer hover:opacity-90 border-none">
                <span style="color: #ffffff !important; font-weight: 700;">ยืนยันการสำรองและลบข้อมูล</span>
            </button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

<script>
function executeBackup() {
    const btn = document.getElementById("backup-btn");
    btn.disabled = true;
    btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span style="color:#ffffff;font-weight:700;">กำลังสำรองข้อมูล...</span>`;

    fetch('/Home/BackupDatabase', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(async response => {
        if (!response.ok) {
            const err = await response.json().catch(() => ({ error: 'เกิดข้อผิดพลาดในการดาวน์โหลด' }));
            throw new Error(err.error || 'Server error ' + response.status);
        }
        const disposition = response.headers.get('Content-Disposition') || '';
        let filename = 'CostFlow_Backup.zip';
        const match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
        if (match && match[1]) {
            filename = match[1].replace(/['"]/g, '');
        }
        return response.blob().then(blob => ({ blob, filename }));
    })
    .then(({ blob, filename }) => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(url);

        btn.disabled = false;
        btn.innerHTML = `<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg><span style="color:#ffffff;font-weight:700;">ดาวน์โหลด Backup ทั้งหมด (.ZIP)</span>`;
        if (typeof showToast === 'function') showToast('ดาวน์โหลด Backup สำเร็จ! (' + filename + ')', 'success');
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg><span style="color:#ffffff;font-weight:700;">ดาวน์โหลด Backup ฐานข้อมูล</span>`;
        if (typeof showToast === 'function') showToast(err.message || 'เกิดข้อผิดพลาดในการ Backup', 'error');
        else alert(err.message || 'เกิดข้อผิดพลาดในการ Backup');
    });
}

function executeSyncToGoogleSheets() {
    const btn = document.getElementById("sync-sheet-btn");
    const originalHtml = btn.innerHTML;

    if (typeof Swal !== 'undefined') {
        Swal.fire({
            title: 'ส่งข้อมูลลง Google Sheet?',
            text: 'ระบบจะกวาดข้อมูลค่าใช้จ่ายและบันทึกการรับของประจำเดือนทั้งหมดจาก Database ไปอัปเดตบน Google Sheet',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '🚀 เริ่มส่งข้อมูล',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#059669',
            cancelButtonColor: '#64748b'
        }).then((result) => {
            if (result.isConfirmed) {
                performSync();
            }
        });
    } else {
        if (confirm("ต้องการส่งข้อมูลทั้งหมดไปยัง Google Sheet หรือไม่?")) {
            performSync();
        }
    }

    function performSync() {
        btn.disabled = true;
        btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span style="color:#ffffff;font-weight:700;">กำลังส่งข้อมูลไปยัง Google Sheet...</span>`;

        fetch('/Home/SyncAllToGoogleSheets', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;

            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'ส่งข้อมูลลง Google Sheet สำเร็จ!',
                        html: `
                            <div class="text-left text-xs text-slate-600 space-y-2 mt-2">
                                <p><b>📊 จำนวนข้อมูลที่ส่ง:</b> ${data.totalActions || 0} รายการ</p>
                                <p><b>📅 จำนวนเดือนที่อัปเดต:</b> ${data.totalMonths || 0} เดือน</p>
                                <p class="text-emerald-700 bg-emerald-50 p-2 rounded border border-emerald-200 mt-2">
                                    ✅ ข้อมูลใน Google Sheet แท็บ <b>"บันทึกการรับของประจำเดือน"</b> ได้รับการอัปเดตเรียบร้อยแล้ว
                                </p>
                            </div>
                        `,
                        confirmButtonColor: '#059669',
                        confirmButtonText: 'ตกลง'
                    });
                } else if (typeof showToast === 'function') {
                    showToast(data.message || 'ส่งข้อมูลลง Google Sheet สำเร็จ!', 'success');
                }
            } else {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: data.error || 'ไม่สามารถส่งข้อมูลไปยัง Google Sheet ได้'
                    });
                } else if (typeof showToast === 'function') {
                    showToast(data.error || 'ไม่สามารถส่งข้อมูลไปยัง Google Sheet ได้', 'error');
                }
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'เชื่อมต่อล้มเหลว',
                    text: err.message || 'เกิดข้อผิดพลาดในการเชื่อมต่อเครือข่าย'
                });
            } else if (typeof showToast === 'function') {
                showToast(err.message || 'เกิดข้อผิดพลาดในการเชื่อมต่อเครือข่าย', 'error');
            }
        });
    }
}

function openArchiveModal() {
    document.getElementById("archive-modal").classList.remove("hidden");
}

function closeArchiveModal() {
    document.getElementById("archive-modal").classList.add("hidden");
}

function executeArchiveAndPurge() {
    const btn = document.getElementById("confirm-archive-btn");
    btn.disabled = true;
    btn.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span style="color:#ffffff;">กำลังประมวลผล...</span>`;

    fetch('/Home/ArchiveAndPurge', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
        btn.disabled = false;
        btn.innerHTML = `<span style="color: #ffffff !important; font-weight: 700;">ยืนยันการสำรองและลบข้อมูล</span>`;
        closeArchiveModal();

        if (data.success) {
            // กรณีไม่มีข้อมูลที่เก่าเกิน 2 ปี (ไม่มีอะไรต้องลบ)
            if (data.purged === 0 && data.archived === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'info',
                        title: 'ไม่พบข้อมูลที่เก่าเกิน 2 ปี',
                        html: `
                            <div class="text-left text-xs text-slate-600 space-y-2 mt-2 leading-relaxed">
                                <p>ข้อมูลทั้งหมดในฐานข้อมูลของคุณอยู่ในช่วง <b>24 เดือนล่าสุด</b> ยังไม่มีรายการเก่าที่ต้องย้ายลง Google Sheet หรือลบออกจากระบบครับ</p>
                                <p class="text-slate-400 text-[11px] mt-2">* หากต้องการดาวน์โหลดสำรองข้อมูลปัจจุบันทั้งหมด สามารถกดปุ่ม <b>"ดาวน์โหลด Backup ทั้งหมด (.ZIP)"</b> ด้านบนได้ทันทีครับ</p>
                            </div>
                        `,
                        confirmButtonColor: '#2563eb'
                    });
                } else if (typeof showToast === 'function') {
                    showToast("ไม่พบข้อมูลเก่าเกิน 2 ปีในระบบ", "info");
                }
                return;
            }

            let directDownloadLink = '';

            // 💾 ดาวน์โหลดไฟล์สำรองอัตโนมัติลงเครื่องทันที (Purged Archive Backup)
            if (data.backupJson) {
                const blob = new Blob([data.backupJson], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const dlName = data.backupFileName || 'CostFlow_PurgedArchive.json';

                const a = document.createElement('a');
                a.href = url;
                a.download = dlName;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    a.remove();
                }, 1000);

                directDownloadLink = `
                    <div class="mt-3 pt-2.5 border-t border-slate-200 flex items-center justify-between">
                        <span class="text-[11px] text-slate-500">หากเบราว์เซอร์ไม่ดาวน์โหลดอัตโนมัติ:</span>
                        <a href="${url}" download="${dlName}" class="text-xs font-bold text-blue-600 hover:text-blue-800 underline flex items-center gap-1">
                            📥 คลิกดาวน์โหลดไฟล์สำรอง
                        </a>
                    </div>
                `;
            }

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'สำรองและล้างข้อมูลสำเร็จ!',
                    html: `
                        <div class="text-left text-xs text-slate-600 space-y-2 mt-2">
                            <p><b>📊 ย้ายลง Google Sheets สำรอง:</b> ${data.archived} แถว</p>
                            <p><b>🗑️ ลบข้อมูลเก่าออกจากฐานข้อมูล:</b> ${data.purged} รายการ</p>
                            <p><b>💾 ไฟล์สำรอง JSON:</b> <span class="text-blue-600 font-mono bg-blue-50 px-1 py-0.5 rounded border border-blue-200">${data.backupFileName || 'PurgedArchive.json'}</span> (เริ่มดาวน์โหลดลงเครื่องเรียบร้อยแล้ว)</p>
                            ${directDownloadLink}
                        </div>
                    `,
                    confirmButtonColor: '#2563eb'
                });
            } else if (typeof showToast === 'function') {
                showToast(data.message || "สำรองข้อมูลและลบรายการเก่าเรียบร้อย พร้อมดาวน์โหลดไฟล์สำรองแล้ว!", "success");
            }
        } else {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: data.error || 'เกิดข้อผิดพลาดในการสำรองข้อมูล'
                });
            } else if (typeof showToast === 'function') {
                showToast(data.error || "เกิดข้อผิดพลาดในการสำรองข้อมูล", "error");
            }
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = `<span style="color: #ffffff !important; font-weight: 700;">ยืนยันการสำรองและลบข้อมูล</span>`;
        closeArchiveModal();
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาดในการเชื่อมต่อ',
                text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'
            });
        } else if (typeof showToast === 'function') {
            showToast("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์", "error");
        }
    });
}

document.addEventListener("DOMContentLoaded", function() {
    function showToast(message, type = 'error') {
        const container = document.getElementById("toast-container");
        const toast = document.createElement("div");
        toast.className = `px-4 py-3 rounded shadow-lg text-xs font-semibold flex items-center gap-2 transform translate-y-2 opacity-0 transition-all duration-300 pointer-events-auto max-w-sm ${
            type === 'success' 
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
                : 'bg-rose-50 text-rose-800 border border-rose-200'
        }`;
        
        const icon = type === 'success'
            ? `<svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            : `<svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;

        toast.innerHTML = `${icon}<span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(() => {
            toast.classList.remove("translate-y-2", "opacity-0");
        }, 10);

        setTimeout(() => {
            toast.classList.add("opacity-0", "translate-y-2");
            setTimeout(() => {
                toast.remove();
            }, 300);
        }, 3000);
    }
    window.showToast = showToast;
});
</script>
