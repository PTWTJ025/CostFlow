@model CostFlow.Controllers.HomeDashboardViewModel
@{
    ViewData["Title"] = "หน้าหลัก";
    ViewData["HeaderTitle"] = "หน้าหลัก (Dashboard)";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-xl max-w-[1440px] mx-auto w-full">

    <!-- Welcome Header / Hero Banner -->
    <div class="bg-gradient-to-r from-primary to-primary-container text-white rounded border border-outline-variant shadow-sm p-lg h-56 relative overflow-hidden flex justify-between items-center fade-in-up">
        <div class="z-10 max-w-xl">
            <div class="flex items-center gap-2 mb-2">
                <h2 class="font-headline-md text-headline-md font-bold">ระบบบริหารจัดการและวิเคราะห์ต้นทุน (DEMO)</h2>
            </div>
            <p class="text-xs text-white/80 leading-relaxed mb-3">ยินดีต้อนรับสู่แดชบอร์ดสรุปผลการจับคู่ใบสั่งงานผลิตอะไหล่, เปรียบเทียบใบขออนุมัติ, ตรวจสอบข้อมูลราคากลางประวัติจัดซื้อย้อนหลัง และบันทึกคำสั่งซื้อโรงงานครบวงจร</p>
            <style>
                @@keyframes dotBlinkWhite {
                    0%, 100% {
                        opacity: 1;
                        transform: scale(1.15);
                        box-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
                    }
                    50% {
                        opacity: 0.2;
                        transform: scale(0.75);
                        box-shadow: 0 0 1px rgba(255, 255, 255, 0);
                    }
                }
            
                .dot-blink-white {
                    display: inline-block;
                    width: 9px;
                    height: 9px;
                    background-color: #ffffff;
                    border-radius: 50%;
                    animation: dotBlinkWhite 2.4s infinite ease-in-out;
                }
            </style>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium bg-white/10 backdrop-blur-sm border border-white/20 text-white shadow-xs">
                <span class="dot-blink-white"></span>
                <span>อัปเดตข้อมูลสถิติอัตโนมัติทุก 15 วินาที</span>
            </div>
        </div>
        <div class="hidden lg:block z-0 opacity-10 absolute right-10 top-0 bottom-0 flex items-center">
            <img src="~/images/logo.png" alt="CostFlow Logo" class="w-64 h-64 object-contain" />
        </div>
    </div>

    <!-- Quick Stats Metric Row -->
    <section aria-label="สถิติข้อมูล" class="bg-surface-container-lowest rounded-lg border border-outline-variant/60 shadow-sm overflow-hidden">
        <div class="grid grid-cols-2 lg:grid-cols-4">
            <!-- Stat 1: Merged Reports -->
            <a href="/Report"
               class="group flex items-start gap-md px-md md:px-lg py-md md:py-lg border-b lg:border-b-0 border-r border-outline-variant/60 hover:bg-primary/5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
                <i data-lucide="file-check-2" class="w-6 h-6 text-primary flex-shrink-0" aria-hidden="true"></i>
                <div class="min-w-0">
                    <div id="stat-merged-reports" class="font-headline-sm text-headline-sm text-on-surface tabular-nums tracking-tight leading-none group-hover:text-primary transition-colors">
                        @Model.TotalMergedReports.ToString("N0")
                    </div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant mt-1 truncate">รายงานที่บันทึก</div>
                </div>
            </a>

            <!-- Stat 2: Yearly Cost / Expense -->
            <a href="/MonthlyCost"
               class="group flex items-start gap-md px-md md:px-lg py-md md:py-lg border-b lg:border-b-0 lg:border-r border-outline-variant/60 hover:bg-primary/5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
                <i data-lucide="coins" class="w-6 h-6 text-primary flex-shrink-0" aria-hidden="true"></i>
                <div class="min-w-0">
                    <div id="stat-yearly-cost" class="font-headline-sm text-headline-sm text-on-surface tabular-nums tracking-tight leading-none truncate group-hover:text-primary transition-colors">
                        ฿@Model.TotalYearlyCost.ToString("N0")
                    </div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant mt-1 truncate">ค่าใช้จ่ายประจำปี</div>
                </div>
            </a>

            <!-- Stat 3: Saved Spare Part Orders -->
            <a href="/FileMerge"
               class="group flex items-start gap-md px-md md:px-lg py-md md:py-lg border-r border-outline-variant/60 hover:bg-primary/5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
                <i data-lucide="shopping-cart" class="w-6 h-6 text-primary flex-shrink-0" aria-hidden="true"></i>
                <div class="min-w-0">
                    <div id="stat-spare-orders" class="font-headline-sm text-headline-sm text-on-surface tabular-nums tracking-tight leading-none group-hover:text-primary transition-colors">
                        @Model.TotalSparePartOrders.ToString("N0")
                    </div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant mt-1 truncate">รายการสั่งซื้อสะสม</div>
                </div>
            </a>

            <!-- Stat 4: Reference Prices count -->
            <a href="/PriceReference"
               class="group flex items-start gap-md px-md md:px-lg py-md md:py-lg hover:bg-primary/5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
                <i data-lucide="database" class="w-6 h-6 text-primary flex-shrink-0" aria-hidden="true"></i>
                <div class="min-w-0">
                    <div id="stat-ref-prices" class="font-headline-sm text-headline-sm text-on-surface tabular-nums tracking-tight leading-none group-hover:text-primary transition-colors">
                        @Model.TotalReferencePrices.ToString("N0")
                    </div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant mt-1 truncate">ราคากลางอ้างอิง</div>
                </div>
            </a>
        </div>
    </section>

    <!-- Quick Navigation and Recent Reports -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg lg:gap-xl">

        <!-- Left 2 cols: Main Functions Navigation -->
        <section aria-label="เครื่องมือเข้าใช้งานด่วน" class="lg:col-span-2 flex flex-col gap-md">
            <header>
                <h2 class="font-headline-sm text-headline-sm text-on-surface mb-xs">เข้าใช้งานด่วน</h2>
                <!--    <p class="font-body-md text-body-md text-on-surface-variant">เลือกทำรายการที่คุณต้องการได้อย่างรวดเร็ว</p> -->
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                <!-- Nav Card 1 -->
                <a href="/FileMerge" class="group flex gap-md items-start p-md lg:p-lg rounded bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">นำเข้าและจับคู่ข้อมูลการผลิต</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">ตรวจสอบและเปรียบเทียบยอดผลิตจริง กับใบเป้าหมายส่งมอบประจำสัปดาห์</p>
                    </div>
                </a>

                <!-- Nav Card 2 -->
                <a href="/ProductSearch" class="group flex gap-md items-start p-md lg:p-lg rounded bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3v3m-7.5-6v6m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">จำลองและคำนวณค่าใช้จ่ายจัดซื้อ</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">เพิ่มรายการเบิกอะไหล่ และเปรียบเทียบกับราคากลางเพื่อหาต้นทุนทันที</p>
                    </div>
                </a>

                <!-- Nav Card 3 -->
                <a href="/Report" class="group flex gap-md items-start p-md lg:p-lg rounded-lg bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3h7.5M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6.75A2.25 2.25 0 0 0 18 4.5H6A2.25 2.25 0 0 0 3.75 6.75v11.25A2.25 2.25 0 0 0 6 20.25Z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">ประวัติรายงานและสรุปยอด</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">ดูรายงานย้อนหลังและส่งออกข้อมูลสรุปเป็นไฟล์ Excel สำหรับบัญชี</p>
                    </div>
                </a>

                <!-- Nav Card 4 -->
                <a href="/PriceReference" class="group flex gap-md items-start p-md lg:p-lg rounded-lg bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h16.5m-18 3h18M3.75 10.5h16.5M3.75 13.5h16.5M7.5 12h-.008v.008H7.5V12Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm-.375 3h-.008v.008H7.5V15Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm9.625-3h-.008v.008h-.008V12Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm-.375 3h-.008v.008h-.008V15Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">สืบค้นข้อมูลราคากลางอะไหล่</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">ตรวจสอบราคามาตรฐานของอะไหล่แต่ละรายการได้อย่างสะดวกรวดเร็ว</p>
                    </div>
                </a>
            </div>
        </section>

        <!-- Right 1 col: Recent Saved Reports -->
        <section aria-label="รายงานล่าสุด" class="flex flex-col gap-md">
            <header class="flex justify-between items-end mb-xs">
                <h2 class="font-headline-sm text-headline-sm text-on-surface">รายงานล่าสุด</h2>
                <a href="/Report" class="font-label-bold text-label-bold text-primary hover:text-primary-container hover:underline focus-visible:outline-none focus-visible:underline">ดูทั้งหมด</a>
            </header>

            <div class="flex flex-col gap-sm flex-1" id="recent-reports-container">
                @if (Model.RecentReports == null || !Model.RecentReports.Any())
                {
                    <div class="flex flex-col items-center justify-center flex-1 p-lg bg-surface-container-lowest rounded-lg border border-dashed border-outline-variant/80 text-center min-h-[200px] shadow-sm">
                        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-3">
                            <i data-lucide="folder-open" class="w-6 h-6"></i>
                        </div>
                        <h3 class="font-label-bold text-label-bold text-on-surface mb-1">ยังไม่มีรายงานในระบบ</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4">เริ่มต้นตรวจสอบต้นทุนโดยเปรียบเทียบข้อมูลไฟล์ผลิตของคุณ</p>
                        <a href="/FileMerge" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white font-label-bold text-label-sm px-4 py-2 rounded-md transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                            <span>สร้างรายงานใหม่</span>
                        </a>
                    </div>
                }
                else
                {
                    foreach (var r in Model.RecentReports)
                    {
                        double acc = r.TotalRows > 0 ? Math.Round((double)r.MatchedRows / r.TotalRows * 100, 1) : 0;
                        string formattedDate = r.CreatedAt.ToString("MMMM yyyy", new System.Globalization.CultureInfo("th-TH"));

                        <a href="/Report" class="group p-md border border-outline-variant/60 rounded bg-surface-container-lowest hover:bg-primary/5 hover:border-primary/40 transition-colors flex flex-col gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 shadow-sm">
                            <div class="flex justify-between items-start">
                                <time datetime="@r.CreatedAt.ToString("O")" class="font-data-tabular text-data-tabular text-secondary">ประจำเดือน @formattedDate</time>
                                <span class="font-label-bold text-[10px] text-primary opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
                                    เปิด
                                    <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                                </span>
                            </div>
                            <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors truncate" title="@Html.Raw(r.ReportName)">
                                @Html.Raw(r.ReportName)
                            </h3>

                            <div class="flex justify-between items-center mt-1">
                                <span class="font-body-md text-body-md text-on-surface-variant">ตรงตามใบเป้าหมายส่งมอบ @r.MatchedRows / @r.TotalRows</span>
                                <span class="bg-primary/10 text-primary font-data-tabular text-[11px] px-2 py-0.5 rounded-sm inline-flex items-center">@acc%</span>
                            </div>
                        </a>
                    }
                }
            </div>
        </section>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- Periodic Polling (Auto-fetch every 15 seconds) ---
        const POLLING_INTERVAL_MS = 15000; // 15 วินาที

        function fetchDashboardStats() {
            fetch('/Home/GetDashboardApiStats')
                .then(res => {
                    if (!res.ok) throw new Error("HTTP error " + res.status);
                    return res.json();
                })
                .then(data => {
                    // Update stat metric cards
                    const elReports = document.getElementById("stat-merged-reports");
                    if (elReports) elReports.textContent = Number(data.totalMergedReports).toLocaleString();

                    const elCost = document.getElementById("stat-yearly-cost");
                    if (elCost) elCost.textContent = "฿" + (data.formattedTotalYearlyCost || Number(data.totalYearlyCost).toLocaleString());

                    const elOrders = document.getElementById("stat-spare-orders");
                    if (elOrders) elOrders.textContent = Number(data.totalSparePartOrders).toLocaleString();

                    const elPrices = document.getElementById("stat-ref-prices");
                    if (elPrices) elPrices.textContent = Number(data.totalReferencePrices).toLocaleString();

                    // Update recent reports
                    const container = document.getElementById("recent-reports-container");
                    if (container && data.recentReports) {
                        if (data.recentReports.length === 0) {
                            container.innerHTML = `
                                <div class="flex flex-col items-center justify-center flex-1 p-lg bg-surface-container-lowest rounded-lg border border-dashed border-outline-variant/80 text-center min-h-[200px] shadow-sm">
                                    <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-3">
                                        <i data-lucide="folder-open" class="w-6 h-6"></i>
                                    </div>
                                    <h3 class="font-label-bold text-label-bold text-on-surface mb-1">ยังไม่มีรายงานในระบบ</h3>
                                    <p class="font-body-md text-body-md text-on-surface-variant mb-4">เริ่มต้นตรวจสอบต้นทุนโดยเปรียบเทียบข้อมูลไฟล์ผลิตของคุณ</p>
                                    <a href="/FileMerge" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white font-label-bold text-label-sm px-4 py-2 rounded-md transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                                        <span>สร้างรายงานใหม่</span>
                                    </a>
                                </div>`;
                        } else {
                            let html = "";
                            data.recentReports.forEach(r => {
                                html += `
                                    <a href="${r.detailsUrl}" class="group p-md border border-outline-variant/60 rounded bg-surface-container-lowest hover:bg-primary/5 hover:border-primary/40 transition-colors flex flex-col gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 shadow-sm">
                                        <div class="flex justify-between items-start">
                                            <time class="font-data-tabular text-data-tabular text-secondary">${r.formattedDate}</time>
                                            <span class="font-label-bold text-[10px] text-primary opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
                                                เปิด
                                                <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                                            </span>
                                        </div>
                                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors truncate" title="${r.reportName}">
                                            ${r.reportName}
                                        </h3>
                                        <div class="flex justify-between items-center mt-1">
                                            <span class="font-body-md text-body-md text-on-surface-variant">ตรงตามใบเป้าหมายส่งมอบ ${r.matchedRows} / ${r.totalRows}</span>
                                            <span class="bg-primary/10 text-primary font-data-tabular text-[11px] px-2 py-0.5 rounded-sm inline-flex items-center">${r.accuracy}%</span>
                                        </div>
                                    </a>`;
                            });
                            container.innerHTML = html;
                        }
                        if (typeof lucide !== 'undefined') {
                            lucide.createIcons();
                        }
                    }
                })
                .catch(err => console.error("Periodic Polling Error:", err));
        }

        // เริ่มต้นวนลูปดึงข้อมูลสถิติล่าสุดทุกๆ 15 วินาที
        setInterval(fetchDashboardStats, POLLING_INTERVAL_MS);
    });
</script>
