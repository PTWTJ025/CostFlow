@model CostFlow.Controllers.HomeDashboardViewModel
@{
    ViewData["Title"] = "หน้าหลัก";
    ViewData["HeaderTitle"] = "หน้าหลัก (Dashboard)";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-xl max-w-[1440px] mx-auto w-full">

    <!-- Welcome Header / Hero Banner -->
    <div class="bg-gradient-to-r from-primary to-primary-container text-white rounded border border-outline-variant shadow-sm p-lg h-56 relative overflow-hidden flex justify-between items-center fade-in-up">
        <div class="z-10 max-w-xl">
            <h2 class="font-headline-md text-headline-md font-bold mb-xs">ระบบบริหารจัดการและวิเคราะห์ต้นทุน (DEMO)</h2>
            <p class="text-xs text-white/80 leading-relaxed">ยินดีต้อนรับสู่แดชบอร์ดสรุปผลการจับคู่ใบสั่งงานผลิตอะไหล่, เปรียบเทียบใบขออนุมัติ, ตรวจสอบข้อมูลราคากลางประวัติจัดซื้อย้อนหลัง และบันทึกคำสั่งซื้อโรงงานครบวงจร</p>
        </div>
        <div class="hidden lg:block z-0 opacity-10 absolute right-10 top-0 bottom-0 flex items-center">
            <svg class="w-64 h-64 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"/>
            </svg>
        </div>
    </div>

    <!-- Quick Stats Metric Row -->
    <section aria-label="สถิติข้อมูล" class="grid grid-cols-2 lg:grid-cols-4 gap-sm md:gap-md mt-6">
        <!-- Stat 1: Merged Reports -->
        <a href="/Report" class="bg-blue-50/60 rounded-lg border border-blue-200/80 px-md py-sm flex items-center gap-sm relative hover:bg-blue-50 transition-colors group">
            <div class="w-9 h-9 rounded-md bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fi fi-rs-document-signed text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="font-headline-sm text-headline-sm text-blue-900 tabular-nums tracking-tight leading-none">@Model.TotalMergedReports.ToString("N0")</div>
                <div class="font-label-sm text-label-sm text-blue-700/70 mt-0.5 truncate">รายงานที่บันทึก</div>
            </div>
        </a>

        <!-- Stat 2: Yearly Cost / Expense -->
        <a href="/MonthlyCost" class="bg-purple-50/60 rounded-lg border border-purple-200/80 px-md py-sm flex items-center gap-sm relative hover:bg-purple-50 transition-colors group">
            <div class="w-9 h-9 rounded-md bg-purple-100 flex items-center justify-center text-purple-600 flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fi fi-rs-coins text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="font-headline-sm text-headline-sm text-purple-900 tabular-nums tracking-tight leading-none truncate">฿@Model.TotalYearlyCost.ToString("N0")</div>
                <div class="font-label-sm text-label-sm text-purple-700/70 mt-0.5 truncate">ค่าใช้จ่ายประจำปี</div>
            </div>
        </a>

        <!-- Stat 3: Saved Spare Part Orders -->
        <a href="/FileMerge" class="bg-sky-50/60 rounded-lg border border-sky-200/80 px-md py-sm flex items-center gap-sm relative hover:bg-sky-50 transition-colors group">
            <div class="w-9 h-9 rounded-md bg-sky-100 flex items-center justify-center text-sky-600 flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fi fi-rs-shopping-cart text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="font-headline-sm text-headline-sm text-sky-900 tabular-nums tracking-tight leading-none">@Model.TotalSparePartOrders.ToString("N0")</div>
                <div class="font-label-sm text-label-sm text-sky-700/70 mt-0.5 truncate">รายการสั่งซื้อสะสม</div>
            </div>
        </a>

        <!-- Stat 4: Reference Prices count -->
        <a href="/PriceReference" class="bg-amber-50/60 rounded-lg border border-amber-200/80 px-md py-sm flex items-center gap-sm relative hover:bg-amber-50 transition-colors group">
            <div class="w-9 h-9 rounded-md bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fi fi-rs-database text-base"></i>
            </div>
            <div class="min-w-0">
                <div class="font-headline-sm text-headline-sm text-amber-900 tabular-nums tracking-tight leading-none">@Model.TotalReferencePrices.ToString("N0")</div>
                <div class="font-label-sm text-label-sm text-amber-700/70 mt-0.5 truncate">ราคากลางอ้างอิง</div>
            </div>
        </a>
    </section>

    <!-- Quick Navigation and Recent Reports -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg lg:gap-xl mt-6">

        <!-- Left 2 cols: Main Functions Navigation -->
        <section aria-label="เครื่องมือเข้าใช้งานด่วน" class="lg:col-span-2 flex flex-col gap-md">
            <header>
                <h2 class="font-headline-sm text-headline-sm text-on-surface mb-xs">เข้าใช้งานด่วน</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">เลือกทำรายการที่คุณต้องการได้อย่างรวดเร็ว</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-md mt-2">
                <!-- Nav Card 1 -->
                <a href="/FileMerge" class="group flex gap-md items-start p-md lg:p-lg rounded-lg bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">นำเข้า & เปรียบเทียบข้อมูลไฟล์ผลิต</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">เปรียบเทียบข้อมูลแผนผลิตประจำสัปดาห์ เข้ากับใบขออนุมัติสั่งผลิตชิ้นส่วน</p>
                    </div>
                </a>

                <!-- Nav Card 2 -->
                <a href="/ProductSearch" class="group flex gap-md items-start p-md lg:p-lg rounded-lg bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3v3m-7.5-6v6m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">คีย์ข้อมูลใบสั่งซื้ออะไหล่โรงงาน</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">คีย์ข้อมูลรายการซื้ออะไหล่แบบร่าง พร้อมระบบเทียบราคากลางทันที</p>
                    </div>
                </a>

                <!-- Nav Card 3 -->
                <a href="/Report" class="group flex gap-md items-start p-md lg:p-lg rounded-lg bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.03 0 1.9.693 2.166 1.638m-7.377 2.24a4.008 4.008 0 0 1 1.953-3.238"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">คลังข้อมูลและสรุปรายงานทางการเงิน</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">ตรวจสอบความถูกต้องย้อนหลัง และส่งออกข้อมูลเป็น Excel</p>
                    </div>
                </a>

                <!-- Nav Card 4 -->
                <a href="/PriceReference" class="group flex gap-md items-start p-md lg:p-lg rounded-lg bg-surface-container-lowest border border-outline-variant/60 hover:bg-primary/5 hover:border-primary/40 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                    <div class="w-12 h-12 rounded-md bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h16.5m-18 3h18M3.75 10.5h16.5M3.75 13.5h16.5M7.5 12h-.008v.008H7.5V12Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm-.375 3h-.008v.008H7.5V15Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm9.625-3h-.008v.008h-.008V12Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Zm-.375 3h-.008v.008h-.008V15Zm.375 0a.375 .375 0 1 1 -.75 0 .375 .375 0 0 1 .75 0Z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors mb-1">สืบค้นฐานข้อมูลราคากลางอะไหล่</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">สืบค้นและตรวจสอบฐานข้อมูลด้วยระบบ AJAX ทันทีขณะพิมพ์</p>
                    </div>
                </a>
            </div>
        </section>

        <!-- Right 1 col: Recent Saved Reports -->
        <section aria-label="รายงานล่าสุด" class="flex flex-col gap-md">
            <header class="flex justify-between items-end mb-xs">
                <h2 class="font-headline-sm text-headline-sm text-on-surface">รายงานล่าสุด</h2>
                <a href="/Report" class="font-label-bold text-label-bold text-primary hover:text-primary-container hover:underline focus-visible:outline-none focus-visible:underline">ดูทั้งหมด</a>
            </header>

            <div class="flex flex-col gap-sm flex-1">
                @if (Model.RecentReports == null || !Model.RecentReports.Any())
                {
                    <div class="flex flex-col items-center justify-center flex-1 p-lg bg-surface-container-lowest rounded-lg border border-dashed border-outline-variant/80 text-center min-h-[200px] shadow-sm">
                        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-3">
                            <i class="fi fi-rs-folder-open text-xl"></i>
                        </div>
                        <h3 class="font-label-bold text-label-bold text-on-surface mb-1">ยังไม่มีรายงานในระบบ</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4">เริ่มต้นตรวจสอบต้นทุนโดยเปรียบเทียบข้อมูลไฟล์ผลิตของคุณ</p>
                        <a href="/FileMerge" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white font-label-bold text-label-sm px-4 py-2 rounded-md transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                            <span>สร้างรายงานใหม่</span>
                            <i class="fi fi-rs-arrow-right"></i>
                        </a>
                    </div>
                }
                else
                {
                    foreach (var r in Model.RecentReports)
                    {
                        double acc = r.TotalRows > 0 ? Math.Round((double)r.MatchedRows / r.TotalRows * 100, 1) : 0;
                        string formattedDate = r.CreatedAt.ToString("dd MMM yyyy HH:mm น.", new System.Globalization.CultureInfo("th-TH"));

                        <a href="@Url.Action("Details", "Report", new { fileName = r.ReportName })" class="group p-md border border-outline-variant/60 rounded-lg bg-surface-container-lowest hover:bg-primary/5 hover:border-primary/40 transition-colors flex flex-col gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 shadow-sm">
                            <div class="flex justify-between items-start">
                                <time datetime="@r.CreatedAt.ToString("O")" class="font-data-tabular text-data-tabular text-secondary">@formattedDate</time>
                                <span class="font-label-bold text-[10px] text-primary opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
                                    เปิด
                                    <i class="fi fi-rs-arrow-up-right"></i>
                                </span>
                            </div>
                            <h3 class="font-label-bold text-label-bold text-on-surface group-hover:text-primary transition-colors truncate" title="@Html.Raw(r.ReportName)">
                                @Html.Raw(r.ReportName)
                            </h3>

                            <div class="flex justify-between items-center mt-1">
                                <span class="font-body-md text-body-md text-on-surface-variant">ตรงตามแผน @r.MatchedRows / @r.TotalRows</span>
                                <span class="bg-primary/10 text-primary font-data-tabular text-[11px] px-2 py-0.5 rounded-sm inline-flex items-center">@acc%</span>
                            </div>
                        </a>
                    }
                }
            </div>
        </section>

    </div>
</div>

