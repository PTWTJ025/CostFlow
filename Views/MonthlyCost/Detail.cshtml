        // ─── Search & Filter (Multi-PO keyword support) ──────────────────────────────
        function getSearchKeywords() {
            const searchInput = document.getElementById('search-pending');
            if (!searchInput) return [];
            const raw = searchInput.value.toLowerCase().trim();
            if (!raw) return [];
            // แยกคำค้นหาด้วย การขึ้นบรรทัดใหม่ (Excel), ลูกน้ำ (,), อัฒภาค (;), แท็บ (\t) (ไม่แยกด้วยช่องว่าง)
            return raw.split(/[\n\r\t,;]+/).map(k => k.trim()).filter(k => k.length > 0);
        }

        function clearSearchInput() {
            const searchInput = document.getElementById('search-pending');
            if (searchInput) {
                searchInput.value = '';
                toggleClearSearchBtn();
                applyPendingFilters();
                applySavedFilters();
                searchInput.focus();
            }
        }

        function toggleClearSearchBtn() {
            const searchInput = document.getElementById('search-pending');
            const clearBtn = document.getElementById('clear-search-btn');
            if (clearBtn && searchInput) {
                clearBtn.style.display = searchInput.value.trim().length > 0 ? 'block' : 'none';
            }
        }

        function applyPendingFilters() {
            const select = document.getElementById('pending-sort-select');
            const filterType = select ? select.value : 'default';
            const keywords = getSearchKeywords();

            let visible = 0;
            let totalAmount = 0;
            document.querySelectorAll('.order-card').forEach(card => {
                const po = card.dataset.poNumber ? card.dataset.poNumber.toLowerCase() : '';
                const name = card.dataset.orderName ? card.dataset.orderName.toLowerCase() : '';
                
                // Multi-keyword OR search: ถ้าตรงกับเลขใดเลขหนึ่งที่ค้นหา
                const matchSearch = keywords.length === 0 || keywords.some(k => po.includes(k) || name.includes(k));

                const fwdStatus = card.getAttribute('data-forwarded-status') || '';
                let matchType = true;
                if (filterType === 'this-month') matchType = (fwdStatus === '');
                else if (filterType === 'deferred') matchType = (fwdStatus === 'Deferred');
                else if (filterType === 'requested') matchType = (fwdStatus === 'Requested');
                else if (filterType === 'skipped') matchType = (fwdStatus === 'Skipped');

                if (matchSearch && matchType) {
                    card.style.display = '';
                    visible++;
                    const price = parseFloat(card.dataset.price) || 0;
                    totalAmount += price;
                } else {
                    card.style.display = 'none';
                }
            });
            const countEl = document.getElementById('tab-pending-count');
            if (countEl) countEl.textContent = visible;

            const totalAmountEl = document.getElementById('filtered-total-amount');
            const totalContainerEl = document.getElementById('filtered-total-container');
            if (totalAmountEl && totalContainerEl) {
                totalAmountEl.textContent = new Intl.NumberFormat('th-TH', { style: 'currency', currency: 'THB', minimumFractionDigits: 2 }).format(totalAmount);
                
                totalContainerEl.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-md border shadow-sm transition-colors duration-300';
                
                if (filterType === 'deferred') {
                    totalContainerEl.classList.add('bg-amber-50', 'text-amber-700', 'border-amber-100');
                } else if (filterType === 'requested') {
                    totalContainerEl.classList.add('bg-blue-50', 'text-blue-700', 'border-blue-100');
                } else if (filterType === 'skipped') {
                    totalContainerEl.classList.add('bg-purple-50', 'text-purple-700', 'border-purple-100');
                } else {
                    totalContainerEl.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-100');
                }
            }
            onCardCheckboxChange();
        }

        function applySavedFilters() {
            const select = document.getElementById('saved-action-select');
            const filterAction = select ? select.value : 'all';
            const keywords = getSearchKeywords();

            let visible = 0;
            document.querySelectorAll('.saved-card').forEach(card => {
                const po = card.dataset.poNumber ? card.dataset.poNumber.toLowerCase() : '';
                const name = card.dataset.orderName ? card.dataset.orderName.toLowerCase() : '';
                
                // Multi-keyword OR search: ถ้าตรงกับเลขใดเลขหนึ่งที่ค้นหา
                const matchSearch = keywords.length === 0 || keywords.some(k => po.includes(k) || name.includes(k));

                const action = card.dataset.action || '';
                let matchAction = true;
                if (filterAction !== 'all') {
                    matchAction = (action === filterAction);
                }

                if (matchSearch && matchAction) {
                    card.style.display = '';
                    visible++;
                } else {
                    card.style.display = 'none';
                }
            });
            const countEl = document.getElementById('tab-saved-count');
            if (countEl) countEl.textContent = visible;
            onSavedCardCheckboxChange();
        }

        const searchInputEl = document.getElementById('search-pending');
        if (searchInputEl) {
            searchInputEl.addEventListener('input', function () {
                toggleClearSearchBtn();
                applyPendingFilters();
                applySavedFilters();
            });

            // ดักจับเมื่อผู้ใช้ Paste ข้อความ (เช่น ก๊อปจาก Excel หลายบรรทัด)
            searchInputEl.addEventListener('paste', function () {
                setTimeout(() => {
                    toggleClearSearchBtn();
                    applyPendingFilters();
                    applySavedFilters();
                }, 50);
            });
        }

        function bulkAddToCart(action) {
            const checkedBoxes = Array.from(document.querySelectorAll('.pending-card-checkbox')).filter(cb => {
                const card = cb.closest('.order-card');
                return cb.checked && card && card.style.display !== 'none' && !card.classList.contains('in-cart');
            });

            let targetCards = [];
            if (checkedBoxes.length > 0) {
                targetCards = checkedBoxes.map(cb => cb.closest('.order-card'));
            } else {
                targetCards = Array.from(document.querySelectorAll('.order-card')).filter(card => {
                    if (card.style.display === 'none' || card.classList.contains('in-cart')) return false;

                    const fwdStatus = card.getAttribute('data-forwarded-status') || '';

                    if (action === 'Deferred') {
                        return fwdStatus === 'Deferred';
                    } else if (action === 'Skipped') {
                        return fwdStatus === 'Skipped';
                    } else if (action === 'Requested') {
                        return fwdStatus === 'Requested';
                    } else {
                        // ReceivedFull เอาทั้งหมดที่มองเห็นอยู่ ยกเว้น Requested ที่ถูกล็อกรอใบตอบกลับ
                        return fwdStatus !== 'Requested';
                    }
                });
            }

            if (!targetCards.length) return;

            targetCards.forEach(card => {
                const btn = card.querySelector('.add-btn');
                if (btn) {
                    addToCartWithAction(btn, action);
                }
            });

            // รีเซ็ตสถานะ checkbox
            const selectAll = document.getElementById('select-all-pending');
            if (selectAll) selectAll.checked = false;
            document.querySelectorAll('.pending-card-checkbox').forEach(cb => cb.checked = false);
        }

        function addToCartWithAction(btnEl, specifiedAction) {
            const card = btnEl.closest('.order-card');
            const orderId = card.dataset.orderId;

            if (cart[orderId] || card.classList.contains('is-locked-deferred') || card.classList.contains('is-locked-requested')) return;

            let finalAction = specifiedAction || 'ReceivedFull';
            if (card.dataset.forwardedStatus === 'Deferred') {
                finalAction = 'ReceivedFull';
            }

            const itemPrice = parseFloat(card.dataset.price) || 0;
            const item = {
                orderId: orderId,
                poNumber: card.dataset.poNumber,
                orderName: card.dataset.orderName,
                price: itemPrice,
                quantity: parseInt(card.dataset.quantity) || 1,
                department: card.dataset.department,
                delivery: card.dataset.delivery,
                forwardedStatus: card.dataset.forwardedStatus || '',
                forwardedFrom: card.dataset.forwardedFrom || '',
                originalMonth: card.dataset.originalMonth || '',
                action: finalAction,
                actionPrice: finalAction === 'ReceivedFull' ? itemPrice : 0,
                isStockReceived: (finalAction === 'ReceivedFull' || finalAction === 'Deferred')
            };

            cart[orderId] = item;
            card.classList.add('in-cart');
            btnEl.textContent = '✓ เพิ่มแล้ว';

            renderCartItem(orderId);
            document.getElementById('cart-empty').style.display = 'none';

            // ใช้ finalAction เสมอ เพื่อซิงค์ UI และปุ่มให้พร้อมทำงานทันที
            setAction(orderId, finalAction);

            updateSummary();
        }

