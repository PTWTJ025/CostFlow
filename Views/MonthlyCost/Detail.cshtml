                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                customClass: { popup: 'rounded-xl' },
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const resp = await fetch('/MonthlyCost/SaveActions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        monthYear: MONTH_YEAR,
                        allPendingOrderIds: allPendingIds,
                        actions: ids.map(id => ({
                            orderId: cart[id].orderId,
                            action: cart[id].action,
                            price: cart[id].actionPrice
                        })),
                        isCloseMonth: false  // คืนเป็น false - บันทึกเฉพาะรายการที่เลือก
                    })
