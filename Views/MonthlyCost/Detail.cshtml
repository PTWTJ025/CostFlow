                                    <span class="font-bold text-blue-800 text-xs">เฉพาะรายการต้องการรับของ (Requested)</span>
                                    <p class="text-[11px] text-slate-400">รายการที่บันทึกตามแผนขอรับของรอบหน้า (ยังไม่ตัดงบเดือนนี้)</p>
                                </div>
                            </label>
                            <label class="flex items-center gap-2.5 p-2 rounded-lg border border-slate-200 hover:bg-purple-50/50 cursor-pointer transition-all">
                                <input type="radio" name="swal_action_filter" value="Skipped" class="text-purple-600 focus:ring-purple-500 w-4 h-4 cursor-pointer">
                                <div class="flex-1">
                                    <span class="font-bold text-purple-800 text-xs">เฉพาะรายการยังไม่รับสินค้า (Skipped)</span>
                                    <p class="text-[11px] text-slate-400">รายการที่ของยังไม่มา หรือยังรอดำเนินการในรอบถัดไป</p>
                                </div>
                            </label>

                        </div>
                    </div>
                </div>
            `;

            const { value: formValues } = await Swal.fire({
                title: '<span class="text-base font-bold text-slate-800">ตัวเลือกการส่งออก Excel สรุปราคา</span>',
                html: htmlContent,
                showCancelButton: true,
                confirmButtonText: 'ดาวน์โหลด Excel',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                customClass: {
                    popup: 'rounded-xl max-w-lg',
                    confirmButton: 'px-5 py-2 rounded-lg font-bold text-xs shadow-sm',
                    cancelButton: 'px-4 py-2 rounded-lg font-bold text-xs'
                },
                preConfirm: () => {
                    const actionRadio = document.querySelector('input[name="swal_action_filter"]:checked');
                    return {
                        action: actionRadio ? actionRadio.value : 'all',
                        status: 'all'
                    };
                }
            });

            if (formValues) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/MonthlyCost/ExportDetailExcel';
                
                const inputMonth = document.createElement('input');
                inputMonth.type = 'hidden';
                inputMonth.name = 'monthYear';
                inputMonth.value = monthYear;
                form.appendChild(inputMonth);
                
                const inputAction = document.createElement('input');
                inputAction.type = 'hidden';
                inputAction.name = 'actionFilter';
                inputAction.value = formValues.action;
                form.appendChild(inputAction);
                
                const inputStatus = document.createElement('input');
                inputStatus.type = 'hidden';
                inputStatus.name = 'statusFilter';
                inputStatus.value = formValues.status;
                form.appendChild(inputStatus);

                const inputCart = document.createElement('input');
                inputCart.type = 'hidden';
                inputCart.name = 'draftCartJson';
                inputCart.value = JSON.stringify(cart);
                form.appendChild(inputCart);

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);
            }
        }

        // ─── Import Production Feedback Modal (Auto-Match) ──────────────────────────
        let currentImportWorkbook = null;
        let currentImportFile = null;

        function openImportModal() {
            resetImportFileInput();
            const overlay = document.getElementById('import-feedback-modal-overlay');
            const card = document.getElementById('import-feedback-modal-card');
            if (!overlay || !card) return;

            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            setTimeout(() => {
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            }, 30);
        }

        function closeImportFeedbackModal() {
            const overlay = document.getElementById('import-feedback-modal-overlay');
            const card = document.getElementById('import-feedback-modal-card');
            if (!overlay || !card) return;

            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                overlay.classList.remove('flex');
                overlay.classList.add('hidden');
            }, 150);
        }

        function resetImportFileInput() {
            currentImportWorkbook = null;
            currentImportFile = null;
            const fileInput = document.getElementById('import-file-input');
            if (fileInput) fileInput.value = '';

            const dropzone = document.getElementById('import-dropzone');
            if (dropzone) dropzone.classList.remove('hidden');

            const fileCard = document.getElementById('import-file-card');
            if (fileCard) fileCard.classList.add('hidden');

            const sheetsContainer = document.getElementById('import-sheets-container');
            if (sheetsContainer) sheetsContainer.classList.add('hidden');

            const errorMsg = document.getElementById('import-error-msg');
            if (errorMsg) {
                errorMsg.textContent = '';
                errorMsg.classList.add('hidden');
            }

            const btnProcess = document.getElementById('btn-process-import');
            if (btnProcess) btnProcess.disabled = true;

            const statusText = document.getElementById('import-status-text');
            if (statusText) statusText.textContent = 'กรุณาเลือกไฟล์ Excel';
        }

        function handleImportFileSelect(file) {
            if (!file) return;

            const validExts = ['.xlsx', '.xls'];
            const fileName = file.name || '';
            const ext = fileName.substring(fileName.lastIndexOf('.')).toLowerCase();
            const errorMsg = document.getElementById('import-error-msg');

            if (!validExts.includes(ext)) {
                if (errorMsg) {
                    errorMsg.textContent = 'รองรับเฉพาะไฟล์ Excel (.xlsx, .xls) เท่านั้น';
                    errorMsg.classList.remove('hidden');
                }
                return;
            }

            if (errorMsg) errorMsg.classList.add('hidden');
            currentImportFile = file;

            // Show file card
            const dropzone = document.getElementById('import-dropzone');
            if (dropzone) dropzone.classList.add('hidden');

            const fileCard = document.getElementById('import-file-card');
            if (fileCard) fileCard.classList.remove('hidden');

            const nameEl = document.getElementById('import-file-name');
            if (nameEl) nameEl.textContent = file.name;

            const sizeEl = document.getElementById('import-file-size');
            if (sizeEl) {
                const kb = (file.size / 1024).toFixed(1);
                sizeEl.textContent = `${kb} KB`;
            }

            const statusText = document.getElementById('import-status-text');
            if (statusText) statusText.textContent = 'กำลังอ่านโครงสร้างชีทในไฟล์...';

            // Read sheets via SheetJS
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    currentImportWorkbook = XLSX.read(data, { type: 'array' });
                    const sheetNames = currentImportWorkbook.SheetNames || [];
                    if (sheetNames.length === 0) {
                        throw new Error('ไม่พบแท็บชีทในไฟล์');
                    }
                    populateImportSheets(sheetNames);
                } catch(err) {
                    if (errorMsg) {
                        errorMsg.textContent = 'เกิดข้อผิดพลาดในการอ่านไฟล์: ' + err.message;
                        errorMsg.classList.remove('hidden');
                    }
                    if (statusText) statusText.textContent = 'อ่านไฟล์ล้มเหลว';
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function populateImportSheets(sheetNames) {
            const sheetsContainer = document.getElementById('import-sheets-container');
            const selectDelivered = document.getElementById('import-select-delivered');
            const selectWip = document.getElementById('import-select-wip');
            const badge = document.getElementById('import-sheets-badge');
            const btnProcess = document.getElementById('btn-process-import');
            const statusText = document.getElementById('import-status-text');

            if (!sheetsContainer || !selectDelivered) return;

            // Keywords detection: prioritize "งานส่งมอบแล้ว (งบหน่วยงาน)"
            const deliveredRegex = /งานส่งมอบแล้ว.*งบหน่วยงาน|งานส่งมอบแล้ว|งบหน่วยงาน|ส่งมอบ|delivered/i;
            const deliveredMatch = sheetNames.find(s => deliveredRegex.test(s));

            // Populate delivered dropdown
            selectDelivered.innerHTML = '<option value="">-- ไม่เลือกแท็บนี้ --</option>' + 
                sheetNames.map(s => `<option value="${s}">${s} ${s === deliveredMatch ? ' (ตรวจพบอัตโนมัติ)' : ''}</option>`).join('');
            if (deliveredMatch) {
                selectDelivered.value = deliveredMatch;
            } else if (sheetNames.length > 0) {
                selectDelivered.value = sheetNames[0];
            }

            const isAutoMatched = !!deliveredMatch;
            if (badge) {
                if (isAutoMatched) {
                    badge.innerHTML = `<span>ตรวจพบชีทงานส่งมอบแล้ว (งบหน่วยงาน)</span><svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
                    badge.className = 'text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded flex items-center gap-1';
                } else {
                    badge.innerHTML = `<span>พบ ${sheetNames.length} ชีท (กรุณาเลือกชีท)</span>`;
                    badge.className = 'text-[10px] font-bold text-slate-700 bg-slate-200/80 px-2 py-0.5 rounded flex items-center gap-1';
                }
            }

            sheetsContainer.classList.remove('hidden');
            if (btnProcess) btnProcess.disabled = false;
            if (statusText) statusText.textContent = `พบ ${sheetNames.length} ชีท พร้อมสำหรับการจับคู่ข้อมูล`;
        }

        async function processImportMatch() {
            if (!currentImportWorkbook) return;

            const selectDelivered = document.getElementById('import-select-delivered');
            const deliveredSheetName = selectDelivered ? selectDelivered.value : '';

            if (!deliveredSheetName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ยังไม่ได้เลือกชีท',
                    text: 'กรุณาเลือกชีท งานส่งมอบแล้ว (งบหน่วยงาน)'
                });
                return;
            }

            // Index pending cards by PO Number
            const pendingCards = Array.from(document.querySelectorAll('.order-card[data-po-number]'));
            const poToCardMap = new Map();
            pendingCards.forEach(card => {
                const po = (card.dataset.poNumber || '').trim().toUpperCase();
                if (po) {
                    poToCardMap.set(po, card);
                }
            });

            function extractPoListFromSheet(sheetName) {
                if (!sheetName || !currentImportWorkbook.Sheets[sheetName]) return new Set();
                const sheet = currentImportWorkbook.Sheets[sheetName];
                const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '' });
                const matchedPos = new Set();

                for (let r = 0; r < rows.length; r++) {
                    const row = rows[r];
                    if (!Array.isArray(row)) continue;
                    for (let c = 0; c < row.length; c++) {
                        const cellVal = String(row[c] || '').trim().toUpperCase();
                        if (!cellVal) continue;
                        
                        // Exact match
                        if (poToCardMap.has(cellVal)) {
                            matchedPos.add(cellVal);
                        } else {
                            // Substring token match inside cell
                            poToCardMap.forEach((_, poKey) => {
                                if (cellVal.includes(poKey)) {
                                    matchedPos.add(poKey);
                                }
                            });
                        }
                    }
                }
                return matchedPos;
            }

            const deliveredPos = extractPoListFromSheet(deliveredSheetName);
            let addedDeliveredCount = 0;

            function addCardToCartWithAction(card, actionType) {
                const orderId = card.dataset.orderId;
                if (!orderId) return false;

                const price = parseFloat(card.dataset.price) || 0;
                const item = {
                    orderId: orderId,
                    poNumber: card.dataset.poNumber,
                    orderName: card.dataset.orderName,
                    price: price,
                    department: card.dataset.department,
                    delivery: card.dataset.delivery,
                    quantity: parseInt(card.dataset.quantity) || 1,
                    forwardedStatus: card.dataset.forwardedStatus || '',
                    forwardedFrom: card.dataset.forwardedFrom || '',
                    originalMonth: card.dataset.originalMonth || '',
                    action: actionType,
                    actionPrice: (actionType === 'ReceivedFull') ? price : 0,
                    isStockReceived: true
                };

                cart[orderId] = item;
                card.classList.add('in-cart');
                const btn = card.querySelector('.add-btn');
                if (btn) btn.textContent = '✓ เพิ่มแล้ว';
                const lockedReq = card.querySelector('.btn-locked-requested');
                if (lockedReq) {
                    lockedReq.innerHTML = `<svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg> ✓ จับคู่แล้ว`;
                    lockedReq.className = 'btn-locked-requested px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1 select-none cursor-default';
                    lockedReq.title = 'จับคู่กับใบตอบกลับจากฝ่ายผลิตแล้ว';
                }

                const existingCi = document.getElementById('ci-' + orderId);
                if (existingCi) existingCi.remove();
                renderCartItem(orderId);
                return true;
            }

            // Process Delivered POs -> ReceivedFull
            deliveredPos.forEach(po => {
                const card = poToCardMap.get(po);
                if (card && addCardToCartWithAction(card, 'ReceivedFull')) {
                    addedDeliveredCount++;
                }
            });

            const totalMatched = addedDeliveredCount;

            if (totalMatched === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่พบรหัสสั่งซื้อที่ตรงกัน',
                    html: `
                        <div class="text-left text-xs space-y-2 py-1">
                            <p class="text-slate-600">ระบบสแกนชีท <b>${deliveredSheetName || '-'}</b> แล้ว แต่ไม่พบเลขที่ PO/WO ที่ตรงกับรายการรอดำเนินการของเดือนนี้</p>
                            <p class="text-slate-400">กรุณาตรวจสอบว่าในชีทมีคอลัมน์รหัส PO/WO ตรงกับในระบบหรือไม่</p>
                        </div>
                    `,
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#059669'
                });
                return;
            }

            // Update Cart UI
            const emptyEl = document.getElementById('cart-empty');
            if (emptyEl) emptyEl.style.display = 'none';
            updateSummary();
            saveCartToStorage();

            closeImportFeedbackModal();

            Swal.fire({
                icon: 'success',
                title: 'นำเข้าและจับคู่ข้อมูลสำเร็จ!',
                html: `
                    <div class="text-left text-xs space-y-2 py-1">
                        <p class="text-slate-700">ระบบจับคู่รหัสสั่งซื้อจากไฟล์ Excel ตรงกับระบบทั้งหมด <b>${totalMatched} รายการ</b>:</p>
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg space-y-1.5 font-medium">
                            <div class="text-emerald-700 flex items-center justify-between">
                                <span>• แท็บ <b>งานส่งมอบแล้ว (งบหน่วยงาน)</b>:</span>
                                <span class="font-bold">${addedDeliveredCount} รายการ (ปรับเป็นรับสินค้าแล้ว)</span>
                            </div>
                        </div>
                        <p class="text-slate-500 text-[11px] mt-2">* รายการที่ตรวจพบถูกนำเข้า <b>"รายการที่เลือก"</b> ฝั่งขวาเรียบร้อยแล้ว คุณสามารถตรวจสอบความถูกต้องแล้วกด <b>[บันทึกรายการ]</b> ได้ทันที</p>
                    </div>
                `,
                confirmButtonText: 'รับทราบ',
                confirmButtonColor: '#059669',
                customClass: { popup: 'rounded-xl max-w-md' }
            });
        }

        // Initialize drag-and-drop & file change event listeners
        document.addEventListener('DOMContentLoaded', function() {
            const dropzone = document.getElementById('import-dropzone');
            const fileInput = document.getElementById('import-file-input');

            if (dropzone && fileInput) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('border-emerald-500', 'bg-emerald-50/50');
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/50');
                    }, false);
                });

                dropzone.addEventListener('drop', (e) => {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    if (files && files.length > 0) {
                        handleImportFileSelect(files[0]);
                    }
                }, false);

                fileInput.addEventListener('change', (e) => {
                    if (fileInput.files && fileInput.files.length > 0) {
                        handleImportFileSelect(fileInput.files[0]);
                    }
                });
            }

            // Close modal on ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const overlay = document.getElementById('import-feedback-modal-overlay');
                    if (overlay && !overlay.classList.contains('hidden')) {
                        closeImportFeedbackModal();
                    }
                }
            });
        });

        document.getElementById('save-btn').addEventListener('click', function () {
            handleSaveProcess();
        });

        // ── Realtime polling — อัพเดต summary pills ทุก 20 วินาที ──────────────────
        const MONTH_YEAR = '@Html.Raw(Model.MonthYear)';
        const POLL_MS = 20000;

        function fmtN2(n) {
            return Number(n).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        async function pollDetailStats() {
            try {
                const res = await fetch(`/MonthlyCost/GetDetailStats?monthYear=${encodeURIComponent(MONTH_YEAR)}`);
                if (!res.ok) return;
                const d = await res.json();

                const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
                set('pill-total', d.totalOrders);
                set('pill-saved', d.savedCount);
                set('pill-pending', d.pendingCount ?? (@Model.PendingOrders.Count));
                set('pill-remaining', fmtN2(d.remainingAmount) + ' บาท');

                // อัพเดต tab badge "บันทึกแล้ว" เฉพาะตอนที่ไม่ได้ filter อยู่
                const savedSelect = document.getElementById('saved-action-select');
                const savedFilter = savedSelect ? savedSelect.value : 'all';
                const searchEl = document.getElementById('search-pending');
                const searchQ = searchEl ? searchEl.value.trim() : '';
                const isOnSavedTab = !document.getElementById('panel-saved').classList.contains('hidden');
                const isSavedFiltered = savedFilter !== 'all' || searchQ !== '';
                if (!isOnSavedTab || !isSavedFiltered) {
                    // ไม่ได้ filter อยู่ → overwrite badge ได้ตามปกติ
                    set('tab-saved-count', d.savedCount);
                }
                // ถ้า filter อยู่ → badge จะถูกอัปเดตจาก applySavedFilters() แทน
            } catch (e) { /* silent */ }
        }

        // Initialize summary UI on page load
        loadCartFromStorage();
        updateSummary();

        // SignalR Instant Push
        try {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/dashboardHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMonthlyCostUpdate", function () {
                pollDetailStats();
            });

            connection.start().catch(err => console.error("SignalR connection error: ", err));
        } catch (e) {
            console.error("SignalR init error: ", e);
        }



        // ดักจับการกดปุ่ม Back ของเบราว์เซอร์ (BFCache) เพื่อบังคับดึงข้อมูลล่าสุดเสมอ
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                window.location.reload();
            }
        });
    </script>
}
