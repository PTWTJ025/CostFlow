@model CostFlow.Models.MonthlyCostDetailViewModel
@{
    ViewData["Title"] = "จัดการค่าใช้จ่าย - " + Model.MonthYear;
    ViewData["HeaderTitle"] = "จัดการค่าใช้จ่าย - " + Model.MonthYear;
}

<style>
    .order-card {
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .order-card:hover {
        border-color: #94a3b8;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.07);
    }

    .order-card.in-cart {
        opacity: 0.45;
        pointer-events: none;
    }

    /* Action pill toggle */
    .action-pill {
        cursor: pointer;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.12s ease;
        user-select: none;
        background: white;
        color: #64748b;
        white-space: nowrap;
    }

    .action-pill input[type="radio"] {
        display: none;
    }

    .action-pill:hover {
        border-color: #94a3b8;
        color: #334155;
    }

    .action-pill.active-receive {
        border-color: #10b981;
        background: #ecfdf5;
        color: #065f46;
    }

    .action-pill.active-defer {
        border-color: #f59e0b;
        background: #fffbeb;
        color: #78350f;
    }

    .action-pill.active-skip {
        border-color: #8b5cf6;
        background: #f5f3ff;
        color: #4c1d95;
    }

    .action-pill.active-request {
        border-color: #3b82f6;
        background: #eff6ff;
        color: #1e40af;
    }

    .cart-item {
        animation: slideIn 0.18s ease forwards;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .deferred-note {
        display: none;
    }

    .deferred-note.open {
        display: flex;
    }

    .defer-stock-checkbox {
        box-shadow: none !important;
        --tw-ring-shadow: 0 0 #0000 !important;
        --tw-ring-offset-shadow: 0 0 #0000 !important;
        outline: none !important;
    }
    .defer-stock-checkbox:focus,
    .defer-stock-checkbox:active {
        box-shadow: none !important;
        --tw-ring-shadow: 0 0 #0000 !important;
        --tw-ring-offset-shadow: 0 0 #0000 !important;
        outline: none !important;
    }

    @@media (prefers-reduced-motion: reduce) {
        .cart-item {
            animation: none;
        }

        .order-card,
        .action-pill,
        .deferred-input-wrap {
            transition: none;
        }
    }

    /* Scrollable panels */
    .panel-body {
        overflow-y: auto;
        flex: 1;
        min-height: 0;
    }

    .panel-body::-webkit-scrollbar {
        width: 4px;
    }

    .panel-body::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    /* Remove button */
    .remove-btn {
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        color: #ef4444;
        background: transparent;
        border: none;
        cursor: pointer;
        transition: background 0.12s ease, transform 0.12s ease;
        flex-shrink: 0;
    }

    .remove-btn:hover {
        background: #fef2f2;
        transform: scale(1.15);
    }

    .remove-btn:active {
        transform: scale(0.9);
    }

    @@media (prefers-reduced-motion: reduce) {
        .remove-btn {
            transition: background 0.12s ease;
        }

        .remove-btn:hover,
        .remove-btn:active {
            transform: none;
        }
    }
</style>

<div class="flex-1 flex flex-col min-h-0 p-4 md:p-6 gap-4">

<!-- ── Header + Summary bar ── -->
<div class="flex items-center justify-between gap-4 flex-wrap">
    <!-- Left: breadcrumb + subtitle -->
    <div>
        <div class="flex items-center gap-2 mb-0.5">
            <a href="/MonthlyCost" class="text-slate-400 hover:text-slate-600 transition-colors text-sm">คิดค่าใช้จ่าย</a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-700 font-semibold text-sm">@Model.MonthYear</span>
        </div>
        <p class="text-slate-500 text-xs">เลือกรายการที่ต้องการดำเนินการ แล้วกำหนดประเภทการจ่ายชำระ</p>
    </div>

    <!-- Right: summary pills -->
    <div class="flex items-center gap-2 flex-wrap">
        <!-- ทั้งหมด -->
        <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-md px-3 shadow-sm select-none" style="height: 34px !important;">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
            </svg>
            <span class="text-[11px] text-slate-500 font-medium">ทั้งหมด</span>
            <span class="text-sm font-bold text-slate-700" id="pill-total">@Model.Stats.TotalOrders</span>
        </div>

        <!-- รอดำเนินการ -->
        <div class="flex items-center gap-1.5 bg-amber-50 border border-amber-200 rounded-md px-3 shadow-sm select-none" style="height: 34px !important;">
            <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            <span class="text-[11px] text-amber-600 font-medium">รอดำเนินการ</span>
            <span class="text-sm font-bold text-amber-700" id="pill-pending">@Model.PendingOrders.Count</span>
        </div>

        <!-- ดำเนินการแล้ว -->
        <div class="flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 rounded-md px-3 shadow-sm select-none" style="height: 34px !important;">
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            <span class="text-[11px] text-emerald-600 font-medium">บันทึกแล้ว</span>
            <span class="text-sm font-bold text-emerald-700" id="pill-saved">@Model.SavedOrders.Count</span>
        </div>

        <!-- ยอดรวมสั่งผลิตประจำเดือน -->
        <div class="flex items-center gap-1.5 bg-purple-50 border border-purple-200 rounded-md px-3 shadow-sm select-none" style="height: 34px !important;">
            <svg class="w-4 h-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/>
            </svg>
            <span class="text-[11px] text-purple-600 font-medium">ยอดรวมสั่งผลิต</span>
            <span class="text-xs font-bold text-purple-700" id="pill-remaining">@Model.Stats.RemainingAmount.ToString("N2") บาท</span>
        </div>

        <!-- ปุ่ม Export Excel สรุปราคา -->
        <button type="button" onclick="openExportModal()" title="ส่งออก Excel" class="flex items-center justify-center btn-custom-green rounded-md text-white shadow-sm transition-all active:scale-95 shrink-0 cursor-pointer" style="width: 34px !important; height: 34px !important; padding: 0 !important;">
            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" viewBox="0 0 48 48" style="width: 18px !important; height: 18px !important;">
                <path fill="#169154" d="M29,6H15.744C14.781,6,14,6.781,14,7.744v7.259h15V6z"></path><path fill="#18482a" d="M14,33.054v7.202C14,41.219,14.781,42,15.743,42H29v-8.946H14z"></path><path fill="#0c8045" d="M14 15.003H29V24.005000000000003H14z"></path><path fill="#17472a" d="M14 24.005H29V33.055H14z"></path>
                <g>
                    <path fill="#29c27f" d="M42.256,6H29v9.003h15V7.744C44,6.781,43.219,6,44,6z"></path><path fill="#27663f" d="M29,33.054V42h13.257C43.219,42,44,41.219,44,40.257v-7.202H29z"></path><path fill="#19ac65" d="M29 15.003H44V24.005000000000003H29z"></path><path fill="#129652" d="M29 24.005H44V33.055H29z"></path>
                </g><path fill="#0c7238" d="M22.319,34H5.681C4.753,34,4,33.247,4,32.319V15.681C4,14.753,4.753,14,5.681,14h16.638 C23.247,14,24,14.753,24,15.681v16.638C24,33.247,23.247,34,22.319,34z"></path><path fill="#fff" d="M9.807 19L12.193 19 14.129 22.754 16.175 19 18.404 19 15.333 24 18.474 29 16.123 29 14.013 25.07 11.912 29 9.526 29 12.719 23.982z"></path>
            </svg>
        </button>

        <!-- ปุ่ม Import Excel ใบตอบกลับจากฝ่ายผลิต (Auto-Match) - คลุมโทน กรอบสีน้ำเงิน -->
        <button
    type="button"
    onclick="openImportModal()"
    title="นำเข้า Excel ใบตอบกลับจากฝ่ายผลิต (Auto-Match)"
    class="flex items-center justify-center btn-custom-blue-soft rounded-md shadow-sm transition-all active:scale-95 shrink-0 cursor-pointer group"
    style="width: 34px !important; height: 34px !important; padding: 0 !important;"
>
    <svg
        class="w-5 h-5 transition-transform duration-200 group-hover:-translate-y-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
        style="width: 19px !important; height: 19px !important;"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z"
        ></path>
    </svg>
        </button>
    </div>
</div>

@{
    var deferredCarryOverOrders = Model.PendingOrders.Where(o => o.ForwardedStatus == "Deferred").ToList();
}

<!-- ── Split screen ── -->
<div class="flex-1 min-h-0 flex flex-col lg:flex-row gap-4 lg:gap-6">

<!-- LEFT: รายการรอดำเนินการ -->
<div class="bg-white border border-slate-200 rounded-md flex flex-col min-h-0 overflow-hidden flex-1 lg:w-1/2" style="min-height: 400px;">

<!-- Panel header with tabs -->
<div class="px-4 pt-3 border-b border-slate-100 bg-slate-50/60 shrink-0">
    <div class="flex items-center justify-between mb-2 gap-2 flex-wrap">
        <!-- Tabs -->
        <div class="flex gap-2">
            <button id="tab-pending" onclick="switchTab('pending')"
                    class="flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-bold border transition-all"
                    style="background:#fffbeb;border-color:#fcd34d;color:#92400e;">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
                รอดำเนินการ
                <span class="px-1.5 rounded-full text-[10px] font-bold" id="tab-pending-count"
                      style="background:#fbbf24;color:#78350f;">
                    @Model.PendingOrders.Count
                </span>
            </button>
            <button id="tab-saved" onclick="switchTab('saved')"
                    class="flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-bold border transition-all"
                    style="background:#f8fafc;border-color:#e2e8f0;color:#94a3b8;">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
                บันทึกแล้ว
                <span class="px-1.5 rounded-full text-[10px] font-bold" id="tab-saved-count"
                      style="background:#e2e8f0;color:#475569;">
                    @Model.SavedOrders.Count
                </span>
            </button>
        </div>
        <!-- Total Amount Display -->
        <div class="flex-1 flex justify-end sm:px-2">
            <div id="filtered-total-container" class="flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-md border border-emerald-100 shadow-sm transition-colors duration-300">
                <span id="filtered-total-amount" class="text-[13px] font-bold">฿0.00</span>
            </div>
        </div>
        <!-- Search (Multi-PO support) -->
        <div class="relative flex items-center" id="search-wrap">
            <div class="relative flex items-center w-48 sm:w-60 focus-within:w-60 sm:focus-within:w-72 transition-all duration-200">
                <input type="text" id="search-pending" placeholder="ค้นหา / วางหลายเลข PO..."
                    title="สามารถ Copy เลข PO หลายรายการ (คั่นด้วยการขึ้นบรรทัดใหม่จาก Excel หรือลูกน้ำ) มาวางได้เลย"
                    class="py-1.5 text-xs border border-slate-200 rounded-md w-full focus:ring-1 focus:ring-primary focus:border-primary outline-none bg-white shadow-2xs">
                <button type="button" id="clear-search-btn" onclick="clearSearchInput()" style="display:none;"
                        title="ล้างคำค้นหา"
                        class="absolute right-2 text-slate-400 hover:text-slate-600 p-0.5 rounded-full hover:bg-slate-100 transition-all cursor-pointer">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Bulk actions toolbar (shown on pending tab) -->
    <div id="bulk-actions-toolbar" class="flex items-center justify-between py-2 px-3 border-t border-slate-200/80 bg-slate-50/80 gap-2 rounded-b-md shadow-inner text-xs flex-nowrap overflow-x-auto">
        <!-- Left side: Select all & Sort -->
        <div class="flex items-center gap-2.5 shrink-0">
            <input type="checkbox" id="select-all-pending" onchange="toggleSelectAllPending(this)"
                   title="เลือกทั้งหมด"
                   class="rounded border-slate-300 text-primary focus:ring-primary w-4 h-4 transition-all cursor-pointer">

            <div class="h-4 w-px bg-slate-300"></div>

            <div class="flex items-center gap-1.5 text-slate-500 bg-white border border-slate-200 rounded-md px-2 py-1 shadow-xs" style="height: 30px;">
                <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5"/>
                </svg>
                <select id="pending-sort-select" onchange="sortPendingOrders(this.value)"
                        class="bg-transparent text-slate-700 font-bold outline-none cursor-pointer text-xs focus:ring-0 p-0 m-0 h-full w-[115px]"
                        style="border: none !important; box-shadow: none !important;">
                    <option value="default">เรียงมาตรฐาน</option>
                    <option value="this-month">เฉพาะเดือนนี้</option>
                    <option value="deferred">ผ่อนยกยอด</option>
                    <option value="requested">ต้องการรับของ</option>
                    <option value="skipped">ค้างยกยอด</option>
                </select>
            </div>
        </div>

        <!-- Right side: Bulk actions -->
        <div class="flex items-center gap-1.5 shrink-0 flex-nowrap">
            <button type="button" onclick="bulkAddToCart('ReceivedFull')"
                    title="รับสินค้า (ชำระแล้ว)"
                    class="px-2 py-1 rounded-md font-bold bg-white text-emerald-700 border border-emerald-200 hover:bg-emerald-50 hover:border-emerald-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer text-xs whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                ชำระแล้ว
            </button>
            <button type="button" onclick="bulkAddToCart('Deferred')"
                    title="รับสินค้า (ยังไม่ชำระ)"
                    class="px-2 py-1 rounded-md font-bold bg-white text-amber-700 border border-amber-200 hover:bg-amber-50 hover:border-amber-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer text-xs whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                ยังไม่ชำระ
            </button>
            <button type="button" onclick="bulkAddToCart('Requested')"
                    title="ต้องการรับของ"
                    class="px-2 py-1 rounded-md font-bold bg-white text-blue-700 border border-blue-200 hover:bg-blue-50 hover:border-blue-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer text-xs whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                ต้องการรับ
            </button>
            <button type="button" onclick="bulkAddToCart('Skipped')"
                    title="ยังไม่รับสินค้า"
                    class="px-2 py-1 rounded-md font-bold bg-white text-purple-700 border border-purple-200 hover:bg-purple-50 hover:border-purple-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer text-xs whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                ยังไม่รับ
            </button>
        </div>
    </div>

    <!-- Bulk actions toolbar (shown on saved tab) -->
    <div id="saved-actions-toolbar" class="hidden flex items-center justify-between py-2 px-3 border-t border-slate-200/80 bg-slate-50/80 gap-2 rounded-b-md shadow-inner text-xs flex-nowrap overflow-x-auto">
        <!-- Left side: Select all, count & Action filter -->
        <div class="flex items-center gap-2.5 shrink-0 flex-nowrap">
            <input type="checkbox" id="select-all-saved" onchange="toggleSelectAllSaved(this)"
                   title="เลือกทั้งหมด"
                   class="rounded border-slate-300 text-rose-600 focus:ring-rose-500 w-4 h-4 transition-all cursor-pointer">
            <div class="h-4 w-px bg-slate-300"></div>
            <span class="text-[11px] text-slate-500 font-semibold whitespace-nowrap" id="saved-selected-count">เลือกแล้ว 0</span>

            <div class="h-4 w-px bg-slate-300"></div>

            <!-- Filter by action -->
            <div class="flex items-center gap-1.5 text-slate-500 bg-white border border-slate-200 rounded-md px-2 py-1 shadow-xs" style="height: 30px;">
                <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/>
                </svg>
                <select id="saved-action-select" onchange="applySavedFilters()"
                        class="bg-transparent text-slate-700 font-bold outline-none cursor-pointer text-xs focus:ring-0 p-0 m-0 h-full w-[125px]"
                        style="border: none !important; box-shadow: none !important;">
                    <option value="all">สถานะทั้งหมด</option>
                    <option value="ReceivedFull">ชำระแล้ว</option>
                    <option value="Deferred">ยังไม่ชำระ</option>
                    <option value="Requested">ต้องการรับ</option>
                    <option value="Skipped">ยังไม่รับ</option>
                </select>
            </div>
        </div>

        <!-- Right side: Bulk cancel button -->
        <div class="flex items-center gap-2 shrink-0">
            <button type="button" onclick="bulkCancelSavedActions()" id="bulk-cancel-saved-btn" disabled
                    class="px-3 py-1.5 rounded-md font-bold bg-rose-600 hover:bg-rose-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white shadow-sm transition-all flex items-center gap-1.5 cursor-pointer disabled:hover:bg-slate-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                </svg>
                ยกเลิกบันทึก
            </button>
        </div>
    </div>
</div>

<!-- Pending list panel -->
<div class="panel-body p-3 space-y-4" id="panel-pending">

    @if (Model.PendingOrders.Any())
    {
        foreach (var order in Model.PendingOrders)
        {
            var fwdBadge = "";
            var qtyColor = order.ForwardedStatus == "Deferred" ? "text-amber-600"
                : order.ForwardedStatus == "Skipped" ? "text-purple-600"
                : "text-blue-600";

            // สร้าง tooltip ที่แสดงทั้งเดือนต้นทางและเดือนที่กด action ล่าสุด
            if (order.ForwardedStatus == "Deferred")
            {
                var tooltipText = !string.IsNullOrEmpty(order.OriginalMonth)
                    ? $"WO สร้างจาก {order.OriginalMonth} • กดผ่อนล่าสุดที่ {order.ForwardedFromMonth}"
                    : $"กดผ่อนล่าสุดที่ {order.ForwardedFromMonth}";
                fwdBadge = $"<span class=\"ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-700\" title=\"{tooltipText}\">ผ่อนชำระต่อเนื่อง</span>";
            }
            else if (order.ForwardedStatus == "Skipped")
            {
                var tooltipText = !string.IsNullOrEmpty(order.OriginalMonth)
                    ? $"WO สร้างจาก {order.OriginalMonth} • ค้างมาจาก {order.ForwardedFromMonth}"
                    : $"ค้างมาจาก {order.ForwardedFromMonth}";
                fwdBadge = $"<span class=\"ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-purple-100 text-purple-700\" title=\"{tooltipText}\">ค้างยกยอดมา</span>";
            }
            else if (order.ForwardedStatus == "Requested")
            {
                var tooltipText = !string.IsNullOrEmpty(order.OriginalMonth)
                    ? $"WO สร้างจาก {order.OriginalMonth} • ขอรับของเมื่อ {order.ForwardedFromMonth} (รอใบตอบกลับฝ่ายผลิต)"
                    : $"ขอรับของเมื่อ {order.ForwardedFromMonth} (รอใบตอบกลับฝ่ายผลิต)";
                fwdBadge = $"<span class=\"ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-100 text-blue-700\" title=\"{tooltipText}\">ต้องการรับของ</span>";
            }

            <div class="order-card border border-slate-200 rounded p-3 bg-white @(order.ForwardedStatus == "Deferred" ? "in-cart is-locked-deferred" : (order.ForwardedStatus == "Requested" ? "is-locked-requested" : ""))"
                 data-order-id="@order.OrderId"
                 data-po-number="@order.PoNumber"
                 data-order-name="@order.OrderName"
                 data-price="@order.TotalPrice"
                 data-quantity="@order.Quantity"
                 data-department="@order.Department"
                 data-delivery="@order.DeliveryTarget"
                 data-forwarded-status="@order.ForwardedStatus"
                 data-forwarded-from="@order.ForwardedFromMonth"
                 data-original-month="@order.OriginalMonth">

                <div class="flex items-start gap-3">
                    @if (order.ForwardedStatus == "Deferred")
                    {
                        <div class="mt-1 shrink-0 w-4 h-4 flex items-center justify-center text-amber-500 select-none" title="รายการผ่อนชำระต่อเนื่อง ถูกล็อกในรายการที่เลือกแล้ว">
                            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
                            </svg>
                        </div>
                    }
                    else if (order.ForwardedStatus == "Requested")
                    {
                        <div class="mt-1 shrink-0 w-4 h-4 flex items-center justify-center text-blue-500 select-none" title="รายการต้องการรับของ รอใบตอบกลับจากฝ่ายผลิต (ไม่สามารถเลือกด้วยตนเองได้)">
                            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                            </svg>
                        </div>
                    }
                    else
                    {
                        <input type="checkbox" class="pending-card-checkbox mt-1 rounded border-slate-300 text-primary focus:ring-primary shrink-0 cursor-pointer" onchange="onCardCheckboxChange()"/>
                    }
                    <!-- Info -->
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center flex-wrap gap-1 mb-0.5">
                            <span class="font-bold text-[13px] text-slate-800">@order.PoNumber</span>
                            @Html.Raw(fwdBadge)
                        </div>

                        <p class="text-xs text-slate-500 leading-snug line-clamp-2">@order.OrderName</p>

                        @if (order.ForwardedStatus == "Deferred")
                        {
                            var infoText = "";
                            if (!string.IsNullOrEmpty(order.OriginalMonth) && !string.IsNullOrEmpty(order.ForwardedFromMonth))
                            {
                                infoText = $"WO สั่งซื้อจาก {order.OriginalMonth} • ผ่อนจาก {order.ForwardedFromMonth}";
                            }
                            else if (!string.IsNullOrEmpty(order.OriginalMonth))
                            {
                                infoText = $"WO สั่งซื้อจาก {order.OriginalMonth} • ผ่อนสะสมมา";
                            }
                            else
                            {
                                infoText = "รายการผ่อนสะสม";
                            }

                            <div class="mt-1.5 mb-1.5 text-[11px] font-bold text-amber-600 bg-amber-50/70 border border-amber-100 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5">
                                <span>@infoText</span>
                            </div>
                        }
                        else if (order.ForwardedStatus == "Skipped")
                        {
                            var infoText = "";
                            if (!string.IsNullOrEmpty(order.OriginalMonth) && !string.IsNullOrEmpty(order.ForwardedFromMonth))
                            {
                                infoText = $"WO สร้างจาก {order.OriginalMonth} • ค้างมาจาก {order.ForwardedFromMonth}";
                            }
                            else if (!string.IsNullOrEmpty(order.ForwardedFromMonth))
                            {
                                infoText = $"ค้างมาจาก {order.ForwardedFromMonth}";
                            }
                            else if (!string.IsNullOrEmpty(order.OriginalMonth))
                            {
                                infoText = $"WO สร้างจาก {order.OriginalMonth}";
                            }
                            else
                            {
                                infoText = "รายการค้างยกยอดมา";
                            }

                            <div class="mt-1.5 mb-1.5 text-[11px] font-bold text-purple-700 bg-purple-50/70 border border-purple-100 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5">
                                <span>@infoText</span>
                            </div>
                        }
                        else if (order.ForwardedStatus == "Requested")
                        {
                            var infoText = "";
                            if (!string.IsNullOrEmpty(order.OriginalMonth) && !string.IsNullOrEmpty(order.ForwardedFromMonth))
                            {
                                infoText = $"WO สร้างจาก {order.OriginalMonth} • ขอรับของจาก {order.ForwardedFromMonth} (รอใบตอบกลับฝ่ายผลิต)";
                            }
                            else if (!string.IsNullOrEmpty(order.ForwardedFromMonth))
                            {
                                infoText = $"ขอรับของจาก {order.ForwardedFromMonth} (รอใบตอบกลับฝ่ายผลิต)";
                            }
                            else if (!string.IsNullOrEmpty(order.OriginalMonth))
                            {
                                infoText = $"WO สร้างจาก {order.OriginalMonth} • รอใบตอบกลับฝ่ายผลิต";
                            }
                            else
                            {
                                infoText = "ต้องการรับของ (รอใบตอบกลับฝ่ายผลิต)";
                            }

                            <div class="mt-1.5 mb-1.5 text-[11px] font-bold text-blue-700 bg-blue-50/70 border border-blue-100 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5">
                                <span>@infoText</span>
                            </div>
                        }

                        <div class="flex items-center flex-wrap gap-x-2.5 gap-y-1 mt-1.5 text-[11px] leading-none">
                            <span class="inline-flex items-center gap-1 font-medium @qtyColor leading-none">
                                <span>จำนวน:</span>
                                <span class="font-bold leading-none">@order.Quantity.ToString("N0")</span>
                                <span>ชิ้น</span>
                            </span>
                            <span class="text-slate-300 leading-none select-none inline-flex items-center ml-3 gap-3"></span>
                            <div class="inline-flex items-center gap-1 leading-none">
                                <svg class="w-3.5 h-3.5 text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
                                </svg>
                                @if (order.DeliveryTarget != "-" && !string.IsNullOrEmpty(order.DeliveryTarget))
                                {
                                    <span class="text-slate-400 leading-none">เป้าหมายส่งมอบ: <span class="font-medium text-indigo-600">@order.DeliveryTarget</span> </span>
                                }
                                else
                                {
                                    <span class="text-[11px] text-red-600 italic leading-none">ยังไม่มีแผนผลิตที่จับคู่</span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- Price + Add btn -->
                    <div class="shrink-0 flex flex-col items-end gap-2">
                        <span class="font-bold text-sm text-slate-800">฿@order.TotalPrice.ToString("N2")</span>
                        @if (order.ForwardedStatus == "Deferred")
                        {
                            <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1 select-none cursor-default" title="ถูกล็อกตัดจ่ายในรายการที่เลือกแล้ว">
                                <svg class="w-3 h-3 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
                                </svg>
                                ล็อกตัดจ่าย
                            </span>
                        }
                        else if (order.ForwardedStatus == "Requested")
                        {
                            <span class="btn-locked-requested px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1 select-none cursor-default" title="อยู่ในสถานะต้องการรับของ รอใบตอบกลับจากฝ่ายผลิต (นำเข้า Excel เพื่อปลดล็อกและจับคู่อัตโนมัติ)">
                                <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                รอตอบกลับ
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    onclick="addToCart(this)"
                                    class="add-btn px-3 py-1.5 rounded-md text-xs font-bold bg-primary text-white hover:bg-primary/90 active:scale-95 transition-all cursor-pointer">
                                + เพิ่ม
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex flex-col items-center justify-center h-full min-h-[200px] text-slate-300">
            <svg class="w-10 h-10 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
            </svg>
            <p class="text-sm font-medium text-slate-400">ไม่มีรายการรอดำเนินการ</p>
        </div>
    }
</div>

<!-- Saved list panel (hidden by default) -->
<div class="panel-body p-3 space-y-4 hidden" id="panel-saved">
    @if (Model.SavedOrders.Any())
    {
        foreach (var saved in Model.SavedOrders)
        {
            var actionBg = saved.Action == "ReceivedFull" ? "bg-emerald-50 border-emerald-200 text-emerald-700"
                : saved.Action == "Deferred" ? "bg-amber-50 border-amber-200 text-amber-700"
                : saved.Action == "Requested" ? "bg-blue-50 border-blue-200 text-blue-700"
                : "bg-purple-50 border-purple-200 text-purple-700";
            var actionColor = saved.Action == "ReceivedFull" ? "text-emerald-600"
                : saved.Action == "Deferred" ? "text-amber-600"
                : saved.Action == "Requested" ? "text-blue-600"
                : "text-purple-600";
            var actionLabel = saved.Action == "ReceivedFull" ? "รับสินค้า (ชำระแล้ว)"
                : saved.Action == "Deferred" ? "รับสินค้า (ยังไม่ชำระ)"
                : saved.Action == "Requested" ? "ต้องการรับของ"
                : "ยังไม่รับสินค้า";
            var fwdBadge = "";
            if (saved.ForwardedStatus == "Deferred")
            {
                var tooltipText = !string.IsNullOrEmpty(saved.OriginalMonth)
                    ? $"WO สั่งซื้อจาก {saved.OriginalMonth} • ถูกผ่อนจาก {saved.ForwardedFromMonth}"
                    : $"ถูกผ่อนจาก {saved.ForwardedFromMonth}";
                fwdBadge = $"<span class=\"ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-700\" title=\"{tooltipText}\">ผ่อนยกยอดมา</span>";
            }
            else if (saved.ForwardedStatus == "Skipped")
            {
                var tooltipText = !string.IsNullOrEmpty(saved.OriginalMonth)
                    ? $"WO สั่งซื้อจาก {saved.OriginalMonth} • ค้างมาจาก {saved.ForwardedFromMonth}"
                    : $"ค้างมาจาก {saved.ForwardedFromMonth}";
                fwdBadge = $"<span class=\"ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-purple-100 text-purple-700\" title=\"{tooltipText}\">ค้างยกยอดมา</span>";
            }

            <div class="saved-card border border-slate-200 rounded-lg p-3 bg-white hover:border-slate-300 transition-all shadow-2xs"
                 data-action-id="@saved.ActionId"
                 data-po-number="@saved.PoNumber"
                 data-order-name="@saved.OrderName"
                 data-action="@saved.Action">
                <div class="flex items-start gap-3">
                    <input type="checkbox"
                           class="saved-card-checkbox mt-1 rounded border-slate-300 text-rose-600 focus:ring-rose-500 shrink-0 cursor-pointer"
                           data-action-id="@saved.ActionId"
                           data-po-number="@saved.PoNumber"
                           onchange="onSavedCardCheckboxChange()"/>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center flex-wrap gap-1 mb-0.5">
                            <span class="font-bold text-[13px] text-slate-800">@saved.PoNumber</span>
                            @Html.Raw(fwdBadge)
                        </div>
                        <p class="text-xs text-slate-500 leading-snug line-clamp-2">@saved.OrderName</p>

                        @if (saved.ForwardedStatus == "Deferred")
                        {
                            var infoText = "";
                            if (!string.IsNullOrEmpty(saved.OriginalMonth) && !string.IsNullOrEmpty(saved.ForwardedFromMonth))
                            {
                                infoText = $"WO สั่งซื้อจาก {saved.OriginalMonth} • ผ่อนจาก {saved.ForwardedFromMonth}";
                            }
                            else if (!string.IsNullOrEmpty(saved.OriginalMonth))
                            {
                                infoText = $"WO สั่งซื้อจาก {saved.OriginalMonth} • ผ่อนสะสมมา";
                            }
                            else
                            {
                                infoText = "รายการผ่อนสะสม";
                            }

                            <div class="mt-1.5 mb-1.5 text-[11px] font-bold text-amber-600 bg-amber-50/70 border border-amber-100 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5">
                                <span>@infoText</span>
                            </div>
                        }
                        else if (saved.ForwardedStatus == "Skipped")
                        {
                            var infoText = "";
                            if (!string.IsNullOrEmpty(saved.OriginalMonth) && !string.IsNullOrEmpty(saved.ForwardedFromMonth))
                            {
                                infoText = $"WO สร้างจาก {saved.OriginalMonth} • ค้างมาจาก {saved.ForwardedFromMonth}";
                            }
                            else if (!string.IsNullOrEmpty(saved.ForwardedFromMonth))
                            {
                                infoText = $"ค้างมาจาก {saved.ForwardedFromMonth}";
                            }
                            else if (!string.IsNullOrEmpty(saved.OriginalMonth))
                            {
                                infoText = $"WO สร้างจาก {saved.OriginalMonth}";
                            }
                            else
                            {
                                infoText = "รายการค้างยกยอดมา";
                            }

                            <div class="mt-1.5 mb-1.5 text-[11px] font-bold text-purple-700 bg-purple-50/70 border border-purple-100 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5">
                                <span>@infoText</span>
                            </div>
                        }
                        <div class="flex items-center flex-wrap gap-x-2.5 mt-1.5 text-[11px] leading-none">
                            <span class="inline-flex items-center gap-1 font-medium @actionColor leading-none">
                                <span>จำนวน:</span>
                                <span class="font-bold leading-none">@saved.Quantity.ToString("N0")</span>
                                <span>ชิ้น</span>
                            </span>
                            <span class="text-slate-300 leading-none select-none inline-flex items-center">•</span>
                            <div class="inline-flex items-center gap-1.5 leading-none ml-3">
                                <svg class="w-3.5 h-3.5 text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
                                </svg>
                                <span class="text-slate-400 leading-none">เป้าหมายส่งมอบ: <span class="font-medium text-indigo-600">@(saved.DeliveryTarget != "-" ? saved.DeliveryTarget : "ไม่ระบุ")</span></span>
                            </div>
                        </div>
                    </div>
                    <div class="shrink-0 flex flex-col items-end gap-1.5">
                        @if (saved.Action == "ReceivedFull")
                        {
                            <span class="font-bold text-sm text-slate-700">฿@saved.ActionPrice.ToString("N2")</span>
                        }
                        else if (saved.Action == "Deferred")
                        {
                            <span class="font-bold text-sm text-amber-600">฿@saved.ActionPrice.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="font-bold text-sm text-slate-400">฿@saved.TotalPrice.ToString("N2")</span>
                        }
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border @actionBg">
                            @actionLabel
                        </span>
                    </div>
                </div>

                <!-- Footer / Edit & Cancel button -->
                <div class="flex items-center justify-between gap-2 mt-2 pt-2 border-t border-slate-100 text-xs">
                    <span class="text-[10px] text-slate-400">
                        @(saved.ActionId != Guid.Empty ? $"บันทึกเมื่อ: {saved.CreatedAt:dd/MM/yyyy HH:mm}" : "ผลัดไปเดือนถัดไปอัตโนมัติ")
                    </span>
                    @if (saved.ActionId != Guid.Empty)
                    {
                        <button type="button"
                                onclick="cancelSavedAction('@saved.ActionId', '@saved.PoNumber')"
                                class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 border border-rose-200 transition-all cursor-pointer">
                            ยกเลิกบันทึก
                        </button>
                    }
                    else
                    {
                        <span class="text-[10px] text-purple-600 font-medium bg-purple-50 px-2 py-0.5 rounded border border-purple-200">
                            ผลัดไปเดือนถัดไป
                        </span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex flex-col items-center justify-center py-16 text-slate-300">
            <svg class="w-10 h-10 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            <p class="text-sm font-medium text-slate-400">ยังไม่มีรายการที่บันทึก</p>
        </div>
    }
</div>
</div>

<!-- RIGHT: รายการที่เลือก -->
<div class="bg-white border border-blue-200 rounded-md flex flex-col min-h-0 overflow-hidden shadow-xs flex-1 lg:w-1/2" style="min-height: 400px;">

    <!-- Panel header -->
    <div class="px-4 py-2.5 border-b border-blue-100 bg-blue-50/60 shrink-0 flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center">
            <span class="font-bold text-blue-800 text-sm">รายการที่เลือก</span>
            <span class="ml-2 text-xs text-blue-500 font-semibold" id="cart-count-label">@deferredCarryOverOrders.Count รายการ</span>
        </div>
        <div class="w-full flex items-center gap-1.5 flex-wrap" id="cart-header-actions" style="display:none;">
            <span class="text-[11px] text-slate-400 font-medium mr-0.5 hidden xl:inline-block">ปรับทั้งหมดเป็น:</span>
            <button type="button" onclick="setAllCartAction('ReceivedFull')"
                    class="px-2 py-1 rounded-md text-[11px] font-bold bg-white text-emerald-700 border border-emerald-200 hover:bg-emerald-50 hover:border-emerald-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                    title="รับสินค้า (ชำระแล้ว)">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                รับสินค้า (ชำระแล้ว)
            </button>
            <button type="button" onclick="setAllCartAction('Deferred')"
                    class="px-2 py-1 rounded-md text-[11px] font-bold bg-white text-amber-700 border border-amber-200 hover:bg-amber-50 hover:border-amber-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                    title="รับสินค้า (ยังไม่ชำระ)">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                รับสินค้า (ยังไม่ชำระ)
            </button>
            <button type="button" onclick="setAllCartAction('Requested')"
                    class="px-2 py-1 rounded-md text-[11px] font-bold bg-white text-blue-700 border border-blue-200 hover:bg-blue-50 hover:border-blue-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                    title="ต้องการรับของ">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                ต้องการรับของ
            </button>
            <button type="button" onclick="setAllCartAction('Skipped')"
                    class="px-2 py-1 rounded-md text-[11px] font-bold bg-white text-purple-700 border border-purple-200 hover:bg-purple-50 hover:border-purple-300 shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                    title="ยังไม่รับสินค้า">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                ยังไม่รับสินค้า
            </button>
            <button type="button" id="clear-cart-btn" onclick="clearAllCart()"
                    class="ml-auto px-2.5 py-1 rounded text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 border border-rose-200 transition-all cursor-pointer">
                ✕ เคลียร์
            </button>
        </div>
    </div>

    <!-- Cart list with right scrollbar -->
    <div class="panel-body p-3 space-y-4" id="cart-list">
        <div id="cart-empty" class="flex flex-col items-center justify-center h-full min-h-[200px] text-slate-300">
            <p class="text-sm font-medium text-slate-400">ยังไม่ได้เลือกรายการ</p>
            <p class="text-xs text-slate-300 mt-1">กด <span class="font-bold">+ เพิ่ม</span> จากรายการซ้าย</p>
        </div>
    </div>

    <!-- Footer -->
    <div class="shrink-0 border-t border-slate-200 bg-slate-50 px-4 py-3" id="cart-footer">
        <!-- Breakdown -->
        <div class="flex flex-col gap-2 mb-3" id="cart-breakdown-container" style="display:none;">
            <!-- Deferred -->
            <div class="flex items-center justify-between text-xs" id="breakdown-deferred" style="display:none;">
                <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span class="text-slate-600">รับสินค้า (ยังไม่ชำระ → ยกไปเดือนหน้า)</span>
                </div>
                <span class="font-bold text-amber-700" id="total-deferred">฿0.00</span>
            </div>
            <!-- Requested -->
            <div class="flex items-center justify-between text-xs" id="breakdown-requested" style="display:none;">
                <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                    <span class="text-slate-600">ต้องการรับของ (แผนส่งฝ่ายผลิต)</span>
                </div>
                <span class="font-bold text-blue-700" id="count-requested">0 รายการ</span>
            </div>
            <!-- Skipped -->
            <div class="flex items-center justify-between text-xs" id="breakdown-skipped" style="display:none;">
                <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                    <span class="text-slate-600">ยังไม่รับสินค้า → ยกยอด</span>
                </div>
                <span class="font-bold text-purple-700" id="count-skipped">0 รายการ</span>
            </div>
        </div>

        @if (deferredCarryOverOrders.Any())
        {
            <!-- ข้อความเตือนรายการตัดจ่ายอัตโนมัติจากรอบก่อน -->
            <!-- Banner wrapper: overflow-hidden enables slide-up/down animation -->
            <div id="deferred-notice-banner-wrap" style="overflow:hidden; transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease, margin-bottom 0.3s ease; max-height: 120px; opacity:1; margin-bottom:0.75rem;">
                <div id="deferred-notice-banner" class="px-3 py-2 rounded-lg bg-amber-50/90 border border-amber-200 flex items-center justify-between gap-2 text-xs text-amber-900 shadow-2xs">
                    <div class="flex items-center gap-2 min-w-0">
                        <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/>
                        </svg>
                        <div class="leading-tight">
                            <span>รายการตัดจ่ายอัตโนมัติ <b>@deferredCarryOverOrders.Count รายการ</b> (<b>฿@deferredCarryOverOrders.Sum(x => x.TotalPrice).ToString("N2")</b>) รับสินค้ามาจากรอบก่อน ต้องดำเนินการตัดจ่ายในรอบนี้</span>
                        </div>
                    </div>
                    <!-- Hide button -->
                    <button type="button" onclick="hideDeferredBanner()" title="ซ่อนการแจ้งเตือน" class="shrink-0 text-amber-600/70 hover:text-amber-900 hover:bg-amber-100/80 rounded p-1 transition-colors cursor-pointer ml-1">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                </div>
            </div>
            <!-- Chevron restore button (hidden by default) — tiny corner icon only -->
            <div id="deferred-notice-restore" style="display:none; margin-bottom:0.5rem;" class="w-full flex justify-end">
                <button type="button" onclick="showDeferredBanner()" title="แสดงการแจ้งเตือนอีกครั้ง"
                    class="w-6 h-6 flex items-center justify-center text-amber-400 hover:text-amber-600 transition-colors cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                    </svg>
                </button>
            </div>

        }

        <!-- Total + Save Buttons -->
        <div class="flex items-center justify-between gap-4 pt-3 border-t border-slate-200 flex-wrap">
            <div>
                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">ยอดรวมชำระจริงเดือนนี้</div>
                <div class="text-lg font-black text-slate-800" id="cart-total">฿@deferredCarryOverOrders.Sum(x => x.TotalPrice).ToString("N2")</div>
                @if (deferredCarryOverOrders.Any())
                {
                    <div class="text-[10px] text-amber-700 font-semibold mt-0.5">
                        <span>รวมยอดตัดจ่ายอัตโนมัติ @deferredCarryOverOrders.Count รายการ</span>
                    </div>
                }
            </div>
            <div class="flex items-center gap-3.5 flex-wrap">
                @if (Model.IsFutureMonth)
                {
                    <div class="flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 border border-slate-200 text-slate-400 text-xs font-semibold cursor-not-allowed select-none" title="ยังไม่ถึงรอบเดือนนี้ กรุณาข้ามเวลาไปยังเดือนนั้นก่อน">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
                        </svg>
                        ยังไม่ถึงรอบเดือนนี้
                    </div>
                }
                else
                {
                    <button type="button" id="save-btn" @(deferredCarryOverOrders.Any() ? "" : "disabled")
                            title="บันทึกรายการ"
                            class="px-6 py-2.5 rounded-lg font-bold text-xs text-white bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:cursor-not-allowed active:scale-95 transition-all cursor-pointer shadow-sm whitespace-nowrap">
                        บันทึกรายการ
                    </button>
                }
            </div>
        </div>
    </div>
</div>
</div><!-- /split screen -->
</div>

<!-- ── Custom Modal: นำเข้าใบตอบกลับจากฝ่ายผลิต (Auto-Match) ── -->
<div id="import-feedback-modal-overlay" class="fixed inset-0 bg-slate-900/50 backdrop-blur-[2px] z-[100] hidden items-center justify-center p-4">
    <div id="import-feedback-modal-card" class="bg-white rounded-xl border border-slate-200 shadow-2xl max-w-lg w-full overflow-hidden transform scale-95 opacity-0 transition-all duration-200">
        
        <!-- Modal Header -->
        <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/70 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div>
                    <h3 class="text-sm font-bold text-slate-800">นำเข้าใบตอบกลับจากฝ่ายผลิต</h3>
                </div>
            </div>
            <button type="button" onclick="closeImportFeedbackModal()" class="text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg p-1.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-5 space-y-4">

            <!-- Condition Banner -->
            <div class="p-3 bg-emerald-50/50 border border-emerald-200/70 rounded-lg space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-emerald-900 flex items-center gap-1.5">
                        <span>เงื่อนไขการตรวจจับในไฟล์:</span>
                    </span>
                    <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded">ระบบตรวจจับให้อัตโนมัติ</span>
                </div>
                <div class="text-[11px] text-emerald-800 space-y-1">
                    <div class="flex items-start gap-1.5">
                        <span class="text-emerald-600 font-bold">•</span>
                        <span>แท็บ <b>งานส่งมอบแล้ว (งบหน่วยงาน)</b> ➔ ระบบจะปรับสถานะเป็นรับสินค้าทันที (ReceivedFull) และดึงเข้าตะกร้าฝั่งขวา</span>
                    </div>
                </div>
            </div>

            <!-- Upload Dropzone Area -->
            <div id="import-dropzone" onclick="document.getElementById('import-file-input').click()" class="border-2 border-dashed border-slate-300 hover:border-emerald-500 bg-slate-50/50 hover:bg-emerald-50/30 rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-all text-center select-none">
                <input type="file" id="import-file-input" accept=".xlsx, .xls" class="hidden" />
                
                <div class="w-12 h-12 rounded-full bg-emerald-100/70 text-emerald-700 flex items-center justify-center mb-2.5">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
                    </svg>
                </div>
                <p class="text-xs font-semibold text-slate-700 mb-1">
                    ลากและวางไฟล์ที่นี่ หรือ <span class="text-emerald-600 underline font-bold">คลิกเพื่อเลือกไฟล์</span>
                </p>
                <p class="text-[11px] text-slate-400">รองรับไฟล์ Excel (.xlsx, .xls) ตอบกลับจากฝ่ายผลิต</p>
            </div>

            <!-- Selected File Details Card (Hidden until file selected) -->
            <div id="import-file-card" class="hidden bg-emerald-50/60 border border-emerald-200 rounded-lg p-3 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-9 h-9 rounded bg-white border border-emerald-200 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-bold text-slate-800 truncate" id="import-file-name">ไฟล์ตัวอย่าง.xlsx</p>
                        <p class="text-[10px] text-emerald-700 font-medium" id="import-file-size">0 KB</p>
                    </div>
                </div>
                <button type="button" onclick="resetImportFileInput()" class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-2.5 py-1 rounded transition-colors shrink-0 cursor-pointer">
                    เปลี่ยนไฟล์
                </button>
            </div>

            <!-- Sheet Detection & Mapping Box (Hidden until file selected & parsed) -->
            <div id="import-sheets-container" class="hidden space-y-2.5 pt-1 border-t border-slate-100">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                        <span>ผลการตรวจจับชีทในไฟล์:</span>
                    </span>
                    <span id="import-sheets-badge" class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded flex items-center gap-1">
                        <span>ตรวจพบตรงตามเงื่อนไขอัตโนมัติ</span>
                        <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    </span>
                </div>

                <!-- Mapping Row: Delivered (งานส่งมอบแล้ว (งบหน่วยงาน)) -->
                <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-lg flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></div>
                        <div>
                            <span class="block text-xs font-bold text-slate-800">แท็บงานส่งมอบแล้ว (งบหน่วยงาน)</span>
                            <span class="block text-[10px] text-slate-500">ปรับเป็น: รับสินค้าทันที (ReceivedFull)</span>
                        </div>
                    </div>
                    <select id="import-select-delivered" class="text-xs font-semibold border border-slate-300 rounded px-2.5 py-1.5 bg-white text-slate-700 focus:ring-1 focus:ring-emerald-500 outline-none w-full sm:w-64 shadow-2xs cursor-pointer">
                        <option value="">-- ไม่พบชีท --</option>
                    </select>
                </div>
            </div>

            <!-- Error message if any -->
            <p id="import-error-msg" class="text-xs text-rose-600 font-semibold hidden"></p>
        </div>

        <!-- Modal Footer -->
        <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-3">
            <span class="text-[11px] text-slate-400" id="import-status-text">กรุณาเลือกไฟล์ Excel</span>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeImportFeedbackModal()" class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-200/60 bg-white border border-slate-200 transition-colors cursor-pointer">
                    ยกเลิก
                </button>
                <button type="button" id="btn-process-import" onclick="processImportMatch()" disabled class="px-5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:cursor-not-allowed shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
                    <span>อัปโหลดและจับคู่ข้อมูล</span>
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script type="text/javascript">
        // ─── Tab switching ────────────────────────────────────────────────────────────
        function switchTab(tab) {
            const pendingPanel = document.getElementById('panel-pending');
            const savedPanel = document.getElementById('panel-saved');
            const searchWrap = document.getElementById('search-wrap');
            const btnPending = document.getElementById('tab-pending');
            const btnSaved = document.getElementById('tab-saved');
            const badgePending = document.getElementById('tab-pending-count');
            const badgeSaved = document.getElementById('tab-saved-count');
            const pendingToolbar = document.getElementById('bulk-actions-toolbar');
            const savedToolbar = document.getElementById('saved-actions-toolbar');

            if (tab === 'pending') {
                pendingPanel.classList.remove('hidden');
                savedPanel.classList.add('hidden');
                searchWrap.classList.remove('hidden');
                if (pendingToolbar) pendingToolbar.classList.remove('hidden');
                if (savedToolbar) savedToolbar.classList.add('hidden');
                // pending = active (amber)
                btnPending.style.cssText = 'background:#fffbeb;border-color:#fcd34d;color:#92400e;';
                btnSaved.style.cssText = 'background:#f8fafc;border-color:#e2e8f0;color:#94a3b8;';
                badgePending.style.cssText = 'background:#fbbf24;color:#78350f;';
                badgeSaved.style.cssText = 'background:#e2e8f0;color:#475569;';
                // Reset pending sort & search, then re-apply filter
                const pendingSort = document.getElementById('pending-sort-select');
                if (pendingSort) pendingSort.value = 'default';
                const searchPending = document.getElementById('search-pending');
                if (searchPending) searchPending.value = '';
                toggleClearSearchBtn();
                applyPendingFilters();
            } else {
                savedPanel.classList.remove('hidden');
                pendingPanel.classList.add('hidden');
                searchWrap.classList.remove('hidden');
                if (pendingToolbar) pendingToolbar.classList.add('hidden');
                if (savedToolbar) savedToolbar.classList.remove('hidden');
                // saved = active (emerald)
                btnSaved.style.cssText = 'background:#ecfdf5;border-color:#6ee7b7;color:#065f46;';
                btnPending.style.cssText = 'background:#f8fafc;border-color:#e2e8f0;color:#94a3b8;';
                badgeSaved.style.cssText = 'background:#34d399;color:#064e3b;';
                badgePending.style.cssText = 'background:#e2e8f0;color:#475569;';
                // Reset saved action filter to "all" & search, then re-apply filter
                const savedSelect = document.getElementById('saved-action-select');
                if (savedSelect) savedSelect.value = 'all';
                const searchSaved = document.getElementById('search-pending');
                if (searchSaved) searchSaved.value = '';
                toggleClearSearchBtn();
                applySavedFilters();
            }
        }

        // ─── State ────────────────────────────────────────────────────────────────────
        const isCurrentMonthPage = @(Model.IsCurrentMonth ? "true" : "false");
        const IS_FUTURE_MONTH = @(Model.IsFutureMonth ? "true" : "false");
        const cart = {}; // orderId → { poNumber, orderName, price, department, delivery, action, actionPrice }
        const CART_STORAGE_KEY = `costflow_cart_${'@Html.Raw(Model.MonthYear)'}`;

        const LOCKED_DEFERRED_ORDERS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(deferredCarryOverOrders.Select(o => new {
            orderId = o.OrderId,
            poNumber = o.PoNumber,
            orderName = o.OrderName,
            price = o.TotalPrice,
            quantity = o.Quantity,
            department = o.Department,
            delivery = o.DeliveryTarget,
            forwardedStatus = o.ForwardedStatus,
            forwardedFrom = o.ForwardedFromMonth,
            originalMonth = o.OriginalMonth,
            action = "ReceivedFull",
            actionPrice = o.TotalPrice,
            isStockReceived = true,
            isLocked = true
        })));

        function saveCartToStorage() {
            try {
                localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
            } catch (e) { console.error('Failed to save cart to storage', e); }
        }

        function loadCartFromStorage() {
            try {
                // 1. โหลดรายการที่ผู้ใช้เลือกไว้เองจาก localStorage (ยกเว้นรายการที่ระบบล็อกไว้)
                const stored = localStorage.getItem(CART_STORAGE_KEY);
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (parsed && typeof parsed === 'object') {
                        Object.keys(parsed).forEach(orderId => {
                            if (LOCKED_DEFERRED_ORDERS.some(l => l.orderId === orderId)) return;

                            const item = parsed[orderId];
                            const card = document.querySelector(`.order-card[data-order-id="${orderId}"]`);
                            if (card && card.style.display !== 'none' && !card.classList.contains('in-cart')) {
                                if (!item.quantity && card.dataset.quantity) {
                                    item.quantity = parseInt(card.dataset.quantity) || 1;
                                }
                                cart[orderId] = item;
                                card.classList.add('in-cart');
                                const btn = card.querySelector('.add-btn');
                                if (btn) btn.textContent = '✓ เพิ่มแล้ว';
                                const lockedReq = card.querySelector('.btn-locked-requested');
                                if (lockedReq) {
                                    lockedReq.innerHTML = `<svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg> ✓ จับคู่แล้ว`;
                                    lockedReq.className = 'btn-locked-requested px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1 select-none cursor-default';
                                    lockedReq.title = 'จับคู่กับใบตอบกลับจากฝ่ายผลิตแล้ว';
                                }
                                
                                renderCartItem(orderId);
                            }
                        });
                    }
                }

                // 2. บรรจุรายการผ่อนชำระต่อเนื่อง (13 รายการ) เข้าตะกร้าและล็อกไว้เสมอ
                LOCKED_DEFERRED_ORDERS.forEach(item => {
                    cart[item.orderId] = {
                        ...item,
                        action: 'ReceivedFull',
                        actionPrice: item.price,
                        isStockReceived: true,
                        isLocked: true
                    };
                    const card = document.querySelector(`.order-card[data-order-id="${item.orderId}"]`);
                    if (card) {
                        card.classList.add('in-cart', 'is-locked-deferred');
                    }
                    renderCartItem(item.orderId);
                });

                if (Object.keys(cart).length > 0) {
                    const emptyEl = document.getElementById('cart-empty');
                    if (emptyEl) emptyEl.style.display = 'none';
                }
            } catch (e) {
                console.error('Failed to load cart from storage', e);
            }
        }

        // ─── Banner Toggle ────────────────────────────────────────────────────────────
        function hideDeferredBanner() {
            const wrap = document.getElementById('deferred-notice-banner-wrap');
            const restore = document.getElementById('deferred-notice-restore');
            if (!wrap) return;
            wrap.style.maxHeight = wrap.scrollHeight + 'px'; // pin before collapsing
            requestAnimationFrame(() => {
                wrap.style.maxHeight = '0px';
                wrap.style.opacity = '0';
                wrap.style.marginBottom = '0';
            });
            setTimeout(() => {
                wrap.style.display = 'none';
                if (restore) restore.style.display = 'block';
            }, 350);
        }

        function showDeferredBanner() {
            const wrap = document.getElementById('deferred-notice-banner-wrap');
            const restore = document.getElementById('deferred-notice-restore');
            if (!wrap) return;
            if (restore) restore.style.display = 'none';
            wrap.style.display = '';
            wrap.style.maxHeight = '0px';
            wrap.style.opacity = '0';
            wrap.style.marginBottom = '0';
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    wrap.style.maxHeight = '120px';
                    wrap.style.opacity = '1';
                    wrap.style.marginBottom = '0.75rem';
                });
            });
        }

        // ─── Helpers ─────────────────────────────────────────────────────────────────
        function fmt(n) {
            return '฿' + Number(n).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function updateSummary() {
            saveCartToStorage();
            const ids = Object.keys(cart);
            const total = ids.reduce((s, id) => s + (cart[id].actionPrice || 0), 0);

            // Calculate breakdown by action type
            const receivedTotal = ids.filter(id => cart[id].action === 'ReceivedFull')
                .reduce((s, id) => s + (cart[id].actionPrice || 0), 0);
            const deferredTotal = ids.filter(id => cart[id].action === 'Deferred')
                .reduce((s, id) => s + (cart[id].actionPrice || 0), 0);
            const requestedCount = ids.filter(id => cart[id].action === 'Requested').length;
            const skippedCount = ids.filter(id => cart[id].action === 'Skipped').length;

            // Show/hide breakdown rows & container
            const breakdownContainer = document.getElementById('cart-breakdown-container');
            const hasExtraBreakdown = deferredTotal > 0 || requestedCount > 0 || skippedCount > 0;
            if (breakdownContainer) {
                breakdownContainer.style.display = hasExtraBreakdown ? 'flex' : 'none';
            }

            const deferredRow = document.getElementById('breakdown-deferred');
            const requestedRow = document.getElementById('breakdown-requested');
            const skippedRow = document.getElementById('breakdown-skipped');

            if (deferredRow) {
                if (deferredTotal > 0) {
                    deferredRow.style.display = 'flex';
                    const el = document.getElementById('total-deferred');
                    if (el) el.textContent = fmt(deferredTotal);
                } else {
                    deferredRow.style.display = 'none';
                }
            }

            if (requestedRow) {
                if (requestedCount > 0) {
                    requestedRow.style.display = 'flex';
                    const el = document.getElementById('count-requested');
                    if (el) el.textContent = requestedCount + ' รายการ';
                } else {
                    requestedRow.style.display = 'none';
                }
            }

            if (skippedRow) {
                if (skippedCount > 0) {
                    skippedRow.style.display = 'flex';
                    const el = document.getElementById('count-skipped');
                    if (el) el.textContent = skippedCount + ' รายการ';
                } else {
                    skippedRow.style.display = 'none';
                }
            }

            // Update totals
            const cartCountLabel = document.getElementById('cart-count-label');
            if (cartCountLabel) cartCountLabel.textContent = ids.length + ' รายการ';
            
            const cartTotalEl = document.getElementById('cart-total');
            if (cartTotalEl) cartTotalEl.textContent = fmt(total);
            
            const saveBtn = document.getElementById('save-btn');
            if (saveBtn) {
                saveBtn.disabled = ids.length === 0;
            }

            const allPendingCount = @Model.PendingOrders.Count;
            const closeBtn = document.getElementById('close-month-btn');
            if (closeBtn) {
                closeBtn.disabled = allPendingCount === 0;
            }

            const cartHeaderActions = document.getElementById('cart-header-actions');
            if (cartHeaderActions) {
                cartHeaderActions.style.display = ids.length > 0 ? 'flex' : 'none';
            }
        }

        // ─── Lifecycle ────────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            loadCartFromStorage();
            updateSummary();
        });

        function addToCart(btn) {
            addToCartWithAction(btn, 'ReceivedFull');
        }

        function setAllCartAction(action) {
            Object.keys(cart).forEach(orderId => {
                if (!cart[orderId].isLocked) {
                    setAction(orderId, action);
                }
            });
        }

        function clearAllCart() {
            Object.keys(cart).forEach(orderId => {
                if (!cart[orderId].isLocked) {
                    removeFromCart(orderId);
                }
            });
        }

        // ─── Render one cart item ─────────────────────────────────────────────────────
        function renderCartItem(orderId) {
            const item = cart[orderId];
            const el = document.createElement('div');
            el.className = 'cart-item border border-slate-200 rounded-lg bg-white';
            el.id = 'ci-' + orderId;
            el.dataset.id = orderId;

            // ตรวจสอบว่าเป็นรายการผ่อนชำระที่ระบบล็อกไว้หรือไม่
            if (item.isLocked) {
                const fromMonth = item.forwardedFrom || item.originalMonth;
                const fromMonthText = fromMonth
                    ? `รายการรับสินค้าจากเดือน ${fromMonth} • ตัดจ่ายรอบเดือนนี้อัตโนมัติ`
                    : `รายการรับสินค้า • ตัดจ่ายรอบเดือนนี้อัตโนมัติ`;

                el.innerHTML = `
                    <div class="p-3 pb-2.5 bg-amber-50/25 border-l-4 border-l-amber-500 rounded-r-lg">
                        <div class="flex items-start justify-between gap-2 mb-1.5">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center flex-wrap gap-1 mb-0.5">
                                    <span class="font-bold text-[13px] text-slate-800">${item.poNumber}</span>
                                </div>
                                <p class="text-xs text-slate-500 leading-snug line-clamp-2 mt-0.5">${item.orderName}</p>
                                <div class="flex items-center gap-1.5 mt-2 mb-0.5 text-[11px] leading-none">
                                    <span class="inline-flex items-center gap-1 font-medium text-amber-800 leading-none">
                                        <span>จำนวน:</span>
                                        <span class="font-bold leading-none">${(item.quantity || 1).toLocaleString()}</span>
                                        <span>ชิ้น</span>
                                    </span>
                                </div>
                            </div>
                            <div class="shrink-0 flex flex-col items-end gap-1.5">
                                <span class="font-bold text-sm text-slate-800">${fmt(item.price)}</span>
                            </div>
                        </div>

                        <p class="text-[11px] text-amber-700 mt-1 font-medium flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6.5A2.5 2.5 0 0 0 4 4.5v15"/><path d="M17 2v6"/><path d="M17 4h2"/><path d="M20 15.2V21a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><circle cx="17" cy="10" r="2"/></svg>
                            <span>${fromMonthText}</span>
                        </p>

                    </div>
                `;

                document.getElementById('cart-list').appendChild(el);
                return;
            }

            const isDeferredCarryOver = item.forwardedStatus === 'Deferred';
            const isSkippedCarryOver = item.forwardedStatus === 'Skipped';
            const isRequestedCarryOver = item.forwardedStatus === 'Requested';

            let fwdBadgeHtml = '';
            if (isDeferredCarryOver) {
                const tooltipText = item.originalMonth
                    ? `WO สั่งซื้อจาก ${item.originalMonth} • ผ่อนมาจาก ${item.forwardedFrom}`
                    : `ผ่อนมาจาก ${item.forwardedFrom}`;
                fwdBadgeHtml = `<span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-800 cursor-help" title="${tooltipText}">ผ่อนชำระต่อเนื่อง</span>`;
            } else if (isSkippedCarryOver) {
                const tooltipText = item.originalMonth
                    ? `WO สร้างจาก ${item.originalMonth} • ค้างมาจาก ${item.forwardedFrom}`
                    : `ค้างมาจาก ${item.forwardedFrom}`;
                fwdBadgeHtml = `<span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-purple-100 text-purple-700 cursor-help" title="${tooltipText}">ค้างยกยอดมา</span>`;
            } else if (isRequestedCarryOver) {
                fwdBadgeHtml = `<span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-100 text-blue-700 cursor-help">แผนขอรับของ</span>`;
            }

            const isRec = item.action === 'ReceivedFull';
            const isDef = item.action === 'Deferred';
            const isReq = item.action === 'Requested';
            const isSkip = item.action === 'Skipped';

            const receiveClass = isRec ? 'action-pill active-receive' : 'action-pill';
            const deferClass = isDef ? 'action-pill active-defer' : 'action-pill';
            const reqClass = isReq ? 'action-pill active-request' : 'action-pill';
            const skipClass = isSkip ? 'action-pill active-skip' : 'action-pill';

            const actionContentHtml = `
                <div class="flex items-center flex-wrap gap-1.5" id="pills-${orderId}">
                    <label class="${receiveClass}" id="pill-receive-${orderId}" onclick="setAction('${orderId}','ReceivedFull')">
                        <input type="radio" name="act_${orderId}" value="ReceivedFull" ${isRec ? 'checked' : ''} onclick="event.stopPropagation()" onchange="setAction('${orderId}','ReceivedFull')">
                        <span>รับสินค้า (ชำระแล้ว)</span>
                        <span class="font-bold ml-1">${fmt(item.price)}</span>
                    </label>
                    <label class="${deferClass}" id="pill-defer-${orderId}" onclick="setAction('${orderId}','Deferred')">
                        <input type="radio" name="act_${orderId}" value="Deferred" ${isDef ? 'checked' : ''} onclick="event.stopPropagation()" onchange="setAction('${orderId}','Deferred')">
                        <span>รับสินค้า (ยังไม่ชำระ)</span>
                        <span class="font-bold ml-1">${fmt(item.price)}</span>
                    </label>
                    <label class="${reqClass}" id="pill-request-${orderId}" onclick="setAction('${orderId}','Requested')">
                        <input type="radio" name="act_${orderId}" value="Requested" ${isReq ? 'checked' : ''} onclick="event.stopPropagation()" onchange="setAction('${orderId}','Requested')">
                        <span>ต้องการรับของ</span>
                    </label>
                    <label class="${skipClass}" id="pill-skip-${orderId}" onclick="setAction('${orderId}','Skipped')">
                        <input type="radio" name="act_${orderId}" value="Skipped" ${isSkip ? 'checked' : ''} onclick="event.stopPropagation()" onchange="setAction('${orderId}','Skipped')">
                        <span>ยังไม่รับสินค้า</span>
                    </label>
                </div>
                <p class="text-[11px] text-amber-700 mt-1.5 font-medium" id="defer-note-${orderId}" style="display:${isDef ? 'block' : 'none'};">
                    ✓ รับของแล้ว • ยอดเงิน <b>${fmt(item.price)}</b> ยกไปตัดจ่ายเดือนหน้า
                </p>
                <p class="text-[11px] text-blue-700 mt-1.5 font-medium" id="request-note-${orderId}" style="display:${isReq ? 'block' : 'none'};">
                    บันทึกในแผนขอรับของรอบหน้า • ยังไม่ตัดงบเดือนนี้ (รอฝ่ายผลิตตอบกลับ)
                </p>
            `;

            const removeBtnHtml = `<button type="button" onclick="removeFromCart('${orderId}')" class="remove-btn" title="นำออกจากรายการที่เลือก">
                       <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                       </svg>
                   </button>`;

            el.innerHTML = `
                <div class="p-3 pb-2.5">
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center flex-wrap gap-1 mb-0.5">
                                <span class="font-bold text-[13px] text-slate-800">${item.poNumber}</span>
                                ${fwdBadgeHtml}
                            </div>
                            <p class="text-xs text-slate-500 leading-snug line-clamp-2 mt-0.5">${item.orderName}</p>
                            <div class="flex items-center gap-1.5 mt-2 mb-0.5 text-[11px] leading-none">
                                <span class="inline-flex items-center gap-1 font-medium text-blue-600 leading-none">
                                    <span>จำนวน:</span>
                                    <span class="font-bold leading-none">${(item.quantity || 1).toLocaleString()}</span>
                                    <span>ชิ้น</span>
                                </span>
                            </div>
                        </div>
                        <div class="shrink-0 flex flex-col items-end gap-1.5">
                            <span class="font-bold text-sm text-slate-700">${fmt(item.price)}</span>
                            ${removeBtnHtml}
                        </div>
                    </div>

                    <!-- Action pills / Locked state -->
                    ${actionContentHtml}
                </div>
            `;

            document.getElementById('cart-list').appendChild(el);
        }

        // ─── Remove from cart ─────────────────────────────────────────────────────────
        function removeFromCart(orderId) {
            if (cart[orderId] && cart[orderId].isLocked) return;
            delete cart[orderId];

            // Remove cart item DOM
            const ci = document.getElementById('ci-' + orderId);
            if (ci) ci.remove();

            // Re-enable pending card
            const card = document.querySelector(`.order-card[data-order-id="${orderId}"]`);
            if (card) {
                card.classList.remove('in-cart');
                const btn = card.querySelector('.add-btn');
                if (btn) btn.textContent = '+ เพิ่ม';

                const lockedReq = card.querySelector('.btn-locked-requested');
                if (lockedReq) {
                    lockedReq.innerHTML = `<svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg> รอตอบกลับ`;
                    lockedReq.className = 'btn-locked-requested px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1 select-none cursor-default';
                    lockedReq.title = 'อยู่ในสถานะต้องการรับของ รอใบตอบกลับจากฝ่ายผลิต (นำเข้า Excel เพื่อปลดล็อกและจับคู่อัตโนมัติ)';
                }
            }

            // Show empty state if cart is empty
            if (Object.keys(cart).length === 0) {
                document.getElementById('cart-empty').style.display = '';
            }

            updateSummary();
        }

        // ─── Set action ───────────────────────────────────────────────────────────────
        function setAction(orderId, action) {
            if (!cart[orderId] || cart[orderId].isLocked) return;

            cart[orderId].action = action;
            const item = cart[orderId];

            // ซิงค์สถานะ checked ของ radio element ใน DOM ให้ตรงกันเสมอ
            const radio = document.querySelector(`input[name="act_${orderId}"][value="${action}"]`);
            if (radio) {
                radio.checked = true;
            }

            // Update pill active classes
            document.getElementById('pill-receive-' + orderId)?.classList.toggle('active-receive', action === 'ReceivedFull');
            document.getElementById('pill-defer-' + orderId)?.classList.toggle('active-defer', action === 'Deferred');
            document.getElementById('pill-request-' + orderId)?.classList.toggle('active-request', action === 'Requested');
            document.getElementById('pill-skip-' + orderId)?.classList.toggle('active-skip', action === 'Skipped');
            document.getElementById('pill-receive-' + orderId)?.classList.toggle('action-pill', true);
            document.getElementById('pill-defer-' + orderId)?.classList.toggle('action-pill', true);
            document.getElementById('pill-request-' + orderId)?.classList.toggle('action-pill', true);
            document.getElementById('pill-skip-' + orderId)?.classList.toggle('action-pill', true);

            // Note visibility
            const deferNote = document.getElementById('defer-note-' + orderId);
            if (deferNote) deferNote.style.display = (action === 'Deferred') ? 'block' : 'none';

            const reqNote = document.getElementById('request-note-' + orderId);
            if (reqNote) reqNote.style.display = (action === 'Requested') ? 'block' : 'none';

            // Update action price & stock received status
            if (action === 'ReceivedFull') {
                cart[orderId].actionPrice = item.price;
                cart[orderId].isStockReceived = true;
            } else if (action === 'Deferred') {
                cart[orderId].actionPrice = 0; // รับของแล้วยังไม่จ่าย -> ไม่ตัดงบเดือนนี้ (ยกไปตัดจ่ายเดือนหน้า)
                cart[orderId].isStockReceived = true;  // รับของแล้วเข้าสต๊อกอัตโนมัติ
            } else if (action === 'Requested') {
                cart[orderId].actionPrice = 0; // แผนขอรับของ ยังไม่ตัดเงินเดือนนี้
                cart[orderId].isStockReceived = false;
            } else if (action === 'Skipped') {
                cart[orderId].actionPrice = 0;
                cart[orderId].isStockReceived = false;
            }

            updateSummary();
        }


        // ─── Bulk Select & Actions ───────────────────────────────────────────────────
        function toggleSelectAllPending(chk) {
            const isChecked = chk.checked;
            document.querySelectorAll('.pending-card-checkbox').forEach(cb => {
                const card = cb.closest('.order-card');
                if (card && card.style.display !== 'none' && !card.classList.contains('in-cart')) {
                    cb.checked = isChecked;
                }
            });
        }

        function onCardCheckboxChange() {
            const visibleCheckboxes = Array.from(document.querySelectorAll('.pending-card-checkbox')).filter(cb => {
                const card = cb.closest('.order-card');
                return card && card.style.display !== 'none' && !card.classList.contains('in-cart');
            });

            const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
            const selectAll = document.getElementById('select-all-pending');
            if (selectAll) {
                selectAll.checked = visibleCheckboxes.length > 0 && checkedCount === visibleCheckboxes.length;
            }
        }

        // ─── Bulk Select & Actions for Saved Tab ──────────────────────────────────
        function toggleSelectAllSaved(chk) {
            const isChecked = chk.checked;
            // เลือกเฉพาะ card ที่ visible (ไม่ถูก filter ซ่อน)
            document.querySelectorAll('.saved-card').forEach(card => {
                if (card.style.display !== 'none') {
                    const cb = card.querySelector('.saved-card-checkbox');
                    if (cb) cb.checked = isChecked;
                }
            });
            onSavedCardCheckboxChange();
        }

        function onSavedCardCheckboxChange() {
            // นับเฉพาะ checkbox ของ card ที่มองเห็น
            const visibleCheckboxes = Array.from(document.querySelectorAll('.saved-card')).filter(card => card.style.display !== 'none').map(card => card.querySelector('.saved-card-checkbox')).filter(Boolean);
            const checkedBoxes = visibleCheckboxes.filter(cb => cb.checked);
            const count = checkedBoxes.length;

            const selectAll = document.getElementById('select-all-saved');
            if (selectAll) {
                selectAll.checked = visibleCheckboxes.length > 0 && count === visibleCheckboxes.length;
            }

            const countEl = document.getElementById('saved-selected-count');
            if (countEl) countEl.textContent = `เลือกแล้ว ${count} รายการ`;

            const btn = document.getElementById('bulk-cancel-saved-btn');
            if (btn) btn.disabled = count === 0;
        }

        async function bulkCancelSavedActions() {
            const checkedBoxes = Array.from(document.querySelectorAll('.saved-card-checkbox')).filter(cb => cb.checked);
            if (!checkedBoxes.length) return;

            const actionIds = checkedBoxes.map(cb => cb.dataset.actionId);
            const count = actionIds.length;

            const noticeText = isCurrentMonthPage
