                    confirmButtonText: 'รับทราบ',
                    confirmButtonColor: '#64748b',
                    customClass: { popup: 'rounded-xl' }
                });
                return;
            }

            const ids = Object.keys(cart);
            const allPendingIds = @Html.Raw(Json.Serialize(Model.PendingOrders.Select(o => o.OrderId)));

            if (!ids.length) {
                await Swal.fire({
                    title: 'คำเตือน',
                    text: 'กรุณาเลือกอย่างน้อย 1 รายการเพื่อบันทึก',
                    confirmButtonColor: '#059669'
                });
                return;
            }

            const total = ids.reduce((s, id) => s + (cart[id].actionPrice || 0), 0);

            const confirmHtml = `คุณกำลังจะบันทึก <b>${ids.length} รายการ</b> ที่เลือก<br><span class="text-slate-600 text-sm font-semibold">ยอดรวมชำระจริงเดือนนี้: ${fmt(total)}</span><br><br><span class="text-xs text-slate-500">* รายการที่เลือกจะย้ายไปแท็บบันทึกแล้ว รายการที่ไม่เลือกจะคงอยู่รอดำเนินการ</span>`;

            const result = await Swal.fire({
                title: 'ยืนยันการบันทึกรายการ',
                html: confirmHtml,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'ยืนยันบันทึก',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                customClass: {
                    popup: 'rounded-xl'
                }
            });

            if (!result.isConfirmed) return;

            // แสดงหน้าจอรอ (Loading Spinner) ระหว่างส่งข้อมูลไป SQLite และ Google Sheets
            Swal.fire({
                title: 'กำลังบันทึกข้อมูล...',
                html: '<div class="py-2"><p class="text-sm text-slate-600 mb-1">ระบบกำลังบันทึกข้อมูลลงฐานข้อมูลและส่งสำรองไปยัง Google Sheets</p><p class="text-xs text-slate-400">กรุณารอสักครู่ ห้ามปิดหรือรีเฟรชหน้าต่างนี้...</p></div>',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                customClass: { popup: 'rounded-xl' },
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const payloadActions = ids.map(id => ({
                    orderId: cart[id].orderId,
                    action: cart[id].action,
                    price: cart[id].actionPrice,
                    isStockReceived: !!cart[id].isStockReceived
                }));

                const resp = await fetch('/MonthlyCost/SaveActions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        monthYear: MONTH_YEAR,
                        allPendingOrderIds: allPendingIds,
                        actions: payloadActions,
                        isCloseMonth: false
                    })
                });

                const data = await resp.json();
                if (data.success) {
                    try { localStorage.removeItem(CART_STORAGE_KEY); } catch (e) {}
                    await Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ!',
                        text: `บันทึกรายการเรียบร้อยแล้ว (${ids.length} รายการ)`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    location.reload();
                } else {
                    await Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: data.error || 'ไม่สามารถบันทึกรายการได้'
                    });
                }
            } catch (e) {
                await Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์'
                });
            }
        }

