@model CostFlow.Models.MonthlySummaryViewModel
@{
    ViewData["Title"] = "สรุปค่าใช้จ่ายประจำปี";
    ViewData["HeaderTitle"] = "สรุปค่าใช้จ่ายประจำปี";
    var availableYears = ViewBag.AvailableYears as List<int> ?? new List<int>();
    var selectedYear = (int)(ViewBag.SelectedYear ?? DateTime.Now.Year);
    var now = DateTime.Now;
    var currentMonthKey = now.ToString("yyyy-MM");
}

<div class="flex-1 flex flex-col min-h-0 bg-slate-50 items-center"
     style="padding: 2rem clamp(1.5rem, 10vw, 12rem);">

    <div class="w-full max-w-5xl flex-1 flex flex-col min-h-0">

        <!-- ── Compact Header & KPI Pills ──────────────────────────────────── -->
        <div class="shrink-0 flex flex-col xl:flex-row xl:items-center justify-between gap-4 mb-6">

            <!-- Left: Title & Subtitle -->
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-slate-400 font-medium">สรุปค่าใช้จ่าย</span>
                    <span class="text-slate-300">/</span>
                    <h1 class="text-lg font-bold text-slate-800">
                        ประจำปี พ.ศ. @(selectedYear + 543)
                    </h1>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">Annual Financial Ledger & Settlement</p>
            </div>

            <!-- Right: KPI Pills & Controls -->
            <div class="flex flex-wrap items-center justify-start xl:justify-end gap-3 sm:gap-2 flex-1 xl:flex-none">

                <div class="flex flex-wrap items-center gap-2">
                    <!-- หนี้คงเหลือ -->
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded border border-rose-200 bg-rose-50/50">
                        <span class="text-[11px] font-medium text-rose-700">หนี้คงเหลือสะสม</span>
                        <span class="text-[11px] font-bold text-rose-900">฿@Model.CurrentDebt.ToString("N2")</span>
                    </div>

                    <!-- จ่ายจริง -->
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded border border-emerald-200 bg-emerald-50/50">
                        <span class="text-[11px] font-medium text-emerald-700">จ่ายจริงทั้งปี</span>
                        <span class="text-[11px] font-bold text-emerald-900">฿@Model.GrandTotal.ToString("N2")</span>
                    </div>

                    <!-- รับสินค้า -->
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded border border-blue-200 bg-blue-50/50">
                        <span class="text-[11px] font-medium text-blue-700">รับสินค้า (จ่ายเต็ม)</span>
                        <span class="text-[11px] font-bold text-blue-900">฿@Model.TotalReceived.ToString("N2")</span>
                    </div>

                    <!-- ผ่อนชำระ -->
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded border border-amber-200 bg-amber-50/50">
                        <span class="text-[11px] font-medium text-amber-700">ผ่อนชำระสะสม</span>
                        <span class="text-[11px] font-bold text-amber-900">฿@Model.TotalDeferred.ToString("N2")</span>
                    </div>
                </div>

                <!-- Divider & Selector (Pushed to right) -->
                <div class="flex items-center gap-2 ml-auto xl:ml-0">
                    <!-- Divider -->
                    <div class="w-px h-6 bg-slate-200 mx-1 hidden sm:block"></div>

                    <!-- Year Selector Custom Dropdown -->
                    <div class="relative">
                        <button type="button" onclick="document.getElementById('year-dropdown').classList.toggle('hidden')"
                                onblur="setTimeout(() => document.getElementById('year-dropdown').classList.add('hidden'), 200)"
                                class="flex items-center justify-between min-w-[100px] pl-3 pr-2 py-1.5 border border-slate-200 rounded text-xs font-bold text-slate-700 bg-white hover:bg-slate-50 focus:border-slate-400 outline-none cursor-pointer transition-colors">
                            <span>ปี @(selectedYear + 543)</span>
                            <svg class="w-3 h-3 text-slate-400 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                            </svg>
                        </button>

                        <div id="year-dropdown" class="hidden absolute right-0 mt-1 min-w-full bg-white border border-slate-200 rounded-md shadow-lg z-50 overflow-hidden">
                            <ul class="py-1 flex flex-col">
                                @foreach (var y in availableYears)
                                {
                                    <li>
                                        <a href="/MonthlyCost/Summary?year=@y"
                                           class="block px-3 py-2 text-xs font-medium @(y == selectedYear ? "bg-blue-50 text-blue-700 font-bold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                                            ปี @(y + 543)
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Ledger Table for Accountants (Row-by-Row Analysis) ── -->
        <div class="flex-1 bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden flex flex-col min-h-0">
            <!-- Table Toolbar -->
            <div class="shrink-0 px-5 py-3.5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                <span class="text-sm font-bold text-slate-700 uppercase tracking-wider">สมุดบัญชีแยกรายเดือน (Monthly Cost Register)</span>
                <span class="text-xs font-semibold text-slate-400 uppercase">หน่วย: บาท (THB)</span>
            </div>

            <!-- Table Container -->
            <div class="flex-1 overflow-auto">
                <table class="w-full text-sm text-left border-collapse">
                    <thead>
                    <tr class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-200 bg-slate-50/50 sticky top-0 bg-white z-10">
                        <th class="px-5 py-3 w-40">เดือน</th>
                        <th class="px-4 py-3 text-center w-32">สถานะ</th>
                        <th class="px-4 py-3 text-right">ผ่อนชำระยกมา (จากเดือนก่อน)</th>
                        <th class="px-4 py-3 text-right">จ่ายเต็มในเดือนนี้</th>
                        <th class="px-4 py-3 text-right font-semibold text-slate-750">ยอดจ่ายจริง</th>
                        <th class="px-5 py-3 text-center w-28">การจัดการ</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-150 text-slate-600">
                    @foreach (var row in Model.Rows)
                    {
                        var isCurrent = row.MonthKey == currentMonthKey;
                        var isPast = string.Compare(row.MonthKey, currentMonthKey) < 0;
                        var hasData = row.HasData;
                        var hasCarryOver = row.CarryOverDeferredCount > 0;

                        // Row background styling: highlight current month subtly, gray out empty future months
                        string rowClass = "hover:bg-slate-50/80 transition-colors duration-150";
                        if (isCurrent)
                        {
                            rowClass = "bg-blue-50/30 hover:bg-blue-50/50 font-semibold";
                        }
                        else if (!hasData && !hasCarryOver && !isPast)
                        {
                            rowClass = "opacity-45 hover:bg-slate-50/80";
                        }

                        <tr class="@rowClass">
                            <!-- Month Name -->
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-2">
                                    @if (isCurrent)
                                    {
                                        <span class="text-slate-800 font-bold">@row.MonthDisplay</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-600">@row.MonthDisplay</span>
                                    }
                                </div>
                            </td>

                            <!-- Status Badge -->
                            <td class="px-4 py-3.5 text-center">
                                @if (isCurrent)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-100 text-blue-700 uppercase tracking-wider">
                                        เดือนปัจจุบัน
                                    </span>
                                }
                                else if (hasData)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700 uppercase tracking-wider">
                                        บันทึกแล้ว
                                    </span>
                                }
                                else if (hasCarryOver)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 text-amber-700 uppercase tracking-wider animate-pulse">
                                        รอรับสินค้า
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-50 text-slate-300 uppercase tracking-wider">
                                        ไม่มีรายการ
                                    </span>
                                }
                            </td>

                            <!-- ผ่อนสะสมยกมา -->
                            <td class="px-4 py-3.5 text-right">
                                @if (hasCarryOver)
                                {
                                    <span class="text-amber-700 font-semibold">฿@row.CarryOverDeferredAmount.ToString("N2")</span>
                                    <span class="text-xs text-slate-400 block font-sans">@row.CarryOverDeferredCount รายการ</span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- จ่ายเต็มในเดือนนี้ -->
                            <td class="px-4 py-3.5 text-right">
                                @if (row.ReceivedCount > 0)
                                {
                                    <span class="text-slate-750">฿@row.ReceivedAmount.ToString("N2")</span>
                                    <span class="text-xs text-slate-400 block font-sans">@row.ReceivedCount รายการ</span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>


                            <!-- ยอดจ่ายจริง -->
                            <td class="px-4 py-3.5 text-right font-bold text-slate-800">
                                @if (hasData || hasCarryOver)
                                {
                                    <span>฿@row.TotalPaid.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="px-5 py-3.5 text-center">
                                @if (isCurrent || hasData || hasCarryOver || isPast)
                                {
                                    <a href="/MonthlyCost/Detail/@row.MonthDisplay"
                                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md text-xs font-bold text-blue-700 bg-blue-50 hover:bg-blue-600 hover:text-white transition-all duration-150">
                                        จัดการ
                                    </a>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-300 font-medium">ยังไม่เปิด</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- Ledger Table Layout — no scripts required -->
}
