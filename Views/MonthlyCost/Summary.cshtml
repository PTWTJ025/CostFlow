@model CostFlow.Models.YearlyOrderSummaryViewModel
@{
    ViewData["Title"] = "รายการสั่งซื้อประจำปี";
    ViewData["HeaderTitle"] = "รายการสั่งซื้อประจำปี";
    var selectedYear = Model.SelectedYear;
}

<div class="flex-1 p-md md:p-lg flex flex-col gap-md max-w-container-max mx-auto w-full">

    <!-- ── Header & Year Selector ──────────────────────────────────── -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-md mb-xs">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-slate-400 font-medium text-sm">รายการสั่งซื้อ</span>
                <span class="text-slate-300">/</span>
                <h1 class="text-xl font-bold text-slate-800">
                    ประจำปี พ.ศ. @(selectedYear + 543)
                </h1>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">สรุปรายการสั่งซื้อทั้งหมด การจัดการรับสินค้า และผ่อนชำระ</p>
        </div>

        <!-- Year Selector Dropdown -->
        <div class="relative">
            <button type="button" onclick="document.getElementById('year-dropdown').classList.toggle('hidden')"
                    onblur="setTimeout(() => document.getElementById('year-dropdown').classList.add('hidden'), 200)"
                    class="flex items-center justify-between min-w-[130px] px-3 py-1.5 border border-slate-200 rounded-md text-xs font-bold text-slate-700 bg-white hover:bg-slate-50 shadow-xs outline-none cursor-pointer transition-all gap-2">
                <span>ปี @(selectedYear + 543)</span>
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>

            <div id="year-dropdown" class="hidden absolute right-0 mt-1 w-full bg-white rounded-lg shadow-lg z-50 overflow-hidden border border-slate-100">
                <ul class="py-1 flex flex-col">
                    @foreach (var y in Model.AvailableYears)
                    {
                        <li>
                            <a href="/MonthlyCost/Summary?year=@y"
                               class="block px-4 py-2 text-xs font-medium @(y == selectedYear ? "bg-blue-50 text-blue-700 font-bold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                                ปี @(y + 543)
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- ── Custom Toolbar: Filters & KPI Summary Badges & Excel Export ──────────────────────────── -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-3 sm:p-4 custom-toolbar flex items-center justify-between gap-2 overflow-x-auto scrollbar-none">
        <!-- Left Side: Search, Month and Status Dropdown Filters -->
        <div class="flex items-center gap-2 shrink">
            <!-- Search -->
            <div class="flex-1 min-w-[140px] max-w-[210px]">
                <input
                    id="po-search"
                    type="text"
                    placeholder="ค้นหาเลข PO / รายการ..."
                    class="block w-full border border-slate-200 rounded-md outline-none transition-all bg-white text-slate-700 text-xs shadow-2xs focus:border-primary focus:ring-1 focus:ring-primary"
                    style="height: 32px; padding: 6px 10px; font-size: 12px;">
            </div>
            <!-- Status Filter Dropdown
            <div class="flex-1 min-w-[120px] max-w-[150px]">
                <select id="filter-status" onchange="onStatusSelectChange()" class="block w-full border border-slate-200 rounded-md outline-none transition-all bg-white text-slate-700 cursor-pointer font-medium text-xs shadow-2xs hover:border-slate-300 focus:border-primary" style="height: 32px; padding: 4px 8px; font-size: 12px;">
                    <option value="all">ทุกสถานะ</option>
                    <option value="ReceivedFull">รับสินค้าแล้ว</option>
                    <option value="Deferred">ผ่อนชำระ</option>
                    <option value="Skipped">ยังไม่รับสินค้า</option>
                </select>
            </div> -->
        </div>

        <!-- Right Side: KPI Summary Badges & Action Buttons -->
        <div class="custom-toolbar-right flex items-center gap-2 shrink-0 ml-auto">
            <!-- KPI Summary Badges with Lucide Icons -->
            <div class="flex items-center gap-1.5 shrink-0">
                <div class="inline-flex items-center gap-1.5 px-2.5 text-xs font-semibold rounded-md text-blue-700 border border-blue-200 select-none whitespace-nowrap transition-all status-badge-pill cursor-pointer" data-filter="all" title="คลิกเพื่อกรองทั้งหมด" style="height: 34px;">
                    <svg class="w-3.5 h-3.5 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
                    </svg>
                    <span>ทั้งหมด</span>
                    <span class="font-bold px-1.5 py-0.5 text-blue-800 text-[11px] rounded shadow-2xs" id="count-all">@Model.TotalOrders</span>
                </div>
                <div class="inline-flex items-center gap-1.5 px-2.5 text-xs font-semibold rounded-md text-emerald-700 border border-emerald-200 select-none whitespace-nowrap transition-all status-badge-pill" data-filter="ReceivedFull" title="คลิกเพื่อกรองรับสินค้าแล้ว" style="height: 34px;">
                    <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                    </svg>
                    <span>รับสินค้าแล้ว</span>
                    <span class="font-bold px-1.5 py-0.5 text-emerald-800 text-[11px] rounded shadow-2xs" id="count-received">@Model.TotalReceivedCount</span>
                </div>
                <div class="inline-flex items-center gap-1.5 px-2.5 text-xs font-semibold rounded-md text-amber-700 border border-amber-200 select-none whitespace-nowrap transition-all status-badge-pill" data-filter="Deferred" title="คลิกเพื่อกรองผ่อนชำระ" style="height: 34px;">
                    <svg class="w-3.5 h-3.5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                    </svg>
                    <span>ผ่อนชำระ</span>
                    <span class="font-bold px-1.5 py-0.5 text-amber-800 text-[11px] rounded shadow-2xs" id="count-deferred">@Model.TotalDeferredCount</span>
                </div>
                <div class="inline-flex items-center gap-1.5 px-2.5 text-xs font-semibold rounded-md text-purple-700 border border-purple-200 select-none whitespace-nowrap transition-all status-badge-pill cursor-pointer" data-filter="Skipped" title="คลิกเพื่อกรองยังไม่รับสินค้า" style="height: 34px;">
                    <svg class="w-3.5 h-3.5 text-purple-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"/>
                    </svg>
                    <span>ยังไม่รับสินค้า</span>
                    <span class="font-bold px-1.5 py-0.5 text-purple-800 text-[11px] rounded shadow-2xs" id="count-skipped">@Model.TotalSkippedCount</span>
                </div>
            </div>

            <!-- Export Excel Button -->
            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" id="btn-export-excel"
                        title="ส่งออก Excel ตามตัวกรองปัจจุบัน"
                        class="flex items-center justify-center btn-custom-green shadow-sm transition-all active:scale-95 shrink-0 cursor-pointer"
                        style="width: 34px !important; height: 34px !important; padding: 0 !important;">
                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" viewBox="0 0 48 48" style="width: 18px !important; height: 18px !important;">
                        <path fill="#169154" d="M29,6H15.744C14.781,6,14,6.781,14,7.744v7.259h15V6z"></path>
                        <path fill="#18482a" d="M14,33.054v7.202C14,41.219,14.781,42,15.743,42H29v-8.946H14z"></path>
                        <path fill="#0c8045" d="M14 15.003H29V24.005000000000003H14z"></path>
                        <path fill="#17472a" d="M14 24.005H29V33.055H14z"></path>
                        <g>
                            <path fill="#29c27f" d="M42.256,6H29v9.003h15V7.744C44,6.781,43.219,6,44,6z"></path>
                            <path fill="#27663f" d="M29,33.054V42h13.257C43.219,42,44,41.219,44,40.257v-7.202H29z"></path>
                            <path fill="#19ac65" d="M29 15.003H44V24.005000000000003H29z"></path>
                            <path fill="#129652" d="M29 24.005H44V33.055H29z"></path>
                        </g>
                        <path fill="#0c7238" d="M22.319,34H5.681C4.753,34,4,33.247,4,32.319V15.681C4,14.753,4.753,14,5.681,14h16.638 C23.247,14,24,14.753,24,15.681v16.638C24,33.247,23.247,34,22.319,34z"></path>
                        <path fill="#fff" d="M9.807 19L12.193 19 14.129 22.754 16.175 19 18.404 19 15.333 24 18.474 29 16.123 29 14.013 25.07 11.912 29 9.526 29 12.719 23.982z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- ── Table Container ──────────────────────────────────── -->
    <div class="bg-white rounded border border-outline-variant shadow-sm overflow-hidden flex-1 flex flex-col min-h-0">
        <div class="overflow-x-auto">
            <table class="w-full table-compact text-sm min-w-[1200px]" id="orders-table">
                <thead class="bg-slate-100 border-b border-outline-variant">
                <tr>
                    <!-- ว.ด.ป.ที่สั่ง -->
                    <th class="text-center text-on-surface font-bold whitespace-nowrap cursor-pointer hover:bg-slate-200 transition-colors th-sortable group select-none"
                        data-sort-key="approved"
                        onclick="handleSort('approved', this)"
                        title="วันที่อนุมัติใบสั่งผลิต">
                        <div class="flex items-center justify-center gap-1 pointer-events-none">
                            <span>ว.ด.ป.ที่สั่ง</span>
                            <span class="sort-icon inline-flex items-center text-slate-400">
                                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                                </svg>
                            </span>
                        </div>
                    </th>
                    <!-- รหัสใบสั่ง -->
                    <th class="text-center text-on-surface font-bold whitespace-nowrap cursor-pointer hover:bg-slate-200 transition-colors th-sortable group select-none"
                        data-sort-key="po"
                        onclick="handleSort('po', this)"
                        title="รหัสใบสั่งผลิต (WO)">
                        <div class="flex items-center justify-center gap-1 pointer-events-none">
                            <span>รหัสใบสั่ง</span>
                            <span class="sort-icon inline-flex items-center text-slate-400">
                                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                                </svg>
                            </span>
                        </div>
                    </th>
                    <!-- รายการ -->
                    <th class="text-left text-on-surface font-bold whitespace-nowrap" style="min-width: 220px;">
                        <span>รายการ</span>
                    </th>
                    <!-- จำนวน -->
                    <th class="text-center text-on-surface font-bold whitespace-nowrap">
                        <span>จำนวน</span>
                    </th>
                    <!-- ราคา/หน่วย -->
                    <th class="text-right text-on-surface font-bold whitespace-nowrap">
                        <span>ราคา/หน่วย</span>
                    </th>
                    <!-- ราคารวม -->
                    <th class="text-right text-on-surface font-bold whitespace-nowrap cursor-pointer hover:bg-slate-200 transition-colors th-sortable group select-none"
                        data-sort-key="amount"
                        onclick="handleSort('amount', this)"
                        title="คลิกเพื่อเรียงตามมูลค่า">
                        <div class="flex items-center justify-end gap-1 pointer-events-none">
                            <span>ราคารวม (฿)</span>
                            <span class="sort-icon inline-flex items-center text-slate-400">
                                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                                </svg>
                            </span>
                        </div>
                    </th>
                    <!-- เป้าหมาย -->
                    <th class="text-center text-on-surface font-bold whitespace-nowrap" title="วันเป้าหมายส่งสินค้า">
                        <span>เป้าหมาย</span>
                    </th>
                    <!-- ว.ด.ป.ที่รับของ -->
                    <th class="text-center text-on-surface font-bold whitespace-nowrap cursor-pointer hover:bg-slate-200 transition-colors th-sortable group select-none"
                        data-sort-key="month"
                        onclick="handleSort('month', this)"
                        title="วันที่รับสินค้าจริง">
                        <div class="flex items-center justify-center gap-1 pointer-events-none">
                            <span>ว.ด.ป.ที่รับของ</span>
                            <span class="sort-icon inline-flex items-center text-slate-400">
                                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                                </svg>
                            </span>
                        </div>
                    </th>
                    <!-- สถานะ -->
                    <th class="text-center text-on-surface font-bold whitespace-nowrap">
                        <span>สถานะ</span>
                    </th>
                </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant" id="orders-tbody">
                @if (Model.Items.Count == 0)
                {
                    <tr id="empty-row">
                        <td colspan="9" class="px-5 py-16 text-center">
                            <div class="flex flex-col items-center gap-2">
                                <svg class="w-10 h-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"/>
                                </svg>
                                <p class="text-sm font-medium text-slate-400">ไม่มีรายการสั่งซื้อในปีนี้</p>
                                <p class="text-xs text-slate-300">ลองเปลี่ยนปีที่ต้องการดู</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    var groupedList = Model.Items
                        .GroupBy(i => i.Action == "Skipped" ? 99 : i.DisplayMonthNumber)
                        .Select(g => new {
                            MonthNumber = g.Key,
                            Items = g.ToList()
                        })
                        .ToList();

                    // แทรกเดือนปัจจุบันถ้ายังไม่มีในระบบ (เฉพาะกรณีดูปีปัจจุบัน)
                    var currentMonth = DateTime.Now.Month;
                    var currentYear = DateTime.Now.Year;
                    if (selectedYear == currentYear && !groupedList.Any(g => g.MonthNumber == currentMonth))
                    {
                        groupedList.Add(new {
                            MonthNumber = currentMonth,
                            Items = new System.Collections.Generic.List<CostFlow.Models.YearlyOrderItem>()
                        });
                    }

                    // เรียงเดือนล่าสุด (12) ไปเก่าสุด (1) โดยให้ Skipped (99) อยู่ล่างสุดเสมอ
                    var sortedGroups = groupedList
                        .OrderBy(g => g.MonthNumber == 99 ? 1 : 0)
                        .ThenByDescending(g => g.MonthNumber)
                        .ToList();

                    var thaiMonths = new[] { "", "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };

                    @foreach (var group in sortedGroups)
                    {
                        var isInitiallyCollapsed = group.MonthNumber == 99;
                        var groupName = group.MonthNumber == 99 
                            ? "ยังไม่กำหนดเดือนรับ/ชำระ" 
                            : (group.Items.FirstOrDefault()?.DisplayMonthDisplay ?? $"{thaiMonths[group.MonthNumber]} {selectedYear + 543}");
                        
                        var groupTotal = group.Items.Sum(i => i.Amount);
                        var groupCount = group.Items.Count;
                        var groupId = "group-" + group.MonthNumber;

                        <!-- ── Group Header ── -->
                        <tr class="bg-slate-100 hover:bg-slate-200 cursor-pointer transition-colors group-header-row select-none @(isInitiallyCollapsed ? "is-collapsed" : "")"
                            onclick="toggleGroup('@groupId')"
                            data-group-id="@groupId">
                            <td colspan="9" class="py-2.5 px-3 border-y border-slate-200 shadow-sm">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div class="p-1 rounded-md text-slate-500">
                                            <svg id="icon-@groupId" class="w-4 h-4 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="@(isInitiallyCollapsed ? "transform: rotate(-90deg);" : "")">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </div>
                                        <span class="font-bold text-slate-800 text-sm">@groupName</span>
                                        @if (group.MonthNumber == currentMonth && selectedYear == currentYear)
                                        {
                                            <span class="text-[10px] font-bold text-blue-700 bg-blue-100 px-1.5 py-0.5 rounded uppercase tracking-wider ml-1">เดือนปัจจุบัน</span>
                                        }
                                        <span class="text-xs font-medium text-slate-600 px-2 py-0.5 ml-1">@groupCount รายการ</span>
                                    </div>
                                    <div class="font-bold text-slate-900 text-sm">
                                        <span class="text-emerald-700">฿@groupTotal.ToString("N2")</span>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        if (groupCount == 0)
                        {
                            <tr class="order-row @groupId text-xs @(isInitiallyCollapsed ? "hidden hidden-by-group" : "")" style="@(isInitiallyCollapsed ? "display: none;" : "")" data-group-class="@groupId" data-month-sort="@group.MonthNumber" data-empty="true">
                                <td colspan="9" class="text-center py-6 text-slate-400 bg-slate-50/50">
                                    <p class="font-medium text-slate-500">ยังไม่มีรายการรับสินค้า/ชำระเงินในเดือนนี้</p>
                                    <p class="text-[11px] mt-0.5 text-slate-400">เมื่อมีรายการใหม่ จะแสดงผลที่นี่</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in group.Items)
                            {
                                // ตัดชื่อรายการให้สั้น
                            var shortName = item.OrderName;
                            var cutPatterns = new[] { " จำนวน", " เป้าหมาย", " แก้ไข", " (", " -" };
                            foreach (var pat in cutPatterns)
                            {
                                var idx = shortName.IndexOf(pat, System.StringComparison.OrdinalIgnoreCase);
                                if (idx > 0) { shortName = shortName.Substring(0, idx).Trim(); break; }
                            }
                            bool hasTooltip = shortName != item.FullOrderName && !string.IsNullOrEmpty(item.FullOrderName);

                            <tr class="order-row hover:bg-slate-50/80 transition-colors text-xs @groupId @(isInitiallyCollapsed ? "hidden hidden-by-group" : "")"
                                style="@(isInitiallyCollapsed ? "display: none;" : "")"
                                data-group-class="@groupId"
                                data-po="@item.PoNumber"
                                data-name="@item.OrderName"
                                data-quantity="@item.Quantity"
                                data-amount="@item.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                data-month="@(item.Action == "Skipped" ? "" : item.DisplayMonthNumber.ToString())"
                                data-month-sort="@(item.Action == "Skipped" ? 99 : item.DisplayMonthNumber)"
                                data-approved="@item.ApprovedDate"
                                data-status="@item.Action">

                                <!-- ว.ด.ป.ที่สั่ง -->
                                <td class="text-center text-slate-500 whitespace-nowrap py-3 px-3 font-mono text-[11px]">
                                    @(item.ApprovedDate == "-" ? "-" : item.ApprovedDate)
                                </td>

                                <!-- รหัสใบสั่ง -->
                                <td class="font-bold text-slate-800 text-center whitespace-nowrap py-3 px-3 font-mono">
                                    @item.PoNumber
                                </td>

                                <!-- รายการ -->
                                <td class="text-slate-700 text-left py-3 px-3 font-medium" style="min-width: 220px; max-width: 320px;">
                                    <span class="truncate block w-full cursor-help" title="@item.FullOrderName">
                                        @shortName@(hasTooltip ? "..." : "")
                                    </span>
                                </td>

                                <!-- จำนวน -->
                                <td class="text-center text-slate-600 whitespace-nowrap py-3 px-3 font-medium">
                                    @item.Quantity
                                </td>

                                <!-- ราคา/หน่วย -->
                                <td class="text-right text-slate-400 whitespace-nowrap py-3 px-3 font-mono text-[11px]">
                                    @(item.UnitPrice > 0 ? "฿" + item.UnitPrice.ToString("N2") : "-")
                                </td>

                                <!-- ราคารวม -->
                                <td class="text-right font-bold text-slate-800 whitespace-nowrap py-3 px-3 font-mono">
                                    @if (item.Amount > 0)
                                    {
                                        <span class="text-slate-900">฿@item.Amount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">-</span>
                                    }
                                </td>

                                <!-- เป้าหมาย -->
                                <td class="text-center text-slate-500 whitespace-nowrap py-3 px-3 font-mono text-[11px]">
                                    @(string.IsNullOrEmpty(item.DeliveryTarget) || item.DeliveryTarget == "-" ? "-" : item.DeliveryTarget)
                                </td>

                                <!-- ว.ด.ป.ที่รับของ -->
                                <td class="text-center whitespace-nowrap py-3 px-3 font-mono text-[11px]">
                                    @if (item.ReceivedDate == "-")
                                    {
                                        <span class="text-slate-300">-</span>
                                    }
                                    else
                                    {
                                        <span class="text-emerald-600 font-semibold">@item.ReceivedDate</span>
                                    }
                                </td>

                                <!-- สถานะ -->
                                <td class="text-center whitespace-nowrap py-3 px-3">
                                    @if (item.Action == "ReceivedFull")
                                    {
                                        <span class="inline-flex items-center justify-center gap-1 px-2.5 py-1 text-xs font-medium rounded-md whitespace-nowrap" style="background: #d1fae5; color: #059669; border: 1px solid #a7f3d0;">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                                            </svg>
                                            <span class="leading-none">รับสินค้าแล้ว</span>
                                        </span>
                                    }
                                    else if (item.Action == "Deferred")
                                    {
                                        <span class="inline-flex items-center justify-center gap-1 px-2.5 py-1 text-xs font-medium rounded-md whitespace-nowrap" style="background: #fef3c7; color: #d97706; border: 1px solid #fde68a;">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                            </svg>
                                            <span class="leading-none">ผ่อนชำระ</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center justify-center gap-1 px-2.5 py-1 text-xs font-medium rounded-md whitespace-nowrap" style="background: #f3e8ff; color: #9333ea; border: 1px solid #e9d5ff;">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"/>
                                            </svg>
                                            <span class="leading-none">ยังไม่รับสินค้า</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        } // end else (groupCount > 0)
                    } // end foreach group
                } 
                </tbody>
            </table>
        </div>

        <!-- No results container -->
        <div id="no-filter-results" class="hidden px-5 py-12 text-center border-t border-slate-100">
            <p class="text-sm font-medium text-slate-400">ไม่มีรายการที่ตรงกับตัวกรอง</p>
            <button type="button" onclick="resetFilters()" class="mt-2 text-xs text-blue-600 hover:text-blue-800 font-medium cursor-pointer">ล้างตัวกรองทั้งหมด</button>
        </div>
    </div>

</div>


@section Scripts {
<script>
    let currentStatusFilter = 'all';

    let currentSortKey = null;
    let currentSortAsc = true;

    // ── Status Filter Badges (Pills) & Dropdown Synchronization ──
    const badgePills = document.querySelectorAll('.status-badge-pill');
    badgePills.forEach(pill => {
        pill.addEventListener('click', function () {
            const filterVal = this.dataset.filter || 'all';
            const statusSelect = document.getElementById('filter-status');
            if (statusSelect) {
                statusSelect.value = filterVal;
            }
            setStatusFilter(filterVal);
        });
    });

    function onStatusSelectChange() {
        const statusSelect = document.getElementById('filter-status');
        const filterVal = statusSelect ? statusSelect.value : 'all';
        setStatusFilter(filterVal);
    }

    function setStatusFilter(filterVal) {
        currentStatusFilter = filterVal;

        badgePills.forEach(p => {
            const f = p.dataset.filter;
            if (f === currentStatusFilter) {
                p.classList.add('shadow-sm');
                if (f === 'all') p.classList.add('bg-blue-100');
                else if (f === 'ReceivedFull') p.classList.add('bg-emerald-100');
                else if (f === 'Deferred') p.classList.add('bg-amber-100');
                else if (f === 'Skipped') p.classList.add('bg-purple-100');
            } else {
                p.classList.remove('shadow-sm');
                if (f === 'all') p.classList.remove('bg-blue-100');
                else if (f === 'ReceivedFull') p.classList.remove('bg-emerald-100');
                else if (f === 'Deferred') p.classList.remove('bg-amber-100');
                else if (f === 'Skipped') p.classList.remove('bg-purple-100');
            }
        });

        applyFilters();
    }

    // ── Search & Filter Logic (Multi-PO Keyword Support) ──
    function getSearchKeywords() {
        const raw = (document.getElementById('po-search')?.value || '').toLowerCase().trim();
        if (!raw) return [];
        // แยกคำค้นหาด้วย ช่องว่าง, การขึ้นบรรทัดใหม่จาก Excel (\n, \r), ลูกน้ำ (,), อัฒภาค (;), แท็บ (\t)
        return raw.split(/[\s,;\n\r\t]+/).map(k => k.trim()).filter(k => k.length > 0);
    }

    const searchInput = document.getElementById('po-search');
    if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
        searchInput.addEventListener('paste', () => setTimeout(applyFilters, 50));
    }

    // ── Group Toggle Logic ──
    function toggleGroup(groupId) {
        const header = document.querySelector(`.group-header-row[data-group-id="${groupId}"]`);
        const icon = document.getElementById(`icon-${groupId}`);
        const rows = document.querySelectorAll(`.${groupId}`);

        const isCollapsed = header.classList.toggle('is-collapsed');
        if (isCollapsed) {
            icon.style.transform = 'rotate(-90deg)';
            rows.forEach(r => r.classList.add('hidden', 'hidden-by-group'));
        } else {
            icon.style.transform = 'rotate(0deg)';
            rows.forEach(r => r.classList.remove('hidden', 'hidden-by-group'));
        }
        applyFilters();
    }

    function applyFilters() {
        const keywords = getSearchKeywords();
        const monthVal = document.getElementById('filter-month')?.value || '';
        const groupHeaders = document.querySelectorAll('.group-header-row');
        let visibleCount = 0;

        let totalMonthCount = 0;
        let receivedCount = 0;
        let deferredCount = 0;
        let skippedCount = 0;

        const isFiltering = keywords.length > 0 || currentStatusFilter !== 'all' || monthVal !== '';

        groupHeaders.forEach(header => {
            const groupId = header.getAttribute('data-group-id');
            const rows = document.querySelectorAll(`.${groupId}`);
            let hasVisibleRow = false;

            rows.forEach(function (row) {
                const rowPo = (row.getAttribute('data-po') || '').toLowerCase();
                const rowName = (row.getAttribute('data-name') || '').toLowerCase();
                const rowMonth = row.getAttribute('data-month');
                const rowStatus = row.getAttribute('data-status');

                let matchSearch = true;
                if (keywords.length > 0) {
                    matchSearch = keywords.some(kw => rowPo.includes(kw) || rowName.includes(kw));
                }

                let matchMonth = !monthVal || rowMonth === monthVal;
                let matchStatus = currentStatusFilter === 'all' || rowStatus === currentStatusFilter;

                let show = matchSearch && matchMonth && matchStatus;

                // คำนวณ KPI เฉพาะตัวที่แสดงผลและไม่ถูกพับซ่อน (แต่ถ้า filter อยู่ เราจะอิงตาม match logic)
                if (show) {
                    hasVisibleRow = true;
                    visibleCount++;
                    totalMonthCount++;
                    if (rowStatus === 'ReceivedFull') receivedCount++;
                    else if (rowStatus === 'Deferred') deferredCount++;
                    else if (rowStatus === 'Skipped') skippedCount++;
                }

                if (row.classList.contains('hidden-by-group')) {
                    show = false; // ถ้ากลุ่มถูกพับ ก็ซ่อนไว้
                }

                row.style.display = show ? '' : 'none';
            });

            // ถ้ามีการค้นหา ให้กางกล่องอัตโนมัติเพื่อให้เห็นผลลัพธ์
            if (isFiltering && hasVisibleRow) {
                header.classList.remove('is-collapsed');
                const icon = document.getElementById(`icon-${groupId}`);
                if (icon) icon.style.transform = 'rotate(0deg)';
                rows.forEach(r => {
                    r.classList.remove('hidden', 'hidden-by-group');
                    r.style.display = ''; // force show
                });
            }

            // ซ่อนหัวข้อเดือน ถ้าข้างในไม่มีรายการไหนตรงกับตัวกรองเลย
            header.style.display = hasVisibleRow ? '' : 'none';
        });

        // อัปเดตตัวเลขบน KPI Badges ตามเดือนที่เลือก
        const countAllEl = document.getElementById('count-all');
        const countRecEl = document.getElementById('count-received');
        const countDefEl = document.getElementById('count-deferred');
        const countSkipEl = document.getElementById('count-skipped');
        if (countAllEl) countAllEl.innerText = totalMonthCount;
        if (countRecEl) countRecEl.innerText = receivedCount;
        if (countDefEl) countDefEl.innerText = deferredCount;
        if (countSkipEl) countSkipEl.innerText = skippedCount;

        // Show/hide no results
        const noResults = document.getElementById('no-filter-results');
        if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0 || @(Model.Items.Count == 0 ? "true" : "false"));
        }
    }

    function resetFilters() {
        if (searchInput) searchInput.value = '';
        const monthSel = document.getElementById('filter-month');
        if (monthSel) monthSel.value = '';
        const statusSelect = document.getElementById('filter-status');
        if (statusSelect) statusSelect.value = 'all';
        
        setStatusFilter('all');
    }

    // ── Sorting Logic ──
    function handleSort(sortKey, thElement) {
        if (!sortKey) return;
        const activeTh = thElement || document.querySelector(`.th-sortable[data-sort-key="${sortKey}"]`);

        if (currentSortKey === sortKey) {
            currentSortAsc = !currentSortAsc;
        } else {
            currentSortKey = sortKey;
            // For amount and month, first click defaults to descending (highest first)
            currentSortAsc = (sortKey === 'amount' || sortKey === 'month') ? false : true;
        }

        sortTable(sortKey, currentSortAsc);
        if (activeTh) updateSortIcons(activeTh, currentSortAsc);
    }

    const thElements = document.querySelectorAll('.th-sortable');

    function sortTable(key, asc) {
        // เรียงข้อมูล "ภายในกลุ่มเดือน" เท่านั้น เพื่อไม่ให้กลุ่มพัง
        const groupHeaders = document.querySelectorAll('.group-header-row');
        
        groupHeaders.forEach(header => {
            const groupId = header.getAttribute('data-group-id');
            const rows = Array.from(document.querySelectorAll(`.${groupId}`));
            if (rows.length === 0) return;

            rows.sort(function (a, b) {
                let valA, valB;

                switch (key) {
                    case 'approved': // ว.ด.ป. ที่สั่ง (เปรียบเทียบ string ไปก่อน)
                        valA = a.getAttribute('data-approved') || '';
                        valB = b.getAttribute('data-approved') || '';
                        return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
                    case 'po':
                        valA = a.getAttribute('data-po') || '';
                        valB = b.getAttribute('data-po') || '';
                        return asc ? valA.localeCompare(valB, undefined, { numeric: true }) : valB.localeCompare(valA, undefined, { numeric: true });
                    case 'amount':
                        valA = parseFloat(a.getAttribute('data-amount')) || 0;
                        valB = parseFloat(b.getAttribute('data-amount')) || 0;
                        return asc ? valA - valB : valB - valA;
                    case 'month':
                        // กรณี month sort อาจไม่ค่อยมีผลเมื่อจัดกลุ่มแล้ว แต่เผื่อไว้
                        valA = parseInt(a.getAttribute('data-month-sort')) || 0;
                        valB = parseInt(b.getAttribute('data-month-sort')) || 0;
                        return asc ? valA - valB : valB - valA;
                    default:
                        return 0;
                }
            });

            // แทรก rows กลับเข้าไปต่อจาก Header ตามลำดับใหม่
            let currentEl = header;
            rows.forEach(r => {
                currentEl.after(r);
                currentEl = r;
            });
        });
    }

    function updateSortIcons(activeTh, asc) {
        thElements.forEach(th => {
            const iconContainer = th.querySelector('.sort-icon');
            if (!iconContainer) return;

            if (th === activeTh) {
                th.classList.add('bg-blue-100/70', 'text-blue-700');
                if (asc) {
                    iconContainer.innerHTML = `
                        <svg class="w-3.5 h-3.5 text-blue-600 font-bold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m18 15-6-6-6 6"/>
                        </svg>`;
                } else {
                    iconContainer.innerHTML = `
                        <svg class="w-3.5 h-3.5 text-blue-600 font-bold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m6 9 6 6 6-6"/>
                        </svg>`;
                }
            } else {
                th.classList.remove('bg-blue-100/70', 'text-blue-700');
                iconContainer.innerHTML = `
                    <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m7 15 5 5 5-5"/>
                        <path d="m7 9 5-5 5 5"/>
                    </svg>`;
            }
        });
    }

    // ── Export to Excel with Prompt ──
    const btnExport = document.getElementById('btn-export-excel');
    if (btnExport) {
        btnExport.addEventListener('click', function () {
            const year = "@selectedYear";
            const month = document.getElementById('filter-month')?.value || '';
            const status = currentStatusFilter;
            const search = (document.getElementById('po-search')?.value || '').trim();

            let statusThai = 'ทั้งหมด';
            if (status === 'ReceivedFull') statusThai = 'รับสินค้าแล้ว';
            else if (status === 'Deferred') statusThai = 'ผ่อนชำระ';
            else if (status === 'Skipped') statusThai = 'ยังไม่รับสินค้า';

            const defaultFileName = `รายงานสรุปรายการสั่งซื้อ_ปี${parseInt(year) + 543}_${statusThai}`;

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'ตั้งชื่อไฟล์สำหรับส่งออก Excel',
                    input: 'text',
                    inputValue: defaultFileName,
                    inputPlaceholder: 'กรอกชื่อไฟล์...',
                    showCancelButton: true,
                    confirmButtonText: 'ดาวน์โหลด',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#059669',
                    cancelButtonColor: '#94a3b8',
                    inputValidator: (value) => {
                        if (!value || !value.trim()) {
                            return 'กรุณากรอกชื่อไฟล์ที่ต้องการบันทึก!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const customName = result.value.trim();
                        let exportUrl = `/MonthlyCost/ExportYearlySummaryExcel?year=${encodeURIComponent(year)}&status=${encodeURIComponent(status)}&customName=${encodeURIComponent(customName)}`;
                        if (month) exportUrl += `&month=${encodeURIComponent(month)}`;
                        if (search) exportUrl += `&search=${encodeURIComponent(search)}`;
                        window.location.href = exportUrl;
                    }
                });
            } else {
                let exportUrl = `/MonthlyCost/ExportYearlySummaryExcel?year=${encodeURIComponent(year)}&status=${encodeURIComponent(status)}`;
                if (month) exportUrl += `&month=${encodeURIComponent(month)}`;
                if (search) exportUrl += `&search=${encodeURIComponent(search)}`;
                window.location.href = exportUrl;
            }
        });
    }
</script>
}