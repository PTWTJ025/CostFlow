@model CostFlow.Models.MonthlyCostIndexViewModel
@{
    ViewData["Title"] = "คิดค่าใช้จ่ายประจำเดือน";
    ViewData["HeaderTitle"] = "คิดค่าใช้จ่ายประจำเดือน (จากแผนผลิต)";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">

    <!-- Page Header -->
    <div class="flex justify-between items-end mb-xs">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">คิดค่าใช้จ่ายประจำเดือน</h3>
            <p class="text-secondary text-sm">จัดการการรับสินค้าและการผ่อนชำระจากไฟล์แผนผลิต</p>
        </div>
    </div>

    <!-- Toolbar: search + sort + filter -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-3 mb-4">
        <div class="relative flex-1 max-w-sm">
            <input id="search-input" type="text" placeholder="ค้นหาเดือนหรือชื่อไฟล์..."
                   class="w-full pl-3 pr-3 py-2 border border-outline-variant rounded text-sm focus:ring-1 focus:ring-primary focus:border-primary outline-none"/>
        </div>
        <div class="flex flex-wrap gap-sm ml-auto sm:ml-auto">
            @{
                var availableYears = ViewBag.AvailableYears as List<int> ?? new List<int>();
                var selectedYear = (int)(ViewBag.SelectedYear ?? DateTime.Now.Year);
            }
            <select id="year-filter" onchange="window.location.href='/MonthlyCost?year=' + this.value" class="px-3 py-2 border border-outline-variant rounded text-xs font-semibold text-slate-600 outline-none cursor-pointer bg-white hover:border-primary/50 transition-colors">
                @foreach (var y in availableYears)
                {
                    var buddhistYear = y + 543;
                    <option value="@y" selected="@(y == selectedYear)">พ.ศ. @buddhistYear (@y)</option>
                }
            </select>

            <select id="filter-status" class="px-3 py-2 border border-outline-variant rounded text-xs font-semibold text-slate-600 outline-none cursor-pointer">
                <option value="all">ทุกสถานะ</option>
                <option value="active">กำลังดำเนินการ</option>
                <option value="completed">เสร็จสมบูรณ์</option>
                <option value="pending">ค้างดำเนินการ</option>
            </select>
        </div>
    </div>

    <!-- Monthly Cards Grid -->
    <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">

        @if (Model.Cards.Any())
        {
            foreach (var card in Model.Cards)
            {
                var statusBg = card.StatusCode == "active" ? "bg-emerald-50 text-emerald-600 border-emerald-200/60"
                    : card.StatusCode == "completed" ? "bg-blue-50 text-blue-600 border-blue-200/60"
                    : card.StatusCode == "future" ? "bg-slate-50 text-slate-500 border-slate-200/60"
                    : "bg-red-50 text-red-700 border-red-200/60";


                var progressColor = card.StatusCode == "active" ? "bg-gradient-to-r from-primary to-primary-container"
                    : card.StatusCode == "completed" ? "bg-blue-600"
                    : "bg-amber-500";

                var progressTextColor = card.StatusCode == "active" ? "text-primary"
                    : card.StatusCode == "completed" ? "text-blue-600"
                    : "text-amber-600";

                var pendingDotClass = card.PendingItems > 0 ? "animate-pulse bg-amber-500" : "bg-slate-400";
                var pendingBadgeBg = card.PendingItems > 0
                    ? "bg-amber-50 text-amber-700 border-amber-200/60"
                    : "bg-slate-100 text-slate-500 border-slate-200/60";

                var fileIconColor = card.StatusCode == "completed" ? "text-blue-600" : "text-emerald-600";

                <a asp-controller="MonthlyCost" asp-action="Detail" asp-route-id="@card.MonthYearDisplay"
                   data-month="@card.MonthYearDisplay.ToLower()"
                   data-month-key="@card.MonthYearKey"
                   data-file="@card.FileName.ToLower()"
                   data-status="@card.StatusCode"
                   data-progress="@card.ProgressPercent"
                   class="card-item group bg-white rounded-lg border border-slate-200 shadow-sm hover:shadow-md hover:border-primary/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between p-md cursor-pointer">

                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <div class="overflow-hidden flex-1">
                                <div class="flex items-center gap-2">
                                    <h4 class="font-bold text-slate-800 text-sm group-hover:text-primary transition-colors duration-300">@card.MonthYearDisplay</h4>
                                </div>
                                @if (!string.IsNullOrEmpty(card.FileName))
                                {
                                    <span class="text-[11px] text-secondary block mt-1 font-medium">
                                        <i class="fi fi-rs-file-excel @fileIconColor text-xs"></i>
                                        @card.FileName
                                    </span>
                                }
                            </div>

                            <!-- ยอดมูลค่าประจำเดือน และยอดจ่าย -->
                            <div class="shrink-0 text-right ml-3 flex flex-col items-end gap-1.5">
                                <div>
                                    <div class="text-[10px] text-slate-400 font-medium mb-0.5">มูลค่าประจำเดือน</div>
                                    <div class="text-sm font-bold text-slate-700" data-field="monthAmount">
                                        @card.MonthAmount.ToString("N2")
                                    </div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-emerald-600 font-medium mb-0.5">ยอดจ่าย</div>
                                    <div class="text-sm font-bold text-emerald-600" data-field="paidAmount">
                                        @card.ReceivedAmount.ToString("N2")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ความคืบหน้า (ไม่มี bar และ %) -->
                        <div class="mb-3">
                            <div class="text-xs font-bold text-slate-600">ความคืบหน้า</div>
                        </div>
                    </div>

                    <!-- Status Breakdown Pills -->
                    <div class="pt-3 border-t border-slate-100 flex flex-row gap-2">
                        <!-- Received Pill -->
                        <div class="flex-1 min-w-0 bg-slate-50/40 hover:bg-slate-100/60 border border-slate-200/40 rounded-lg py-2 px-2 flex flex-col items-center justify-center text-center transition-all duration-200 group/pill relative"
                             title="รับสินค้าชำระเต็ม: @card.ReceivedCount รายการ | @card.ReceivedAmount.ToString("N2") บาท">
                            <div class="flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-tight mb-0.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                                <span>รับสินค้า</span>
                            </div>
                            <div class="text-sm font-extrabold font-mono text-slate-700 leading-none my-0.5 group-hover/pill:text-slate-800 transition-colors">
                                <span data-field="receivedCount">@card.ReceivedCount</span> <span class="text-[10px] font-normal text-slate-400 font-sans">รายการ</span>
                            </div>
                            <div class="text-[9px] font-medium text-emerald-600 mt-0.5" data-field="receivedAmount">
                                @card.ReceivedAmount.ToString("N2") บาท
                            </div>
                        </div>
                        <!-- Deferred Pill -->
                        <div class="flex-1 min-w-0 bg-slate-50/40 hover:bg-slate-100/60 border border-slate-200/40 rounded-lg py-2 px-2 flex flex-col items-center justify-center text-center transition-all duration-200 group/pill relative"
                             title="ผ่อนชำระ: @card.DeferredCount รายการ | @card.DeferredAmount.ToString("N2") บาท">
                            <div class="flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-tight mb-0.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>
                                <span>ผ่อนชำระ</span>
                            </div>
                            <div class="text-sm font-extrabold font-mono text-slate-700 leading-none my-0.5 group-hover/pill:text-slate-800 transition-colors">
                                <span data-field="deferredCount">@card.DeferredCount</span> <span class="text-[10px] font-normal text-slate-400 font-sans">รายการ</span>
                            </div>
                            <div class="text-[9px] font-medium text-amber-600 mt-0.5" data-field="deferredAmount">
                                @card.DeferredAmount.ToString("N2") บาท
                            </div>
                        </div>
                        @if (card.IsLatestWithData)
                        {
                            <!-- Total Amount Pill -->
                            <div class="flex-1 min-w-0 bg-blue-50/80 hover:bg-blue-100 border border-blue-200/60 rounded-lg py-2 px-2 flex flex-col items-center justify-center text-center transition-all duration-200 group/pill relative shadow-sm"
                                 title="มูลค่ารวมสะสม: @card.TotalAmount.ToString("N2") บาท">
                                <div class="flex items-center gap-1 text-[10px] font-black text-blue-600 uppercase tracking-tight mb-0.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0 animate-pulse"></span>
                                    <span>มูลค่ารวมสะสม</span>
                                </div>
                                <div class="text-[13px] font-black font-mono text-blue-700 leading-none my-0.5 group-hover/pill:text-blue-800 transition-colors" data-field="totalAmount">
                                    @card.TotalAmount.ToString("N2")
                                </div>
                                <div class="text-[9px] font-black text-blue-500 mt-0.5">
                                    บาท
                                </div>
                            </div>
                        }
                    </div>
                </a>
            }
        }
        else
        {
            <div class="col-span-full text-center py-12">
                <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <p class="text-slate-500 text-sm">ยังไม่มีข้อมูลประจำเดือน</p>
                <p class="text-slate-400 text-xs mt-1">เดือนใหม่จะปรากฏที่นี่เมื่อมีการบันทึกข้อมูล</p>
            </div>
        }

    </div>

    <!-- Empty state when filter/search yields no results -->
    <div id="empty-search-state" class="hidden text-center py-12">
        <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-slate-500 text-sm">ไม่พบรายการที่ตรงกับการค้นหา</p>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('search-input');
            const filterStatus = document.getElementById('filter-status');
            const grid = document.getElementById('cards-grid');
            const emptyState = document.getElementById('empty-search-state');
            const allCards = Array.from(grid.querySelectorAll('a.card-item'));

            function applyFilters() {
                const term = searchInput.value.toLowerCase().trim();
                const status = filterStatus.value;

                let visible = allCards.filter(card => {
                    const matchSearch = !term
                        || card.dataset.month.includes(term)
                        || card.dataset.file.includes(term);
                    const matchStatus = status === 'all' || card.dataset.status === status;
                    return matchSearch && matchStatus;
                });

                // เรียงลำดับตามปฏิทิน (มกราคม -> ธันวาคม)
                visible.sort((a, b) => {
                    const keyA = a.dataset.monthKey || a.dataset.month;
                    const keyB = b.dataset.monthKey || b.dataset.month;
                    return keyA.localeCompare(keyB);
                });

                allCards.forEach(c => { c.style.display = 'none'; });
                visible.forEach(c => { c.style.display = ''; grid.appendChild(c); });

                if (visible.length === 0 && allCards.length > 0) {
                    emptyState.classList.remove('hidden');
                } else {
                    emptyState.classList.add('hidden');
                }
            }

            searchInput.addEventListener('input', applyFilters);
            filterStatus.addEventListener('change', applyFilters);

            // ── Realtime polling ──────────────────────────────────────────────
            const selectedYear = @(ViewBag.SelectedYear ?? DateTime.Now.Year);
            const POLL_INTERVAL = 3000; // 3 วินาที (Realtime)

            function fmtN2(n) {
                return Number(n).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function updateCards(data) {
                data.forEach(item => {
                    const card = grid.querySelector(`a.card-item[data-month-key="${item.monthKey}"]`);
                    if (!card) return;

                    // อัพเดตตัวเลขในแต่ละ field
                    const set = (field, val) => {
                        const el = card.querySelector(`[data-field="${field}"]`);
                        if (el) el.textContent = val;
                    };

                    set('monthAmount', fmtN2(item.monthAmount));
                    set('totalAmount', fmtN2(item.totalAmount));
                    set('paidAmount', fmtN2(item.paidAmount));
                    set('receivedCount', item.receivedCount);
                    set('receivedAmount', fmtN2(item.receivedAmount) + ' บาท');
                    set('deferredCount', item.deferredCount);
                    set('deferredAmount', fmtN2(item.deferredAmount) + ' บาท');
                    set('skippedCount', item.skippedCount);
                    set('skippedAmount', fmtN2(item.skippedAmount) + ' บาท');
                });
            }

            async function pollCards() {
                try {
                    const res = await fetch(`/MonthlyCost/GetCardsData?year=${selectedYear}`);
                    if (!res.ok) return;
                    const data = await res.json();
                    updateCards(data);
                } catch (e) {
                    // silent fail — ไม่รบกวน UX ถ้า network error
                }
            }

            // Poll ทันทีหลัง load และทุก 3 วินาที + เมื่อสลับแท็บกลับมา
            pollCards();
            setInterval(pollCards, POLL_INTERVAL);
            window.addEventListener('focus', pollCards);
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) pollCards();
            });
            window.addEventListener('pageshow', pollCards);
        });
    </script>
}
