        </div>
        <div class="flex items-center gap-2 shrink-0">
            <div class="w-32 bg-slate-200 rounded-full h-2 overflow-hidden">
                <div id="success-rate-bar" class="h-2 rounded-full transition-all @(successRate == 100 ? "bg-emerald-500" : "bg-primary")" style="width: @successRate.ToString("0.0")%"></div>
            </div>
            <span id="success-rate-text" class="text-sm font-bold @(successRate == 100 ? "text-emerald-600" : "text-primary") whitespace-nowrap">@successRate.ToString("0.0")% (@matchedCount/@total)</span>
