@model List<CostFlow.Models.OrderTrackingMaster>
@functions {
    private string GetIsoDate(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr) || dateStr == "-") return "";
        dateStr = dateStr.Trim().Split(' ')[0];
        var parts = dateStr.Split('/');
        if (parts.Length == 3 && 
            int.TryParse(parts[0], out var day) && 
            int.TryParse(parts[1], out var month) && 
            int.TryParse(parts[2], out var year))
        {
            if (year > 2500) year -= 543;
            try
            {
                return new DateTime(year, month, day).ToString("yyyy-MM-dd");
            }
            catch {}
        }
        return "";
    }
}
@{
    string reportName = ViewData["ReportName"] as string ?? "รายละเอียดใบสั่งผลิต";
    DateTime createdAt = ViewData["CreatedAt"] as DateTime? ?? DateTime.Now;
    int total = Model.Count;
    int matchedCount = Model.Count(x => x.Status == "Matched");
    int pendingCount = total - matchedCount;
    int uploadedPlansCount = ViewData["UploadedWeeklyPlansCount"] as int? ?? 0;
    double successRate = total > 0 ? (double)matchedCount / total * 100 : 0;
    ViewData["Title"] = reportName;
    ViewData["HeaderTitle"] = "รายละเอียดรายการสั่งผลิต";
    var sortedModel = Model.OrderBy(x => x.Status == "Matched" ? 1 : 0).ThenBy(x => x.PoNumber).ToList();
    
    // ดึงค่า month และ year จาก query string (ถ้ามี)
    var currentMonth = Context.Request.Query["month"].ToString();
    var currentYear = Context.Request.Query["year"].ToString();
}

<style>
    @@keyframes timeline-pulse-ring {
        0% {
            transform: scale(0.5);
            opacity: 0.8;
        }
        80%, 100% {
            transform: scale(1.6);
            opacity: 0;
        }
    }
    
    @@keyframes timeline-dot-pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.18);
        }
    }
</style>

<div class="flex-1 p-md md:p-lg flex flex-col gap-md max-w-container-max mx-auto w-full">
    <div class="flex items-center gap-sm mb-xs">
        <div class="flex-1 min-w-0">
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-0">@reportName</h3>
            <p class="text-secondary text-xs">นำเข้าข้อมูล @createdAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <div class="w-32 bg-slate-200 rounded-full h-2 overflow-hidden">
                <div class="h-2 rounded-full transition-all @(successRate == 100 ? "bg-emerald-500" : "bg-primary")" style="width: @successRate.ToString("0.0")%"></div>
            </div>
            <span class="text-sm font-bold @(successRate == 100 ? "text-emerald-600" : "text-primary") whitespace-nowrap">@successRate.ToString("0.0")% (@matchedCount/@total)</span>
        </div>
    </div>

    <div class="bg-white rounded border border-outline-variant shadow-sm p-4 custom-toolbar">
        <!-- Left Side: Search and Sort Filters -->
        <div class="flex items-center gap-3 flex-wrap">
            <div class="w-64 flex-shrink-0">
                <input
                    id="po-search"
                    type="text"
                    placeholder="ค้นหาเลขที่อนุมัติ..."
                    class="block w-full border border-slate-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white"
                    style="height: 36px; padding: 6px 12px; font-size: 13px;"
                >
            </div>
            <div class="w-56 flex-shrink-0">
                <select id="sort-order" class="block w-full border border-slate-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white cursor-pointer" style="height: 36px; padding: 6px 12px; font-size: 13px; font-weight: 500;">
                    <option value="default">เรียงลำดับ: เริ่มต้น</option>
                    <option value="approved-desc">วันที่อนุมัติ: ใหม่ล่าสุด</option>
                    <option value="approved-asc">วันที่อนุมัติ: เก่าสุด</option>
                    <option value="delivery-desc">เป้าหมายส่งมอบ: ใหม่ล่าสุด</option>
                    <option value="delivery-asc">เป้าหมายส่งมอบ: เก่าสุด</option>
                </select>
            </div>
        </div>

        <!-- Right Side: Both Status Filters and Action Buttons grouped together -->
        <div class="custom-toolbar-right">
            <!-- Status Filters -->
            <div class="flex gap-2">
                <button class="status-filter-btn flex items-center justify-center bg-white hover:bg-emerald-50 border-2 border-emerald-500 text-emerald-700 transition-all" data-filter="matched" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 8px;">
                    ได้แผนแล้ว (@matchedCount)
                </button>
                <button class="status-filter-btn flex items-center justify-center bg-white hover:bg-rose-50 border-2 border-rose-500 text-rose-700 transition-all" data-filter="pending" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 8px;">
                    รอแผนผลิต (@pendingCount)
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-3 flex-wrap">
                <button id="btn-open-upload-modal"
                        class="flex items-center gap-1 btn-custom-amber shadow-sm transition-all active:scale-95">
                    <svg xmlns="http://www.w3.org/2000/svg" style="color: #b45309 !important;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V3m0 0L7.5 7.5M12 3l4.5 4.5M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5" />
                    </svg>
                    <span>นำเข้าแผนผลิต</span>
                    <span class="text-xs font-bold" style="color: #b45309 !important;">(@uploadedPlansCount)</span>
                </button>

                <button type="button" id="btn-view-all-system"
                        class="flex items-center gap-2 btn-custom-white shadow-sm transition-all active:scale-95">
                    <svg xmlns="http://www.w3.org/2000/svg" style="color: #475569 !important;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5-5.25h16.5m-16.5 10.5h16.5" />
                    </svg>
                    <span>ดูรายการทั้งหมด</span>
                </button>

                <button type="button" id="btn-export-excel"
                        title="ส่งออก Excel"
                        class="flex items-center justify-center btn-custom-green shadow-sm transition-all active:scale-95"
                        style="width: 36px !important; padding: 0 !important;">
                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" viewBox="0 0 48 48" style="width: 20px !important; height: 20px !important;">
                        <path fill="#169154" d="M29,6H15.744C14.781,6,14,6.781,14,7.744v7.259h15V6z"></path><path fill="#18482a" d="M14,33.054v7.202C14,41.219,14.781,42,15.743,42H29v-8.946H14z"></path><path fill="#0c8045" d="M14 15.003H29V24.005000000000003H14z"></path><path fill="#17472a" d="M14 24.005H29V33.055H14z"></path><g><path fill="#29c27f" d="M42.256,6H29v9.003h15V7.744C44,6.781,43.219,6,44,6z"></path><path fill="#27663f" d="M29,33.054V42h13.257C43.219,42,44,41.219,44,40.257v-7.202H29z"></path><path fill="#19ac65" d="M29 15.003H44V24.005000000000003H29z"></path><path fill="#129652" d="M29 24.005H44V33.055H29z"></path></g><path fill="#0c7238" d="M22.319,34H5.681C4.753,34,4,33.247,4,32.319V15.681C4,14.753,4.753,14,5.681,14h16.638 C23.247,14,24,14.753,24,15.681v16.638C24,33.247,23.247,34,22.319,34z"></path><path fill="#fff" d="M9.807 19L12.193 19 14.129 22.754 16.175 19 18.404 19 15.333 24 18.474 29 16.123 29 14.013 25.07 11.912 29 9.526 29 12.719 23.982z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white rounded border border-outline-variant shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full table-compact text-sm">
                <thead class="bg-slate-100 border-b border-outline-variant">
                    <tr>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">ลำดับ</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">สถานะ</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">เลขที่อนุมัติ</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">วันที่อนุมัติ</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">ปภ.ความเร่งด่วน</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">ราคาที่ผู้ผลิตเสนอ</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">จำนวน</th>
                        <th class="text-center text-on-surface font-bold">รายละเอียด</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">เป้าหมายส่งมอบ</th>
                        <th class="text-center text-on-surface font-bold whitespace-nowrap">ข้อมูลแผนผลิต</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @for (int i = 0; i < sortedModel.Count; i++)
                    {
                        var order = sortedModel[i];
                        var isMatched = order.Status == "Matched";
                        var hasWeeklyPlan = order.MatchedInWeeklyPlans.Any();
                        var deliveryTarget = hasWeeklyPlan ? order.MatchedInWeeklyPlans.First().DeliveryTarget : "-";

                        <tr class="order-row hover:bg-slate-50  transition-colors text-sm" 
                            data-status="@(isMatched ? "matched" : "pending")" 
                            data-po="@order.PoNumber"
                            data-approved-date="@GetIsoDate(order.ApprovedDate)"
                            data-delivery-target="@GetIsoDate(deliveryTarget)"
                            data-index="@(i + 1)">
                            <td class="text-secondary px-3 py-2 text-center">@(i + 1)</td>
                            <td class="px-3 py-2 text-center">
                                @if (isMatched)
                                {
                                    <span class="badge-status badge-matched inline-flex items-center justify-center gap-1 px-2.5 py-1 text-xs font-medium rounded-lg whitespace-nowrap">
                                        <svg style="transform: translateY(-1.5px);" class="w-3.5 h-3.5 shrink-0 !inline-block" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5z" clip-rule="evenodd"/>
                                        </svg>
                                        <span class="leading-none">ได้แผนผลิตแล้ว</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-pending inline-flex items-center justify-center gap-1 px-2.5 py-1 text-xs font-medium rounded-lg whitespace-nowrap">
                                        <svg style="transform: translateY(-1.5px);" class="w-3.5 h-3.5 shrink-0 !inline-block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                        <span class="leading-none">ยังไม่มีแผนผลิต</span>
                                    </span>
                                }
                            </td>
                            <td class="font-medium text-on-surface text-center">@order.PoNumber</td>
                            <td class="text-center text-secondary">@order.ApprovedDate</td>
                            <td class="text-center text-secondary">@order.Urgency</td>
                            @{
                                var proposedPrice = hasWeeklyPlan 
                                    ? order.MatchedInWeeklyPlans.OrderByDescending(wpd => wpd.WeeklyPlan.UploadedAt).First().Price 
                                    : order.Amount;
                                
                                if (string.IsNullOrEmpty(proposedPrice) || proposedPrice == "-")
                                {
                                    proposedPrice = order.Amount;
                                }

                                decimal tempPrice;
                                string displayProposedPrice = proposedPrice ?? "-";
                                if (!string.IsNullOrEmpty(proposedPrice) && decimal.TryParse(proposedPrice.Replace("฿", "").Replace(",", "").Trim(), out tempPrice))
                                {
                                    displayProposedPrice = "฿" + tempPrice.ToString("N2");
                                }
                                else
                                {
                                    displayProposedPrice = "-";
                                }
                            }
                            <td class="text-right font-medium text-on-surface">@displayProposedPrice</td>
                            <td class="text-center text-secondary">@order.RemarksQuantity</td>
                            <td class="text-secondary detail-cell text-left">@order.Remarks</td>
                            <td class="text-center">
                                @if (hasWeeklyPlan)
                                {
                                    <span class="text-xs font-bold text-blue-700">@deliveryTarget</span>
                                }
                                else
                                {
                                    <span class="text-secondary text-xs">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (hasWeeklyPlan)
                                {
                                    <button class="btn-view-detail px-3 py-1 bg-primary hover:bg-primary/90 text-white text-xs font-bold rounded transition-colors" data-order-id="@order.Id">
                                        ตรวจสอบ
                                    </button>
                                }
                                else
                                {
                                    <span class="text-secondary text-xs">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="upload-modal" class="hidden fixed inset-0 modal-backdrop-premium flex items-center justify-center z-50 p-4">
    <div id="upload-modal-container" class="modal-content-premium w-full max-w-lg transition-all duration-300">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <h3 class="text-base font-bold text-slate-800">นำเข้าไฟล์แผนผลิตสัปดาห์ (สูงสุด 10 ไฟล์)</h3>
            <button id="btn-close-upload-modal" class="text-slate-400 hover:text-slate-600 transition p-1 hover:bg-slate-100 rounded-full">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div style="padding: 24px;">
            <div id="upload-step">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider" style="margin-bottom: 12px; display: block;">อัปโหลดไฟล์ Excel (สูงสุด 10 ไฟล์)</label>
                <div id="dropzone-area" class="border-2 border-dashed border-slate-200 rounded flex flex-col items-center justify-center bg-slate-50/30 hover:bg-slate-50/70 hover:border-slate-400 cursor-pointer transition-all" style="padding: 36px 24px; border-radius: 8px;">
                    <input type="file" id="weeklyPlanFiles" multiple accept=".xlsx,.csv" class="hidden" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-400" style="margin-bottom: 16px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
                    </svg>
                    <span class="text-sm font-semibold text-slate-600" style="margin-bottom: 6px; display: block; text-align: center;">ลากและวางไฟล์ที่นี่ หรือ คลิกเพื่อเลือกไฟล์</span>
                    <span class="text-xs text-slate-400" style="text-align: center; display: block;">Excel (.xlsx) หรือ .csv สูงสุด 10 ไฟล์</span>
                </div>
                <div id="files-list" style="margin-top: 16px; display: flex; flex-direction: column; gap: 8px;"></div>
                <button id="btn-upload-files" class="hidden btn-custom-blue font-bold rounded shadow-sm" style="margin-top: 16px; width: 100%;">
                    อัปโหลดและเลือก Sheet
                </button>
            </div>

            <div id="sheet-selection-step" class="hidden">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                    <div>
                        <h4 class="text-base font-bold text-slate-800">เลือก Sheet ที่ต้องการจากแต่ละไฟล์:</h4>
                        <p class="text-xs text-slate-500 mt-0.5">ระบบได้ตรวจจับและเลือกชีตที่คาดว่าเป็นแผนผลิตสัปดาห์ให้อัตโนมัติ กรุณาตรวจสอบก่อนดำเนินการจับคู่</p>
                    </div>
                </div>
                <div id="sheet-selectors" class="mb-6"></div>
                <!-- ลบ style="gap: 12px;" ออกไปได้เลย -->
<div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-5 pb-1 mt-6">

                    <button id="btn-back-to-files" class="btn-custom-white" style="padding: 10px 20px;">กลับไปเลือกไฟล์ใหม่</button>
                    <button id="btn-confirm-match" class="btn-custom-blue" style="padding: 10px 22px;">ดำเนินการจับคู่</button>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_OrderDetailModal")



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/weekly-plan-upload.js" asp-append-version="true"></script>
    <script>
        const formatPrice = (val) => {
            if (val === null || val === undefined || val === '') return '-';
            if (typeof val === 'number') {
                return '฿' + val.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            const cleanStr = val.toString().replace(/[^\d.-]/g, '');
            const num = parseFloat(cleanStr);
            if (!isNaN(num)) {
                return '฿' + num.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            return val;
        };

        // Initialize uploader
        WeeklyPlanUploader.init('@Html.Raw(reportName)');

        // Modal handlers
        document.getElementById('btn-open-upload-modal').addEventListener('click', () => {
            document.getElementById('upload-modal').classList.remove('hidden');
        });

        const closeUploadModal = () => {
            if (WeeklyPlanUploader.isProcessing) return;
            WeeklyPlanUploader.closeModal();
        };

        document.getElementById('btn-close-upload-modal').addEventListener('click', closeUploadModal);
        document.getElementById('upload-modal').addEventListener('click', (e) => {
            if (WeeklyPlanUploader.isProcessing) return;
            if (e.target.id === 'upload-modal') closeUploadModal();
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !document.getElementById('upload-modal').classList.contains('hidden')) {
                if (WeeklyPlanUploader.isProcessing) {
                    e.preventDefault();
                } else {
                    closeUploadModal();
                }
            }
        });

        // Detail Modal
        const detailModal = document.getElementById('detail-modal');
        
        document.querySelectorAll('.btn-view-detail').forEach(btn => {
            btn.addEventListener('click', async function() {
                const orderId = this.getAttribute('data-order-id');

                try {
                    const response = await fetch(`/Report/GetWeeklyPlanDetail?orderId=${orderId}`);
                    const data = await response.json();

                    if (data.success) {
                        document.getElementById('detail-department').textContent = data.department || '-';
                        document.getElementById('detail-order-name').textContent = data.orderName || '-';
                        document.getElementById('detail-delivery-target').textContent = data.deliveryTarget || '-';
                        document.getElementById('detail-file-name').textContent = data.fileName || '-';
                        document.getElementById('detail-file-name').setAttribute('title', data.fileName || '-');
                        document.getElementById('detail-po-number').textContent = data.poNumberInFile || '-';

                        // Render status badge
                        const statusContainer = document.getElementById('detail-order-status-badge');
                        const statusVal = data.orderStatus || '';
                        let cleanStatusVal = statusVal;
                        if (statusVal.includes(':')) {
                            cleanStatusVal = statusVal.split(':').slice(1).join(':').trim();
                        }
                        
                        let badgeHtml = '';
                        if (statusVal.includes('ดำเนินการ') || statusVal.startsWith('0') || statusVal.startsWith('O:')) {
                            badgeHtml = `<span class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200"><span style="width: 6px; height: 6px; border-radius: 50%; background-color: #d97706; flex-shrink: 0;"></span>${cleanStatusVal}</span>`;
                        } else if (statusVal.includes('ปิด') || statusVal.startsWith('C:')) {
                            badgeHtml = `<span class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200"><span style="width: 6px; height: 6px; border-radius: 50%; background-color: #e11d48; flex-shrink: 0;"></span>${cleanStatusVal}</span>`;
                        } else {
                            badgeHtml = `<span class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-slate-50 text-slate-600 border border-slate-200"><span style="width: 6px; height: 6px; border-radius: 50%; background-color: #64748b; flex-shrink: 0;"></span>${cleanStatusVal || '-'}</span>`;
                        }
                        statusContainer.innerHTML = badgeHtml;

                        // Render timeline history
                        const historyContainer = document.getElementById('detail-history-container');
                        historyContainer.innerHTML = '';
                        
                        if (data.history && data.history.length > 0) {
                            // Build timeline wrapper with vertical line
                            const timelineOuter = document.createElement('div');
                            timelineOuter.style.cssText = 'position: relative; padding-left: 28px;';
                            
                            // Vertical timeline line
                            const vLine = document.createElement('div');
                            vLine.style.cssText = 'position: absolute; left: 6px; top: 10px; bottom: 10px; width: 2px; background: #e2e8f0; border-radius: 1px;';
                            timelineOuter.appendChild(vLine);

                            data.history.forEach((item, index) => {
                                const hStatusVal = item.orderStatus || '';
                                let hCleanStatusVal = hStatusVal;
                                if (hStatusVal.includes(':')) {
                                    hCleanStatusVal = hStatusVal.split(':').slice(1).join(':').trim();
                                }
                                
                                // Determine status badge colors
                                let badgeBg, badgeText, badgeBorder, dotColor, markerColor;
                                if (hStatusVal.includes('ดำเนินการ') || hStatusVal.startsWith('0') || hStatusVal.startsWith('O:')) {
                                    badgeBg = '#fffbeb'; badgeText = '#b45309'; badgeBorder = '#fde68a'; dotColor = '#f59e0b'; markerColor = '#f59e0b';
                                } else if (hStatusVal.includes('ปิด') || hStatusVal.startsWith('C:')) {
                                    badgeBg = '#fff1f2'; badgeText = '#be123c'; badgeBorder = '#fecdd3'; dotColor = '#f43f5e'; markerColor = '#f43f5e';
                                } else {
                                    badgeBg = '#f8fafc'; badgeText = '#475569'; badgeBorder = '#e2e8f0'; dotColor = '#94a3b8'; markerColor = '#94a3b8';
                                }
                                
                                const hBadgeHtml = `<span style="display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 2px 8px; border-radius: 6px; font-size: 10px; font-weight: 700; background: ${badgeBg}; color: ${badgeText}; border: 1px solid ${badgeBorder};"><span style="width: 5px; height: 5px; border-radius: 50%; background: ${dotColor}; flex-shrink: 0;"></span>${hCleanStatusVal || '-'}</span>`;
                                
                                // เอฟเฟกต์วงแหวนและจุดกระพริบสำหรับทุกรายการพร้อมหน่วงเวลา (Staggered Animation)
                                const pulseRingHtml = `
                                    <span class="absolute" style="left: -33px; top: 8px; width: 22px; height: 22px; border-radius: 50%; background: ${markerColor}; opacity: 0.45; animation: timeline-pulse-ring 2.2s cubic-bezier(0.24, 0, 0.38, 1) infinite; animation-delay: ${index * 0.35}s; pointer-events: none;"></span>
                                `;

                                const itemHtml = `
                                    <div style="position: relative; margin-bottom: 16px;">
                                        <!-- Marker dot -->
                                        ${pulseRingHtml}
                                        <div style="position: absolute; left: -27px; top: 14px; width: 10px; height: 10px; border-radius: 50%; background: ${markerColor}; box-shadow: 0 0 0 3px #e2e8f0; animation: timeline-dot-pulse 2.2s infinite; animation-delay: ${index * 0.35}s;"></div>
                                        
                                        <!-- Card -->
                                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px;">
                                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                                <span style="font-size: 12px; font-weight: 600; color: #1e293b; line-height: 1.4; word-break: break-word; max-width: 320px;" title="${item.fileName}">${item.fileName}</span>
                                                <span style="font-size: 10px; color: #94a3b8; font-weight: 500; white-space: nowrap; flex-shrink: 0;">${item.uploadedAt}</span>
                                            </div>
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                                                <span style="font-size: 11px; color: #94a3b8;">ชีท: <strong style="color: #64748b; font-weight: 500;">${item.sheetName}</strong>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                timelineOuter.insertAdjacentHTML('beforeend', itemHtml);
                            });
                            
                            historyContainer.appendChild(timelineOuter);
                        } else {
                            historyContainer.innerHTML = '<div style="text-align: center; font-size: 12px; color: #94a3b8; padding: 16px 0;">ไม่มีข้อมูลประวัติแผนผลิต</div>';
                        }

                        // Reset collapsible state to closed by default
                        const historyWrapper = document.getElementById('history-wrapper');
                        const chevronHistory = document.getElementById('chevron-history');
                        if (historyWrapper) historyWrapper.style.display = 'none';
                        if (chevronHistory) chevronHistory.style.transform = 'rotate(0deg)';

                        detailModal.classList.remove('hidden');
                    } else {
                        Swal.fire('ไม่พบข้อมูล', 'ไม่พบข้อมูลแผนผลิต', 'warning');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire('เกิดข้อผิดพลาด', 'เกิดข้อผิดพลาดในการโหลดข้อมูล', 'error');
                }
            });
        });

        // Toggle history accordion
        const btnToggleHistory = document.getElementById('btn-toggle-history');
        if (btnToggleHistory) {
            btnToggleHistory.addEventListener('click', () => {
                const historyWrapper = document.getElementById('history-wrapper');
                const chevronHistory = document.getElementById('chevron-history');
                if (historyWrapper && chevronHistory) {
                    const isHidden = historyWrapper.style.display === 'none';
                    historyWrapper.style.display = isHidden ? 'block' : 'none';
                    chevronHistory.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
                }
            });
        }

        document.getElementById('btn-close-detail-modal').addEventListener('click', () => {
            detailModal.classList.add('hidden');
        });

        document.getElementById('btn-close-detail').addEventListener('click', () => {
            detailModal.classList.add('hidden');
        });

        // Status Filter with Mutually Exclusive functionality
        let activeFilter = null; // เก็บ filter ที่เปิดอยู่ (ตัวเดียว)

        document.querySelectorAll('.status-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const filter = this.getAttribute('data-filter');
                
                // If clicking the same filter, toggle it off
                if (activeFilter === filter) {
                    activeFilter = null;
                    // Reset to default state (white bg with colored border)
                    if (filter === 'matched') {
                        this.style.background = '#ffffff';
                        this.style.color = '#047857';
                        this.style.borderColor = '#10b981';
                    } else if (filter === 'pending') {
                        this.style.background = '#ffffff';
                        this.style.color = '#be123c';
                        this.style.borderColor = '#f43f5e';
                    }
                } else {
                    // Reset all buttons to default state first
                    document.querySelectorAll('.status-filter-btn').forEach(b => {
                        const bFilter = b.getAttribute('data-filter');
                        if (bFilter === 'matched') {
                            b.style.background = '#ffffff';
                            b.style.color = '#047857';
                            b.style.borderColor = '#10b981';
                        } else if (bFilter === 'pending') {
                            b.style.background = '#ffffff';
                            b.style.color = '#be123c';
                            b.style.borderColor = '#f43f5e';
                        }
                    });

                    // Set the clicked button as active
                    activeFilter = filter;
                    // Active state (filled with respective color)
                    if (filter === 'matched') {
                        this.style.background = '#10b981'; // emerald-500
                        this.style.color = '#ffffff';
                        this.style.borderColor = '#10b981';
                    } else if (filter === 'pending') {
                        this.style.background = '#f43f5e'; // rose-500
                        this.style.color = '#ffffff';
                        this.style.borderColor = '#f43f5e';
                    }
                }

                // Filter rows based on active filter
                const rows = document.querySelectorAll('.order-row');
                const searchTerm = document.getElementById('po-search').value.toLowerCase().trim();

                rows.forEach(row => {
                    const status = row.getAttribute('data-status');
                    const poNumber = row.getAttribute('data-po').toLowerCase();
                    
                    const matchSearch = searchTerm === '' || poNumber.includes(searchTerm);
                    const matchFilter = activeFilter === null || activeFilter === status;

                    row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                });
            });
        });

        // Search (updated to work with mutually exclusive filter logic)
        document.getElementById('po-search').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.order-row');

            rows.forEach(row => {
                const poNumber = row.getAttribute('data-po').toLowerCase();
                const rowStatus = row.getAttribute('data-status');

                const matchSearch = poNumber.includes(searchTerm);
                const matchFilter = activeFilter === null || activeFilter === rowStatus;

                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
            });
        });

        // Sorting functionality
        document.getElementById('sort-order').addEventListener('change', function() {
            const val = this.value;
            const tbody = document.querySelector('table tbody');
            const rows = Array.from(tbody.querySelectorAll('.order-row'));
            
            rows.sort((a, b) => {
                if (val === 'default') {
                    const indexA = parseInt(a.getAttribute('data-index'));
                    const indexB = parseInt(b.getAttribute('data-index'));
                    return indexA - indexB;
                }
                
                if (val.startsWith('approved')) {
                    const dateA = a.getAttribute('data-approved-date') || '';
                    const dateB = b.getAttribute('data-approved-date') || '';
                    
                    if (dateA === dateB) return 0;
                    if (!dateA) return 1;
                    if (!dateB) return -1;
                    
                    return val === 'approved-desc' ? dateB.localeCompare(dateA) : dateA.localeCompare(dateB);
                }
                
                if (val.startsWith('delivery')) {
                    const dateA = a.getAttribute('data-delivery-target') || '';
                    const dateB = b.getAttribute('data-delivery-target') || '';
                    
                    if (dateA === dateB) return 0;
                    if (!dateA) return 1;
                    if (!dateB) return -1;
                    
                    return val === 'delivery-desc' ? dateB.localeCompare(dateA) : dateA.localeCompare(dateB);
                }
                
                return 0;
            });
            
            // Re-append sorted rows to tbody
            rows.forEach((row, i) => {
                tbody.appendChild(row);
                // Update numbering
                const numberCell = row.querySelector('td:first-child');
                if (numberCell) {
                    numberCell.textContent = i + 1;
                }
            });
        });

        // Handle export Excel with custom name prompt
        document.getElementById('btn-export-excel').addEventListener('click', function() {
            const reportName = "@Html.Raw(reportName)";
            const currentMonth = "@currentMonth";
            const currentYear  = "@currentYear";
            const defaultExportName = `รายงาน_${reportName}_${new Date().toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' }).replace(/ /g, '_')}`;

            Swal.fire({
                title: 'ตั้งชื่อไฟล์สำหรับส่งออก',
                input: 'text',
                inputValue: defaultExportName,
                inputPlaceholder: 'กรอกชื่อไฟล์...',
                showCancelButton: true,
                confirmButtonText: 'ดาวน์โหลด',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#00288e',
                cancelButtonColor: '#94a3b8',
                inputValidator: (value) => {
                    if (!value.trim()) {
                        return 'กรุณากรอกชื่อไฟล์ที่ต้องการบันทึก!';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const customName = result.value.trim();
                    let exportUrl;
                    if (currentMonth && currentYear) {
                        // month/year mode
                        exportUrl = `/Report/ExportToExcel?month=${encodeURIComponent(currentMonth)}&year=${encodeURIComponent(currentYear)}&customName=${encodeURIComponent(customName)}`;
                    } else {
                        // legacy fileName mode
                        exportUrl = `/Report/ExportToExcel?fileName=${encodeURIComponent(reportName)}&customName=${encodeURIComponent(customName)}`;
                    }
                    window.location.href = exportUrl;
                }
            });
        });

        // Close modals on background click
        detailModal.addEventListener('click', (e) => {
            if (e.target === detailModal) detailModal.classList.add('hidden');
        });

        // Redirect to All Orders page
        document.getElementById('btn-view-all-system').addEventListener('click', () => {
            const reportName = "@Html.Raw(reportName)";
            const month = "@currentMonth";
            const year = "@currentYear";
            
            // ถ้ามาจาก month/year mode ให้ส่ง month & year ไปด้วย
            if (month && year) {
                window.location.href = `/Report/AllOrders?returnReportName=${encodeURIComponent(reportName)}&month=${month}&year=${year}`;
            } else {
                // ถ้าเป็น fileName mode ปกติ
                window.location.href = `/Report/AllOrders?returnReportName=${encodeURIComponent(reportName)}`;
            }
        });
    </script>
}
