                        style="padding: 6px 10px; font-size: 12.5px;">
                    <svg xmlns="http://www.w3.org/2000/svg" style="color: #475569 !important;" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5-5.25h16.5m-16.5 10.5h16.5"/>
                    </svg>
                    <span>ดูรายการทั้งหมด</span>
                </button>

                <button type="button" id="btn-export-excel"
                        title="ส่งออก Excel"
                        class="flex items-center justify-center btn-custom-green shadow-sm transition-all active:scale-95 shrink-0"
                        style="width: 34px !important; height: 34px !important; padding: 0 !important;">
                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" viewBox="0 0 48 48" style="width: 18px !important; height: 18px !important;">
                        <path fill="#169154" d="M29,6H15.744C14.781,6,14,6.781,14,7.744v7.259h15V6z"></path><path fill="#18482a" d="M14,33.054v7.202C14,41.219,14.781,42,15.743,42H29v-8.946H14z"></path><path fill="#0c8045" d="M14 15.003H29V24.005000000000003H14z"></path><path fill="#17472a" d="M14 24.005H29V33.055H14z"></path>
