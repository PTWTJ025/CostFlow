@model List<dynamic>
@{
    ViewData["Title"] = "รายงานการติดตามแผนผลิตรายเดือน";
    ViewData["HeaderTitle"] = "รายงานการติดตามแผนผลิตรายเดือน";

    var selectedYear = (int)ViewData["SelectedYear"]!;
    var currentYear = (int)ViewData["CurrentYear"]!;
    var availableYears = (List<int>)ViewData["AvailableYears"]!;
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">

    <!-- Page Header -->
    <div class="flex justify-between items-end mb-xs">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">รายงานการสั่งผลิตรายเดือน</h3>
            <p class="text-secondary text-sm">ภาพรวมใบสั่งผลิตแยกตามเดือน (กรองตาม "วันที่อนุมัติขอสั่งผลิต")</p>
        </div>
        <div class="flex gap-sm items-center">
            <!-- Year Filter Custom Dropdown -->
            <div class="relative" id="year-dropdown-wrapper">
                <!-- Year Dropdown Button -->
                <button id="year-dropdown-btn"
                        class="h-10 flex items-center gap-2 px-4 bg-white border border-outline-variant
               rounded-lg text-sm font-semibold text-slate-700
               hover:border-primary hover:text-primary
               transition-all duration-200 shadow-sm
               min-w-[160px] justify-between">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-slate-400"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
                        </svg>

                        <span id="year-dropdown-label" class="whitespace-nowrap">
                            ปี @(selectedYear + 543) (@selectedYear)
                        </span>
                    </div>

                    <svg id="year-chevron"
                         class="w-4 h-4 text-slate-400 transition-transform duration-200"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="2">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </button>

                <!-- Dropdown Panel -->
                <div id="year-dropdown-panel"
                     class="absolute right-0 mt-1.5 w-full bg-white border border-slate-200 rounded-lg shadow-lg z-50 overflow-hidden
                            opacity-0 scale-95 pointer-events-none
                            transition-all duration-200 origin-top">
                    @foreach (var yr in availableYears)
                    {
                        <button type="button"
                                data-year="@yr"
                                class="year-option w-full flex items-center justify-between px-4 py-2.5 text-sm hover:bg-primary/5 transition-colors duration-150
                                       @(yr == selectedYear ? "font-bold text-primary bg-primary/5" : "font-medium text-slate-700")">
                            <span>ปี @(yr + 543)</span>
                            <span class="text-xs text-slate-400">(@yr)</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Import Button -->
            <a href="@Url.Action("Index", "FileMerge")"
               class="h-10 flex items-center justify-center gap-2 px-4
          bg-primary hover:bg-primary/95 text-on-primary
          rounded-lg text-sm font-bold shadow-sm
          transition-colors whitespace-nowrap">
                <svg class="w-4 h-4 shrink-0"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="2">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 4v16m8-8H4"/>
                </svg>

                นำเข้าไฟล์สั่งผลิตใหม่
            </a>
        </div>
    </div>

    <!-- Monthly Cards Grid (12 เดือน - 4 columns responsive) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-lg">
        @foreach (var card in Model)
        {
            var month = (int)card.Month;
            var year = (int)card.Year;
            var totalOrders = (int)card.TotalOrders;
            var totalAmount = (decimal)card.TotalAmount;
            var statusCode = (string)card.StatusCode;
            var statusLabel = (string)card.StatusLabel;
            var monthDisplay = (string)card.MonthYearDisplay;

            var isEmpty = statusCode == "empty";
            var isActive = statusCode == "active";
            var isCompleted = statusCode == "completed";

            var cardBg = isEmpty ? "bg-gradient-to-br from-slate-50 to-slate-100 border-slate-200" : "bg-white border-slate-200 hover:border-primary/60 hover:shadow-xl hover:shadow-primary/10 hover:scale-[1.02] hover:-translate-y-1";
            var statusBg = isEmpty ? "bg-slate-200/50 text-slate-500 border-slate-300"
                : isActive ? "bg-emerald-100 text-emerald-700 border-emerald-300"
                : "bg-blue-100 text-blue-700 border-blue-300";

            <a href="@(isEmpty ? "javascript:void(0)" : Url.Action("Details", new { month = month, year = year }))"
               class="group @cardBg rounded border shadow-sm transition-all duration-300 ease-out flex flex-col justify-between p-md min-h-[180px] animate-card-fade-in @(isEmpty ? "cursor-default" : "cursor-pointer")">

                <div>
                    <!-- Header -->
                    <div class="flex justify-between items-start mb-3">
                        <div class="overflow-hidden flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <h4 class="font-bold @(isEmpty ? "text-slate-400" : "text-slate-800 group-hover:text-primary") text-base transition-colors duration-300">
                                    @monthDisplay
                                </h4>
                            </div>
                        </div>
                    </div>

                    @if (!isEmpty)
                    {
                        <!-- Stats -->
                        <div class="space-y-2.5">
                            <div class="flex justify-between items-baseline">
                                <span class="text-xs text-slate-500 font-semibold">จำนวนใบสั่งผลิต</span>
                                <span class="text-xl font-black text-slate-800 font-mono group-hover:text-primary transition-colors duration-300">@totalOrders</span>
                            </div>
                            <div class="flex justify-between items-baseline">
                                <span class="text-xs text-slate-500 font-semibold">มูลค่ารวม</span>
                                <span class="text-base font-bold text-primary font-mono group-hover:scale-105 transition-transform duration-300">@totalAmount.ToString("N2") ฿</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Empty State -->
                        <div class="mt-4 min-h-[100px]
            flex flex-col items-center justify-center
            pt-6 pb-4 text-center">

                            <div class="w-14 h-14 rounded-full bg-slate-200/50
                flex items-center justify-center mb-3 group-hover:scale-110 transition-transform duration-300">

                                <svg class="w-7 h-7 text-slate-400 group-hover:text-slate-500 transition-colors duration-300"
                                     xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="1.5"
                                     stroke="currentColor">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"/>
                                </svg>
                            </div>

                            <p class="text-sm font-semibold text-slate-500 leading-6">
                                ไม่มีข้อมูล
                            </p>
                        </div>
                    }
                </div>

                @if (!isEmpty)
                {
                    <!-- Footer / Arrow -->
                    <div class="mt-3 pt-3 border-t border-slate-100 flex justify-end">
                        <span class="text-xs text-slate-400 group-hover:text-primary transition-colors flex items-center gap-1.5 group-hover:translate-x-1 transition-transform duration-300">
                            ดูรายละเอียด
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </span>
                    </div>
                }
            </a>
        }
    </div>

    <style>
        @@keyframes cardFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
    
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    
        .animate-card-fade-in {
            animation: cardFadeIn 0.5s ease-out forwards;
        }
    
        .animate-card-fade-in:nth-child(1) {
            animation-delay: 0.05s;
        }
    
        .animate-card-fade-in:nth-child(2) {
            animation-delay: 0.1s;
        }
    
        .animate-card-fade-in:nth-child(3) {
            animation-delay: 0.15s;
        }
    
        .animate-card-fade-in:nth-child(4) {
            animation-delay: 0.2s;
        }
    
        .animate-card-fade-in:nth-child(5) {
            animation-delay: 0.25s;
        }
    
        .animate-card-fade-in:nth-child(6) {
            animation-delay: 0.3s;
        }
    
        .animate-card-fade-in:nth-child(7) {
            animation-delay: 0.35s;
        }
    
        .animate-card-fade-in:nth-child(8) {
            animation-delay: 0.4s;
        }
    
        .animate-card-fade-in:nth-child(9) {
            animation-delay: 0.45s;
        }
    
        .animate-card-fade-in:nth-child(10) {
            animation-delay: 0.5s;
        }
    
        .animate-card-fade-in:nth-child(11) {
            animation-delay: 0.55s;
        }
    
        .animate-card-fade-in:nth-child(12) {
            animation-delay: 0.6s;
        }
    </style>

</div>

@section Scripts {
    <script>
        // ── Year Dropdown ──────────────────────────────────────────────
        const btn = document.getElementById('year-dropdown-btn');
        const panel = document.getElementById('year-dropdown-panel');
        const chevron = document.getElementById('year-chevron');
        let isOpen = false;

        function openDropdown() {
            isOpen = true;
            panel.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
            panel.classList.add('opacity-100', 'scale-100');
            chevron.style.transform = 'rotate(180deg)';
        }

        function closeDropdown() {
            isOpen = false;
            panel.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            panel.classList.remove('opacity-100', 'scale-100');
            chevron.style.transform = 'rotate(0deg)';
        }

        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            isOpen ? closeDropdown() : openDropdown();
        });

        document.addEventListener('click', (e) => {
            if (!document.getElementById('year-dropdown-wrapper').contains(e.target)) {
                closeDropdown();
            }
        });

        document.querySelectorAll('.year-option').forEach(opt => {
            opt.addEventListener('click', () => {
                const year = opt.dataset.year;
                window.location.href = '@Url.Action("Index")?year=' + year;
            });
        });
    </script>
}
