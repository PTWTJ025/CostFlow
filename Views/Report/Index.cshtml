@model List<dynamic>
@{
    ViewData["Title"] = "รายงานการติดตามแผนผลิตรายเดือน";
    ViewData["HeaderTitle"] = "รายงานการติดตามแผนผลิตรายเดือน";

    var selectedYear = (int)ViewData["SelectedYear"]!;
    var currentYear = (int)ViewData["CurrentYear"]!;
    var availableYears = (List<int>)ViewData["AvailableYears"]!;
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">

    <!-- Page Header -->
    <div class="flex justify-between items-end mb-xs">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">รายงานการสั่งผลิตรายเดือน</h3>
            <p class="text-secondary text-sm">ภาพรวมใบสั่งผลิตแยกตามเดือน (กรองตาม "วันที่อนุมัติขอสั่งผลิต")</p>
        </div>
        <div class="flex gap-sm items-center">
            <!-- Year Filter Custom Dropdown -->
            <div class="relative" id="year-dropdown-wrapper">
                <!-- Year Dropdown Button -->
                <button id="year-dropdown-btn"
                        class="h-10 flex items-center gap-2 px-4 bg-white border border-outline-variant
               rounded-lg text-sm font-semibold text-slate-700
               hover:border-primary hover:text-primary
               transition-all duration-200 shadow-sm
               min-w-[160px] justify-between">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-slate-400"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
                        </svg>

                        <span id="year-dropdown-label" class="whitespace-nowrap">
                            ปี @(selectedYear + 543) (@selectedYear)
                        </span>
                    </div>

                    <svg id="year-chevron"
                         class="w-4 h-4 text-slate-400 transition-transform duration-200"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="2">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </button>

                <!-- Dropdown Panel -->
                <div id="year-dropdown-panel"
                     class="absolute right-0 mt-1.5 w-full bg-white border border-slate-200 rounded-lg shadow-lg z-50 overflow-hidden
                            opacity-0 scale-95 pointer-events-none
                            transition-all duration-200 origin-top">
                    @foreach (var yr in availableYears)
                    {
                        <button type="button"
                                data-year="@yr"
                                class="year-option w-full flex items-center justify-between px-4 py-2.5 text-sm hover:bg-primary/5 transition-colors duration-150
                                       @(yr == selectedYear ? "font-bold text-primary bg-primary/5" : "font-medium text-slate-700")">
                            <span>ปี @(yr + 543)</span>
                            <span class="text-xs text-slate-400">(@yr)</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Import Button -->
            <a href="@Url.Action("Index", "FileMerge")"
               class="h-10 flex items-center justify-center gap-2 px-4
          bg-primary hover:bg-primary/95 text-on-primary
          rounded-lg text-sm font-bold shadow-sm
          transition-colors whitespace-nowrap">
                <svg class="w-4 h-4 shrink-0"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="2">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 4v16m8-8H4"/>
                </svg>

                นำเข้าไฟล์สั่งผลิตใหม่
            </a>
        </div>
    </div>

    <!-- Monthly Cards Grid (12 เดือน - 4 columns responsive) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-md">
        @foreach (var card in Model)
        {
            var month = (int)card.Month;
            var year = (int)card.Year;
            var monthOrders = (int)card.MonthOrders;
            var monthAmount = (decimal)card.MonthAmount;
            var totalOrders = (int)card.TotalOrders;
            var totalAmount = (decimal)card.TotalAmount;
            var isLatestWithData = (bool)card.IsLatestWithData;
            var statusCode = (string)card.StatusCode;
            var statusLabel = (string)card.StatusLabel;
            var monthDisplay = (string)card.MonthYearDisplay;

            var isEmpty = statusCode == "empty";
            var isActive = statusCode == "active";
            var isCompleted = statusCode == "completed";

            <a href="@(isEmpty ? "javascript:void(0)" : Url.Action("Details", new { month = month, year = year }))"
               class="month-card group bg-white rounded-xl border border-slate-200 shadow-sm p-md flex flex-col justify-between h-full animate-card-in
                      @(isEmpty ? "cursor-default opacity-60" : "cursor-pointer hover:border-primary/50 hover:shadow-md transition-all duration-200")">

                <!-- Header: ชื่อเดือน + status badge -->
                <div class="flex items-start justify-between gap-2 min-h-[58px]">
                    <div>
                        <h4 class="font-semibold text-sm @(isEmpty ? "text-slate-400" : "text-slate-800 group-hover:text-primary transition-colors duration-200") leading-tight">
                            @monthDisplay
                        </h4>
                        @if (!isEmpty)
                        {
                            <p class="text-xs text-slate-400 mt-1">@monthOrders ใบสั่งผลิต</p>
                        }
                    </div>
                    <div class="flex flex-col items-end gap-1 shrink-0">
                        @if (!isEmpty)
                        {
                            <span class="shrink-0 inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border
                                         @(isActive ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-blue-50 text-blue-700 border-blue-200")">
                                @if (isActive)
                                {
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                }
                                @statusLabel
                            </span>
                        }
                        @if (isLatestWithData)
                        {
                            <div class="bg-blue-50/90 border border-blue-200/60 rounded px-2 py-0.5 text-right mt-0.5 shadow-2xs">
                                <div class="text-xs font-black text-primary tabular-nums">@totalAmount.ToString("N2")</div>
                            </div>
                        }
                    </div>
                </div>

                @if (!isEmpty)
                {
                    <!-- Stat pills (ตรึงแนวด้านล่างการ์ดเสมอเพื่อความสมมาตร) -->
                    <div class="grid grid-cols-2 gap-2 mt-auto pt-2">
                        <div class="bg-slate-50 rounded-lg px-3 py-2 text-center border border-slate-100">
                            <div class="text-[10px] text-slate-500 font-medium mb-0.5">ใบสั่งผลิต</div>
                            <div class="text-lg font-black text-slate-800 tabular-nums leading-none">@monthOrders</div>
                        </div>
                        <div class="bg-slate-50 rounded-lg px-3 py-2 text-center border border-slate-100">
                            <div class="text-[10px] text-slate-500 font-medium mb-0.5">มูลค่าประจำเดือน</div>
                            <div class="text-xs font-bold text-slate-700 tabular-nums leading-tight mt-1">@monthAmount.ToString("N2")</div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="flex flex-col items-center justify-center py-4 gap-2 text-center flex-1">
                        <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"/>
                        </svg>
                        <p class="text-xs font-medium text-slate-400">ไม่มีข้อมูล</p>
                    </div>
                }
            </a>
        }
    </div>

    <style>
        @@keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
    
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    
        .animate-card-in {
            animation: cardIn 0.35s ease-out both;
        }
    
        .month-card:nth-child(1) {
            animation-delay: 0.03s;
        }
    
        .month-card:nth-child(2) {
            animation-delay: 0.06s;
        }
    
        .month-card:nth-child(3) {
            animation-delay: 0.09s;
        }
    
        .month-card:nth-child(4) {
            animation-delay: 0.12s;
        }
    
        .month-card:nth-child(5) {
            animation-delay: 0.15s;
        }
    
        .month-card:nth-child(6) {
            animation-delay: 0.18s;
        }
    
        .month-card:nth-child(7) {
            animation-delay: 0.21s;
        }
    
        .month-card:nth-child(8) {
            animation-delay: 0.24s;
        }
    
        .month-card:nth-child(9) {
            animation-delay: 0.27s;
        }
    
        .month-card:nth-child(10) {
            animation-delay: 0.30s;
        }
    
        .month-card:nth-child(11) {
            animation-delay: 0.33s;
        }
    
        .month-card:nth-child(12) {
            animation-delay: 0.36s;
        }
    
        @@media (prefers-reduced-motion: reduce) {
            .animate-card-in {
                animation: none;
            }
        }
    </style>

</div>

@section Scripts {
    <script>
        // ── Year Dropdown ──────────────────────────────────────────────
        const btn = document.getElementById('year-dropdown-btn');
        const panel = document.getElementById('year-dropdown-panel');
        const chevron = document.getElementById('year-chevron');
        let isOpen = false;

        function openDropdown() {
            isOpen = true;
            panel.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
            panel.classList.add('opacity-100', 'scale-100');
            chevron.style.transform = 'rotate(180deg)';
        }

        function closeDropdown() {
            isOpen = false;
            panel.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            panel.classList.remove('opacity-100', 'scale-100');
            chevron.style.transform = 'rotate(0deg)';
        }

        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            isOpen ? closeDropdown() : openDropdown();
        });

        document.addEventListener('click', (e) => {
            if (!document.getElementById('year-dropdown-wrapper').contains(e.target)) {
                closeDropdown();
            }
        });

        document.querySelectorAll('.year-option').forEach(opt => {
            opt.addEventListener('click', () => {
                const year = opt.dataset.year;
                window.location.href = '@Url.Action("Index")?year=' + year;
            });
        });
    </script>
}
