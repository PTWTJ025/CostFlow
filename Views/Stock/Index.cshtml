@model IEnumerable<CostFlow.Models.StockItem>
@{
    ViewData["Title"] = "ระบบสต๊อกสินค้า (Stock System)";
    var pendingCount = (int)(ViewBag.PendingReceiveCount ?? 0);
    string userName = User.Identity?.Name ?? "";
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("Dev") || User.IsInRole("Staff") ||
                   userName.Equals("ADMIN01", StringComparison.OrdinalIgnoreCase) ||
                   userName.Equals("DEV01", StringComparison.OrdinalIgnoreCase) ||
                   userName.Equals("STAFF01", StringComparison.OrdinalIgnoreCase);
}

<style>
    /* Responsive header for mobile */
    @@media (max-width: 767px) {
        .stock-header-bar {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.75rem !important;
        }

        .stock-header-search,
        .stock-search-container {
            width: 100% !important;
        }

        .stock-label-remaining {
            display: none !important;
        }
    }

    /* ซ่อนปุ่มลูกศรเพิ่มลดเลขสำหรับ Chrome, Safari, Edge และ Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* ซ่อนปุ่มลูกศรสำหรับ Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    /* Uniform Hardware Catalog Cards & Equal Image Sizing */
    .stock-cards-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
    }
    @@media (min-width: 640px) {
        .stock-cards-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }
    }
    @@media (min-width: 768px) {
        .stock-cards-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }
    }
    @@media (min-width: 1024px) {
        .stock-cards-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }
    }
    @@media (min-width: 1280px) {
        .stock-cards-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 1rem;
        }
    }

    .stock-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.625rem;
        overflow: hidden;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .stock-card:hover {
        border-color: #cbd5e1;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px -2px rgba(0, 0, 0, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
    }

    /* ทุกภาพขนาดและสัดส่วน 4:3 เท่ากัน 100% ไม่บิดเบี้ยว */
    .stock-card-img-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        height: 155px;
        overflow: hidden;
        background-color: #f1f5f9;
        flex-shrink: 0;
    }
    @@supports (aspect-ratio: 4 / 3) {
        .stock-card-img-wrapper {
            height: auto;
            aspect-ratio: 4 / 3;
        }
    }
    .stock-card-img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
        display: block !important;
        transition: transform 0.35s ease;
    }
    .stock-card:hover .stock-card-img {
        transform: scale(1.06);
    }

    .stock-badge-top-right {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 5;
    }
    .stock-badge-bottom-left {
        position: absolute;
        bottom: 8px;
        left: 8px;
        z-index: 5;
    }

    /* ล็อกความสูงชื่อสินค้า 2 บรรทัดให้การ์ดทุกใบสูงเท่ากัน */
    .stock-card-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.35;
        height: 2.7em;
        margin-top: 0.25rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #1e293b;
    }

    /* Mobile vs Desktop Toolbar */
    @@media (max-width: 767px) {
        .stock-header-bar {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.75rem !important;
            padding: 0.75rem 0.875rem !important;
        }
        .stock-header-toolbar {
            width: 100% !important;
            display: flex !important;
            align-items: center !important;
            gap: 0.5rem !important;
        }
        .stock-search-container {
            flex: 1 1 auto !important;
            width: 100% !important;
            min-width: 0 !important;
        }
        .btn-text-desktop {
            display: none !important;
        }
        #btnPendingReceiveBell {
            padding-left: 0.625rem !important;
            padding-right: 0.625rem !important;
            flex-shrink: 0 !important;
        }
        .btn-add-stock {
            padding-left: 0.625rem !important;
            padding-right: 0.625rem !important;
            flex-shrink: 0 !important;
        }
    }

    @@media (min-width: 768px) {
        .btn-text-desktop {
            display: inline !important;
        }
    }
</style>

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">
    
    <!-- Page Header -->
    <div class="flex justify-between items-end mb-xs">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">ระบบสต๊อกสินค้า (Stock System)</h3>
            <p class="text-secondary text-sm">จัดการรายการสินค้าในสต๊อก, ดูยอดคงเหลือ และประวัติการเบิกจ่าย</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded border border-outline-variant shadow-sm overflow-hidden">
        <div class="stock-header-bar px-md py-3.5 sm:py-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
            <h3 class="text-body-md font-bold text-on-surface">รายการสินค้าในสต๊อกทั้งหมด (@Model.Count() รายการ)</h3>
            <div class="stock-header-toolbar flex items-center gap-2">
                <div class="relative w-48 md:w-60 stock-search-container">
                    <input type="text" id="stockCustomSearch" placeholder="ค้นหารหัส หรือชื่อสินค้า..." class="stock-header-search px-3 py-2 bg-white border border-outline-variant rounded text-sm text-on-surface placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary w-full transition-all shadow-sm" style="height: 38px;" autocomplete="off" />
                    <div id="stock-suggestions-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-md shadow-lg z-50 max-h-[240px] overflow-y-auto divide-y divide-slate-100"></div>
                </div>
                <button type="button"
                        onclick="openReceiveModal()"
                        id="btnPendingReceiveBell"
                        class="px-2.5 sm:px-3 py-2 bg-blue-50/70 border border-primary/30 rounded text-sm font-semibold text-primary hover:bg-blue-100/80 transition-colors flex items-center gap-1.5 shadow-sm whitespace-nowrap"
                        style="height: 38px;"
                        title="ตรวจรับสินค้าเข้าคลังจาก Monthly Cost / PO">
                    <i data-lucide="bell" class="w-4 h-4 shrink-0"></i>
                    <span class="btn-text-desktop">รายการรอรับ</span>
                    <span id="pendingReceiveBadge" 
                          class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-[10px] font-bold shrink-0 leading-none" 
                          aria-label="จำนวนรายการรอรับเข้าคลัง">@pendingCount</span>
                </button>
                @if (isAdmin)
                {
                    <button onclick="openAddModal()" 
                            class="btn-add-stock px-2.5 sm:px-4 py-2 bg-white border border-outline-variant rounded text-sm font-medium text-secondary hover:text-primary hover:border-primary/50 transition-colors flex items-center gap-1.5 shadow-sm whitespace-nowrap" 
                            style="height: 38px;"
                            title="เพิ่มสินค้าใหม่เข้าสต๊อก">
                        <i data-lucide="plus" class="w-4 h-4 shrink-0"></i>
                        <span class="btn-text-desktop">เพิ่มสินค้าใหม่</span>
                    </button>
                }
            </div>
        </div>

        <!-- Unified Hardware Catalog Cards View (Global House / Thai Watsadu Style) -->
        @{
            var mockImages = new[]
            {
                "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=500&q=80", // เฟือง / เกียร์อุตสาหกรรม
                "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=500&q=80", // ลูกปืน / ตลับลูกปืนเหล็ก
                "https://images.unsplash.com/photo-1581092335397-9583fe92d232?auto=format&fit=crop&w=500&q=80", // เครื่องจักร / มอเตอร์
                "https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?auto=format&fit=crop&w=500&q=80", // เพลาโลหะ / งานกลึง
                "https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=500&q=80", // ชิ้นส่วนอะไหล่ความแม่นยำสูง
                "https://images.unsplash.com/photo-1586864387967-d02ef85d93e8?auto=format&fit=crop&w=500&q=80", // น็อต สลักเกลียว สกรู
                "https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=500&q=80", // ระบบส่งกำลัง มู่เล่ย์ สายพาน
                "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=500&q=80", // บอร์ดคอนโทรล / วงจรอุปกรณ์
                "https://images.unsplash.com/photo-1581092795360-fd1ca04f0952?auto=format&fit=crop&w=500&q=80", // วาล์วไฮดรอลิก / ท่อส่ง
                "https://images.unsplash.com/photo-1563770660941-20978e870e26?auto=format&fit=crop&w=500&q=80", // อะไหล่กลไกเครื่องกล
                "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=500&q=80", // เซ็นเซอร์และอุปกรณ์ตรวจจับ
                "https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=500&q=80"  // อะไหล่สายพานลำเลียง
            };
        }

        <div id="stockGridContainer" class="p-3 md:p-4 bg-slate-50/40 min-h-[400px]">
            <div id="stockCardsGrid" class="stock-cards-grid grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 md:gap-4">
                @foreach (var item in Model)
                {
                    int imgIndex = Math.Abs((item.ProductCode ?? "").GetHashCode()) % mockImages.Length;
                    string imageUrl = !string.IsNullOrWhiteSpace(item.FilePath)
                        ? item.FilePath
                        : mockImages[imgIndex];

                    <div class="stock-card bg-white border border-slate-200 hover:border-slate-300 rounded-lg shadow-2xs hover:shadow-sm transition-all overflow-hidden flex flex-col justify-between group"
                         data-id="@item.Id"
                         data-code="@item.ProductCode"
                         data-name="@item.ProductName"
                         data-category="@(item.Category ?? "")"
                         data-image="@(item.FilePath ?? "")"
                         data-min="@item.MinStock"
                         data-max="@item.MaxStock"
                         data-quantity="@item.Quantity">
                        
                        <!-- Top: Image Banner (สัดส่วน 4:3 ขนาดเท่ากัน 100% ทุกใบ) + Status Badges -->
                        <div class="stock-card-img-wrapper" style="position: relative; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; background-color: #f1f5f9; flex-shrink: 0;">
                            <img src="@imageUrl" 
                                 alt="@item.ProductName" 
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=500&q=80';"
                                 class="stock-card-img"
                                 style="width: 100%; height: 100%; object-fit: cover; object-position: center; display: block;" />
                            
                            <!-- Status Badge overlaid top-right -->
                            <div class="stock-badge-top-right" style="position: absolute; top: 8px; right: 8px; z-index: 5;">
                                @if (item.Quantity <= 0)
                                {
                                    <span class="stock-status-badge inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-600/95 text-white shadow-2xs">
                                        สต๊อกหมด
                                    </span>
                                }
                                else if (item.Quantity <= item.MinStock)
                                {
                                    <span class="stock-status-badge inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/95 text-white shadow-2xs">
                                        สต๊อกใกล้หมด
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-status-badge inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-600/95 text-white shadow-2xs">
                                        สต๊อกเพียงพอ
                                    </span>
                                }
                            </div>

                            <!-- Category Badge overlaid bottom-left -->
                            <div class="stock-badge-bottom-left" style="position: absolute; bottom: 8px; left: 8px; z-index: 5;">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-900/60 text-white backdrop-blur-xs">
                                    @(string.IsNullOrEmpty(item.Category) ? "ทั่วไป" : item.Category)
                                </span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-3 flex-1 flex flex-col justify-between gap-2.5">
                            <div>
                                <!-- Product Code -->
                                <div class="text-[11px] font-bold text-primary font-mono tracking-tight truncate">
                                    @item.ProductCode
                                </div>
                                <!-- Product Name (clamped to exactly 2 lines for uniform height) -->
                                <h4 class="stock-card-title" style="display: -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.6em; line-height: 1.3; margin-top: 0.25rem; font-size: 0.75rem; font-weight: 600; color: #1e293b;" title="@item.ProductName">
                                    @item.ProductName
                                </h4>
                            </div>

                            <!-- Card Footer: Quantity + Edit / Inline Adjust Button -->
                            <div class="stock-card-footer pt-2 border-t border-slate-100">
                                <!-- Normal View -->
                                <div class="stock-card-normal-view flex items-end justify-between gap-1.5">
                                    <div class="flex flex-col min-w-0" title="ขั้นต่ำ: @item.MinStock.ToString("N0") | สูงสุด: @item.MaxStock.ToString("N0")">
                                        <span class="stock-label-remaining text-[10px] text-slate-400 leading-none">คงเหลือ</span>
                                        <div class="flex items-baseline gap-1 mt-0.5">
                                            <span class="stock-card-qty-val text-base font-bold @(item.Quantity <= item.MinStock ? "text-red-600" : "text-emerald-600") leading-none">
                                                @item.Quantity.ToString("N0")
                                            </span>
                                            <span class="text-[10px] text-slate-400">ชิ้น</span>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-1 shrink-0">
                                        @if (isAdmin)
                                        {
                                            <button type="button" 
                                                    onclick="openEditModal(this)"
                                                    data-id="@item.Id"
                                                    data-code="@item.ProductCode"
                                                    data-name="@item.ProductName"
                                                    data-category="@(item.Category ?? "")"
                                                    data-image="@(item.FilePath ?? "")"
                                                    data-min="@item.MinStock"
                                                    data-max="@item.MaxStock"
                                                    data-quantity="@item.Quantity"
                                                    class="h-7 px-2.5 bg-blue-50/80 hover:bg-blue-100 text-primary border border-blue-200/70 rounded text-xs font-semibold transition-colors flex items-center gap-1 cursor-pointer shadow-2xs"
                                                    title="แก้ไขข้อมูลสินค้า">
                                                <i data-lucide="edit" class="w-3 h-3"></i>
                                                <span>แก้ไข</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" 
                                                    onclick="startInlineQuantityEdit(this)"
                                                    class="h-7 px-2.5 bg-blue-50/80 hover:bg-blue-100 text-primary border border-blue-200/70 rounded text-xs font-semibold transition-colors flex items-center gap-1 cursor-pointer shadow-2xs"
                                                    title="ปรับยอดคงเหลือหน้างาน">
                                                <span>ปรับยอด</span>
                                            </button>
                                        }
                                        <button type="button" 
                                                onclick="openHistoryModal('@item.ProductCode', '@item.ProductName')" 
                                                class="h-7 w-7 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 border border-slate-200 rounded transition-colors cursor-pointer shadow-2xs shrink-0" 
                                                title="ประวัติเข้า-ออก">
                                            <i data-lucide="history" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Inline Edit View for Staff (Hidden by default) -->
                                <div class="stock-card-inline-edit-view hidden w-full flex items-center justify-between gap-1.5">
                                    <div class="flex items-center gap-1 flex-1 min-w-0">
                                        <input type="number" 
                                               min="0" 
                                               step="1" 
                                               value="@item.Quantity.ToString("F0")" 
                                               data-original="@item.Quantity.ToString("F0")"
                                               class="stock-inline-qty-input w-full h-7 px-1.5 bg-blue-50/60 border border-primary/40 focus:border-primary focus:ring-1 focus:ring-primary rounded text-xs font-bold text-primary text-center outline-none shadow-2xs [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" 
                                               placeholder="0" />
                                        <span class="text-[10px] text-slate-400 shrink-0">ชิ้น</span>
                                    </div>
                                    <div class="flex items-center gap-1 shrink-0">
                                        <button type="button" 
                                                onclick="submitInlineQuantityEdit(this)"
                                                class="btn-save-inline-qty h-7 px-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-semibold flex items-center justify-center gap-1 transition-colors cursor-pointer shadow-2xs"
                                                title="บันทึกยอด (Enter)">
                                            <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                        </button>
                                        <button type="button" 
                                                onclick="cancelInlineQuantityEdit(this)"
                                                class="btn-cancel-inline-qty h-7 w-7 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded flex items-center justify-center transition-colors cursor-pointer shadow-2xs shrink-0"
                                                title="ยกเลิก (Esc)">
                                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Search Empty State -->
            <div id="stockSearchEmptyState" class="hidden py-16 text-center text-slate-400">
                <i data-lucide="package-search" class="w-10 h-10 mx-auto mb-2 text-slate-300"></i>
                <p class="text-sm font-medium text-slate-600">ไม่พบรายการสินค้าที่ตรงกับคำค้นหา</p>
                <p class="text-xs text-slate-400 mt-1">ลองค้นหาด้วยรหัสสินค้า, ชื่อ หรือหมวดหมู่อื่น</p>
            </div>
        </div>
    </div>
    <!-- Modal เพิ่มสินค้าใหม่ -->
    <div id="addStockModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 hidden">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg border border-slate-200 overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <div>
                    <h3 class="text-base font-bold text-slate-800">เพิ่มสินค้าใหม่</h3>
                    <p class="text-xs text-slate-500 mt-0.5">ระบุข้อมูลสินค้าเพื่อนำเข้าสต๊อกสินค้าหลัก</p>
                </div>
                <button type="button" onclick="closeAddModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-md hover:bg-slate-100 transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="addStockForm" onsubmit="submitAddStock(event)" class="p-6 flex flex-col gap-4">
                <!-- รหัสสินค้า -->
                <div>
                    <label for="modalProductCode" class="block text-xs font-semibold text-slate-700 mb-1">
                        รหัสสินค้า <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="modalProductCode" required placeholder="เช่น P-001 หรือ รหัสสินค้าในระบบ" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors" />
                </div>

                <!-- ชื่อสินค้า -->
                <div>
                    <label for="modalProductName" class="block text-xs font-semibold text-slate-700 mb-1">
                        ชื่อสินค้า <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="modalProductName" required placeholder="ระบุชื่อสินค้า / อะไหล่" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors" />
                </div>

                <!-- หมวดหมู่ (ดึงเฉพาะ 2 หมวดหมู่ของระบบ) -->
                <div>
                    <label for="modalCategory" class="block text-xs font-semibold text-slate-700 mb-1">
