        // ==========================================
        // ระบบปรับยอดสต๊อกด่วนบนการ์ดสินค้า (Inline Quantity Edit) สำหรับ Staff
        // ==========================================
        function startInlineQuantityEdit(btn) {
            const card = btn.closest('.stock-card');
            if (!card) return;

            const normalView = card.querySelector('.stock-card-normal-view');
            const editView = card.querySelector('.stock-card-inline-edit-view');
            const input = card.querySelector('.stock-inline-qty-input');

            if (normalView) normalView.classList.add('hidden');
            if (editView) editView.classList.remove('hidden');

            if (input) {
                const curQty = card.dataset.quantity || '0';
                input.value = parseFloat(curQty);
                input.dataset.original = input.value;
                input.focus();
                input.select();
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }

        function cancelInlineQuantityEdit(btn) {
            const card = btn.closest('.stock-card');
            if (!card) return;

            const normalView = card.querySelector('.stock-card-normal-view');
            const editView = card.querySelector('.stock-card-inline-edit-view');
            const input = card.querySelector('.stock-inline-qty-input');

            if (input && input.dataset.original !== undefined) {
                input.value = input.dataset.original;
            }

            if (editView) editView.classList.add('hidden');
            if (normalView) normalView.classList.remove('hidden');
        }

        async function submitInlineQuantityEdit(btn) {
            const card = btn.closest('.stock-card');
            if (!card) return;

            const input = card.querySelector('.stock-inline-qty-input');
            const saveBtn = card.querySelector('.btn-save-inline-qty');
            if (!input) return;

            const rawVal = input.value.trim();
            if (rawVal === '' || isNaN(rawVal)) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณากรอกตัวเลข',
                        text: 'ระบุจำนวนสต๊อกที่ถูกต้อง'
                    });
                }
                input.focus();
                return;
            }

            const newQty = parseFloat(rawVal);
            if (newQty < 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'จำนวนไม่ถูกต้อง',
                        text: 'จำนวนสต๊อกต้องไม่ติดลบ'
                    });
                }
                input.focus();
                return;
            }

            const itemId = parseInt(card.dataset.id) || 0;
            if (itemId <= 0) {
                console.error('Missing item id on stock-card');
                return;
            }

            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="animate-spin text-xs">⏳</span>';
            }

            try {
                const resp = await fetch('/Stock/QuickUpdateQuantity', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: itemId,
                        quantity: newQty
                    })
                });

                const result = await resp.json();

                if (result.success) {
                    const minStock = parseFloat(card.dataset.min) || 0;

                    // 1. อัปเดต data attribute บนการ์ด
                    card.dataset.quantity = newQty;
                    input.dataset.original = newQty;

                    // 2. อัปเดตตัวเลขคงเหลือบนการ์ด
                    const qtyValEl = card.querySelector('.stock-card-qty-val');
                    if (qtyValEl) {
                        qtyValEl.textContent = Number(newQty).toLocaleString();
                        if (newQty <= minStock) {
                            qtyValEl.classList.remove('text-emerald-600');
                            qtyValEl.classList.add('text-red-600');
                        } else {
                            qtyValEl.classList.remove('text-red-600');
                            qtyValEl.classList.add('text-emerald-600');
                        }
                    }

                    // 3. อัปเดตป้ายสถานะบนรูปภาพ
                    const badgeEl = card.querySelector('.stock-status-badge');
                    if (badgeEl) {
                        if (newQty <= 0) {
                            badgeEl.textContent = 'สต๊อกหมด';
                            badgeEl.className = 'stock-status-badge inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-600/95 text-white shadow-2xs';
                        } else if (newQty <= minStock) {
                            badgeEl.textContent = 'สต๊อกใกล้หมด';
                            badgeEl.className = 'stock-status-badge inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/95 text-white shadow-2xs';
                        } else {
                            badgeEl.textContent = 'สต๊อกเพียงพอ';
                            badgeEl.className = 'stock-status-badge inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-600/95 text-white shadow-2xs';
                        }
                    }

                    // 4. สลับกลับหน้าแสดงผลปกติ
                    const normalView = card.querySelector('.stock-card-normal-view');
                    const editView = card.querySelector('.stock-card-inline-edit-view');
                    if (editView) editView.classList.add('hidden');
                    if (normalView) normalView.classList.remove('hidden');

                    // 5. แสดง Toast บันทึกสำเร็จ
                    if (typeof Swal !== 'undefined') {
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 1800,
                            timerProgressBar: true
                        });
                        Toast.fire({
                            icon: 'success',
                            title: `ปรับยอดเป็น ${Number(newQty).toLocaleString()} ชิ้น เรียบร้อย`
                        });
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'ไม่สามารถปรับยอดได้',
                            text: result.message || 'เกิดข้อผิดพลาดในการบันทึก'
                        });
                    }
                }
            } catch (err) {
                console.error('submitInlineQuantityEdit error:', err);
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'
                    });
                }
            } finally {
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i>';
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                }
            }
        }

