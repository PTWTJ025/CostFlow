        async function confirmDeleteStockItem() {
            const id = parseInt(document.getElementById('editItemId').value) || 0;
            const code = document.getElementById('editProductCode').value.trim();
            const name = document.getElementById('editProductName').value.trim();

            if (!id) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่พบรหัสสินค้า',
