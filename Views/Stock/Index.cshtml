@section Scripts {
    <script>
        const isAdminUser = @(isAdmin ? "true" : "false");
        let isCreatedFromReceive = false;

        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // นำรูปภาพที่เลือกหรือถ่ายไว้แบบ Mock ใน LocalStorage มาแสดงผลบนการ์ดสินค้า
            applyLocalMockStockImages();

            // โหลดจำนวนรายการรอรับจริงทันทีตอนเปิดหน้า
            refreshPendingBadgeCount();

            // ตรวจสอบ query param autoOpenReceive เพื่อเปิด Modal ตรวจรับของทันทีเมื่อสลับมาจาก Monthly Cost
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('autoOpenReceive') === 'true') {
                const orderId = urlParams.get('orderId');
                openReceiveModal(orderId);
                // ล้าง query params จาก URL โดยไม่รีโหลดหน้า
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // ระบบค้นหาสินค้า Real-time + Autocomplete Guide List (ทั้ง Desktop Table และ Mobile Cards)
            const searchInput = document.getElementById('stockCustomSearch');
            const stockDropdown = document.getElementById('stock-suggestions-dropdown');
            const stockItemsData = @Html.Raw(Json.Serialize(Model.Select(m => new { code = m.ProductCode, name = m.ProductName })));

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase().trim();
                    // ค้นหาในการ์ดสินค้า Catalog Cards
                    const cards = document.querySelectorAll('#stockCardsGrid .stock-card');
                    let visibleCount = 0;
                    cards.forEach(function(card) {
                        const text = card.textContent.toLowerCase();
                        const match = text.includes(query);
                        card.style.display = match ? '' : 'none';
                        if (match) visibleCount++;
                    });

                    // แสดง Empty State หากไม่พบสินค้า
                    const emptyState = document.getElementById('stockSearchEmptyState');
                    if (emptyState) {
                        emptyState.classList.toggle('hidden', visibleCount > 0 || query.length === 0);
                    }

                    // 3. Autocomplete Guide List
                    if (stockDropdown) {
                        if (query.length < 1) {
                            stockDropdown.classList.add('hidden');
                            stockDropdown.innerHTML = '';
                            return;
                        }

                        const matches = stockItemsData.filter(item => 
                            (item.code || '').toLowerCase().includes(query) || 
                            (item.name || '').toLowerCase().includes(query)
                        ).slice(0, 8);

                        if (matches.length > 0) {
                            stockDropdown.innerHTML = matches.map(item => `
                                <div class="stock-suggest-item px-3 py-2 hover:bg-slate-50 cursor-pointer transition-colors text-left flex flex-col gap-0.5" data-code="${item.code}" data-name="${item.name.replace(/"/g, '&quot;')}">
                                    <span class="font-mono text-primary font-bold text-xs">${item.code}</span>
                                    <span class="text-slate-700 text-xs truncate">${item.name}</span>
                                </div>
                            `).join('');
                            stockDropdown.classList.remove('hidden');

                            stockDropdown.querySelectorAll('.stock-suggest-item').forEach(el => {
                                el.addEventListener('click', function() {
                                    searchInput.value = this.dataset.name || this.dataset.code;
                                    stockDropdown.classList.add('hidden');
                                    searchInput.dispatchEvent(new Event('input'));
                                });
                            });
                        } else {
                            stockDropdown.classList.add('hidden');
                            stockDropdown.innerHTML = '';
                        }
                    }
                });

                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        if (stockDropdown) stockDropdown.classList.add('hidden');
                    } else if (e.key === 'Enter') {
                        const firstOpt = stockDropdown?.querySelector('.stock-suggest-item');
                        if (firstOpt && !stockDropdown.classList.contains('hidden')) {
                            e.preventDefault();
                            firstOpt.click();
                        } else {
                            if (stockDropdown) stockDropdown.classList.add('hidden');
                        }
                    }
                });

                document.addEventListener('click', function(e) {
                    if (stockDropdown && !searchInput.contains(e.target) && !stockDropdown.contains(e.target)) {
                        stockDropdown.classList.add('hidden');
                    }
                });
            }

            // Custom Receive Order Dropdown Event Listeners
            const receiveSearchInput = document.getElementById('receiveOrderSearchInput');
            if (receiveSearchInput) {
                receiveSearchInput.addEventListener('input', function() {
                    filterReceiveOrderOptions(this.value);
                });
            }

            document.addEventListener('click', function(e) {
                const dropdownContainer = document.getElementById('receiveOrderDropdownContainer');
                if (dropdownContainer && !dropdownContainer.contains(e.target)) {
                    closeReceiveOrderDropdown();
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeReceiveOrderDropdown();
                }
            });

            // รองรับการกด Enter (บันทึก) และ Escape (ยกเลิก) สำหรับช่องกรอกปรับยอดสต๊อกด่วนบนการ์ด
            document.addEventListener('keydown', function(e) {
                if (e.target && e.target.classList.contains('stock-inline-qty-input')) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        submitInlineQuantityEdit(e.target);
                    } else if (e.key === 'Escape') {
                        e.preventDefault();
                        cancelInlineQuantityEdit(e.target);
                    }
                }
            });

            // ปิด Modal เมื่อกดคลิกพื้นที่นอกกล่อง
            const modalEl = document.getElementById('addStockModal');
            if (modalEl) {
                modalEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeAddModal();
                    }
                });
            }

            const editModalEl = document.getElementById('editStockModal');
            if (editModalEl) {
                editModalEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeEditModal();
                    }
                });
            }

            const historyModalEl = document.getElementById('historyStockModal');
            if (historyModalEl) {
                historyModalEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeHistoryModal();
                    }
                });
            }

            // การกดปุ่ม Enter ในฟอร์มเพิ่มสินค้า ให้เลื่อนไปช่องถัดไป
            const form = document.getElementById('addStockForm');
            if (form) {
                const inputs = Array.from(form.querySelectorAll('input:not([type="hidden"]), select'));
                inputs.forEach((input, index) => {
                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault(); // ป้องกันการ Submit ก่อนกรอกครบ
                            if (index < inputs.length - 1) {
                                inputs[index + 1].focus();
                                if (typeof inputs[index + 1].select === 'function') {
                                    inputs[index + 1].select();
                                }
                            } else {
                                // ถ้าอยู่ช่องสุดท้าย (สต๊อกปัจจุบัน) แล้วกด Enter ค่อยส่งข้อมูล
                                submitAddStock(e);
                            }
                        }
                    });
                });
            }

            // การกดปุ่ม Enter ในฟอร์มแก้ไข ให้เลื่อนไปช่องถัดไป
            const editForm = document.getElementById('editStockForm');
            if (editForm) {
                const editInputs = Array.from(editForm.querySelectorAll('input:not([type="hidden"]):not([type="file"]), select'));
                editInputs.forEach((input, index) => {
                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            if (index < editInputs.length - 1) {
                                editInputs[index + 1].focus();
                                if (typeof editInputs[index + 1].select === 'function') {
                                    editInputs[index + 1].select();
                                }
                            } else {
                                submitEditStock(e);
                            }
                        }
                    });
                });
            }
        });

        // ==========================================
        // ระบบอัปโหลดรูปภาพสินค้า & ถ่ายภาพจากกล้อง (Image Upload & Camera Capture)
        // ==========================================
        let cameraStream = null;
        let activeCameraMode = 'add'; // 'add' หรือ 'edit'
        let currentFacingMode = 'environment'; // 'environment' (หลัง) หรือ 'user' (หน้า)
        let capturedBlob = null;

        function triggerPickStockImage(mode) {
            const inputId = mode === 'edit' ? 'editStockFileInput' : 'addStockFileInput';
            const input = document.getElementById(inputId);
            if (input) {
                input.value = '';
                input.click();
            }
        }

        async function handleStockFileSelected(input, mode) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            await uploadStockImageFileOrBlob(file, mode);
        }

        async function uploadStockImageFileOrBlob(fileOrBlob, mode) {
            const statusEl = document.getElementById(mode === 'edit' ? 'editStockImgStatus' : 'addStockImgStatus');
            const previewWrapper = document.getElementById(mode === 'edit' ? 'editStockImagePreviewWrapper' : 'addStockImagePreviewWrapper');
            const emptyDropzone = document.getElementById(mode === 'edit' ? 'editStockEmptyDropzone' : 'addStockEmptyDropzone');
            const previewImg = document.getElementById(mode === 'edit' ? 'editStockImagePreview' : 'addStockImagePreview');
            const hiddenUrlInput = document.getElementById(mode === 'edit' ? 'editStockImageUrl' : 'modalStockImageUrl');

            // 1. อ่านรูปด้วย FileReader ทันที (Mock/Client-Side Preview รวดเร็ว ไม่ต้องรอ Server)
            const reader = new FileReader();
            reader.onload = (e) => {
                const dataUrl = e.target.result;
                if (previewImg) previewImg.src = dataUrl;
                if (hiddenUrlInput) hiddenUrlInput.value = dataUrl;
                if (previewWrapper) previewWrapper.classList.remove('hidden');
                if (emptyDropzone) emptyDropzone.classList.add('hidden');
                if (statusEl) {
                    statusEl.innerHTML = '<span class="text-emerald-600 font-semibold flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> เลือกรูปเรียบร้อย</span>';
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                }
            };
            reader.readAsDataURL(fileOrBlob);

            // 2. ลองส่งอัปโหลดไปยัง Backend (หากมีเซิร์ฟเวอร์รองรับ) หากไม่สำเร็จจะยังคงใช้ Data URL พรีวิวแบบ Mock ได้ปกติ
            try {
                const formData = new FormData();
                const fileName = fileOrBlob.name || `capture_${Date.now()}.jpg`;
                formData.append('file', fileOrBlob, fileName);

                const resp = await fetch('/Stock/UploadStockImage', {
                    method: 'POST',
                    body: formData
                });
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.success && data.imageUrl) {
                        if (hiddenUrlInput) hiddenUrlInput.value = data.imageUrl;
                        if (previewImg) previewImg.src = data.imageUrl;
                    }
                }
            } catch (err) {
                console.log('Stock image mock upload mode active:', err);
            }
        }

        function clearStockImage(mode) {
            const statusEl = document.getElementById(mode === 'edit' ? 'editStockImgStatus' : 'addStockImgStatus');
            const previewWrapper = document.getElementById(mode === 'edit' ? 'editStockImagePreviewWrapper' : 'addStockImagePreviewWrapper');
            const emptyDropzone = document.getElementById(mode === 'edit' ? 'editStockEmptyDropzone' : 'addStockEmptyDropzone');
            const previewImg = document.getElementById(mode === 'edit' ? 'editStockImagePreview' : 'addStockImagePreview');
            const hiddenUrlInput = document.getElementById(mode === 'edit' ? 'editStockImageUrl' : 'modalStockImageUrl');
            const fileInput = document.getElementById(mode === 'edit' ? 'editStockFileInput' : 'addStockFileInput');
            const cameraInput = document.getElementById(mode === 'edit' ? 'editStockCameraInput' : 'addStockCameraInput');

            if (previewWrapper) previewWrapper.classList.add('hidden');
            if (emptyDropzone) emptyDropzone.classList.remove('hidden');
            if (previewImg) previewImg.src = '';
            if (hiddenUrlInput) hiddenUrlInput.value = '';
            if (fileInput) fileInput.value = '';
            if (cameraInput) cameraInput.value = '';
            if (statusEl) statusEl.textContent = 'ยังไม่ได้เลือกรูป';
        }

        function setEditStockImage(imageUrl) {
            const statusEl = document.getElementById('editStockImgStatus');
            const previewWrapper = document.getElementById('editStockImagePreviewWrapper');
            const emptyDropzone = document.getElementById('editStockEmptyDropzone');
            const previewImg = document.getElementById('editStockImagePreview');
            const hiddenUrlInput = document.getElementById('editStockImageUrl');

            if (imageUrl && imageUrl.trim()) {
                if (previewImg) previewImg.src = imageUrl;
                if (hiddenUrlInput) hiddenUrlInput.value = imageUrl;
                if (previewWrapper) previewWrapper.classList.remove('hidden');
                if (emptyDropzone) emptyDropzone.classList.add('hidden');
                if (statusEl) statusEl.innerHTML = '<span class="text-slate-600 font-medium">รูปภาพปัจจุบัน</span>';
            } else {
                clearStockImage('edit');
            }
        }

        function applyLocalMockStockImages() {
            try {
                document.querySelectorAll('.stock-card').forEach(card => {
                    const code = card.dataset.code;
                    if (!code) return;
                    const localImg = localStorage.getItem('stock_img_' + code);
                    if (localImg) {
                        const imgEl = card.querySelector('.stock-card-img-wrapper img');
                        if (imgEl) imgEl.src = localImg;
                        card.dataset.image = localImg;
                        const editBtn = card.querySelector('button[onclick*="openEditModal"]');
                        if (editBtn) editBtn.dataset.image = localImg;
                    }
                });
            } catch (e) {
                console.warn('applyLocalMockStockImages error:', e);
            }
        }

        // --- ถ่ายรูปจากกล้อง (เปิดกล้องมือถือ/อุปกรณ์โดยตรง Native Camera) ---
        function triggerCameraDirect(mode) {
