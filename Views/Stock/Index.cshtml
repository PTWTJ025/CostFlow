                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" onclick="closeSimulateModal()" class="px-4 py-2 bg-white border border-slate-300 rounded-md text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer whitespace-nowrap shrink-0">
                        ปิด
                    </button>
                    <button type="button" id="btnSubmitSelectedCandidate" onclick="submitSelectedCandidate()" class="px-4 py-2 bg-primary text-white rounded-md text-xs font-semibold hover:bg-primary/90 transition-colors flex items-center gap-1.5 shadow-xs disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer whitespace-nowrap shrink-0" disabled>
