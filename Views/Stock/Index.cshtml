            const result = await Swal.fire({
                title: 'ยืนยันการลบสินค้า?',
                html: `ต้องการลบ <b>${name || code}</b> (${code}) ออกจากระบบสต๊อกหรือไม่?<br><span class="text-xs text-red-500">การกระทำนี้จะลบรายการออกจากระบบและไม่สามารถกู้คืนได้</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
