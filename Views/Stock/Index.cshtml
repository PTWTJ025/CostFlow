            <!-- Stats Bar (รหัส, หมวดหมู่, ขั้นต่ำ, สูงสุด, สต๊อกปัจจุบัน) -->
            <div id="historyStatsBar" class="px-4 sm:px-5 py-2 bg-slate-50/40 border-b border-slate-100 flex items-center justify-between gap-2.5 text-xs shrink-0">
                <div class="flex items-center gap-2 text-slate-500 min-w-0 flex-wrap">
