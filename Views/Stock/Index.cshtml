        async function loadPendingOrders(targetOrderId = null) {
            const select = document.getElementById('receiveOrderSelect');
            const countBadge = document.getElementById('receiveOrderCountBadge');
            const bellBadge = document.getElementById('pendingReceiveBadge');
            const triggerText = document.getElementById('receiveOrderSelectedText');
            const triggerQty = document.getElementById('receiveOrderSelectedQtyBadge');
            if (!select) return;

            select.innerHTML = '<option value="">-- กำลังโหลดรายการรอรับจาก Monthly Cost... --</option>';
            if (triggerText) {
                triggerText.textContent = 'กำลังโหลดรายการรอรับ...';
                triggerText.title = 'กำลังโหลดรายการรอรับ...';
            }
            if (triggerQty) triggerQty.classList.add('hidden');

            try {
                let url = '/Stock/GetPendingReceiveOrders';
                if (targetOrderId) {
                    url += `?specificOrderId=${encodeURIComponent(targetOrderId)}`;
                }
                const resp = await fetch(url);
                const data = await resp.json();

                if (data.success && data.items && data.items.length > 0) {
                    pendingOrdersList = data.items;
                    const pendingOnlyCount = data.pendingCount !== undefined ? data.pendingCount : data.items.filter(x => !x.isReconciled && !x.IsReconciled).length;

                    if (countBadge) countBadge.textContent = `${pendingOnlyCount} รายการ`;
                    if (bellBadge) {
                        bellBadge.textContent = pendingOnlyCount;
                        if (pendingOnlyCount > 0) {
                            bellBadge.classList.add('animate-pulse');
                        } else {
                            bellBadge.classList.remove('animate-pulse');
                        }
                    }

                    // 1. อัปเดต native select เพื่อความเข้ากันได้
                    select.innerHTML = data.items.map(it => {
                        const po = it.poNumber || it.PoNumber || '-';
                        const name = it.orderName || it.OrderName || '';
                        const qty = it.quantity || it.Quantity || 1;
                        const unit = it.unit || it.Unit || 'ชิ้น';
                        const isRecon = it.isReconciled || it.IsReconciled;
                        const statusTag = isRecon ? ' (รับเข้าสต๊อกแล้ว)' : '';
                        return `<option value="${it.orderId || it.OrderId}">[PO: ${po}] ${name} (${qty} ${unit})${statusTag}</option>`;
                    }).join('');

                    // 2. เรนเดอร์ Custom Dropdown Options List
                    renderCustomReceiveOrderOptions(pendingOrdersList);

                    // 3. เลือกรายการเป้าหมาย หรือรายการแรก
                    let selectedItem = null;
                    if (targetOrderId) {
                        selectedItem = pendingOrdersList.find(x => (x.orderId || x.OrderId) == targetOrderId);
                    }
                    if (!selectedItem) {
                        selectedItem = pendingOrdersList[0];
                    }

                    if (selectedItem) {
                        selectCustomReceiveOrder(selectedItem);
                    }
                } else {
                    pendingOrdersList = [];
                    if (countBadge) countBadge.textContent = 'ไม่มีรายการค้างรับ';
                    if (bellBadge) {
                        bellBadge.textContent = '0';
                        bellBadge.classList.remove('animate-pulse');
                    }
                    select.innerHTML = '<option value="">-- ไม่มีรายการรอรับของในขณะนี้ --</option>';
                    if (triggerText) {
                        triggerText.textContent = 'ไม่มีรายการรอรับของในขณะนี้';
                        triggerText.title = 'ไม่มีรายการรอรับของในขณะนี้';
                    }
                    if (triggerQty) triggerQty.classList.add('hidden');
                    renderCustomReceiveOrderOptions([]);

                    const rawDisplay = document.getElementById('simulateRawTextDisplay');
                    if (rawDisplay) rawDisplay.textContent = '-';
                    const poBadge = document.getElementById('receivePoBadge');
                    const monthBadge = document.getElementById('receiveMonthBadge');
                    if (poBadge) poBadge.classList.add('hidden');
                    if (monthBadge) monthBadge.classList.add('hidden');
                }
            } catch (err) {
                console.error('loadPendingOrders error:', err);
                select.innerHTML = '<option value="">-- ไม่สามารถโหลดรายการได้ --</option>';
                if (triggerText) triggerText.textContent = 'ไม่สามารถโหลดรายการได้';
            }
        }

