                            <div class="flex items-center justify-between text-xs pt-1.5 border-t border-emerald-200/60">
                                <span class="text-slate-600">คงเหลือในโกดัง: <strong id="exactMatchStockQty" class="text-slate-800 font-bold"></strong> ชิ้น</span>
                                <button type="button" onclick="confirmExactMatch()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-md text-xs font-bold transition-colors shadow-xs flex items-center gap-1 cursor-pointer">
