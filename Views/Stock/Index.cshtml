                    <!-- Candidates Section (Clean-Craft: Unified container with divide-y) -->
                    <div id="simulateCandidatesSection" class="hidden space-y-2">
                        <!-- Chevron Toggle Bar (ใช้เมื่อต้องการย่อ/ขยายในกรณี Exact Match) -->
                        <button type="button" onclick="toggleCandidatesAccordion()" id="btnToggleCandidates" class="hidden w-full py-2 px-3 items-center justify-between text-xs font-medium text-slate-600 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 rounded-md border border-slate-200 transition-colors cursor-pointer select-none">
