        // Modal Functions (เพิ่มสินค้า)
        function openAddModal() {
            const modal = document.getElementById('addStockModal');
            const form = document.getElementById('addStockForm');
            if (form) form.reset();
            clearStockImage('add');

            if (modal) {
                modal.classList.remove('hidden');
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
                setTimeout(() => {
                    document.getElementById('modalProductCode')?.focus();
                }, 50);
            }
        }

        function closeAddModal() {
            const modal = document.getElementById('addStockModal');
            if (modal) modal.classList.add('hidden');

            // หากเปิดมาจากหน้าต่างตรวจรับสินค้า ให้เปิดหน้าต่างตรวจรับสินค้ากลับมา
            if (isCreatedFromReceive) {
                isCreatedFromReceive = false;
                const receiveModal = document.getElementById('simulateReceiveModal');
                if (receiveModal) receiveModal.classList.remove('hidden');
            }
        }

        // ฟังก์ชันเปิด Popup เพิ่มสินค้าพร้อมดึงชื่อและจำนวนที่ตัดคำแล้วจากรายการตรวจรับสินค้า (Admin Only)
        function openAddStockFromReceive() {
            const rawText = (currentLoadedOrder?.orderName || currentSimulateData?.cleanName || document.getElementById('simulateRawText')?.value || '').trim();
            const cleanName = currentSimulateData?.cleanName || rawText;

            isCreatedFromReceive = true;

            // ซ่อนหน้าต่างรับของชั่วคราว
            const receiveModal = document.getElementById('simulateReceiveModal');
            if (receiveModal) receiveModal.classList.add('hidden');

            openAddModal();

            // เติมข้อมูลชื่อสินค้าที่ตัดคำส่วนเกิน (เป้าหมาย, วันที่, จำนวน) ออกแล้วให้อัตโนมัติ
            const nameInput = document.getElementById('modalProductName');
            if (nameInput) nameInput.value = cleanName;

            // สต๊อกเริ่มต้นตั้งเป็น 0 เพื่อรอให้การยืนยันรับเข้าจาก PO บวกยอดเข้าไปตามขั้นตอนตรวจรับ
            const qtyInput = document.getElementById('modalQuantity');
            if (qtyInput) qtyInput.value = 0;

            // โฟกัสไปที่ช่องรหัสสินค้าทันที
            setTimeout(() => {
                const codeInput = document.getElementById('modalProductCode');
                if (codeInput) {
                    codeInput.focus();
                    codeInput.select();
                }
            }, 100);
        }

        // ส่งข้อมูลบันทึกสินค้าใหม่ไปยัง Backend
        async function submitAddStock(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitAddStock');
            const code = document.getElementById('modalProductCode').value.trim();
            const name = document.getElementById('modalProductName').value.trim();
            const category = document.getElementById('modalCategory').value.trim();
            const qty = parseFloat(document.getElementById('modalQuantity').value) || 0;
            const min = parseFloat(document.getElementById('modalMinStock').value) || 0;
            const max = parseFloat(document.getElementById('modalMaxStock').value) || 0;
            const imagePath = document.getElementById('modalStockImageUrl')?.value.trim() || null;

            if (!code || !name) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ข้อมูลไม่ครบถ้วน',
                    text: 'กรุณากรอกรหัสสินค้าและชื่อสินค้า'
                });
                return;
            }

            btn.disabled = true;
            btn.textContent = 'กำลังบันทึก...';

            try {
                const resp = await fetch('/Stock/AddItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productCode: code,
                        productName: name,
                        category: category,
                        filePath: imagePath,
                        quantity: qty,
                        minStock: min,
                        maxStock: max
                    })
                });

                const data = await resp.json();

                if (data.success) {
                    if (code) {
                        if (imagePath) {
                            localStorage.setItem('stock_img_' + code, imagePath);
                        } else {
                            localStorage.removeItem('stock_img_' + code);
                        }
                    }
                    const wasFromReceive = isCreatedFromReceive;
                    closeAddModal();

                    if (wasFromReceive) {
                        if (typeof Swal !== 'undefined') {
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2000,
                                timerProgressBar: true
                            });
                            Toast.fire({
                                icon: 'success',
                                title: `สร้างสินค้า ${code} สำเร็จแล้ว`
                            });
                        }

                        // เปิดหน้าต่างตรวจรับของกลับมา
                        const receiveModal = document.getElementById('simulateReceiveModal');
                        if (receiveModal) receiveModal.classList.remove('hidden');

                        // รัน AI Matching ซ้ำทันที สินค้าที่เพิ่งสร้างจะจับคู่ได้ 100% Match ทันที!
                        await runSimulateAnalysis();
                    } else {
                        await Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ!',
                            text: data.message || 'เพิ่มสินค้าใหม่เรียบร้อยแล้ว',
                            timer: 1500,
                            showConfirmButton: false
                        });
                        window.location.reload();
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไม่สามารถบันทึกได้',
                        text: data.message || 'เกิดข้อผิดพลาดในการบันทึกสินค้า'
                    });
                }
            } catch (err) {
                console.error('submitAddStock error:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้'
                });
            } finally {
                btn.disabled = false;
                btn.textContent = 'บันทึกสินค้า';
            }
        }

        // Modal Functions (แก้ไขสินค้า)
        function openEditModal(btn) {
            const dataset = btn.dataset;
            const code = dataset.code || '';
            const localImg = localStorage.getItem('stock_img_' + code);

            document.getElementById('editItemId').value = dataset.id || '';
            document.getElementById('editProductCode').value = code;
            document.getElementById('editProductName').value = dataset.name || '';
            document.getElementById('editCategory').value = dataset.category || 'อะไหล่';
            document.getElementById('editMinStock').value = dataset.min && dataset.min !== '0' ? parseFloat(dataset.min) : '';
            document.getElementById('editMaxStock').value = dataset.max && dataset.max !== '0' ? parseFloat(dataset.max) : '';
            document.getElementById('editQuantity').value = dataset.quantity !== undefined ? parseFloat(dataset.quantity) : '';
            setEditStockImage(localImg || dataset.image || '');

            const modal = document.getElementById('editStockModal');
            if (modal) {
                modal.classList.remove('hidden');
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
                setTimeout(() => {
                    const firstInput = document.getElementById('editProductCode');
                    if (firstInput) {
                        firstInput.focus();
                        firstInput.select();
                    }
                }, 50);
            }
        }

        function closeEditModal() {
            const modal = document.getElementById('editStockModal');
            if (modal) modal.classList.add('hidden');
        }

