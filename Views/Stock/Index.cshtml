        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function parseOrderInfo(rawText) {
            if (!rawText) return { cleanName: '-', meta: '' };
            
            // จัดการบรรทัดและการตัดคำ metadata (จำนวน, เป้าหมาย, หมายเหตุ)
            const normalized = rawText.replace(/\r\n/g, '\n').trim();
            const lines = normalized.split('\n').map(l => l.trim()).filter(Boolean);
            
            let cleanParts = [];
            let metaParts = [];
            
            for (const line of lines) {
                if (/^(?:จำนวน|เป้าหมาย|แก้ไขใหม่|มีชิ้นงาน|ด่วน|หมายเหตุ)/i.test(line)) {
                    const filtered = line.replace(/แก้ไขใหม่กรณีไม่อนุมัติ.*$/gi, '').trim();
                    if (filtered) metaParts.push(filtered);
                } else {
                    const match = line.match(/^(.*?)(?:\s+(?:จำนวน\s*\d+|เป้าหมาย\s*[\d\/]+|แก้ไขใหม่).*)$/i);
                    if (match && match[1] && match[1].trim().length > 1) {
                        cleanParts.push(match[1].trim());
                        const remaining = line.substring(match[1].length).trim();
                        const filtered = remaining.replace(/แก้ไขใหม่กรณีไม่อนุมัติ.*$/gi, '').trim();
                        if (filtered) metaParts.push(filtered);
                    } else {
                        const cleanLine = line.replace(/แก้ไขใหม่กรณีไม่อนุมัติ.*$/gi, '').trim();
                        if (cleanLine) cleanParts.push(cleanLine);
                    }
                }
            }
            
            let cleanName = cleanParts.join(' ').trim();
            if (!cleanName) cleanName = lines[0] || normalized;
            
            const meta = metaParts.join(' • ').trim();
            return { cleanName, meta };
        }

        function renderCustomReceiveOrderOptions(items) {
            const listEl = document.getElementById('receiveOrderOptionsList');
            if (!listEl) return;

            if (!items || items.length === 0) {
                listEl.innerHTML = '<div class="p-4 text-center text-xs text-slate-400 italic">ไม่มีรายการรอรับของ</div>';
                return;
            }

            const currentSelectedId = document.getElementById('receiveOrderSelect')?.value;

            listEl.innerHTML = items.map(it => {
                const id = it.orderId || it.OrderId;
                const po = it.poNumber || it.PoNumber || '';
                const name = it.orderName || it.OrderName || '';
                const qty = it.quantity || it.Quantity || 1;
                const unit = it.unit || it.Unit || 'ชิ้น';
                const isRecon = it.isReconciled || it.IsReconciled;
                const isSelected = currentSelectedId && currentSelectedId == id;
                const info = parseOrderInfo(name);

                const safeTitle = `[PO: ${po || '-'}] ${name}`.replace(/"/g, '&quot;');
                const displayText = (po && po !== '-') ? `${po} ${info.cleanName}` : info.cleanName;

                return `
                    <div class="receive-order-option-item px-3 py-2 hover:bg-slate-50 cursor-pointer transition-colors text-left border-l-2 ${isSelected ? 'bg-blue-50/60 border-primary' : 'border-transparent'}" 
                         data-order-id="${id}"
                         onclick="onCustomReceiveOrderClick('${id}')"
                         title="${safeTitle}">
                        <div class="flex items-center justify-between gap-2 text-xs font-semibold text-slate-800 leading-snug">
                            <span class="truncate flex-1 min-w-0">${escapeHtml(displayText)}</span>
                            <div class="flex items-center gap-1.5 shrink-0 font-normal">
                                ${isRecon ? '<span class="text-[9px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1 py-0.5 rounded leading-none">รับแล้ว</span>' : ''}
                                <span class="text-[11px] text-slate-500 font-sans">(${Number(qty).toLocaleString()} ${escapeHtml(unit)})</span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function onCustomReceiveOrderClick(orderId) {
            const item = pendingOrdersList.find(x => (x.orderId || x.OrderId) == orderId);
            if (item) {
                selectCustomReceiveOrder(item);
                closeReceiveOrderDropdown();
            }
        }

        function selectCustomReceiveOrder(item) {
            const select = document.getElementById('receiveOrderSelect');
            const triggerText = document.getElementById('receiveOrderSelectedText');
            const triggerQty = document.getElementById('receiveOrderSelectedQtyBadge');
            const orderId = item.orderId || item.OrderId;
            const po = item.poNumber || item.PoNumber || '';
            const name = item.orderName || item.OrderName || '';
            const qty = item.quantity || item.Quantity || 1;
            const unit = item.unit || item.Unit || 'ชิ้น';

            if (select) {
                select.value = orderId;
            }

            const info = parseOrderInfo(name);
            const displayText = (po && po !== '-') ? `${po} ${info.cleanName}` : info.cleanName;

            if (triggerText) {
                triggerText.textContent = displayText;
                triggerText.title = `[PO: ${po || '-'}] ${name}`;
            }

            if (triggerQty) {
                triggerQty.textContent = `(${Number(qty).toLocaleString()} ${unit})`;
                triggerQty.classList.remove('hidden');
            }

            // ไฮไลต์รายการที่ถูกเลือกในเมนู
            const listEl = document.getElementById('receiveOrderOptionsList');
            if (listEl) {
                listEl.querySelectorAll('.receive-order-option-item').forEach(el => {
                    if (el.dataset.orderId == orderId) {
                        el.classList.add('bg-blue-50/60', 'border-primary');
                        el.classList.remove('border-transparent');
                    } else {
                        el.classList.remove('bg-blue-50/60', 'border-primary');
                        el.classList.add('border-transparent');
                    }
                });
            }

            loadOrderIntoModal(item);
        }

        function skipToNextReceiveOrder() {
            if (!pendingOrdersList || pendingOrdersList.length === 0) {
                closeReceiveModal();
                return;
            }

            if (pendingOrdersList.length === 1) {
                return;
            }

            const currentSelectedId = document.getElementById('receiveOrderSelect')?.value;
            const currentIndex = pendingOrdersList.findIndex(x => (x.orderId || x.OrderId) == currentSelectedId);

            let nextIndex = currentIndex + 1;
            if (nextIndex >= pendingOrdersList.length || currentIndex === -1) {
                nextIndex = 0;
            }

            const nextItem = pendingOrdersList[nextIndex];
            selectCustomReceiveOrder(nextItem);
        }

        function filterReceiveOrderOptions(query) {
            const q = (query || '').toLowerCase().trim();
            const listEl = document.getElementById('receiveOrderOptionsList');
            if (!listEl) return;

            const items = listEl.querySelectorAll('.receive-order-option-item');
            let visibleCount = 0;
            items.forEach(el => {
                const text = el.textContent.toLowerCase();
                if (!q || text.includes(q)) {
                    el.style.display = '';
                    visibleCount++;
                } else {
                    el.style.display = 'none';
                }
            });

            let noResultsEl = document.getElementById('receiveOrderNoResultsNotice');
            if (visibleCount === 0) {
                if (!noResultsEl) {
                    noResultsEl = document.createElement('div');
                    noResultsEl.id = 'receiveOrderNoResultsNotice';
                    noResultsEl.className = 'p-4 text-center text-xs text-slate-400 italic';
                    noResultsEl.textContent = 'ไม่พบรายการที่ตรงกับคำค้นหา';
                    listEl.appendChild(noResultsEl);
                }
                noResultsEl.style.display = '';
            } else if (noResultsEl) {
                noResultsEl.style.display = 'none';
            }
        }

        function loadOrderIntoModal(item) {
            currentLoadedOrder = item;
            currentLoadedPoNumber = item.poNumber || item.PoNumber || null;

            const orderName = item.orderName || item.OrderName || '';
            const rawInput = document.getElementById('simulateRawText');
            if (rawInput) {
                rawInput.value = orderName;
            }

            const rawDisplay = document.getElementById('simulateRawTextDisplay');
            if (rawDisplay) {
                rawDisplay.textContent = orderName || '-';
            }

            // Always ensure PO badge and Month badge remain hidden as requested
            const poBadge = document.getElementById('receivePoBadge');
            if (poBadge) {
                poBadge.classList.add('hidden');
            }

            const monthBadge = document.getElementById('receiveMonthBadge');
            if (monthBadge) {
                monthBadge.classList.add('hidden');
            }

            // เซ็ตจำนวนจริงจาก Monthly Cost / PO ทันที
            const qtyInput = document.getElementById('simulateQuantityInput');
            if (qtyInput) {
                qtyInput.value = item.quantity || item.Quantity || 1;
            }

            const unitText = document.getElementById('simulateUnitText');
            if (unitText) {
                unitText.textContent = item.unit || item.Unit || 'ชิ้น';
            }

            // รันการวิเคราะห์จับคู่โดยอัตโนมัติทันที
            runSimulateAnalysis();
        }

        function toggleCandidatesAccordion() {
            const container = document.getElementById('simulateCandidatesContainer');
            const icon = document.getElementById('candidatesChevronIcon');
            if (!container) return;

            const isHidden = container.classList.contains('hidden');
            if (isHidden) {
                container.classList.remove('hidden');
                if (icon) icon.classList.add('rotate-180');
            } else {
                container.classList.add('hidden');
                if (icon) icon.classList.remove('rotate-180');
            }
        }

        async function runSimulateAnalysis() {
            const rawText = document.getElementById('simulateRawText').value.trim();
            if (!rawText) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาระบุข้อความ',
                    text: 'พิมพ์หรือเลือกข้อความเพื่อวิเคราะห์'
                });
                return;
            }

            const loading = document.getElementById('simulateLoadingState');
            const panel = document.getElementById('simulateAnalysisPanel');
            const placeholder = document.getElementById('simulateInitialPlaceholder');
            const btn = document.getElementById('btnRunSimulate');

            loading.classList.remove('hidden');
            loading.classList.add('flex');
            if (panel) panel.classList.add('hidden');
            if (placeholder) placeholder.classList.add('hidden');
            if (btn) btn.disabled = true;

            try {
                const resp = await fetch('/Stock/SimulateReceiveItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rawText: rawText })
                });

                const data = await resp.json();
                loading.classList.add('hidden');
                loading.classList.remove('flex');
                if (btn) btn.disabled = false;

                if (data.success) {
                    currentSimulateData = data;
                    if (panel) panel.classList.remove('hidden');

                    // 1. แสดงผลการสกัดข้อความ (Sanitization)
                    const cleanNameEl = document.getElementById('simulateCleanName');
                    if (cleanNameEl) cleanNameEl.textContent = data.cleanName || rawText;

                    // กำหนดจำนวนรับเข้าคลัง: หากมาจากรายการ PO ให้ใช้จำนวนจริงจาก PO เป็นหลัก
                    const actualQty = (currentLoadedOrder && (currentLoadedOrder.quantity || currentLoadedOrder.Quantity))
                        ? (currentLoadedOrder.quantity || currentLoadedOrder.Quantity)
                        : (data.detectedQuantity || 1);
                    document.getElementById('simulateQuantityInput').value = actualQty;
                    document.getElementById('simulateUnitText').textContent = data.detectedUnit || (currentLoadedOrder?.unit || currentLoadedOrder?.Unit || 'ชิ้น');

                    // สรุป Noise
                    const noiseEl = document.getElementById('simulateNoiseTags');
                    if (noiseEl) {
                        const noiseParts = [];
                        if (data.extractedTargetDate) noiseParts.push(`เป้าหมาย: ${data.extractedTargetDate}`);
                        if (data.extractedRemarks) noiseParts.push(`หมายเหตุ: ${data.extractedRemarks}`);
                        if (data.detectedQuantity > 1 || data.detectedUnit) noiseParts.push(`สกัดจำนวน: ${data.detectedQuantity} ${data.detectedUnit || 'ชิ้น'}`);
                        noiseEl.textContent = noiseParts.length > 0 ? noiseParts.join(' | ') : 'ไม่มี Noise ส่วนเกิน';
                    }

                    // 2. แสดงผล Exact Match vs Fuzzy Candidates
                    const exactBanner = document.getElementById('simulateExactMatchBanner');
                    const candidatesSection = document.getElementById('simulateCandidatesSection');
                    const candidatesContainer = document.getElementById('simulateCandidatesContainer');
                    const btnToggle = document.getElementById('btnToggleCandidates');
                    const chevronIcon = document.getElementById('candidatesChevronIcon');
                    const accordionTitle = document.getElementById('candidatesAccordionTitle');
                    const accordionBadge = document.getElementById('candidatesAccordionBadge');
                    const submitBtn = document.getElementById('btnSubmitSelectedCandidate');
                    const skipOption = document.getElementById('simulateSkipOption');

                    submitBtn.disabled = true;
                    selectedCandidateCode = null;

                    const matches = data.matches || [];
                    const exactMatch = matches.find(m => m.isExactNameMatch || m.isExactMapping || m.matchPercentage === 100);

                    if (exactMatch) {
                        exactBanner.classList.remove('hidden');
                        document.getElementById('exactMatchProductCode').textContent = exactMatch.productCode;
                        document.getElementById('exactMatchProductName').textContent = exactMatch.productName;
                        document.getElementById('exactMatchStockQty').textContent = Number(exactMatch.quantity).toLocaleString();

                        // หากพบ Exact 100% ให้แสดงปุ่มดูตัวเลือกอื่นแบบย่อ
                        if (candidatesSection) candidatesSection.classList.remove('hidden');
                        if (candidatesContainer) candidatesContainer.classList.add('hidden');
                        if (btnToggle) {
                            btnToggle.classList.remove('hidden');
                            btnToggle.classList.add('flex');
                        }
                        if (chevronIcon) chevronIcon.classList.remove('rotate-180');
                        if (accordionTitle) accordionTitle.textContent = 'ดูตัวเลือกที่ใกล้เคียงอื่นๆ';
                        if (accordionBadge) accordionBadge.textContent = `${matches.length} รายการ`;
                    } else {
                        exactBanner.classList.add('hidden');

                        // หากเป็น Fuzzy Match ให้แสดงรายชื่อให้เลือกทันทีโดยไม่ต้องผ่านปุ่ม Toggle ซ้ำซ้อน
                        if (candidatesSection) candidatesSection.classList.remove('hidden');
                        if (candidatesContainer) candidatesContainer.classList.remove('hidden');
                        if (btnToggle) {
                            btnToggle.classList.add('hidden');
                            btnToggle.classList.remove('flex');
                        }
                    }

                    if (skipOption) skipOption.classList.remove('hidden');

                    // แสดง Candidates List ด้วย Clean-Craft row style
                    if (matches.length === 0) {
                        candidatesContainer.innerHTML = `
                            <div class="p-6 text-center text-slate-400 text-xs flex flex-col items-center gap-2.5">
                                <span>ไม่พบรายการที่มีความใกล้เคียงในระบบสต๊อกสินค้า</span>
                                ${isAdminUser ? `
                                    <button type="button" onclick="openAddStockFromReceive()" class="px-3 py-1.5 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 rounded-md font-semibold flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs">
                                        <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                                        <span>สร้างรายการนี้เป็นสินค้าใหม่ลงสต๊อก</span>
                                    </button>
                                ` : ''}
                            </div>
                        `;
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    } else {
                        candidatesContainer.innerHTML = matches.map((m, idx) => {
                            const isExact = m.isExactNameMatch || m.isExactMapping || m.matchPercentage === 100;
                            let scoreBadge = '';
                            if (isExact) {
                                // ระดับ 1: ตรงกัน 100% (Exact Match) - เขียวมรกต
                                scoreBadge = '<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80">100% Match</span>';
                            } else if (m.matchPercentage >= 80) {
                                // ระดับ 2: ใกล้เคียงสูงมาก 80% - 99% - น้ำเงินสด
                                scoreBadge = `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200/80">${m.matchPercentage}% Match</span>`;
                            } else if (m.matchPercentage >= 60) {
                                // ระดับ 3: ใกล้เคียงปานกลาง 60% - 79% - ฟ้าสว่าง
                                scoreBadge = `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-sky-50 text-sky-600 border border-sky-200/80">${m.matchPercentage}% Match</span>`;
                            } else if (m.matchPercentage >= 40) {
                                // ระดับ 4: ใกล้เคียงบางคำ 40% - 59% - ส้มเหลืองอำพัน
                                scoreBadge = `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-amber-50 text-amber-700 border border-amber-200/80">${m.matchPercentage}% Match</span>`;
                            } else {
                                // ระดับ 5: ตรงน้อย < 40% - เทาสุภาพ
                                scoreBadge = `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200/70">${m.matchPercentage}% Match</span>`;
                            }

                            return `
                                <label class="p-3 hover:bg-slate-50/80 transition-colors flex items-start gap-3 cursor-pointer select-none bg-white">
                                    <input type="radio" name="simulateSelectedStock" value="${m.productCode}" onchange="onCandidateSelected('${m.productCode}')" class="mt-1 h-4 w-4 text-primary border-slate-300 focus:ring-0 focus:outline-none cursor-pointer shrink-0" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center justify-between gap-2">
                                            <div class="flex items-center gap-2 min-w-0">
                                                <span class="font-mono font-bold text-xs text-primary shrink-0">${m.productCode}</span>
                                                <span class="text-xs font-semibold text-slate-800 truncate">${m.productName}</span>
                                            </div>
                                            <div class="shrink-0">
                                                ${scoreBadge}
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-3 mt-1 text-[11px] text-slate-500">
                                            <span>หมวด: <span class="text-slate-700 font-medium">${m.category || 'ทั่วไป'}</span></span>
                                            <span class="text-slate-300">•</span>
                                            <span>สต๊อกปัจจุบัน: <strong class="text-slate-800 font-semibold">${Number(m.quantity).toLocaleString()}</strong> ชิ้น</span>
                                        </div>
                                    </div>
                                </label>
                            `;
                        }).join('');
                    }

                    document.getElementById('simulateMatchCount').textContent = `พบ ${matches.length} รายการ`;
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: data.message || 'ไม่สามารถวิเคราะห์ข้อความได้'
                    });
                }
            } catch (err) {
                console.error('runSimulateAnalysis error:', err);
                loading.classList.add('hidden');
                loading.classList.remove('flex');
                if (btn) btn.disabled = false;
                Swal.fire({
                    icon: 'error',
                    title: 'การเชื่อมต่อผิดพลาด',
                    text: 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้'
                });
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }

        function onCandidateSelected(productCode) {
            selectedCandidateCode = productCode;
            const submitBtn = document.getElementById('btnSubmitSelectedCandidate');
            if (submitBtn) submitBtn.disabled = !productCode;

            // เปลี่ยนเฉพาะสีพื้นหลังเมื่อเลือก (ไม่มีแถบสีขอบซ้าย)
            const labels = document.querySelectorAll('#simulateCandidatesContainer label');
            labels.forEach(lbl => {
                const input = lbl.querySelector('input[type="radio"]');
                if (input && input.value === productCode) {
                    lbl.classList.add('bg-blue-50/60');
                    lbl.classList.remove('bg-white');
                } else {
                    lbl.classList.remove('bg-blue-50/60');
                    lbl.classList.add('bg-white');
                }
            });
        }

        async function confirmExactMatch() {
            if (!currentSimulateData) return;
            const matches = currentSimulateData.matches || [];
            const exact = matches.find(m => m.isExactNameMatch || m.isExactMapping || m.matchPercentage === 100);
            if (!exact) return;

            const qty = parseFloat(document.getElementById('simulateQuantityInput').value) || (currentLoadedOrder?.quantity || 1);
            const orderName = currentLoadedOrder?.orderName || currentSimulateData.cleanName;
            const refId = currentLoadedPoNumber || 'RECEIVE-PO';
            await executeQuickReceive(exact.productCode, qty, orderName, `รับเข้าคลังอัตโนมัติ (100% Match จาก: ${orderName})`, refId);
        }

        async function submitSelectedCandidate() {
            if (!selectedCandidateCode || !currentSimulateData) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ยังไม่ได้เลือกสินค้า',
                    text: 'กรุณาคลิกเลือกสินค้าในรายการที่ต้องการรับเข้า'
                });
                return;
            }

            const qty = parseFloat(document.getElementById('simulateQuantityInput').value) || (currentLoadedOrder?.quantity || 1);
            const orderName = currentLoadedOrder?.orderName || currentSimulateData.cleanName;
            const refId = currentLoadedPoNumber || 'RECEIVE-PO';
            await executeQuickReceive(selectedCandidateCode, qty, orderName, `รับเข้าคลังผ่าน AI Matching (จับคู่จาก: ${orderName})`, refId);
        }

        async function executeQuickReceive(productCode, quantity, orderName, remarks, referenceId) {
            try {
                Swal.fire({
                    title: 'กำลังบันทึกสต๊อก...',
                    text: 'ระบบกำลังอัปเดตยอดคงเหลือและบันทึกความจำลง ItemMappings',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                const resp = await fetch('/Stock/QuickConfirmReceive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productCode: productCode,
                        quantity: quantity,
                        orderName: orderName,
                        remarks: remarks,
                        referenceId: referenceId
                    })
                });

                const result = await resp.json();
                if (result.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'รับสินค้าเข้าสต๊อกสำเร็จ!',
                        html: `
                            <p class="text-sm text-slate-600">${result.message}</p>
                            <p class="text-xs text-slate-400 mt-2 font-mono">รหัส: <strong>${result.productCode}</strong> | ยอดใหม่: <strong class="text-emerald-600">${Number(result.newQuantity).toLocaleString()}</strong> ชิ้น (${result.newStatus})</p>
                        `,
                        confirmButtonText: 'ตกลง'
                    });

                    // อัปเดตรายการที่ค้างรับ
                    if (pendingOrdersList && pendingOrdersList.length > 1) {
                        await loadPendingOrders();
                    } else {
                        closeReceiveModal();
                        window.location.reload();
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไม่สามารถบันทึกได้',
                        text: result.message || 'เกิดข้อผิดพลาดในการบันทึกสต๊อก'
                    });
                }
            } catch (err) {
                console.error('executeQuickReceive error:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'
                });
            }
        }
    </script>
}
