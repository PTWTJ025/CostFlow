@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // โหลดจำนวนรายการรอรับจริงทันทีตอนเปิดหน้า
            refreshPendingBadgeCount();

            // ตรวจสอบ query param autoOpenReceive เพื่อเปิด Modal ตรวจรับของทันทีเมื่อสลับมาจาก Monthly Cost
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('autoOpenReceive') === 'true') {
                const orderId = urlParams.get('orderId');
                openReceiveModal(orderId);
                // ล้าง query params จาก URL โดยไม่รีโหลดหน้า
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // ระบบค้นหาสินค้า Real-time + Autocomplete Guide List (ทั้ง Desktop Table และ Mobile Cards)
            const searchInput = document.getElementById('stockCustomSearch');
            const stockDropdown = document.getElementById('stock-suggestions-dropdown');
            const stockItemsData = @Html.Raw(Json.Serialize(Model.Select(m => new { code = m.ProductCode, name = m.ProductName })));

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase().trim();
                    // 1. ตาราง Desktop
                    const rows = document.querySelectorAll('#stockTable tbody tr');
                    rows.forEach(function(row) {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? '' : 'none';
                    });
                    // 2. การ์ด Mobile
                    const cards = document.querySelectorAll('#stockMobileList .stock-card');
                    cards.forEach(function(card) {
                        const text = card.textContent.toLowerCase();
                        card.style.display = text.includes(query) ? '' : 'none';
                    });

                    // 3. Autocomplete Guide List
                    if (stockDropdown) {
                        if (query.length < 1) {
                            stockDropdown.classList.add('hidden');
                            stockDropdown.innerHTML = '';
                            return;
                        }

                        const matches = stockItemsData.filter(item => 
                            (item.code || '').toLowerCase().includes(query) || 
                            (item.name || '').toLowerCase().includes(query)
                        ).slice(0, 8);

                        if (matches.length > 0) {
                            stockDropdown.innerHTML = matches.map(item => `
                                <div class="stock-suggest-item px-3 py-2 hover:bg-slate-50 cursor-pointer transition-colors text-left flex flex-col gap-0.5" data-code="${item.code}" data-name="${item.name.replace(/"/g, '&quot;')}">
                                    <span class="font-mono text-primary font-bold text-xs">${item.code}</span>
                                    <span class="text-slate-700 text-xs truncate">${item.name}</span>
                                </div>
                            `).join('');
                            stockDropdown.classList.remove('hidden');

                            stockDropdown.querySelectorAll('.stock-suggest-item').forEach(el => {
                                el.addEventListener('click', function() {
                                    searchInput.value = this.dataset.name || this.dataset.code;
                                    stockDropdown.classList.add('hidden');
                                    searchInput.dispatchEvent(new Event('input'));
                                });
                            });
                        } else {
                            stockDropdown.classList.add('hidden');
                            stockDropdown.innerHTML = '';
                        }
                    }
                });

                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        if (stockDropdown) stockDropdown.classList.add('hidden');
                    } else if (e.key === 'Enter') {
                        const firstOpt = stockDropdown?.querySelector('.stock-suggest-item');
                        if (firstOpt && !stockDropdown.classList.contains('hidden')) {
                            e.preventDefault();
                            firstOpt.click();
                        } else {
                            if (stockDropdown) stockDropdown.classList.add('hidden');
                        }
                    }
                });

                document.addEventListener('click', function(e) {
                    if (stockDropdown && !searchInput.contains(e.target) && !stockDropdown.contains(e.target)) {
                        stockDropdown.classList.add('hidden');
                    }
                });
            }

            // Custom Receive Order Dropdown Event Listeners
            const receiveSearchInput = document.getElementById('receiveOrderSearchInput');
            if (receiveSearchInput) {
                receiveSearchInput.addEventListener('input', function() {
                    filterReceiveOrderOptions(this.value);
                });
            }

            document.addEventListener('click', function(e) {
                const dropdownContainer = document.getElementById('receiveOrderDropdownContainer');
                if (dropdownContainer && !dropdownContainer.contains(e.target)) {
                    closeReceiveOrderDropdown();
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeReceiveOrderDropdown();
                }
            });

            // ปิด Modal เมื่อกดคลิกพื้นที่นอกกล่อง
            const modalEl = document.getElementById('addStockModal');
            if (modalEl) {
                modalEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeAddModal();
                    }
                });
            }

            const editModalEl = document.getElementById('editStockModal');
            if (editModalEl) {
                editModalEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeEditModal();
                    }
                });
            }

            const historyModalEl = document.getElementById('historyStockModal');
            if (historyModalEl) {
                historyModalEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeHistoryModal();
                    }
                });
            }

            // การกดปุ่ม Enter ในฟอร์มเพิ่มสินค้า ให้เลื่อนไปช่องถัดไป
            const form = document.getElementById('addStockForm');
            if (form) {
                const inputs = Array.from(form.querySelectorAll('input:not([type="hidden"]), select'));
                inputs.forEach((input, index) => {
                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault(); // ป้องกันการ Submit ก่อนกรอกครบ
                            if (index < inputs.length - 1) {
                                inputs[index + 1].focus();
                                if (typeof inputs[index + 1].select === 'function') {
                                    inputs[index + 1].select();
                                }
                            } else {
                                // ถ้าอยู่ช่องสุดท้าย (สต๊อกปัจจุบัน) แล้วกด Enter ค่อยส่งข้อมูล
                                submitAddStock(e);
                            }
                        }
                    });
                });
            }

            // การกดปุ่ม Enter ในฟอร์มแก้ไข ให้เลื่อนไปช่องถัดไป
            const editForm = document.getElementById('editStockForm');
            if (editForm) {
                const editInputs = Array.from(editForm.querySelectorAll('input:not([type="hidden"]):not([type="file"]), select'));
                editInputs.forEach((input, index) => {
                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            if (index < editInputs.length - 1) {
                                editInputs[index + 1].focus();
                                if (typeof editInputs[index + 1].select === 'function') {
                                    editInputs[index + 1].select();
                                }
                            } else {
                                submitEditStock(e);
                            }
                        }
                    });
                });
            }
        });

