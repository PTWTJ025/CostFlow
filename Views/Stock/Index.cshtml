@model IEnumerable<CostFlow.Models.StockItem>
@{
    ViewData["Title"] = "ระบบสต๊อกสินค้า (Stock System)";
    var pendingCount = (int)(ViewBag.PendingReceiveCount ?? 0);
}

<style>
    /* Desktop View: แสดงตารางแบบเดิม 100% บนหน้าจอคอมพิวเตอร์ / จอใหญ่ (>= 768px) */
    .stock-desktop-view {
        display: block !important;
    }

    .stock-mobile-view {
        display: none !important;
    }

    /* Mobile View */
    @@media (max-width: 767px) {
        .stock-desktop-view {
            display: none !important;
        }

        .stock-mobile-view {
            display: flex !important;
        }

        .stock-header-bar {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.75rem !important;
        }

        .stock-header-search,
        .stock-search-container {
            width: 100% !important;
        }
    }

  /* ซ่อนปุ่มลูกศรเพิ่มลดเลขสำหรับ Chrome, Safari, Edge และ Opera */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ซ่อนปุ่มลูกศรสำหรับ Firefox */
  input[type=number] {
    -moz-appearance: textfield;
  }

</style>

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">
    
    <!-- Page Header -->
    <div class="flex justify-between items-end mb-xs">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">ระบบสต๊อกสินค้า (Stock System)</h3>
            <p class="text-secondary text-sm">จัดการรายการสินค้าในสต๊อก, ดูยอดคงเหลือ และประวัติการเบิกจ่าย</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded border border-outline-variant shadow-sm overflow-hidden">
        <div class="stock-header-bar px-md py-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
            <h3 class="text-body-md font-bold text-on-surface">รายการสินค้าในสต๊อกทั้งหมด (@Model.Count() รายการ)</h3>
            <div class="flex items-center gap-2">
                <div class="relative w-48 md:w-60 stock-search-container">
                    <input type="text" id="stockCustomSearch" placeholder="ค้นหารหัส หรือชื่อสินค้า..." class="stock-header-search px-3 py-2 bg-white border border-outline-variant rounded text-sm text-on-surface placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary w-full transition-all shadow-sm" style="height: 38px;" autocomplete="off" />
                    <div id="stock-suggestions-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-md shadow-lg z-50 max-h-[240px] overflow-y-auto divide-y divide-slate-100"></div>
                </div>
                <button type="button"
        onclick="openReceiveModal()"
        id="btnPendingReceiveBell"
        class="px-3 py-2 bg-blue-50/70 border border-primary/30 rounded text-sm font-semibold text-primary hover:bg-blue-100/80 transition-colors flex items-center gap-1.5 shadow-sm whitespace-nowrap"
        style="height: 38px;"
        title="ตรวจรับสินค้าเข้าคลังจาก Monthly Cost / PO">

    <i data-lucide="bell" class="w-4 h-4"></i>

    <span>รายการรอรับ</span>

    <span id="pendingReceiveBadge" 
          class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-[10px] font-bold shrink-0 leading-none @(pendingCount > 0 ? "animate-pulse" : "")" 
          aria-label="จำนวนรายการรอรับเข้าคลัง">@pendingCount</span>


</button>
                <button onclick="openAddModal()" class="px-4 py-2 bg-white border border-outline-variant rounded text-sm font-medium text-secondary hover:text-primary hover:border-primary/50 transition-colors flex items-center gap-2 shadow-sm whitespace-nowrap" style="height: 38px;">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    เพิ่มสินค้าใหม่
                </button>
            </div>
        </div>

        <!-- Desktop View (ตารางเดิม 100% สำหรับหน้าจอ PC / Desktop >= 768px) -->
        <div class="stock-desktop-view overflow-x-auto">
            <table id="stockTable" class="min-w-full divide-y divide-slate-200">
                <thead>
                    <tr>
                        <th scope="col" class="px-3 py-3 text-center text-xs font-bold text-secondary uppercase tracking-wider">รหัสสินค้า</th>
                        <th scope="col" class="px-3 py-3 text-left text-xs font-bold text-secondary uppercase tracking-wider">ชื่อสินค้า</th>
                        <th scope="col" class="px-3 py-3 text-center text-xs font-bold text-secondary uppercase tracking-wider">หมวดหมู่</th>
                        <th scope="col" class="px-3 py-3 text-center text-xs font-bold text-secondary uppercase tracking-wider">คงเหลือ</th>
                        <th scope="col" class="px-3 py-3 text-center text-xs font-bold text-secondary uppercase tracking-wider">สถานะ</th>
                        <th scope="col" class="px-3 py-3 text-center text-xs font-bold text-secondary uppercase tracking-wider">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors group">
                            <td class="px-3 py-3 whitespace-nowrap text-sm font-bold text-primary text-center">
                                @item.ProductCode
                            </td>
                            <td class="px-3 py-3 whitespace-nowrap text-sm font-medium text-slate-800">
                                @item.ProductName
                            </td>
                            <td class="px-3 py-3 whitespace-nowrap text-sm text-secondary text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200" title="รหัสหมวดหมู่จาก Excel">
                                    @(string.IsNullOrEmpty(item.Category) ? "ไม่มีหมวดหมู่" : item.Category)
                                </span>
                            </td>
                            <td class="px-3 py-3 whitespace-nowrap text-sm text-center font-bold @(item.Quantity <= item.MinStock ? "text-red-600" : "text-emerald-600") cursor-help" title="ขั้นต่ำ: @item.MinStock.ToString("N0") | สูงสุด: @item.MaxStock.ToString("N0")">
                                @item.Quantity.ToString("N0")
                            </td>
                            <td class="px-3 py-3 whitespace-nowrap text-sm text-center cursor-help" title="ขั้นต่ำ: @item.MinStock.ToString("N0") | สูงสุด: @item.MaxStock.ToString("N0")">
                                @if (item.Quantity <= 0)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-red-50 text-red-700 border border-red-200/60">
                                        สต๊อกหมด
                                    </span>
                                }
                                else if (item.Quantity <= item.MinStock)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200/60">
                                        สต๊อกใกล้หมด
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-50 text-emerald-600 border border-emerald-200/60">
                                        สต๊อกเพียงพอ
                                    </span>
                                }
                            </td>
                            <td class="px-3 py-3 whitespace-nowrap text-center text-sm font-medium transition-opacity">
                                <div class="flex justify-center gap-2">
                                    <button type="button" 
                                            onclick="openEditModal(this)"
                                            data-id="@item.Id"
                                            data-code="@item.ProductCode"
                                            data-name="@item.ProductName"
                                            data-category="@(item.Category ?? "")"
                                            data-min="@item.MinStock"
                                            data-max="@item.MaxStock"
                                            data-quantity="@item.Quantity"
                                            class="p-1 text-primary hover:bg-primary-container/10 rounded transition-colors" 
                                            title="แก้ไข">
                                        <i data-lucide="edit" class="w-4 h-4"></i>
                                    </button>
                                    <button onclick="openHistoryModal('@item.ProductCode', '@item.ProductName')" class="p-1 text-secondary hover:bg-slate-100 rounded transition-colors" title="ประวัติ">
                                        <i data-lucide="history" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile View (การ์ดรายการสำหรับมือถือ < 768px) -->
        <div id="stockMobileList" class="stock-mobile-view p-3 flex-col gap-2.5 bg-slate-50/40">
            @foreach (var item in Model)
            {
                <div class="stock-card bg-white border border-slate-200 rounded-lg p-3 shadow-xs space-y-2 transition-shadow hover:shadow-sm">
                    <!-- บรรทัดที่ 1: รหัสสินค้า + หมวดหมู่ + ป้ายสถานะ -->
                    <div class="flex justify-between items-center gap-2">
                        <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                            <span class="text-sm font-bold text-primary tracking-tight">@item.ProductCode</span>
                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200 truncate max-w-[120px]">
                                @(string.IsNullOrEmpty(item.Category) ? "ไม่มีหมวดหมู่" : item.Category)
                            </span>
                        </div>
                        <div class="shrink-0">
                            @if (item.Quantity <= 0)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-red-50 text-red-700 border border-red-200/60">
                                    สต๊อกหมด
                                </span>
                            }
                            else if (item.Quantity <= item.MinStock)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200/60">
                                    สต๊อกใกล้หมด
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-50 text-emerald-600 border border-emerald-200/60">
                                    สต๊อกเพียงพอ
                                </span>
                            }
                        </div>
                    </div>

                    <!-- บรรทัดที่ 2: ชื่อสินค้า -->
                    <div class="text-sm font-medium text-slate-800 leading-snug">
                        @item.ProductName
                    </div>

                    <!-- บรรทัดที่ 3: ยอดสต๊อกคงเหลือ + ปุ่มจัดการ -->
                    <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
                        <div class="flex flex-col">
                            <span class="text-[10px] text-slate-400">สต๊อกคงเหลือ</span>
                            <div class="flex items-baseline gap-1.5">
                                <span class="text-base font-bold @(item.Quantity <= item.MinStock ? "text-red-600" : "text-emerald-600")">
                                    @item.Quantity.ToString("N0")
                                </span>
                                <span class="text-[11px] text-slate-400">
                                    (Min: @item.MinStock.ToString("N0") / Max: @item.MaxStock.ToString("N0"))
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button" 
                                    onclick="openEditModal(this)"
                                    data-id="@item.Id"
                                    data-code="@item.ProductCode"
                                    data-name="@item.ProductName"
                                    data-category="@(item.Category ?? "")"
                                    data-min="@item.MinStock"
                                    data-max="@item.MaxStock"
                                    data-quantity="@item.Quantity"
                                    class="px-2.5 py-1.5 text-xs font-medium text-primary bg-blue-50/60 hover:bg-blue-100/70 border border-primary/20 rounded-md transition-colors flex items-center gap-1" 
                                    title="แก้ไข">
                                <i data-lucide="edit" class="w-3.5 h-3.5"></i>
                                <span>แก้ไข</span>
                            </button>
                            <button type="button" 
                                    onclick="openHistoryModal('@item.ProductCode', '@item.ProductName')" 
                                    class="p-1.5 text-secondary hover:bg-slate-100 border border-slate-200 rounded-md transition-colors" 
                                    title="ประวัติ">
                                <i data-lucide="history" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <!-- Modal เพิ่มสินค้าใหม่ -->
    <div id="addStockModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 hidden">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg border border-slate-200 overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <div>
                    <h3 class="text-base font-bold text-slate-800">เพิ่มสินค้าใหม่</h3>
                    <p class="text-xs text-slate-500 mt-0.5">ระบุข้อมูลสินค้าเพื่อนำเข้าสต๊อกสินค้าหลัก</p>
                </div>
                <button type="button" onclick="closeAddModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-md hover:bg-slate-100 transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="addStockForm" onsubmit="submitAddStock(event)" class="p-6 flex flex-col gap-4">
                <!-- รหัสสินค้า -->
                <div>
                    <label for="modalProductCode" class="block text-xs font-semibold text-slate-700 mb-1">
                        รหัสสินค้า <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="modalProductCode" required placeholder="เช่น P-001 หรือ รหัสสินค้าในระบบ" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors" />
                </div>

                <!-- ชื่อสินค้า -->
                <div>
                    <label for="modalProductName" class="block text-xs font-semibold text-slate-700 mb-1">
                        ชื่อสินค้า <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="modalProductName" required placeholder="ระบุชื่อสินค้า / อะไหล่" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors" />
                </div>

                <!-- หมวดหมู่ (ดึงเฉพาะ 2 หมวดหมู่ของระบบ) -->
                <div>
                    <label for="modalCategory" class="block text-xs font-semibold text-slate-700 mb-1">
                        หมวดหมู่ <span class="text-red-500">*</span>
                    </label>
                    <select id="modalCategory" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors cursor-pointer">
                        <option value="อะไหล่">อะไหล่ (b7392108)</option>
                        <option value="อะไหล่เวียน">อะไหล่เวียน (b453465a)</option>
                    </select>
                </div>

                <!-- ตัวเลขสต๊อก 3 คอลัมน์ (เรียง: สต๊อกขั้นต่ำ, สต๊อกสูงสุด, สต๊อกปัจจุบัน ขวาสุดโดดเด่น) -->
                <div class="grid grid-cols-3 gap-3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem;">
                    <div>
                        <label for="modalMinStock" class="block text-xs font-semibold text-slate-700 mb-1">สต๊อกขั้นต่ำ</label>
                        <input type="number" id="modalMinStock" min="0" step="1" placeholder="0" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-center" />
                    </div>
                    <div>
                        <label for="modalMaxStock" class="block text-xs font-semibold text-slate-700 mb-1">สต๊อกสูงสุด</label>
                        <input type="number" id="modalMaxStock" min="0" step="1" placeholder="0" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-center" />
                    </div>
                    <div>
                        <label for="modalQuantity" class="block text-xs font-semibold text-primary mb-1">สต๊อกปัจจุบัน</label>
                        <input type="number" id="modalQuantity" min="0" step="1" placeholder="0" class="w-full px-3 py-2 bg-blue-50/60 border border-primary/40 rounded-md text-sm font-semibold text-primary focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors text-center shadow-xs" />
                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="pt-3 border-t border-slate-100 flex justify-end gap-2 mt-2">
                    <button type="button" onclick="closeAddModal()" class="px-4 py-2 bg-white border border-slate-300 rounded-md text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                        ยกเลิก
                    </button>
                    <button type="submit" id="btnSubmitAddStock" class="px-5 py-2 bg-primary text-white rounded-md text-sm font-medium hover:bg-primary/90 transition-colors flex items-center gap-1.5 shadow-sm">
                        บันทึกสินค้า
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- Modal แก้ไขข้อมูลสินค้า -->
    <div id="editStockModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 hidden">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg border border-slate-200 overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <div>
                    <h3 class="text-base font-bold text-slate-800">แก้ไขข้อมูลสินค้า</h3>
                    <p class="text-xs text-slate-500 mt-0.5">แก้ไขรายละเอียดสินค้า หมวดหมู่ และจำนวนสต๊อก</p>
                </div>
                <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-md hover:bg-slate-100 transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="editStockForm" onsubmit="submitEditStock(event)" class="p-6 flex flex-col gap-4">
                <input type="hidden" id="editItemId" />

                <!-- รหัสสินค้า -->
                <div>
                    <label for="editProductCode" class="block text-xs font-semibold text-slate-700 mb-1">
                        รหัสสินค้า <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="editProductCode" required placeholder="เช่น P-001" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors" />
                </div>

                <!-- ชื่อสินค้า -->
                <div>
                    <label for="editProductName" class="block text-xs font-semibold text-slate-700 mb-1">
                        ชื่อสินค้า <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="editProductName" required placeholder="ระบุชื่อสินค้า / อะไหล่" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors" />
                </div>

                <!-- หมวดหมู่ -->
                <div>
                    <label for="editCategory" class="block text-xs font-semibold text-slate-700 mb-1">
                        หมวดหมู่ <span class="text-red-500">*</span>
                    </label>
                    <select id="editCategory" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors cursor-pointer">
                        <option value="อะไหล่">อะไหล่ (b7392108)</option>
                        <option value="อะไหล่เวียน">อะไหล่เวียน (b453465a)</option>
                    </select>
                </div>

                <!-- สต๊อก 3 ช่อง (สต๊อกขั้นต่ำ, สต๊อกสูงสุด, VS_สต๊อกปัจจุบัน) -->
                <div class="grid grid-cols-3 gap-3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem;">
                    <div>
                        <label for="editMinStock" class="block text-xs font-semibold text-slate-700 mb-1">สต๊อกขั้นต่ำ</label>
                        <input type="number" id="editMinStock" min="0" step="1" placeholder="0" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-center" />
                    </div>
                    <div>
                        <label for="editMaxStock" class="block text-xs font-semibold text-slate-700 mb-1">สต๊อกสูงสุด</label>
                        <input type="number" id="editMaxStock" min="0" step="1" placeholder="0" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-md text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-center" />
                    </div>
                    <div>
                        <label for="editQuantity" class="block text-xs font-semibold text-primary mb-1">สต๊อกปัจจุบัน</label>
                        <input type="number" id="editQuantity" min="0" step="1" placeholder="0" class="w-full px-3 py-2 bg-blue-50/60 border border-primary/40 rounded-md text-sm font-semibold text-primary focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors text-center shadow-xs" />
                    </div>
                </div>

                <!-- Footer Buttons -->
