                <!-- 4. Option: หากสินค้าไม่มีในโกดังเดิม สามารถกดข้ามได้ หรือสร้างสินค้าใหม่ (Admin) -->
                <div id="simulateSkipOption" class="flex items-center justify-between text-xs text-slate-500 px-1 pt-0.5">
                    <span>หากสินค้าไม่มีในระบบสต๊อกเดิม หรือไม่ต้องการรับเข้า</span>
                    <div class="flex items-center gap-3 shrink-0">
                        @if (isAdmin)
                        {
                            <button type="button" onclick="openAddStockFromReceive()" class="text-xs text-emerald-600 hover:text-emerald-700 font-semibold cursor-pointer flex items-center gap-1" title="สร้างรายการนี้เป็นสินค้าใหม่ลงสต๊อก">
                                <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                                <span>สร้างเป็นสินค้าใหม่</span>
                            </button>
                        }
                        <button type="button" onclick="skipToNextReceiveOrder()" class="text-xs text-primary hover:text-primary/80 font-semibold underline cursor-pointer flex items-center gap-1" title="ข้ามไปยังรายการรอรับถัดไปใน Dropdown">
