@model CostFlow.Models.StockReconcileViewModel
@{
    ViewData["Title"] = "ตรวจรับของเข้าคลัง (AI Matching)";
}

<div class="max-w-5xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 border-b border-slate-200 pb-5 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">AI Stock Reconciliation</h1>
            <p class="text-sm text-slate-500 mt-1">จับคู่รายการสั่งซื้อกับข้อมูลในโกดัง (จากยอดรับของล่าสุด)</p>
        </div>
        <div class="bg-emerald-50 text-emerald-700 px-4 py-2 rounded-lg font-medium text-sm flex items-center gap-2 border border-emerald-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            รอตรวจรับ @Model.Items.Count รายการ
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center">
            <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
            </div>
            <h3 class="text-lg font-medium text-slate-900">ไม่มีรายการให้ตรวจรับ</h3>
            <p class="text-slate-500 mt-2">กลับไปที่หน้ารายการรายเดือนเพื่อเลือกรายการที่ต้องการบันทึก</p>
            <a href="/MonthlyCost" class="mt-6 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700">
                กลับหน้าแรก
            </a>
        </div>
    }
    else
    {
        <form id="reconcileForm" class="space-y-6">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                <!-- Hidden inputs for mapping back to the model -->
                <input type="hidden" name="Items[@i].OrderId" value="@item.OrderId" />
                <input type="hidden" name="Items[@i].OrderName" value="@item.OrderName" />
                <input type="hidden" name="Items[@i].ReceivedQuantity" value="@item.ReceivedQuantity" />

                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden transition-all hover:shadow-md">
                    <!-- Header (Chevron Toggle) -->
                    <div class="px-6 py-5 bg-slate-50 border-b border-slate-100 flex items-center justify-between cursor-pointer" onclick="toggleAccordion('item-@i')">
                        <div class="flex items-center gap-4">
                            <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 text-indigo-700 rounded-lg flex items-center justify-center font-bold">
                                @(i + 1)
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-slate-800">@item.OrderName</h3>
                                <p class="text-xs text-slate-500 mt-1">PO: @item.PoNumber <span class="mx-2">•</span> จำนวนที่รับ: <span class="font-semibold text-slate-700">@item.ReceivedQuantity</span> ชิ้น</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            @if (item.SuggestedMatches.Any(m => m.IsExactMapping))
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                    <svg class="-ml-0.5 mr-1.5 h-3 w-3 text-green-600" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                                    จำศัพท์แล้ว
                                </span>
                            }
                            else if (item.SuggestedMatches.Any())
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                                    <svg class="-ml-0.5 mr-1.5 h-3 w-3 text-blue-600" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                                    AI แนะนำ
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                                    <svg class="-ml-0.5 mr-1.5 h-3 w-3 text-yellow-600" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                                    ไม่พบของใกล้เคียง
                                </span>
                            }
                            <svg id="chevron-item-@i" class="w-5 h-5 text-slate-400 transform transition-transform duration-200 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>

                    <!-- Body (Options) -->
                    <div id="content-item-@i" class="p-6">
                        <p class="text-sm font-medium text-slate-700 mb-4">เลือกสินค้าในโกดังที่ตรงกับรายการนี้:</p>
                        <div class="space-y-3">
                            @{
                                bool hasPreSelected = false;
                            }
                            
                            @if (item.SuggestedMatches.Any())
                            {
                                foreach (var match in item.SuggestedMatches)
                                {
                                    bool isPreSelected = match.IsExactMapping || (!hasPreSelected && match.MatchPercentage > 80);
                                    if (isPreSelected) hasPreSelected = true;

                                    <label class="relative flex items-center p-4 cursor-pointer rounded-lg border @(isPreSelected ? "border-indigo-500 bg-indigo-50/30" : "border-slate-200 bg-white hover:bg-slate-50") transition-colors group">
                                        <div class="min-w-0 flex-1 flex items-center">
                                            <div class="flex items-center h-5">
                                                <input type="radio" name="Items[@i].SelectedStockProductCode" value="@match.StockItem.ProductCode" @(isPreSelected ? "checked" : "") class="h-4 w-4 text-indigo-600 border-slate-300 focus:ring-indigo-500">
                                            </div>
                                            <div class="ml-4 flex-1">
                                                <div class="flex justify-between">
                                                    <div>
                                                        <span class="block text-sm font-medium text-slate-900 group-hover:text-indigo-700">@match.StockItem.ProductName</span>
                                                        <span class="block text-xs text-slate-500 mt-0.5">รหัส: @match.StockItem.ProductCode | หมวดหมู่: @match.StockItem.Category</span>
                                                    </div>
                                                    <div class="text-right flex flex-col items-end justify-center">
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @(match.IsExactMapping ? "bg-green-100 text-green-800" : match.MatchPercentage >= 80 ? "bg-emerald-100 text-emerald-800" : "bg-orange-100 text-orange-800")">
                                                            @(match.IsExactMapping ? "Exact Match" : $"{match.MatchPercentage}% Match")
                                                        </span>
                                                        <span class="text-xs text-slate-500 mt-1">คงเหลือ: <strong class="@(match.StockItem.Quantity <= match.StockItem.MinStock ? "text-rose-600" : "text-slate-700")">@match.StockItem.Quantity</strong></span>
                                                    </div>
                                                </div>
                                                @if (!match.IsExactMapping)
                                                {
                                                    <div class="mt-3 w-full bg-slate-200 rounded-full h-1.5">
                                                        <div class="bg-indigo-500 h-1.5 rounded-full" style="width: @(match.MatchPercentage)%"></div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </label>
                                }
                            }

                            <!-- No Match Option -->
                            <label class="relative flex items-center p-4 cursor-pointer rounded-lg border @(!hasPreSelected ? "border-rose-500 bg-rose-50/30" : "border-slate-200 bg-white hover:bg-slate-50") transition-colors group">
                                <div class="min-w-0 flex-1 flex items-center">
                                    <div class="flex items-center h-5">
                                        <input type="radio" name="Items[@i].SelectedStockProductCode" value="" @(!hasPreSelected ? "checked" : "") class="h-4 w-4 text-rose-600 border-slate-300 focus:ring-rose-500">
                                    </div>
                                    <div class="ml-4">
                                        <span class="block text-sm font-medium text-slate-900 group-hover:text-rose-700">ไม่มีในโกดัง / ข้ามรายการนี้</span>
                                        <span class="block text-xs text-slate-500 mt-0.5">ระบบจะไม่เพิ่มยอดใดๆ ลงในสต๊อก และจะไม่จำคำศัพท์นี้</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            }

            <div class="sticky bottom-4 bg-white p-5 border border-slate-200 rounded-xl shadow-lg flex items-center justify-between z-10">
                <div>
                    <h4 class="text-sm font-bold text-slate-800">ตรวจสอบความถูกต้องเรียบร้อยแล้วใช่ไหม?</h4>
                    <p class="text-xs text-slate-500 mt-0.5">การบันทึกจะนำสินค้าไปบวกเพิ่มในโกดังอัตโนมัติ</p>
                </div>
                <div class="flex gap-3">
                    <a href="/MonthlyCost" class="px-5 py-2.5 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        ยกเลิก
                    </a>
                    <button type="button" onclick="submitReconcile()" class="px-5 py-2.5 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        ยืนยันและอัปเดตสต๊อก
                    </button>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleAccordion(id) {
            const content = document.getElementById('content-' + id);
            const chevron = document.getElementById('chevron-' + id);
            
            if (content.style.display === 'none') {
                content.style.display = 'block';
                chevron.classList.add('rotate-180');
            } else {
                content.style.display = 'none';
                chevron.classList.remove('rotate-180');
            }
        }

        // Add event listeners to radio buttons to update their container borders
        document.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', function() {
                // Find all labels in the same accordion group
                const groupName = this.name;
                document.querySelectorAll(`input[name="${groupName}"]`).forEach(sibling => {
                    const label = sibling.closest('label');
                    if (sibling.checked) {
                        if (sibling.value === '') { // No match
                            label.classList.replace('border-slate-200', 'border-rose-500');
                            label.classList.replace('bg-white', 'bg-rose-50/30');
                        } else {
                            label.classList.replace('border-slate-200', 'border-indigo-500');
                            label.classList.replace('bg-white', 'bg-indigo-50/30');
                        }
                        label.classList.remove('hover:bg-slate-50');
                    } else {
                        label.classList.remove('border-indigo-500', 'bg-indigo-50/30', 'border-rose-500', 'bg-rose-50/30');
                        label.classList.add('border-slate-200', 'bg-white', 'hover:bg-slate-50');
                    }
                });
            });
        });

        async function submitReconcile() {
            // Build the JSON payload manually because ASP.NET Core sometimes struggles with complex nested forms
            const form = document.getElementById('reconcileForm');
            const formData = new FormData(form);
            
            // Extract items
            const itemsMap = new Map();
            
            for (let [key, value] of formData.entries()) {
                // key looks like "Items[0].OrderId"
                const match = key.match(/Items\[(\d+)\]\.(.+)/);
                if (match) {
                    const idx = match[1];
                    const fieldName = match[2];
                    
                    if (!itemsMap.has(idx)) {
                        itemsMap.set(idx, {});
                    }
                    itemsMap.get(idx)[fieldName] = value;
                }
            }
            
            const payload = {
                Items: Array.from(itemsMap.values())
            };

            try {
                // Show loading
                Swal.fire({
                    title: 'กำลังอัปเดตสต๊อก...',
                    text: 'กรุณารอสักครู่ ระบบกำลังนำเข้าสินค้าและเรียนรู้คำศัพท์',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch('/Stock/ConfirmReconcile', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'อัปเดตสต๊อกสำเร็จ!',
                        text: 'รับสินค้าเข้าโกดังและบันทึกประวัติเรียบร้อยแล้ว',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    window.location.href = '/Stock/Index'; // Redirect to staff dashboard
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: data.error || 'ไม่สามารถบันทึกข้อมูลได้'
                    });
                }
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้'
                });
            }
        }
    </script>
}
