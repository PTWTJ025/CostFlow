@model List<CostFlow.Models.SparePartOrder>
@{
    ViewData["Title"] = "รายละเอียดแผ่นงานสั่งซื้อ";
    ViewData["HeaderTitle"] = "รายละเอียดแผ่นงานสั่งซื้อ";

    string batchName = ViewData["BatchName"] as string ?? "แผ่นงานไม่มีชื่อ";
    Guid batchId = (Guid)(ViewData["BatchId"] ?? Guid.Empty);
    DateTime createdAt = (DateTime)(ViewData["CreatedAt"] ?? DateTime.Now);
    int totalItems = (int)(ViewData["TotalItems"] ?? 0);
    decimal totalAmount = (decimal)(ViewData["TotalAmount"] ?? 0m);
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Back & Action Bar -->
    <div class="flex justify-between items-center bg-white rounded border border-outline-variant shadow-sm p-md">
        <a href="/ProductSearch/SavedOrders" class="inline-flex items-center gap-sm text-xs font-semibold text-slate-600 hover:text-primary transition-colors">
            <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            ย้อนกลับไปรายการทั้งหมด
        </a>

        <a href="/ProductSearch/ExportSavedBatch?batchId=@batchId" class="bg-primary hover:bg-primary/95 text-on-primary text-xs font-bold px-lg py-2 rounded transition-colors shadow-sm flex items-center gap-sm">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            ส่งออกไฟล์ Excel (.xlsx)
        </a>
    </div>

    <!-- Metadata Card -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-lg flex flex-col md:flex-row justify-between gap-md">
        <div class="flex gap-md items-start">
            <div class="w-12 h-12 bg-blue-50 text-primary rounded flex items-center justify-center flex-shrink-0 border border-blue-100">
                <i class="fi fi-rs-document text-xl leading-none"></i>
            </div>
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">@batchName</h3>
                <p class="text-xs text-secondary">
                    บันทึกเมื่อ: <span class="font-semibold text-slate-700">@createdAt.ToString("dd/MM/yyyy HH:mm") น.</span>
                </p>
            </div>
        </div>

        <div class="flex gap-lg items-center border-t md:border-t-0 pt-md md:pt-0 border-slate-100">
            <div class="text-right border-r border-slate-200 pr-lg">
                <span class="text-[10px] text-secondary block uppercase tracking-wider">จำนวนรวม</span>
                <span class="font-bold text-slate-800 text-sm">@totalItems รายการ</span>
            </div>
            <div class="text-right">
                <span class="text-[10px] text-secondary block uppercase tracking-wider">มูลค่ารวมประเมิน</span>
                <span class="font-bold text-primary text-lg font-mono">฿@totalAmount.ToString("N2")</span>
            </div>
        </div>
    </div>

    <!-- Sheet Grid View -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg">
        <div class="overflow-x-auto border border-slate-200 rounded max-h-[500px] overflow-y-auto">
            <table class="min-w-full divide-y divide-slate-200 text-center">
                <thead class="bg-slate-50 sticky top-0 z-10">
                    <tr class="divide-x divide-slate-200">
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[50px] bg-slate-100">ลำดับ</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[120px]">รหัสสินค้า</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-left">รายการอะไหล่</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[80px]">หน่วย</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[120px]">ราคาต่อหน่วย</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[80px]">จำนวน</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[140px] bg-slate-100">มูลค่ารวม</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[120px]">เลขที่อนุมัติ</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[180px] text-left">หมายเหตุ</th>
                        <th class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider w-[100px]">รับ วันที่</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200 text-xs text-slate-700 divide-x divide-slate-200">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var o = Model[i];
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-3 py-2 font-mono text-slate-400 bg-slate-50/30">@(i + 1)</td>
                            <td class="px-3 py-2 font-mono text-primary font-bold">@o.ProductCode</td>
                            <td class="px-3 py-2 text-left max-w-[250px] truncate" title="@o.ProductName">@o.ProductName</td>
                            <td class="px-3 py-2 text-slate-500">@o.Unit</td>
                            <td class="px-3 py-2 font-mono text-right">฿@o.UnitPrice.ToString("N2")</td>
                            <td class="px-3 py-2 font-mono font-bold">@o.Quantity.ToString("N0")</td>
                            <td class="px-3 py-2 font-mono font-bold text-slate-900 text-right bg-slate-50/30">฿@o.TotalAmount.ToString("N2")</td>
                            <td class="px-3 py-2 font-mono text-slate-500">@(string.IsNullOrWhiteSpace(o.ApprovalNo) ? "-" : o.ApprovalNo)</td>
                            <td class="px-3 py-2 text-left max-w-[200px] truncate text-slate-600" title="@o.Remarks">@(string.IsNullOrWhiteSpace(o.Remarks) ? "-" : o.Remarks)</td>
                            <td class="px-3 py-2 font-mono text-slate-500">@(o.ReceiveDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
