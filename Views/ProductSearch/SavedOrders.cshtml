@model List<CostFlow.Controllers.SavedBatchViewModel>
@{
    ViewData["Title"] = "ประวัติการบันทึกใบสั่งซื้อ";
    ViewData["HeaderTitle"] = "ประวัติการบันทึกใบสั่งซื้อ (Google Sheets)";
}

<div class="flex-1 py-md md:py-lg flex flex-col gap-md w-full h-full min-h-0 overflow-hidden bg-background" style="padding-left: clamp(1.5rem, 6vw, 6rem); padding-right: clamp(1.5rem, 6vw, 6rem);">

    <!-- Breadcrumbs & Header -->
    <div class="flex items-center justify-between shrink-0">
        <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                    <span>หน้าแรก</span>
                </a>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                <a href="/ProductSearch" class="hover:text-primary transition-colors">คีย์ใบสั่งซื้อ</a>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                <span class="font-semibold text-on-surface">ประวัติการบันทึก</span>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-md shrink-0">
        <div class="bg-surface border border-outline-variant rounded-lg p-md shadow-xs flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
            </div>
            <div class="flex flex-col">
                <span class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wider">จำนวนแผ่นงานบันทึก</span>
                <span class="text-xl font-black text-slate-800 leading-none mt-1">@(Model?.Count ?? 0) แผ่นงาน</span>
            </div>
        </div>
        <div class="bg-surface border border-outline-variant rounded-lg p-md shadow-xs flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
            <div class="flex flex-col">
                <span class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wider">จำนวนรายการทั้งหมด</span>
                <span class="text-xl font-black text-emerald-600 leading-none mt-1 font-mono">@(Model?.Sum(b => b.TotalItems) ?? 0) รายการ</span>
            </div>
        </div>
        <div class="bg-surface border border-outline-variant rounded-lg p-md shadow-xs flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="flex flex-col">
                <span class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wider">มูลค่ารวมสะสม</span>
                <span class="text-xl font-black text-blue-600 leading-none mt-1 font-mono">฿@(Model?.Sum(b => b.TotalAmount).ToString("N2") ?? "0.00")</span>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="flex-1 flex flex-col bg-surface border border-outline-variant rounded-lg overflow-hidden min-h-0">
        <!-- Toolbar -->
        <div class="bg-surface px-6 py-3.5 border-b border-outline-variant shrink-0 flex flex-wrap items-center justify-between gap-4">
            <form method="get" action="/ProductSearch/SavedOrders" class="flex flex-wrap items-center gap-3">
                <select name="year" onchange="this.form.submit()" class="px-3 py-2 border border-outline-variant rounded text-xs font-semibold text-slate-600 outline-none cursor-pointer bg-white">
                    <option value="">ปีทั้งหมด</option>
                    @if (ViewData["AvailableYears"] is List<int> years)
                    {
                        foreach (var y in years)
                        {
                            if ((int?)ViewData["SelectedYear"] == y)
                            {
                                <option value="@y" selected>ปี @(y + 543)</option>
                            }
                            else
                            {
                                <option value="@y">ปี @(y + 543)</option>
                            }
                        }
                    }
                </select>

                <select name="month" onchange="this.form.submit()" class="px-3 py-2 border border-outline-variant rounded text-xs font-semibold text-slate-600 outline-none cursor-pointer bg-white">
                    <option value="">เดือนทั้งหมด</option>
                    @{
                        string[] monthsTh = { "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };
                        for (int i = 1; i <= 12; i++)
                        {
                            if ((int?)ViewData["SelectedMonth"] == i)
                            {
                                <option value="@i" selected>@monthsTh[i - 1]</option>
                            }
                            else
                            {
                                <option value="@i">@monthsTh[i - 1]</option>
                            }
                        }
                    }
                </select>
            </form>

            <div class="relative w-72 sm:w-80">
                <input type="text" id="search-input" placeholder="ค้นหาชื่อแผ่นงาน..."
                       class="w-full pl-9 pr-9 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800 placeholder-slate-400 transition-all" />
            </div>
        </div>

        <div class="flex-1 overflow-auto relative min-h-0">
            <table class="w-full text-[14px]">
                <thead>
                    <tr class="text-[10px] font-semibold text-on-surface-variant uppercase tracking-wider">
                        <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-3 px-4 text-left">ชื่อแผ่นงาน (Batch Name)</th>
                        <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-3 px-4 text-left">เวลาที่บันทึก</th>
                        <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-3 px-4 text-right">จำนวนรายการ</th>
                        <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-3 px-4 text-right">ยอดรวม</th>
                        <th class="sticky top-0 bg-surface-container border-b border-outline-variant z-20 py-3 px-4 text-center w-48">การจัดการ</th>
                    </tr>
                </thead>
                <tbody id="batch-tbody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var batch in Model)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-high transition-colors batch-row"
                                data-name="@batch.BatchName">
                                <td class="py-3 px-4">
                                    <div class="font-bold text-on-surface">@batch.BatchName</div>
                                </td>
                                <td class="py-3 px-4 text-on-surface-variant font-mono text-xs">
                                    @(batch.CreatedAt == default ? "-" : batch.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                                </td>
                                <td class="py-3 px-4 text-right font-mono font-bold text-slate-700">
                                    @batch.TotalItems รายการ
                                </td>
                                <td class="py-3 px-4 text-right font-mono font-black text-primary">
                                    ฿@batch.TotalAmount.ToString("N2")
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="/ProductSearch?editBatchName=@Uri.EscapeDataString(batch.BatchName)" 
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-primary bg-primary/10 hover:bg-primary/20 transition-all cursor-pointer shadow-2xs"
                                           title="ดึงข้อมูลกลับไปแก้ไขหรือเขียนทับ">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                            </svg>
                                            <span>แก้ไข</span>
                                        </a>
                                        <button type="button" 
                                                class="btn-delete inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-all cursor-pointer shadow-2xs"
                                                data-name="@batch.BatchName"
                                                title="ลบแผ่นงานนี้ออกจาก Google Sheets">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                            <span>ลบ</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-xs text-on-surface-variant">
                                <div class="flex flex-col items-center gap-2">
                                    <svg class="w-10 h-10 text-outline opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                    <span class="font-bold text-on-surface text-sm">ไม่พบประวัติการบันทึกใบสั่งซื้อ</span>
                                    <span>เมื่อคุณบันทึกข้อมูลใบสั่งซื้อ รายการจะส่งไปยัง Google Sheets และแสดงที่นี่</span>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="no-search-results" class="hidden">
                        <td colspan="5" class="py-10 text-center text-xs text-on-surface-variant bg-surface-container-low/40">
                            <div class="flex flex-col items-center gap-1.5">
                                <svg class="w-8 h-8 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                                <span class="font-semibold text-on-surface">ไม่พบข้อมูลที่ค้นหา</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Search Filter
            const searchInput = document.getElementById('search-input');
            const rows = Array.from(document.querySelectorAll('.batch-row'));
            const noResults = document.getElementById('no-search-results');

            if (searchInput) {
                searchInput.addEventListener('input', () => {
                    const query = searchInput.value.trim().toLowerCase();
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const name = (row.dataset.name || '').toLowerCase();
                        const matches = name.includes(query);
                        row.style.display = matches ? '' : 'none';
                        if (matches) visibleCount++;
                    });

                    if (noResults) {
                        noResults.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
                    }
                });
            }

            // Delete Batch Action
            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const name = this.dataset.name;

                    const confirmRes = await Swal.fire({
                        title: 'ยืนยันการลบแผ่นงาน?',
                        text: `ต้องการลบแผ่นงาน "${name}" ออกจาก Google Sheets ใช่หรือไม่? (การดำเนินการนี้ไม่สามารถย้อนกลับได้)`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#e11d48',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'ยืนยัน, ลบแผ่นงาน',
                        cancelButtonText: 'ยกเลิก'
                    });

                    if (!confirmRes.isConfirmed) return;

                    // Show loading overlay
                    Swal.fire({
                        title: 'กำลังลบข้อมูล...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    try {
                        const response = await fetch('/ProductSearch/DeleteBatch', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: new URLSearchParams({ batchName: name })
                        });

                        const result = await response.json();

                        if (result.success) {
                            await Swal.fire({
                                icon: 'success',
                                  title: 'ลบแผ่นงานสำเร็จ',
                                  text: 'ลบแผ่นงานสั่งซื้อออกจาก Google Sheets เรียบร้อยแล้ว',
                                  confirmButtonColor: '#00288e'
                            });
                            location.reload();
                        } else {
                            throw new Error(result.error || 'ลบข้อมูลล้มเหลว');
                        }
                    } catch (error) {
                        console.error(error);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: error.message || 'ไม่สามารถลบแผ่นงานสั่งซื้อได้',
                            confirmButtonColor: '#00288e'
                        });
                    }
                });
            });
        });
    </script>
}
