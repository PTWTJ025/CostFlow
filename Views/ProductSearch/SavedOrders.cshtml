@model List<CostFlow.Controllers.SavedBatchViewModel>
@{
    ViewData["Title"] = "แผ่นงานสั่งซื้อที่บันทึก";
    ViewData["HeaderTitle"] = "แผ่นงานสั่งซื้อที่บันทึก";

    double grandTotal = Model?.Sum(b => b.TotalAmount) ?? 0;
    
    int? selectedYear = ViewData["SelectedYear"] as int?;
    int? selectedMonth = ViewData["SelectedMonth"] as int?;
    var availableYears = ViewData["AvailableYears"] as List<int> ?? new List<int> { DateTime.Now.Year };

    var monthsThai = new Dictionary<int, string>
    {
        { 1, "มกราคม" },
        { 2, "กุมภาพันธ์" },
        { 3, "มีนาคม" },
        { 4, "เมษายน" },
        { 5, "พฤษภาคม" },
        { 6, "มิถุนายน" },
        { 7, "กรกฎาคม" },
        { 8, "สิงหาคม" },
        { 9, "กันยายน" },
        { 10, "ตุลาคม" },
        { 11, "พฤศจิกายน" },
        { 12, "ธันวาคม" }
    };
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Saved Orders Card -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md mb-lg">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">ประวัติรายการที่บันทึก</h3>
                <p class="text-xs text-secondary">รายการสรุปแผ่นงานคีย์สั่งซื้ออะไหล่แบ่งตามช่วงเวลา</p>
            </div>
            
            <div class="flex flex-wrap gap-sm items-center w-full lg:w-auto justify-end">
                <div class="bg-slate-50 border border-slate-200/60 rounded px-3 py-1.5 text-xs font-semibold text-slate-700">
                    <span class="text-slate-400 block text-[10px]">ยอดรวมแผ่นงานทั้งหมด</span>
                    <span class="text-primary font-bold font-mono text-sm">฿@grandTotal.ToString("N2")</span>
                </div>
            </div>
        </div>

        <!-- Period Selection Filter Form -->
        <form method="get" class="flex flex-wrap gap-sm max-w-2xl mb-lg items-end bg-slate-50/50 p-md border border-slate-200/50 rounded" id="filter-form">
            <div class="flex-1 min-w-[140px]">
                <label class="block text-xs font-semibold text-slate-700 mb-1">เลือก ปี (ค.ศ.)</label>
                <select name="year" onchange="this.form.submit()" class="w-full px-3 py-1.5 border border-outline-variant rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none bg-white">
                    <option value="">-- ทั้งหมด --</option>
                    @foreach (var y in availableYears)
                    {
                        if (y == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            
            <div class="flex-1 min-w-[140px]">
                <label class="block text-xs font-semibold text-slate-700 mb-1">เลือก เดือน</label>
                <select name="month" onchange="this.form.submit()" class="w-full px-3 py-1.5 border border-outline-variant rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none bg-white">
                    <option value="">-- ทั้งหมด --</option>
                    @foreach (var m in monthsThai)
                    {
                        if (m.Key == selectedMonth)
                        {
                            <option value="@m.Key" selected>@m.Value</option>
                        }
                        else
                        {
                            <option value="@m.Key">@m.Value</option>
                        }
                    }
                </select>
            </div>

            @if (selectedYear.HasValue || selectedMonth.HasValue)
            {
                <a href="/ProductSearch/SavedOrders" class="px-md py-1.5 border border-slate-200 rounded text-xs font-semibold text-slate-600 bg-white hover:bg-slate-50 transition-colors flex items-center h-[32px] justify-center">
                    ล้างตัวกรอง
                </a>
            }
        </form>

        <!-- High-density Data Table -->
        <div class="overflow-x-auto border border-outline-variant rounded mb-lg max-h-[550px] overflow-y-auto">
            <table class="min-w-full divide-y divide-slate-200 text-center" id="saved-orders-table">
                <thead class="bg-slate-100 sticky top-0 z-10">
                    <tr>
                        <th class="px-3 py-2.5 text-xs font-bold text-slate-500 uppercase tracking-wider w-[50px]">#</th>
                        <th class="px-3 py-2.5 text-xs font-bold text-slate-500 uppercase tracking-wider w-[180px]">วันที่บันทึกข้อมูล</th>
                        <th class="px-3 py-2.5 text-xs font-bold text-slate-500 uppercase tracking-wider text-left">ชื่อแผ่นงาน / รายการคีย์</th>
                        <th class="px-3 py-2.5 text-xs font-bold text-slate-500 uppercase tracking-wider w-[120px]">จำนวนรายการ</th>
                        <th class="px-3 py-2.5 text-xs font-bold text-slate-500 uppercase tracking-wider w-[180px]">มูลค่ารวมทั้งสิ้น</th>
                        <th class="px-3 py-2.5 text-xs font-bold text-slate-500 uppercase tracking-wider w-[240px]">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200 text-xs text-slate-800" id="table-body">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-lg text-slate-400 text-xs italic bg-slate-50/50">ไม่พบประวัติการคีย์ข้อมูลในระบบสำหรับช่วงเวลาที่เลือก</td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            var b = Model[i];
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-3 py-3 text-slate-400 font-mono">@(i + 1)</td>
                                <td class="px-3 py-3 font-mono text-slate-500">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm") น.</td>
                                <td class="px-3 py-3 text-left font-semibold text-slate-700">@b.BatchName</td>
                                <td class="px-3 py-3 font-mono">@b.TotalItems.ToString("N0") รายการ</td>
                                <td class="px-3 py-3 font-mono font-bold text-slate-900">฿@b.TotalAmount.ToString("N2")</td>
                                <td class="px-3 py-3">
                                    <div class="flex items-center justify-center gap-2">
                                        <!-- View -->
                                        <a href="/ProductSearch/SavedBatchDetails?batchId=@b.BatchId" class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-slate-200 hover:border-primary text-[11px] font-semibold text-slate-600 hover:text-primary bg-white rounded shadow-sm transition-all" title="เปิดดูรายละเอียด">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                            </svg>
                                            <span>เปิดดู</span>
                                        </a>
                                        
                                        <!-- Edit -->
                                        <a href="/ProductSearch?editBatchId=@b.BatchId" class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-slate-200 hover:border-blue-600 text-[11px] font-semibold text-slate-600 hover:text-blue-600 bg-white rounded shadow-sm transition-all" title="แก้ไขรายการอะไหล่ในแผ่นงาน">
                                            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                            </svg>
                                            <span>แก้ไข</span>
                                        </a>
                                        
                                        <!-- Delete -->
                                        <button type="button" onclick="confirmDeleteBatch('@b.BatchId', '@b.BatchName')" class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-slate-200 hover:border-red-600 text-[11px] font-semibold text-slate-600 hover:text-red-600 bg-white rounded shadow-sm transition-all" title="ลบแผ่นงานนี้">
                                            <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                            </svg>
                                            <span>ลบ</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Custom Reusable Modal HTML -->
<div id="custom-modal-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] z-[100] hidden items-center justify-center p-md">
    <div class="bg-white rounded-lg border border-slate-200 shadow-2xl max-w-sm w-full overflow-hidden transform scale-95 opacity-0 transition-all duration-200" id="custom-modal-card">
        <div class="p-lg">
            <h3 class="text-sm font-bold text-slate-800" id="modal-title">หัวข้อ</h3>
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed" id="modal-desc">รายละเอียดข้อความ...</p>
        </div>
        
        <div class="px-lg pb-md hidden" id="modal-input-container">
            <input type="text" id="modal-input-field" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none" />
        </div>

        <div class="px-lg py-md bg-slate-50 border-t border-slate-100 flex justify-end gap-sm">
            <button type="button" id="modal-cancel-btn" class="px-md py-2 border border-slate-200 rounded text-xs font-semibold text-slate-600 bg-white hover:bg-slate-50 transition-colors">
                ยกเลิก
            </button>
            <button type="button" id="modal-confirm-btn" class="text-xs font-bold px-5 py-2 rounded transition-colors shadow-sm">
                ตกลง
            </button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-5 right-5 z-[200] flex flex-col gap-2 pointer-events-none"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    // Toast helper
    function showToast(message, type = 'success') {
        const container = document.getElementById("toast-container");
        const toast = document.createElement("div");
        toast.className = `px-4 py-3 rounded shadow-lg text-xs font-semibold flex items-center gap-2 transform translate-y-2 opacity-0 transition-all duration-300 pointer-events-auto max-w-sm ${
            type === 'success' 
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
                : 'bg-rose-50 text-rose-800 border border-rose-200'
        }`;
        
        const icon = type === 'success'
            ? `<svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            : `<svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;

        toast.innerHTML = `${icon}<span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(() => {
            toast.classList.remove("translate-y-2", "opacity-0");
        }, 10);

        setTimeout(() => {
            toast.classList.add("opacity-0", "translate-y-2");
            setTimeout(() => {
                toast.remove();
            }, 300);
        }, 3000);
    }

    // Modal elements
    const modalOverlay = document.getElementById("custom-modal-overlay");
    const modalCard = document.getElementById("custom-modal-card");
    const modalTitle = document.getElementById("modal-title");
    const modalDesc = document.getElementById("modal-desc");
    const modalInputContainer = document.getElementById("modal-input-container");
    const modalInputField = document.getElementById("modal-input-field");
    const modalCancelBtn = document.getElementById("modal-cancel-btn");
    const modalConfirmBtn = document.getElementById("modal-confirm-btn");

    let modalResolve = null;

    window.setCustomModalLoading = function(isLoading) {
        if (isLoading) {
            modalCancelBtn.disabled = true;
            modalConfirmBtn.disabled = true;
            modalCancelBtn.classList.add("opacity-50", "pointer-events-none");
            modalConfirmBtn.classList.add("opacity-80", "pointer-events-none");
            modalConfirmBtn.innerHTML = `
                <span class="flex items-center justify-center gap-1.5">
                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    กำลังดำเนินการ...
                </span>
            `;
        } else {
            modalCancelBtn.disabled = false;
            modalConfirmBtn.disabled = false;
            modalCancelBtn.classList.remove("opacity-50", "pointer-events-none");
            modalConfirmBtn.classList.remove("opacity-80", "pointer-events-none");
            modalConfirmBtn.textContent = "ตกลง";
        }
    };

    window.showCustomModal = function({ title, desc, showInput = false, defaultValue = "", confirmText = "ตกลง", confirmClass = "bg-primary text-white", onConfirm = null }) {
        setCustomModalLoading(false);
        return new Promise((resolve) => {
            modalResolve = resolve;
            
            modalTitle.textContent = title;
            modalDesc.textContent = desc;
            
            if (showInput) {
                modalInputContainer.classList.remove("hidden");
                modalInputField.value = defaultValue;
            } else {
                modalInputContainer.classList.add("hidden");
            }

            modalConfirmBtn.textContent = confirmText;
            modalConfirmBtn.className = `text-xs font-bold px-5 py-2 rounded transition-colors shadow-sm ${confirmClass}`;

            modalConfirmBtn.onclick = () => {
                const hasInput = !modalInputContainer.classList.contains("hidden");
                const val = hasInput ? modalInputField.value : true;
                if (onConfirm) {
                    onConfirm(val);
                } else {
                    hideModal(val);
                }
            };

            modalCancelBtn.onclick = () => {
                hideModal(null);
            };

            modalOverlay.classList.remove("hidden");
            modalOverlay.classList.add("flex");
            setTimeout(() => {
                modalCard.classList.remove("scale-95", "opacity-0");
                modalCard.classList.add("scale-100", "opacity-100");
            }, 50);
        });
    };

    window.hideModal = function(value) {
        modalCard.classList.remove("scale-100", "opacity-100");
        modalCard.classList.add("scale-95", "opacity-0");
        setTimeout(() => {
            modalOverlay.classList.remove("flex");
            modalOverlay.classList.add("hidden");
            if (modalResolve) {
                modalResolve(value);
                modalResolve = null;
            }
        }, 150);
    };

    // Confirm Delete Action
    window.confirmDeleteBatch = function(batchId, batchName) {
        showCustomModal({
            title: "ยืนยันการลบแผ่นงาน",
            desc: `ต้องการลบแผ่นงาน "${batchName}" และรายการสั่งซื้อทั้งหมดอย่างถาวรใช่หรือไม่? (ไม่สามารถกู้คืนได้)`,
            confirmText: "ลบแผ่นงาน",
            confirmClass: "bg-red-600 hover:bg-red-700 text-white",
            onConfirm: function() {
                setCustomModalLoading(true);

                fetch(`/ProductSearch/DeleteBatch?batchId=${batchId}`, {
                    method: "POST"
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast("ลบแผ่นงานสั่งซื้ออะไหล่สำเร็จเรียบร้อยแล้ว!", "success");
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showToast("เกิดข้อผิดพลาด: " + data.error, "error");
                        setCustomModalLoading(false);
                    }
                })
                .catch(err => {
                    showToast("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์", "error");
                    setCustomModalLoading(false);
                });
            }
        });
    };

    // Close on ESC
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modalOverlay.classList.contains("hidden") && !modalConfirmBtn.disabled) {
            hideModal(null);
        }
    });
});
</script>
