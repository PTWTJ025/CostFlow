@using System.Security.Claims
@model List<CostFlow.Controllers.SavedOrderItemViewModel>
@{
    ViewData["Title"] = "ประวัติรายการสินค้าที่บันทึก";
    ViewData["HeaderTitle"] = "ประวัติรายการสินค้าที่บันทึก (Google Sheets)";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="flex-1 py-md md:py-lg flex flex-col gap-md w-full h-full min-h-0 overflow-hidden bg-background" style="padding-left: clamp(1.5rem, 6vw, 6rem); padding-right: clamp(1.5rem, 6vw, 6rem);">

    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-on-surface-variant shrink-0">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5">
            <!-- Heroicon: home -->
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
            </svg>
            <span>หน้าแรก</span>
        </a>
        <svg class="w-3 h-3 text-outline opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
        <a href="/ProductSearch" class="hover:text-primary transition-colors">คีย์ใบสั่งซื้อ</a>
        <svg class="w-3 h-3 text-outline opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="font-semibold text-on-surface">ประวัติรายการสินค้า</span>
    </div>

    <!-- Page Title -->
    <div class="shrink-0 flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-on-surface leading-tight">ประวัติรายการสินค้าที่บันทึก</h1>
            <p class="text-sm text-on-surface-variant mt-0.5">รายการสินค้าทั้งหมดจากใบสั่งซื้อที่บันทึกลง Google Sheets (เรียงตามวันที่คีย์ข้อมูล)</p>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 shrink-0">

        <!-- Card 1: สินค้าทั้งหมด -->
        <div class="bg-surface border border-outline-variant rounded-lg px-4 py-3 flex items-center gap-3">
            <div class="w-8 h-8 rounded flex items-center justify-center shrink-0" style="background:rgba(0,40,142,0.08);">
                <!-- Heroicon: cube -->
                <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
                </svg>
            </div>
            <div class="ml-auto text-right">
                <p class="text-[11px] font-medium text-on-surface-variant leading-none mb-1">รายการสินค้าทั้งหมด</p>
                <p class="text-[20px] font-bold text-primary leading-none">
                    <span id="stat-total-count">@(Model?.Count ?? 0)</span> <span class="text-[13px] font-medium text-on-surface-variant">รายการ</span>
                </p>
            </div>
        </div>

        <!-- Card 2: จำนวนชิ้นรวม -->
        <div class="bg-surface border border-outline-variant rounded-lg px-4 py-3 flex items-center gap-3">
            <div class="w-8 h-8 rounded flex items-center justify-center shrink-0" style="background:rgba(5,150,105,0.08);">
                <!-- Heroicon: clipboard-document-check -->
                <svg class="w-4 h-4" style="color:#059669" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25 2.25 0 0 1 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C7.302 4.004 6 5.273 6 6.75v10.5A2.25 2.25 0 0 0 8.25 19.5h7.5A2.25 2.25 0 0 0 18 17.25V6.75c0-1.477-1.302-2.746-2.726-2.834a49.61 49.61 0 0 0-1.124-.08M9 11.25l2.25 2.25L15 9.75"/>
                </svg>
            </div>
            <div class="ml-auto text-right">
                <p class="text-[11px] font-medium text-on-surface-variant leading-none mb-1">จำนวนรวมสะสม</p>
                <p class="text-[20px] font-bold leading-none" style="color:#059669;">
                    <span id="stat-total-qty">@(Model?.Sum(i => i.Quantity).ToString("N0") ?? "0")</span> <span class="text-[13px] font-medium text-on-surface-variant">หน่วย</span>
                </p>
            </div>
        </div>

        <!-- Card 3: มูลค่ารวมสะสม -->
        <div class="bg-surface border border-outline-variant rounded-lg px-4 py-3 flex items-center gap-3">
            <div class="w-8 h-8 rounded flex items-center justify-center shrink-0" style="background:rgba(37,99,235,0.08);">
                <!-- Heroicon: banknotes -->
                <svg class="w-4 h-4" style="color:#2563eb" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/>
                </svg>
            </div>
            <div class="ml-auto text-right">
                <p class="text-[11px] font-medium text-on-surface-variant leading-none mb-1">มูลค่ารวมสะสม</p>
                <p class="text-[20px] font-bold leading-none" style="color:#2563eb;" id="stat-total-amount">฿@(Model?.Sum(i => i.TotalAmount).ToString("N2") ?? "0.00")</p>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="flex-1 flex flex-col bg-surface border border-outline-variant rounded-lg overflow-hidden min-h-0">
        <!-- Toolbar & Filters -->
        <div class="bg-surface px-5 py-3 border-b border-outline-variant shrink-0 flex flex-wrap items-center justify-between gap-3">
            <form method="get" action="/ProductSearch/SavedOrders" class="flex flex-wrap items-center gap-2" id="filter-form" onsubmit="event.preventDefault(); handleFilterChange(this);">
                <!-- Year select -->
                <div class="relative">
                    <select name="year" onchange="handleFilterChange(this)"
                            class="appearance-none pl-3 pr-8 py-2 border border-outline-variant rounded text-[13px] font-medium text-on-surface-variant outline-none cursor-pointer bg-white hover:border-outline focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all">
                        <option value="">ปีทั้งหมด</option>
                        @if (ViewData["AvailableYears"] is List<int> years)
                        {
                            foreach (var y in years)
                            {
                                if ((int?)ViewData["SelectedYear"] == y)
                                {
                                    <option value="@y" selected>ปี @(y + 543)</option>
                                }
                                else
                                {
                                    <option value="@y">ปี @(y + 543)</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Month select -->
                <div class="relative">
                    <select name="month" onchange="handleFilterChange(this)"
                            class="appearance-none pl-3 pr-8 py-2 border border-outline-variant rounded text-[13px] font-medium text-on-surface-variant outline-none cursor-pointer bg-white hover:border-outline focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all">
                        <option value="">เดือนทั้งหมด</option>
                        @{
                            string[] monthsTh = { "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };
                            for (int i = 1; i <= 12; i++)
                            {
                                if ((int?)ViewData["SelectedMonth"] == i)
                                {
                                    <option value="@i" selected>@monthsTh[i - 1]</option>
                                }
                                else
                                {
                                    <option value="@i">@monthsTh[i - 1]</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Batch select -->
                <div class="relative">
                    <select name="batchName" onchange="handleFilterChange(this)"
                            class="appearance-none pl-3 pr-8 py-2 border border-outline-variant rounded text-[13px] font-medium text-on-surface-variant outline-none cursor-pointer bg-white hover:border-outline focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all max-w-[200px] truncate">
                        <option value="">แผ่นงานทั้งหมด</option>
                        @if (ViewData["AvailableBatches"] is List<string> batches)
                        {
                            foreach (var b in batches)
                            {
                                if ((string?)ViewData["SelectedBatch"] == b)
                                {
                                    <option value="@b" selected title="@b">@b</option>
                                }
                                else
                                {
                                    <option value="@b" title="@b">@b</option>
                                }
                            }
                        }
                    </select>
                </div>
            </form>

            <!-- Search Box (Icon removed & clean padding) -->
            <div class="relative w-64 sm:w-80">
                <input type="text" id="search-input" placeholder="ค้นหาชื่อสินค้า..."
                       class="w-full px-3 py-2 text-[13px] bg-white border border-outline-variant rounded focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 text-on-surface placeholder-outline transition-all"/>
            </div>
        </div>

        <!-- Table -->
        <div class="flex-1 overflow-auto relative min-h-0">
            <table class="w-full text-[13px]">
                <thead>
                <tr class="text-[11px] font-semibold text-on-surface-variant border-b border-outline-variant">
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-left">วันที่คีย์</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-left">ชื่อแผ่นงาน</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-left">รหัสสินค้า</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-left">ชื่อสินค้า</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-right">จำนวน</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-right">ราคา/หน่วย</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-right">ราคารวม</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-left">หมายเหตุ</th>
                    <th class="sticky top-0 bg-surface-container z-20 py-2.5 px-4 text-center w-28">การจัดการ</th>
                </tr>
                </thead>
                <tbody id="item-tbody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string searchText = $"{item.ProductCode} {item.ProductName} {item.BatchName} {item.Remarks}".ToLower();
                        <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors item-row"
                            data-search="@searchText"
                            data-name="@item.ProductName.ToLower()">
                            <td class="py-3 px-4 text-on-surface-variant font-mono text-xs whitespace-nowrap">
                                @(item.CreatedAt == default ? "-" : item.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                            <td class="py-3 px-4 font-medium text-primary hover:underline max-w-[180px] truncate" title="@item.BatchName">
                                <a href="/OrderTracking/Detail?batchName=@Uri.EscapeDataString(item.BatchName)">@item.BatchName</a>
                            </td>
                            <td class="py-3 px-4 font-mono font-semibold text-on-surface whitespace-nowrap">
                                @item.ProductCode
                            </td>
                            <td class="py-3 px-4 font-medium text-on-surface max-w-[220px] truncate" title="@item.ProductName">
                                @item.ProductName
                            </td>
                            <td class="py-3 px-4 text-right font-semibold text-on-surface">
                                @item.Quantity.ToString("N2") <span class="text-xs font-normal text-on-surface-variant">@item.Unit</span>
                            </td>
                            <td class="py-3 px-4 text-right font-mono text-on-surface-variant">
                                ฿@item.UnitPrice.ToString("N2")
                            </td>
                            <td class="py-3 px-4 text-right font-mono font-bold text-primary text-[14px]">
                                ฿@item.TotalAmount.ToString("N2")
                            </td>
                            <td class="py-3 px-4 text-on-surface-variant text-xs max-w-[150px] truncate" title="@item.Remarks">
                                @(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)
                            </td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <!-- Edit Quantity Button (Heroicon: pencil-square) -->
                                    <button type="button"
                                            class="btn-edit-qty p-1.5 rounded-lg text-amber-700 hover:bg-amber-50 border border-amber-200/60 hover:border-amber-300 transition-all flex items-center gap-1 text-[12px] font-semibold"
                                            data-batch="@item.BatchName"
                                            data-code="@item.ProductCode"
                                            data-name="@item.ProductName"
                                            data-qty="@item.Quantity"
                                            data-unit="@item.Unit"
                                            title="แก้ไขเฉพาะจำนวนสินค้า">
                                        <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
                                        </svg>
                                        <span class="hidden sm:inline">แก้ไข</span>
                                    </button>

                                    <!-- Delete Item Button (Heroicon: trash) -->
                                    <button type="button"
                                            class="btn-delete-item p-1.5 rounded-lg text-rose-700 hover:bg-rose-50 border border-rose-200/60 hover:border-rose-300 transition-all flex items-center gap-1 text-[12px] font-semibold"
                                            data-batch="@item.BatchName"
                                            data-code="@item.ProductCode"
                                            data-name="@item.ProductName"
                                            title="ลบรายการสินค้า">
                                        <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                        </svg>
                                        <span class="hidden sm:inline">ลบ</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="py-14 text-center">
                            <div class="flex flex-col items-center gap-3">
                                <!-- Heroicon: inbox -->
                                <svg class="w-10 h-10 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"/>
                                </svg>
                                <div>
                                    <p class="font-semibold text-on-surface text-sm">ยังไม่มีรายการสินค้าในประวัติ</p>
                                    <p class="text-xs text-on-surface-variant mt-1">เมื่อบันทึกใบสั่งซื้อ รายการสินค้าจะแสดงที่นี่</p>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                <tr id="no-search-results" class="hidden">
                    <td colspan="9" class="py-10 text-center text-xs text-on-surface-variant">
                        <div class="flex flex-col items-center gap-2">
                            <!-- Heroicon: magnifying-glass -->
                            <svg class="w-8 h-8 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                            </svg>
                            <span class="font-semibold text-on-surface text-sm">ไม่พบรายการสินค้าที่ตรงกับคำค้นหา</span>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Render Skeleton Loading Rows in Table
        function renderSkeletonRows() {
            const tbody = document.getElementById('item-tbody');
            let html = '';
            for (let i = 0; i < 5; i++) {
                html += `
                <tr class="animate-pulse border-b border-outline-variant">
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-24"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-32"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-20"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-40"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-16 ml-auto"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-16 ml-auto"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-20 ml-auto"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-16"></div></td>
                    <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-200 rounded w-16 mx-auto"></div></td>
                </tr>`;
            }
            tbody.innerHTML = html;
        }

        // Seamless AJAX Filter Handler with Skeleton Loading
        window.handleFilterChange = async function (selectElem) {
            const form = document.getElementById('filter-form');
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);

            // Update browser URL seamlessly without page reload
            const newUrl = `${window.location.pathname}?${params.toString()}`;
            window.history.pushState(null, '', newUrl);

            // Immediately show Skeleton loading animation inside table
            renderSkeletonRows();

            try {
                const response = await fetch(`/ProductSearch/GetSavedOrdersJson?${params.toString()}`);
                const data = await response.json();

                // Update Stats Cards
                const statCount = document.getElementById('stat-total-count');
                const statQty = document.getElementById('stat-total-qty');
                const statAmount = document.getElementById('stat-total-amount');

                if (statCount) statCount.textContent = (data.totalCount || 0).toLocaleString();
                if (statQty) statQty.textContent = (data.totalQuantity || 0).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
                if (statAmount) statAmount.textContent = '฿' + (data.totalAmount || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                const tbody = document.getElementById('item-tbody');
                if (!data.items || data.items.length === 0) {
                    tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="py-14 text-center">
                            <div class="flex flex-col items-center gap-3">
                                <svg class="w-10 h-10 text-outline opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1-.661Z"/>
                                </svg>
                                <div>
                                    <p class="font-semibold text-on-surface text-sm">ยังไม่มีรายการสินค้าในประวัติ</p>
                                    <p class="text-xs text-on-surface-variant mt-1">เมื่อบันทึกใบสั่งซื้อ รายการสินค้าจะแสดงที่นี่</p>
                                </div>
                            </div>
                        </td>
                    </tr>`;
                    return;
                }

                let html = '';
                data.items.forEach(item => {
                    const searchText = `${item.productCode} ${item.productName} ${item.batchName} ${item.remarks}`.toLowerCase();
                    const pNameLower = (item.productName || '').toLowerCase();
                    html += `
                    <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors item-row"
                        data-search="${searchText}"
                        data-name="${pNameLower}">
                        <td class="py-3 px-4 text-on-surface-variant font-mono text-xs whitespace-nowrap">${item.createdAtStr}</td>
                        <td class="py-3 px-4 font-medium text-primary hover:underline max-w-[180px] truncate" title="${item.batchName}">
                            <a href="/OrderTracking/Detail?batchName=${encodeURIComponent(item.batchName)}">${item.batchName}</a>
                        </td>
                        <td class="py-3 px-4 font-mono font-semibold text-on-surface whitespace-nowrap">${item.productCode}</td>
                        <td class="py-3 px-4 font-medium text-on-surface max-w-[220px] truncate" title="${item.productName}">${item.productName}</td>
                        <td class="py-3 px-4 text-right font-semibold text-on-surface">
                            ${item.quantity.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-xs font-normal text-on-surface-variant">${item.unit}</span>
                        </td>
                        <td class="py-3 px-4 text-right font-mono text-on-surface-variant">฿${item.unitPrice.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                        <td class="py-3 px-4 text-right font-mono font-bold text-primary text-[14px]">฿${item.totalAmount.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                        <td class="py-3 px-4 text-on-surface-variant text-xs max-w-[150px] truncate" title="${item.remarks}">${item.remarks}</td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button type="button"
                                        class="btn-edit-qty p-1.5 rounded-lg text-amber-700 hover:bg-amber-50 border border-amber-200/60 hover:border-amber-300 transition-all flex items-center gap-1 text-[12px] font-semibold"
                                        data-batch="${item.batchName}"
                                        data-code="${item.productCode}"
                                        data-name="${item.productName}"
                                        data-qty="${item.quantity}"
                                        data-unit="${item.unit}"
                                        title="แก้ไขเฉพาะจำนวนสินค้า">
                                    <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
                                    </svg>
                                    <span class="hidden sm:inline">แก้ไข</span>
                                </button>

                                <button type="button"
                                        class="btn-delete-item p-1.5 rounded-lg text-rose-700 hover:bg-rose-50 border border-rose-200/60 hover:border-rose-300 transition-all flex items-center gap-1 text-[12px] font-semibold"
                                        data-batch="${item.batchName}"
                                        data-code="${item.productCode}"
                                        data-name="${item.productName}"
                                        title="ลบรายการสินค้า">
                                    <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                    </svg>
                                    <span class="hidden sm:inline">ลบ</span>
                                </button>
                            </div>
                        </td>
                    </tr>`;
                });
                tbody.innerHTML = html;

                // Rebind event listeners on new buttons
                bindActionEvents();

                // Re-apply real-time search filter if text exists
                const searchInput = document.getElementById('search-input');
                if (searchInput && searchInput.value.trim() !== '') {
                    searchInput.dispatchEvent(new Event('input'));
                }

            } catch (err) {
                console.error('Failed to fetch filtered data:', err);
            }
        };

        // Real-time Search Filter (Product Name)
        function initSearchFilter() {
            const searchInput = document.getElementById('search-input');
            if (!searchInput) return;

            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                const rows = Array.from(document.querySelectorAll('.item-row'));
                const noResults = document.getElementById('no-search-results');
                let visibleCount = 0;

                rows.forEach(row => {
                    const productName = (row.dataset.name || row.dataset.search || '').toLowerCase();
                    const matches = productName.includes(query);
                    row.style.display = matches ? '' : 'none';
                    if (matches) visibleCount++;
                });

                if (noResults) {
                    noResults.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
                }
            });
        }

        // Bind Edit & Delete Event Listeners
        function bindActionEvents() {
            // Edit Quantity Button Action
            document.querySelectorAll('.btn-edit-qty').forEach(btn => {
                btn.removeEventListener('click', handleEditQty);
                btn.addEventListener('click', handleEditQty);
            });

            // Delete Item Button Action
            document.querySelectorAll('.btn-delete-item').forEach(btn => {
                btn.removeEventListener('click', handleDeleteItem);
                btn.addEventListener('click', handleDeleteItem);
            });
        }

        async function handleEditQty() {
            const batchName = this.dataset.batch;
            const productCode = this.dataset.code;
            const productName = this.dataset.name;
            const currentQty = this.dataset.qty;
            const unit = this.dataset.unit || 'หน่วย';

            const { value: newQty } = await Swal.fire({
                title: 'แก้ไขจำนวนสินค้า',
                html: `
                    <div style="text-align:left; font-size:13px; color:#444653; margin-top:8px;">
                        <p style="margin-bottom:4px;"><strong>สินค้า:</strong> ${productName}</p>
                        <p style="margin-bottom:12px;"><strong>รหัส:</strong> ${productCode} | <strong>แผ่นงาน:</strong> ${batchName}</p>
                        <label style="display:block; font-weight:600; margin-bottom:6px; color:#1a1b22;">ระบุจำนวนใหม่ (${unit}):</label>
                        <input id="swal-input-qty" type="number" step="any" min="0.01" value="${currentQty}" 
                               style="width:100%; padding:8px 12px; border:1px solid #c4c5d5; border-radius:6px; font-size:14px; outline:none; font-family:inherit;">
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'บันทึกการแก้ไข',
                cancelButtonText: 'ยกเลิก',
                focusConfirm: false,
                customClass: {
                    popup: 'swal-popup-custom',
                    confirmButton: 'swal-btn-primary',
                    cancelButton: 'swal-btn-cancel',
                    actions: 'swal-actions-custom'
                },
                buttonsStyling: false,
                preConfirm: () => {
                    const val = document.getElementById('swal-input-qty').value;
                    const num = parseFloat(val);
                    if (isNaN(num) || num <= 0) {
                        Swal.showValidationMessage('กรุณาระบุจำนวนที่มากกว่า 0');
                        return false;
                    }
                    return num;
                }
            });

            if (!newQty) return;

            Swal.fire({
                html: `<div style="padding:12px 0;display:flex;flex-direction:column;align-items:center;gap:12px;">
                            <div class="swal2-loading-ring"></div>
                            <p style="font-size:14px;color:#444653;margin:0;">กำลังอัปเดตจำนวนสินค้า...</p>
                       </div>`,
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('/ProductSearch/UpdateItemQuantity', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        batchName: batchName,
                        productCode: productCode,
                        newQuantity: newQty
                    })
                });
                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        html: `<div style="display:flex;flex-direction:column;align-items:center;gap:14px;padding:8px 0 4px;">
                                    <div style="width:52px;height:52px;border-radius:50%;background:#f0fdf4;border:1.5px solid #bbf7d0;display:flex;align-items:center;justify-content:center;">
                                        <svg style="width:24px;height:24px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#16a34a">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                        </svg>
                                    </div>
                                    <div>
                                        <p style="font-size:16px;font-weight:700;color:#1a1b22;margin:0 0 4px;">แก้ไขจำนวนสำเร็จ</p>
                                        <p style="font-size:13px;color:#444653;margin:0;">บันทึกจำนวนใหม่ลง Google Sheets เรียบร้อยแล้ว</p>
                                    </div>
                               </div>`,
                        customClass: {
                            popup: 'swal-popup-custom',
                            confirmButton: 'swal-btn-primary',
                            actions: 'swal-actions-custom'
                        },
                        confirmButtonText: 'ตกลง',
                        buttonsStyling: false
                    });
                    // Refresh data asynchronously with skeleton loading
                    handleFilterChange(document.querySelector('#filter-form select'));
                } else {
                    throw new Error(result.error || 'แก้ไขจำนวนล้มเหลว');
                }
            } catch (error) {
                Swal.fire({
                    html: `<div style="display:flex;flex-direction:column;align-items:center;gap:14px;padding:8px 0 4px;">
                                <div style="width:52px;height:52px;border-radius:50%;background:#fff1f2;border:1.5px solid #fecdd3;display:flex;align-items:center;justify-content:center;">
                                    <svg style="width:24px;height:24px;" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="#e11d48">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008Zm9.75-3.75a9.75 9.75 0 1 1-19.5 0 9.75 9.75 0 0 1 19.5 0Z" />
                                    </svg>
                                </div>
                                <div>
                                    <p style="font-size:16px;font-weight:700;color:#1a1b22;margin:0 0 4px;">เกิดข้อผิดพลาด</p>
                                    <p style="font-size:13px;color:#444653;margin:0;">${error.message || 'ไม่สามารถอัปเดตข้อมูลได้'}</p>
                                </div>
                           </div>`,
                    customClass: {
                        popup: 'swal-popup-custom',
                        confirmButton: 'swal-btn-primary',
                        actions: 'swal-actions-custom'
                    },
                    confirmButtonText: 'ตกลง',
                    buttonsStyling: false
                });
            }
        }

        async function handleDeleteItem() {
            const batchName = this.dataset.batch;
            const productCode = this.dataset.code;
            const productName = this.dataset.name;

            const confirmRes = await Swal.fire({
                html: `
                    <div style="display:flex;flex-direction:column;align-items:center;gap:16px;padding:8px 0 4px;">
                        <div style="width:52px;height:52px;border-radius:50%;background:#fff1f2;border:1.5px solid #fecdd3;display:flex;align-items:center;justify-content:center;">
                            <svg style="width:24px;height:24px;color:#e11d48" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="#e11d48">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                            </svg>
                        </div>
                        <div>
                            <p style="font-size:16px;font-weight:700;color:#1a1b22;margin:0 0 6px;">ยืนยันการลบรายการสินค้า?</p>
                            <p style="font-size:13px;color:#444653;margin:0;line-height:1.5;">ลบ <strong style="color:#1a1b22;">"${productName}"</strong> (${productCode})<br>จากแผ่นงาน "${batchName}"</p>
                        </div>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน, ลบรายการ',
                cancelButtonText: 'ยกเลิก',
                customClass: {
                    popup: 'swal-popup-custom',
                    confirmButton: 'swal-btn-confirm',
                    cancelButton: 'swal-btn-cancel',
                    actions: 'swal-actions-custom'
                },
                buttonsStyling: false,
                focusConfirm: false
            });

            if (!confirmRes.isConfirmed) return;

            Swal.fire({
                html: `<div style="padding:12px 0;display:flex;flex-direction:column;align-items:center;gap:12px;">
                            <div class="swal2-loading-ring"></div>
                            <p style="font-size:14px;color:#444653;margin:0;">กำลังลบรายการสินค้า...</p>
                       </div>`,
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('/ProductSearch/DeleteSavedOrderItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        batchName: batchName,
                        productCode: productCode
                    })
                });
                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        html: `<div style="display:flex;flex-direction:column;align-items:center;gap:14px;padding:8px 0 4px;">
                                    <div style="width:52px;height:52px;border-radius:50%;background:#f0fdf4;border:1.5px solid #bbf7d0;display:flex;align-items:center;justify-content:center;">
                                        <svg style="width:24px;height:24px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#16a34a">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                        </svg>
                                    </div>
                                    <div>
                                        <p style="font-size:16px;font-weight:700;color:#1a1b22;margin:0 0 4px;">ลบรายการสินค้าสำเร็จ</p>
                                        <p style="font-size:13px;color:#444653;margin:0;">ลบออกจาก Google Sheets เรียบร้อยแล้ว</p>
                                    </div>
                               </div>`,
                        customClass: {
                            popup: 'swal-popup-custom',
                            confirmButton: 'swal-btn-primary',
                            actions: 'swal-actions-custom'
                        },
                        confirmButtonText: 'ตกลง',
                        buttonsStyling: false
                    });
                    // Refresh data asynchronously with skeleton loading
                    handleFilterChange(document.querySelector('#filter-form select'));
                } else {
                    throw new Error(result.error || 'ลบรายการสินค้าล้มเหลว');
                }
            } catch (error) {
                Swal.fire({
                    html: `<div style="display:flex;flex-direction:column;align-items:center;gap:14px;padding:8px 0 4px;">
                                <div style="width:52px;height:52px;border-radius:50%;background:#fff1f2;border:1.5px solid #fecdd3;display:flex;align-items:center;justify-content:center;">
                                    <svg style="width:24px;height:24px;" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="#e11d48">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008Zm9.75-3.75a9.75 9.75 0 1 1-19.5 0 9.75 9.75 0 0 1 19.5 0Z" />
                                    </svg>
                                </div>
                                <div>
                                    <p style="font-size:16px;font-weight:700;color:#1a1b22;margin:0 0 4px;">เกิดข้อผิดพลาด</p>
                                    <p style="font-size:13px;color:#444653;margin:0;">${error.message || 'ไม่สามารถลบรายการได้'}</p>
                                </div>
                           </div>`,
                    customClass: {
                        popup: 'swal-popup-custom',
                        confirmButton: 'swal-btn-primary',
                        actions: 'swal-actions-custom'
                    },
                    confirmButtonText: 'ตกลง',
                    buttonsStyling: false
                });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initSearchFilter();
            bindActionEvents();
        });
    </script>

    <style>
        .swal-popup-custom {
            border-radius: 12px !important;
            padding: 28px 28px 24px !important;
            max-width: 420px !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12) !important;
            font-family: 'Poppins', 'IBM Plex Sans Thai', sans-serif !important;
        }

        .swal-actions-custom {
            display: flex !important;
            gap: 10px !important;
            margin-top: 20px !important;
            justify-content: center !important;
        }

        .swal-btn-confirm {
            padding: 10px 22px !important;
            border-radius: 6px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            background: #e11d48 !important;
            color: #fff !important;
            border: none !important;
            cursor: pointer !important;
            transition: background 0.15s !important;
        }

        .swal-btn-confirm:hover {
            background: #be123c !important;
        }

        .swal-btn-cancel {
            padding: 10px 22px !important;
            border-radius: 6px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            background: #f4f2fc !important;
            color: #444653 !important;
            border: 1px solid #c4c5d5 !important;
            cursor: pointer !important;
            transition: background 0.15s !important;
        }

        .swal-btn-cancel:hover {
            background: #e8e7f1 !important;
        }

        .swal-btn-primary {
            padding: 10px 28px !important;
            border-radius: 6px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            background: #00288e !important;
            color: #fff !important;
            border: none !important;
            cursor: pointer !important;
            transition: background 0.15s !important;
        }

        .swal-btn-primary:hover {
            background: #1e40af !important;
        }
    </style>
}
