@{
    ViewData["Title"] = "ประมาณการค่าใช้จ่ายประจำเดือน";
    ViewData["HeaderTitle"] = "ประมาณการค่าใช้จ่ายประจำเดือน";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[80vw] lg:max-w-4xl xl:max-w-4xl mx-auto w-full">
    <!-- Unified Workspace Surface -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl flex flex-col flex-1">
        
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">ประมาณการค่าใช้จ่ายประจำเดือน</h3>
                <p class="text-xs text-secondary">
                    ขั้นตอนที่ 1: เลือกรายการสินค้า/อะไหล่ที่ต้องการสั่งซื้อหรือเบิกใช้สำหรับเดือนถัดไป เพื่อส่งต่อเข้าสู่ขั้นตอนการคำนวณยอด
                </p>
            </div>
            <!-- Custom Animated Month Dropdown -->
            <div class="relative inline-block text-left self-start md:self-auto" id="custom-month-container">
                <select id="estimation-month" class="hidden"></select>
                
                <button type="button" id="custom-month-btn" aria-haspopup="listbox" aria-expanded="false" 
                        class="h-8 flex items-center gap-2 bg-slate-50 hover:bg-slate-100 border border-slate-300 hover:border-slate-400 rounded px-3 text-xs transition-all active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-primary/20 select-none shadow-2xs group cursor-pointer">
                    <span class="font-semibold text-slate-600">เดือนประมาณการ:</span>
                    <span id="custom-month-selected-text" class="font-bold text-primary transition-colors">กำลังโหลด...</span>
                    <!-- Chevron icon with 200ms cubic-bezier transition -->
                    <svg id="custom-month-chevron" class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <!-- Animated Dropdown Panel with exponential ease-out and shadow-lg -->
                <div id="custom-month-menu" role="listbox" 
                     class="absolute right-0 mt-1.5 w-52 bg-white rounded border border-slate-200/90 shadow-lg py-1.5 z-50 origin-top opacity-0 scale-95 pointer-events-none transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden">
                    <!-- Dynamic Month Options -->
                </div>
            </div>
        </div>

        <!-- Toolbar & Filter Panel -->
        <div class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center gap-md p-md bg-slate-50 border border-slate-200/60 rounded mb-lg">
            <div class="flex flex-wrap items-center gap-3">
                <!-- Search Box -->
                <div class="w-full sm:w-72 relative">
                    <input
                        id="products-search"
                        type="text"
                        placeholder="ค้นหารหัสสินค้า หรือ ชื่ออะไหล่..."
                        class="block w-full px-3 py-1.5 h-8 text-xs border border-slate-200 rounded focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-colors font-medium text-slate-700 bg-white placeholder:text-slate-400"
                    >
                </div>
                <div class="text-xs text-slate-500 font-medium">
                    ทั้งหมด <span id="products-total-count" class="font-bold text-slate-800">0</span> รายการ
                </div>
            </div>

            <!-- Action Controls & Counter -->
            <div class="flex flex-wrap items-center gap-3 justify-end">
                <span class="text-xs text-slate-600 font-medium">
                    เลือกรายการแล้ว <strong id="summary-selected-count" class="font-mono font-bold text-primary text-sm">0</strong> รายการ
                </span>

                <!-- Clear Selections Button -->
                <button id="btn-clear-selection" disabled class="h-8 px-3 rounded border border-slate-300 hover:bg-slate-100 hover:text-red-600 text-slate-700 font-semibold text-xs transition-colors active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-slate-700 disabled:hover:border-slate-300 focus:outline-none">
                    ล้างการเลือก
                </button>

                <!-- Save & Go to Calculation Page Button -->
                <button id="btn-go-to-calculation" disabled class="h-8 flex items-center gap-1.5 px-4 rounded bg-primary hover:bg-primary/95 text-on-primary font-semibold text-xs transition-all active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed shadow-xs focus:outline-none">
                    <span>บันทึก & ไปคิดค่าใช้จ่าย</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Products Table Container -->
        <div class="border border-slate-200 rounded overflow-hidden flex flex-col flex-1">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse min-w-[800px] text-sm">
                    <thead class="bg-slate-50 sticky top-0 z-10 text-xs text-slate-600 font-semibold border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3 w-12 text-center">เลือก</th>
                            <th class="px-4 py-3 w-12 text-center">ลำดับ</th>
                            <th class="px-4 py-3 w-28 text-left">รหัสสินค้า</th>
                            <th id="th-product-name" class="px-4 py-3 text-left">ชื่อสินค้า / รายการอะไหล่</th>
                            <th class="px-4 py-3 w-20 text-center">หน่วย</th>
                            <th class="px-4 py-3 w-32 text-right">ราคาต่อหน่วย (อ้างอิง)</th>
                            <th class="p-0"></th>
                        </tr>
                    </thead>
                    <tbody id="products-tbody" class="divide-y divide-slate-200 bg-white text-sm text-slate-700">
                        <tr>
                            <td colspan="7" class="text-center py-12 text-slate-500">
                                <div class="flex items-center justify-center gap-2.5">
                                    <div class="w-4 h-4 border-2 border-slate-200 border-t-primary rounded-full animate-spin"></div>
                                    <span class="font-semibold">กำลังโหลดข้อมูลสินค้า...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
                <div class="text-xs text-slate-600">
                    แสดงหน้าที่ <span id="products-current-page" class="font-bold text-slate-800">1</span> จากทั้งหมด <span id="products-total-pages" class="font-bold text-slate-800">1</span> หน้า
                </div>
                <div class="flex items-center gap-3 flex-wrap">
                    <!-- Prev Button -->
                    <button id="btn-products-prev" disabled class="h-8 px-4 flex items-center justify-center gap-1.5 border border-slate-300 rounded text-xs font-semibold bg-white hover:bg-slate-50 text-slate-700 transition-colors select-none disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none shadow-2xs">
                        <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                        </svg>
                        <span>ก่อนหน้า</span>
                    </button>
                    
                    <!-- Page Numbers -->
                    <div id="products-page-numbers" class="flex items-center gap-1.5">
                        <!-- Dynamic Page Buttons -->
                    </div>
                    
                    <!-- Next Button -->
                    <button id="btn-products-next" disabled class="h-8 px-4 flex items-center justify-center gap-1.5 border border-slate-300 rounded text-xs font-semibold bg-white hover:bg-slate-50 text-slate-700 transition-colors select-none disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none shadow-2xs">
                        <span>ถัดไป</span>
                        <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // State management
        let currentPage = 1;
        let totalPages = 1;
        let searchQuery = '';
        const pageSize = 20;
        let isLoading = false;

        // Selected products map: productCode -> { productCode, productName, unit, pricePerUnit, quantity }
        let selectedProducts = new Map();

        // Load previously selected items from localStorage if available
        function loadSavedSelections() {
            try {
                const saved = localStorage.getItem('costflow_selected_estimation_items');
                if (saved) {
                    const items = JSON.parse(saved);
                    if (Array.isArray(items)) {
                        items.forEach(item => {
                            selectedProducts.set(item.productCode, {
                                productCode: item.productCode,
                                productName: item.productName,
                                unit: item.unit || '-',
                                pricePerUnit: item.pricePerUnit || 0,
                                quantity: item.quantity || 1
                            });
                        });
                    }
                }
                const savedMonth = localStorage.getItem('costflow_estimation_month');
                if (savedMonth) {
                    if (window.updateCustomMonthDisplay) {
                        window.updateCustomMonthDisplay(savedMonth);
                    } else {
                        const selectEl = document.getElementById('estimation-month');
                        if (selectEl) selectEl.value = savedMonth;
                    }
                }
            } catch (e) {
                console.error("Error loading saved selections:", e);
            }
            updateSummary();
        }

        // Save selections to localStorage
        function saveSelectionsToStorage() {
            try {
                const items = Array.from(selectedProducts.values());
                localStorage.setItem('costflow_selected_estimation_items', JSON.stringify(items));
                const month = document.getElementById('estimation-month').value;
                localStorage.setItem('costflow_estimation_month', month);
            } catch (e) {
                console.error("Error saving selections:", e);
            }
        }

        // Populate months dynamically with custom animated dropdown
        function initMonthSelector() {
            const selectEl = document.getElementById('estimation-month');
            const customBtn = document.getElementById('custom-month-btn');
            const customMenu = document.getElementById('custom-month-menu');
            const customSelectedText = document.getElementById('custom-month-selected-text');
            const customChevron = document.getElementById('custom-month-chevron');
            const customContainer = document.getElementById('custom-month-container');

            const thaiMonths = [
                "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
                "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
            ];
            
            const now = new Date();
            let nextMonthIndex = now.getMonth() + 1;
            let year = now.getFullYear();
            
            if (nextMonthIndex > 11) {
                nextMonthIndex = 0;
                year += 1;
            }

            const monthOptions = [];
            for (let i = 0; i < 6; i++) {
                const index = (nextMonthIndex + i) % 12;
                const adjustedYear = year + Math.floor((nextMonthIndex + i) / 12);
                const thaiYear = adjustedYear + 543; // BE Year
                const val = `${thaiMonths[index]} ${thaiYear}`;
                monthOptions.push(val);
                
                const opt = document.createElement('option');
                opt.value = val;
                opt.textContent = val;
                selectEl.appendChild(opt);
            }

            // Set default initial option
            if (monthOptions.length > 0) {
                selectEl.value = monthOptions[0];
                if (customSelectedText) customSelectedText.textContent = monthOptions[0];
            }

            let isOpen = false;

            function openMenu() {
                isOpen = true;
                customBtn.setAttribute('aria-expanded', 'true');
                customMenu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                customMenu.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
                customChevron.classList.add('rotate-180');
            }

            function closeMenu() {
                isOpen = false;
                customBtn.setAttribute('aria-expanded', 'false');
                customMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
                customMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                customChevron.classList.remove('rotate-180');
            }

            function renderCustomOptions() {
                customMenu.innerHTML = '';
                const currentVal = selectEl.value;

                monthOptions.forEach((val, idx) => {
                    const isSelected = val === currentVal;
                    const itemEl = document.createElement('div');
                    itemEl.setAttribute('role', 'option');
                    itemEl.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                    
                    if (isSelected) {
                        itemEl.className = 'px-3 py-2 text-xs font-bold text-primary bg-primary/[0.08] border-l-2 border-primary flex items-center justify-between cursor-pointer transition-all duration-150 select-none';
                        itemEl.innerHTML = `
                            <span>${val}</span>
                            <svg class="w-3.5 h-3.5 text-primary shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                        `;
                    } else {
                        itemEl.className = 'px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-primary pl-3 hover:pl-3.5 border-l-2 border-transparent flex items-center justify-between cursor-pointer transition-all duration-150 ease-out select-none';
                        itemEl.innerHTML = `<span>${val}</span>`;
                    }

                    itemEl.addEventListener('click', (e) => {
                        e.stopPropagation();
                        selectEl.value = val;
                        customSelectedText.textContent = val;
                        renderCustomOptions();
                        saveSelectionsToStorage();
                        closeMenu();
                    });

                    customMenu.appendChild(itemEl);
                });
            }

            customBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (isOpen) {
                    closeMenu();
                } else {
                    renderCustomOptions();
                    openMenu();
                }
            });

            document.addEventListener('click', (e) => {
                if (isOpen && !customContainer.contains(e.target)) {
                    closeMenu();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (isOpen && e.key === 'Escape') {
                    closeMenu();
                }
            });

            window.updateCustomMonthDisplay = function(val) {
                if (selectEl) selectEl.value = val;
                if (customSelectedText) customSelectedText.textContent = val;
                if (isOpen) renderCustomOptions();
            };

            selectEl.addEventListener('change', () => {
                if (customSelectedText) customSelectedText.textContent = selectEl.value;
                saveSelectionsToStorage();
            });
        }

        // Fetch products from database
        async function fetchProducts() {
            if (isLoading) return;
            isLoading = true;

            // Immediately update pagination text and buttons state
            document.getElementById('products-current-page').textContent = currentPage;
            renderPagination();

            const tbody = document.getElementById('products-tbody');
            // Render 8 skeleton rows to preserve table height/layout and avoid jumps
            let skeletonHtml = '';
            for (let i = 0; i < 8; i++) {
                skeletonHtml += `
                    <tr class="animate-pulse">
                        <td class="px-4 py-3 text-center"><div class="w-4 h-4 bg-slate-200/80 rounded mx-auto"></div></td>
                        <td class="px-4 py-3 text-center"><div class="w-4 h-4 bg-slate-200/80 rounded mx-auto font-mono"></div></td>
                        <td class="px-4 py-3"><div class="w-20 h-4 bg-slate-200/80 rounded mx-auto font-mono"></div></td>
                        <td class="px-4 py-3"><div class="w-2/3 h-4 bg-slate-200/80 rounded"></div></td>
                        <td class="px-4 py-3 text-center"><div class="w-10 h-4 bg-slate-200/80 rounded mx-auto"></div></td>
                        <td class="px-4 py-3 text-right"><div class="w-16 h-4 bg-slate-200/80 rounded ml-auto"></div></td>
                        <td class="p-0"></td>
                    </tr>
                `;
            }
            tbody.innerHTML = skeletonHtml;

            try {
                const response = await fetch(`/MonthlyExpense/GetProductsJson?search=${encodeURIComponent(searchQuery)}&page=${currentPage}&pageSize=${pageSize}`);
                if (!response.ok) throw new Error("โหลดข้อมูลล้มเหลว");
                
                const data = await response.json();
                currentPage = data.page;
                totalPages = data.totalPages;

                document.getElementById('products-total-count').textContent = data.totalCount.toLocaleString();
                document.getElementById('products-current-page').textContent = currentPage;
                document.getElementById('products-total-pages').textContent = totalPages;

                // Find the longest product name on the current page to adjust name column width dynamically
                let longestNameLen = 0;
                data.products.forEach(p => {
                    const len = p.productName ? p.productName.length : 0;
                    if (len > longestNameLen) {
                        longestNameLen = len;
                    }
                });

                // Calculate name column width dynamically (approx 8.5px per character, min 220px, max 450px)
                const nameColWidth = Math.max(220, Math.min(480, longestNameLen * 8.5));
                const nameHeader = document.getElementById('th-product-name');
                if (nameHeader) {
                    nameHeader.style.width = `${nameColWidth}px`;
                    nameHeader.style.maxWidth = `${nameColWidth}px`;
                }

                isLoading = false;
                renderTable(data.products, nameColWidth);
                renderPagination();
            } catch (err) {
                console.error(err);
                isLoading = false;
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-8 text-red-500 font-semibold">
                            เกิดข้อผิดพลาดในการโหลดข้อมูล กรุณาลองใหม่อีกครั้ง
                        </td>
                    </tr>
                `;
                renderPagination();
            }
        }

        // Render table rows
        function renderTable(products, nameColWidth) {
            const tbody = document.getElementById('products-tbody');
            if (products.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-12 text-slate-500">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.602 10.602z"/>
                                </svg>
                                <span class="font-semibold text-xs">ไม่พบรายการสินค้าที่ตรงกับคำค้นหา "${searchQuery}"</span>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = '';
            products.forEach((prod, index) => {
                const isSelected = selectedProducts.has(prod.productCode);
                const rowNum = (currentPage - 1) * pageSize + index + 1;
                const formattedPrice = '฿' + Number(prod.pricePerUnit).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                const tr = document.createElement('tr');
                tr.className = `hover:bg-slate-50/80 transition-colors cursor-pointer select-none ${isSelected ? 'bg-primary/[0.04]' : ''}`;
                tr.innerHTML = `
                    <td class="px-4 py-2.5 text-center" onclick="event.stopPropagation();">
                        <input 
                            type="checkbox" 
                            class="item-checkbox w-4 h-4 rounded text-primary focus:ring-0 focus:ring-offset-0 border-slate-300 cursor-pointer transition-all"
                            data-code="${prod.productCode}"
                            ${isSelected ? 'checked' : ''}
                        >
                    </td>
                    <td class="px-4 py-2.5 text-center text-slate-500 font-mono">${rowNum}</td>
                    <td class="px-4 py-2.5 text-left font-mono font-bold text-primary">${prod.productCode}</td>
                    <td class="px-4 py-2.5 text-left text-slate-800 font-semibold truncate" style="width: ${nameColWidth}px; max-width: ${nameColWidth}px;" title="${prod.productName}">${prod.productName}</td>
                    <td class="px-4 py-2.5 text-center text-slate-600 font-medium">${prod.unit || '-'}</td>
                    <td class="px-4 py-2.5 text-right font-mono text-slate-700 font-bold">${formattedPrice}</td>
                    <td class="p-0"></td>
                `;

                tr.addEventListener('click', () => {
                    const cb = tr.querySelector('.item-checkbox');
                    cb.checked = !cb.checked;
                    cb.dispatchEvent(new Event('change'));
                });

                tbody.appendChild(tr);
            });

            // Bind Checkbox Events
            tbody.querySelectorAll('.item-checkbox').forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const code = e.target.getAttribute('data-code');
                    const row = e.target.closest('tr');

                    if (e.target.checked) {
                        row.classList.add('bg-blue-50/60', 'font-medium');
                        const product = products.find(p => p.productCode === code);
                        selectedProducts.set(code, {
                            productCode: product.productCode,
                            productName: product.productName,
                            unit: product.unit,
                            pricePerUnit: product.pricePerUnit,
                            quantity: 1
                        });
                    } else {
                        row.classList.remove('bg-blue-50/60', 'font-medium');
                        selectedProducts.delete(code);
                    }
                    updateSummary();
                    saveSelectionsToStorage();
                });
            });
        }

        // Render pagination buttons
        function renderPagination() {
            const prevBtn = document.getElementById('btn-products-prev');
            const nextBtn = document.getElementById('btn-products-next');
            const pagesContainer = document.getElementById('products-page-numbers');

            // Disable pagination buttons when loading
            prevBtn.disabled = isLoading || currentPage === 1;
            nextBtn.disabled = isLoading || currentPage === totalPages || totalPages === 0;

            pagesContainer.innerHTML = '';

            if (totalPages <= 0) return;

            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                const btn = createPageBtn(1);
                pagesContainer.appendChild(btn);
                if (startPage > 2) {
                    const span = document.createElement('span');
                    span.className = 'px-2 text-slate-400 text-xs font-semibold select-none';
                    span.textContent = '...';
                    pagesContainer.appendChild(span);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                const btn = createPageBtn(i);
                pagesContainer.appendChild(btn);
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const span = document.createElement('span');
                    span.className = 'px-2 text-slate-400 text-xs font-semibold select-none';
                    span.textContent = '...';
                    pagesContainer.appendChild(span);
                }
                const btn = createPageBtn(totalPages);
                pagesContainer.appendChild(btn);
            }
        }

        function createPageBtn(page) {
            const btn = document.createElement('button');
            const isActive = page === currentPage;
            btn.className = `h-8 min-w-[32px] px-2.5 flex items-center justify-center border rounded text-xs font-semibold transition-colors select-none focus:outline-none ${
                isActive 
                ? 'bg-primary text-on-primary border-primary shadow-xs' 
                : 'bg-white hover:bg-slate-50 text-slate-700 border-slate-300'
            } ${isLoading ? 'opacity-50 cursor-not-allowed' : ''}`;
            btn.textContent = page;
            btn.disabled = isLoading;
            btn.addEventListener('click', () => {
                if (isLoading) return;
                currentPage = page;
                fetchProducts();
            });
            return btn;
        }

        // Update Summary Cards
        function updateSummary() {
            const selectedCount = selectedProducts.size;
            document.getElementById('summary-selected-count').textContent = selectedCount.toLocaleString();

            const goBtn = document.getElementById('btn-go-to-calculation');
            const clearBtn = document.getElementById('btn-clear-selection');
            goBtn.disabled = selectedCount === 0;
            clearBtn.disabled = selectedCount === 0;
        }

        // Debounced search
        let searchTimeout;
        document.getElementById('products-search').addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                searchQuery = e.target.value;
                currentPage = 1;
                fetchProducts();
            }, 300);
        });

        // Pagination buttons click
        document.getElementById('btn-products-prev').addEventListener('click', () => {
            if (isLoading) return;
            if (currentPage > 1) {
                currentPage--;
                fetchProducts();
            }
        });

        document.getElementById('btn-products-next').addEventListener('click', () => {
            if (isLoading) return;
            if (currentPage < totalPages) {
                currentPage++;
                fetchProducts();
            }
        });

        // Clear Selection Handler
        document.getElementById('btn-clear-selection').addEventListener('click', () => {
            if (selectedProducts.size === 0) return;
            Swal.fire({
                title: 'ยืนยันการล้างรายการ',
                text: 'คุณต้องการยกเลิกรายการสินค้าที่เลือกไว้ทั้งหมดหรือไม่?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'ล้างรายการทั้งหมด',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    selectedProducts.clear();
                    saveSelectionsToStorage();
                    updateSummary();
                    // re-render current page
                    const tbody = document.getElementById('products-tbody');
                    tbody.querySelectorAll('.item-checkbox').forEach(cb => {
                        cb.checked = false;
                        cb.closest('tr').classList.remove('bg-blue-50/60', 'font-medium');
                    });
                }
            });
        });

        // Go to Calculation Page Handler
        document.getElementById('btn-go-to-calculation').addEventListener('click', () => {
            if (selectedProducts.size === 0) return;
            saveSelectionsToStorage();
            window.location.href = '/MonthlyExpense/Calculation';
        });

        // Document Ready
        document.addEventListener('DOMContentLoaded', () => {
            initMonthSelector();
            loadSavedSelections();
            fetchProducts();
        });
    </script>
}

