@{
    ViewData["Title"] = "คำนวณค่าใช้จ่ายประจำเดือน";
    ViewData["HeaderTitle"] = "คำนวณค่าใช้จ่ายประจำเดือน";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg w-full max-w-[96vw] xl:max-w-[98vw] 2xl:max-w-[1600px] mx-auto">
    <!-- Unified Workspace Surface -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl flex flex-col flex-1">
        
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">คำนวณค่าใช้จ่ายประจำเดือน</h3>
                <p class="text-xs text-secondary">
                    ขั้นตอนที่ 2: ระบุจำนวนที่ต้องการสั่งซื้อหรือเบิกใช้ เพื่อคำนวณยอดรวมค่าใช้จ่ายจริงและส่งออกใบประมาณการ
                </p>
            </div>
            <div class="flex items-center gap-2 self-start md:self-auto">
                <a href="/MonthlyExpense/Estimation" class="h-8 inline-flex items-center gap-1.5 px-3 border border-slate-300 rounded text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 transition-colors shadow-xs">
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    <span>ย้อนกลับไปเลือกสินค้าเพิ่ม</span>
                </a>
            </div>
        </div>

        <!-- Empty State (Hidden when items exist) -->
        <div id="empty-state-container" class="hidden bg-slate-50 border border-slate-200/80 rounded p-12 text-center my-6">
            <div class="w-12 h-12 rounded-full bg-white border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-4 shadow-xs">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                </svg>
            </div>
            <h4 class="text-sm font-bold text-slate-800 mb-1">ยังไม่มีรายการสินค้าที่เลือกสำหรับคำนวณค่าใช้จ่าย</h4>
            <p class="text-xs text-slate-500 mb-5">กรุณากลับไปที่หน้า "ประมาณการค่าใช้จ่าย" เพื่อทำการติ๊กเลือกรายการสินค้าที่ต้องการสั่งซื้อ</p>
            <a href="/MonthlyExpense/Estimation" class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary hover:bg-primary/95 text-on-primary font-semibold text-xs rounded transition-all shadow-xs">
                <span>+ ไปเลือกรายการสินค้า</span>
            </a>
        </div>

        <!-- Main Calculation Content (Hidden when 0 items) -->
        <div id="calc-content-container" class="flex flex-col flex-1">
            
            <!-- Summary Strip & Actions -->
            <div class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center gap-md p-md bg-slate-50 border border-slate-200/60 rounded mb-lg">
                <div class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-600 font-medium">ประจำเดือน:</span>
                        <span id="display-month" class="px-2.5 py-1 bg-white border border-slate-200 rounded text-slate-800 font-bold text-xs shadow-xs">-</span>
                    </div>

                    <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>

                    <div class="text-xs text-slate-600 font-medium">
                        รายการที่เลือกทั้งหมด <strong id="calc-item-count" class="font-mono font-bold text-primary text-sm">0</strong> รายการ
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3 justify-end">
                    <div class="text-xs text-slate-600 font-medium flex items-center gap-1.5">
                        <span>ยอดรวมประมาณการทั้งสิ้น:</span>
                        <strong id="calc-grand-total" class="font-mono font-bold text-primary text-base">0.00</strong>
                        <span class="font-semibold text-slate-700">บาท</span>
                    </div>

                    <!-- Export Button -->
                    <button id="btn-export-excel-calc" class="h-8 flex items-center gap-1.5 px-4 rounded bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition-colors shadow-xs focus:outline-none">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                        <span>Export Excel (ใบประมาณการ)</span>
                    </button>
                </div>
            </div>

            <!-- Table Container -->
            <div class="border border-slate-200 rounded overflow-hidden flex flex-col flex-1">
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left border-collapse min-w-[900px] text-sm">
                        <thead class="bg-slate-50 sticky top-0 z-10 text-xs text-slate-600 font-semibold border-b border-slate-200">
                            <tr>
                                <th class="px-4 py-3 w-12 text-center">ลำดับ</th>
                                <th class="px-4 py-3 w-28 text-left">รหัสสินค้า</th>
                                <th class="px-4 py-3 text-left">ชื่อสินค้า / รายการอะไหล่</th>
                                <th class="px-4 py-3 w-20 text-center">หน่วย</th>
                                <th class="px-4 py-3 w-32 text-right">ราคาต่อหน่วย</th>
                                <th class="px-4 py-3 w-36 text-center">จำนวนที่ต้องการสั่ง</th>
                                <th class="px-4 py-3 w-32 text-right">รวมประมาณการ</th>
                                <th class="px-4 py-3 w-16 text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="calc-tbody" class="divide-y divide-slate-200 bg-white text-sm text-slate-700">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let calcItems = [];
        let calcMonth = "";

        function loadFromStorage() {
            try {
                const savedItems = localStorage.getItem('costflow_selected_estimation_items');
                if (savedItems) {
                    calcItems = JSON.parse(savedItems) || [];
                }
                calcMonth = localStorage.getItem('costflow_estimation_month') || "ไม่ระบุเดือน";
            } catch (e) {
                console.error("Failed to load calculation items:", e);
                calcItems = [];
            }

            if (calcItems.length === 0) {
                document.getElementById('empty-state-container').classList.remove('hidden');
                document.getElementById('calc-content-container').classList.add('hidden');
            } else {
                document.getElementById('empty-state-container').classList.add('hidden');
                document.getElementById('calc-content-container').classList.remove('hidden');
                document.getElementById('display-month').textContent = calcMonth;
                renderCalcTable();
            }
        }

        function saveToStorage() {
            try {
                localStorage.setItem('costflow_selected_estimation_items', JSON.stringify(calcItems));
            } catch (e) {
                console.error("Failed to save calculation items:", e);
            }
        }

        function renderCalcTable() {
            const tbody = document.getElementById('calc-tbody');
            if (calcItems.length === 0) {
                document.getElementById('empty-state-container').classList.remove('hidden');
                document.getElementById('calc-content-container').classList.add('hidden');
                return;
            }

            tbody.innerHTML = '';
            let grandTotal = 0;

            calcItems.forEach((item, index) => {
                const qty = item.quantity || 1;
                const subtotal = item.pricePerUnit * qty;
                grandTotal += subtotal;

                const formattedPrice = '฿' + Number(item.pricePerUnit).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const formattedSubtotal = '฿' + Number(subtotal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition-colors select-none";
                tr.innerHTML = `
                    <td class="px-4 py-2.5 text-center text-slate-500 font-mono">${index + 1}</td>
                    <td class="px-4 py-2.5 text-left font-mono font-bold text-primary">${item.productCode}</td>
                    <td class="px-4 py-2.5 text-left text-slate-800 font-bold">${item.productName}</td>
                    <td class="px-4 py-2.5 text-center text-slate-600 font-medium">${item.unit || '-'}</td>
                    <td class="px-4 py-2.5 text-right font-mono text-slate-700 font-bold">${formattedPrice}</td>
                    <td class="px-4 py-2.5 text-center">
                        <div class="flex items-center justify-center gap-1 mx-auto max-w-[130px]">
                            <button class="btn-qty-minus h-7 w-7 border border-slate-300 rounded bg-white hover:bg-slate-50 flex items-center justify-center text-slate-700 transition-colors font-semibold" data-index="${index}">-</button>
                            <input 
                                type="number" 
                                min="1" 
                                value="${qty}" 
                                class="qty-input w-16 h-7 border border-slate-300 rounded text-center font-semibold text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-colors font-mono" 
                                data-index="${index}"
                            >
                            <button class="btn-qty-plus h-7 w-7 border border-slate-300 rounded bg-white hover:bg-slate-50 flex items-center justify-center text-slate-700 transition-colors font-semibold" data-index="${index}">+</button>
                        </div>
                    </td>
                    <td class="px-4 py-2.5 text-right font-mono text-slate-900 font-bold subtotal-cell">${formattedSubtotal}</td>
                    <td class="px-4 py-2.5 text-center">
                        <button class="btn-delete-item p-1.5 text-slate-500 hover:text-red-600 hover:bg-slate-100 rounded transition-colors" data-index="${index}" title="ลบรายการนี้">
                            <!-- Heroicon: trash -->
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                            </svg>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('calc-item-count').textContent = calcItems.length.toLocaleString();
            document.getElementById('calc-grand-total').textContent = grandTotal.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            bindCalcEvents();
        }

        function bindCalcEvents() {
            const tbody = document.getElementById('calc-tbody');

            tbody.querySelectorAll('.qty-input').forEach(input => {
                input.addEventListener('change', (e) => {
                    let qty = parseFloat(e.target.value);
                    if (isNaN(qty) || qty < 1) {
                        qty = 1;
                        e.target.value = 1;
                    }
                    const idx = parseInt(e.target.getAttribute('data-index'));
                    if (calcItems[idx]) {
                        calcItems[idx].quantity = qty;
                        saveToStorage();
                        renderCalcTable();
                    }
                });
            });

            tbody.querySelectorAll('.btn-qty-minus').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(e.target.getAttribute('data-index'));
                    if (calcItems[idx] && calcItems[idx].quantity > 1) {
                        calcItems[idx].quantity -= 1;
                        saveToStorage();
                        renderCalcTable();
                    }
                });
            });

            tbody.querySelectorAll('.btn-qty-plus').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(e.target.getAttribute('data-index'));
                    if (calcItems[idx]) {
                        calcItems[idx].quantity = (calcItems[idx].quantity || 1) + 1;
                        saveToStorage();
                        renderCalcTable();
                    }
                });
            });

            tbody.querySelectorAll('.btn-delete-item').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(e.currentTarget.getAttribute('data-index'));
                    const item = calcItems[idx];
                    Swal.fire({
                        title: 'ลบรายการ?',
                        text: `ต้องการลบ "${item.productName}" ออกจากการคำนวณหรือไม่?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'ลบรายการ',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            calcItems.splice(idx, 1);
                            saveToStorage();
                            renderCalcTable();
                        }
                    });
                });
            });
        }

        document.getElementById('btn-export-excel-calc').addEventListener('click', async () => {
            if (calcItems.length === 0) return;

            try {
                Swal.fire({
                    title: 'กำลังสร้างไฟล์ Excel...',
                    html: 'ระบบกำลังคำนวณยอดและจัดรูปแบบไฟล์',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch('/MonthlyExpense/ExportEstimationExcel', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        estimationMonth: calcMonth,
                        items: calcItems
                    })
                });

                if (!response.ok) throw new Error("ดาวน์โหลดไฟล์ล้มเหลว");

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `ใบคำนวณประมาณการค่าใช้จ่าย_${calcMonth.replace(' ', '_')}.xlsx`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);

                Swal.fire({
                    icon: 'success',
                    title: 'ดาวน์โหลดไฟล์เรียบร้อย!',
                    text: `ส่งออกใบประมาณการค่าใช้จ่ายสำหรับเดือน ${calcMonth} สำเร็จ`,
                    confirmButtonText: 'ตกลง'
                });
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถสร้างไฟล์ Excel ได้ในขณะนี้',
                    confirmButtonText: 'ตกลง'
                });
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            loadFromStorage();
        });
    </script>
}
