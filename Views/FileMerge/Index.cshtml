@{
    ViewData["Title"] = "นำเข้าไฟล์";
    ViewData["HeaderTitle"] = "นำเข้าข้อมูลสั่งผลิต";
}

<style>
    /* Loading Spinner */
    .loader {
        --color-1: #fff;
        --color-2: #3755c3;
        --size: 1.2px;
        width: calc(16 * var(--size));
        height: calc(16 * var(--size));
        border-radius: 50%;
        display: block;
        margin: calc(15 * var(--size)) auto;
        position: relative;
        background: var(--color-1);
        box-shadow:
            calc(-24 * var(--size)) 0 var(--color-1),
            calc(24 * var(--size)) 0 var(--color-1);
        box-sizing: border-box;
        animation: shadowPulse 2s linear infinite;
    }

    @@keyframes shadowPulse {
        33% {
            background: var(--color-1);
            box-shadow:
                calc(-24 * var(--size)) 0 var(--color-2),
                calc(24 * var(--size)) 0 var(--color-1);
        }
        66% {
            background: var(--color-2);
            box-shadow:
                calc(-24 * var(--size)) 0 var(--color-1),
                calc(24 * var(--size)) 0 var(--color-1);
        }
        100% {
            background: var(--color-1);
            box-shadow:
                calc(-24 * var(--size)) 0 var(--color-1),
                calc(24 * var(--size)) 0 var(--color-2);
        }
    }

    /* Fade-in Animation */
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Dropzone Active State */
    .dropzone-active {
        background-color: #e0f2fe !important;
        border-color: #00288e !important;
    }

    .dropzone-active .dropzone-icon {
        transform: scale(1.1);
    }

    /* Button Interaction Effect */
    .btn-interactive:active {
        transform: scale(0.98);
    }
</style>

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">

    <!-- Upload Section -->
    <div id="step-1" class="bg-white rounded border border-outline-variant shadow-sm p-lg animate-fade-in">
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-1">นำเข้าไฟล์ใบสั่งผลิต</h3>
        <p class="text-secondary text-sm mb-lg">อัปโหลดไฟล์สั่งผลิตหลัก — ระบบจะนำเข้าและรอจับคู่แผนผลิต</p>

        <div id="dropzone-master" class="border border-dashed border-primary/40 rounded p-xl flex flex-col items-center justify-center bg-sky-50/30 hover:bg-sky-50 transition-all cursor-pointer min-h-[220px] text-center mb-md w-full">
            <svg class="dropzone-icon w-10 h-10 text-primary mb-sm transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 a5.25 5.25 0 0 1 10.233-2.33 a3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
            </svg>
            <span class="dropzone-label text-sm font-semibold text-slate-700 mb-0.5 transition-colors">คลิกหรือลากไฟล์มาวาง</span>
            <span class="text-xs text-secondary">รองรับ .xlsx, .csv</span>
        </div>
        <input type="file" id="input-master" class="hidden" accept=".xlsx,.csv" />

        <div id="status-master" class="hidden border border-outline-variant rounded p-lg flex flex-col items-center justify-center bg-white min-h-[220px] text-center mb-md">
            <div id="loading-master" class="hidden flex-col items-center justify-center w-full">
                <span class="loader mb-4"></span>
                <span class="text-sm font-medium text-slate-700">กำลังอัปโหลดและประมวลผล...</span>
            </div>
        </div>
    </div>

    <!-- Step 2: Preview -->
    <div id="step-2" class="hidden bg-white rounded border border-outline-variant shadow-sm p-lg animate-fade-in">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-md pb-md border-b border-slate-100">
            <div class="shrink-0">
                <h3 class="font-bold text-slate-800 text-lg">ตรวจสอบข้อมูลก่อนบันทึก</h3>
                <p class="text-slate-400 text-xs mt-1">พบข้อมูลทั้งหมด <span id="preview-total-count" class="font-extrabold text-primary">0</span> รายการ (ไม่ซ้ำกัน)</p>
            </div>
            
            <div class="flex items-center gap-sm shrink-0">
                <button type="button" id="btn-cancel-preview" class="border border-slate-200 text-slate-600 px-md py-2.5 rounded text-xs font-bold hover:bg-slate-50 transition-colors">
                    ยกเลิก/เปลี่ยนไฟล์
                </button>
                <button type="button" id="btn-save-master" class="bg-primary hover:bg-primary/95 text-on-primary px-md py-2.5 rounded text-xs font-bold shadow-sm transition-all flex items-center gap-sm btn-interactive">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    ยืนยันการบันทึกเข้าระบบ
                </button>
            </div>
        </div>

        <div class="overflow-x-auto overflow-y-auto rounded border border-outline-variant min-h-[300px]" style="max-height: calc(100vh - 250px);">
            <table class="w-full text-left border-collapse min-w-[1000px]">
                <thead class="sticky top-0 z-10 text-slate-600 font-bold" style="font-size: 13px;">
                    <tr class="bg-slate-100 border-b border-slate-200">
                        <th class="px-3 py-2.5 bg-slate-100 w-14 text-center">ลำดับ</th>
                        <th class="px-3 py-2.5 bg-slate-100 text-left">เลขที่อนุมัติ (สั่งผลิต)</th>
                        <th class="px-3 py-2.5 bg-slate-100 text-center">วันที่อนุมัติ</th>
                        <th class="px-3 py-2.5 bg-slate-100 text-center">ปภ.ความเร่งด่วน</th>
                        <th class="px-3 py-2.5 bg-slate-100 text-center">จำนวนชิ้น</th>
                        <th class="px-3 py-2.5 bg-slate-100 text-right">ราคาที่ผู้ผลิตเสนอ</th>
                        <th class="px-3 py-2.5 bg-slate-100 w-1/3 text-left">หมายเหตุ / รายละเอียด</th>
                    </tr>
                </thead>
                <tbody id="preview-tbody" class="divide-y divide-slate-200 bg-white text-xs font-medium text-slate-800">
                    <!-- Preview rows go here -->
                </tbody>
            </table>
        </div>
    </div>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let sessionMaster = null;

            // --- Navigation Functions ---
            function showUploadForm() {
                document.getElementById('step-1').classList.remove('hidden');
                document.getElementById('step-2').classList.add('hidden');
            }

            function showPreviewForm() {
                document.getElementById('step-1').classList.add('hidden');
                document.getElementById('step-2').classList.remove('hidden');
            }

            // --- Reusable Dropzone Setup (drag feedback + file type hint) ---
            function setupDropzone(dropzone, input, onFile) {
                let dragCounter = 0;

                dropzone.addEventListener('click', () => input.click());

                dropzone.addEventListener("dragenter", (e) => {
                    e.preventDefault();
                    dragCounter++;
                    dropzone.classList.add("dropzone-active");
                });

                dropzone.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    const items = e.dataTransfer.items;
                    if (items && items.length > 0) {
                        const fileType = items[0].type;
                        const isValid = !fileType || fileType.includes('sheet') || fileType.includes('csv') || fileType.includes('excel');
                        dropzone.classList.toggle('border-red-400', !isValid);
                        dropzone.classList.toggle('bg-red-50/30', !isValid);
                    }
                });

                dropzone.addEventListener("dragleave", (e) => {
                    e.preventDefault();
                    dragCounter--;
                    if (dragCounter <= 0) {
                        dragCounter = 0;
                        dropzone.classList.remove("dropzone-active", "border-red-400", "bg-red-50/30");
                    }
                });

                dropzone.addEventListener("drop", (e) => {
                    e.preventDefault();
                    dragCounter = 0;
                    dropzone.classList.remove("dropzone-active", "border-red-400", "bg-red-50/30");
                    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        onFile(e.dataTransfer.files[0]);
                    }
                });

                input.addEventListener('change', () => {
                    if (input.files && input.files.length > 0) onFile(input.files[0]);
                });
            }

            // --- Step 1: Upload Master ---
            const dropzoneMaster = document.getElementById('dropzone-master');
            const inputMaster = document.getElementById('input-master');

            setupDropzone(dropzoneMaster, inputMaster, processMasterFile);

            function processMasterFile(file) {
                dropzoneMaster.classList.add('hidden');
                document.getElementById('status-master').classList.remove('hidden');
                document.getElementById('loading-master').classList.remove('hidden');
                document.getElementById('loading-master').classList.add('flex');

                const formData = new FormData();
                formData.append("file", file);

                fetch("/FileImport/UploadFile", { method: "POST", body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            sessionMaster = data.sessionId;
                            return fetch("/FileMerge/PreviewMasterFile?sessionId=" + sessionMaster, { method: "POST" });
                        } else {
                            throw new Error(data.error);
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('preview-total-count').textContent = data.totalCount;
                            const tbody = document.getElementById('preview-tbody');
                            tbody.innerHTML = "";
                            let idx = 1;
                            data.items.slice(0, 500).forEach(item => {
                                const parsedAmt = item.amount ? parseFloat(String(item.amount).replace(/,/g, '').trim()) : 0;
                                const formattedAmount = !isNaN(parsedAmt) ? '฿' + parsedAmt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '฿0.00';
                                tbody.innerHTML += `
                                    <tr class="hover:bg-slate-50/50 transition-colors">
                                        <td class="px-3 py-2.5 text-center text-slate-400 font-mono">${idx++}</td>
                                        <td class="px-3 py-2.5 text-left font-mono font-bold text-primary">${item.poNumber}</td>
                                        <td class="px-3 py-2.5 text-center text-slate-600">${item.approvedDate}</td>
                                        <td class="px-3 py-2.5 text-center text-slate-500">${item.urgency || '-'}</td>
                                        <td class="px-3 py-2.5 text-center font-bold text-slate-900">${item.quantity}</td>
                                        <td class="px-3 py-2.5 text-right font-mono text-slate-700">${formattedAmount}</td>
                                        <td class="px-3 py-2.5 text-left text-slate-500 truncate max-w-[280px]" title="${item.remarks}">${item.remarks || '-'}</td>
                                    </tr>
                                `;
                            });
                            showPreviewForm();
                        } else {
                            throw new Error(data.error);
                        }
                    })
                    .catch(err => {
                        Swal.fire('Error', err.message, 'error');
                        resetMasterUpload();
                    });
            }

            function resetMasterUpload() {
                inputMaster.value = "";
                sessionMaster = null;
                dropzoneMaster.classList.remove('hidden');
                document.getElementById('status-master').classList.add('hidden');
                document.getElementById('loading-master').classList.add('hidden');
                document.getElementById('loading-master').classList.remove('flex');
            }

            document.getElementById('btn-cancel-preview').addEventListener('click', () => {
                resetMasterUpload();
                showUploadForm();
            });

            // --- Save Master Data ---
            const btnSaveMaster = document.getElementById('btn-save-master');

            btnSaveMaster.addEventListener('click', () => {
                Swal.fire({
                    title: 'กำลังบันทึกข้อมูล...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                fetch(`/FileMerge/ConfirmSaveMaster?sessionId=${sessionMaster}`, { method: "POST" })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            // Build message with insert/skip details
                            let message = data.message || `บันทึก ${data.insertCount} รายการเข้าระบบเรียบร้อย`;
                            
                            // Show detailed info if there are skipped items
                            let html = `<p class="text-base mb-2">${message}</p>`;
                            if (data.skippedCount > 0 && data.skippedPOs && data.skippedPOs.length > 0) {
                                html += `<div class="mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded text-left">`;
                                html += `<p class="text-sm font-semibold text-yellow-800 mb-1">🔄 รายการที่ข้าม (มีในระบบแล้ว):</p>`;
                                html += `<ul class="text-xs text-yellow-700 list-disc list-inside space-y-0.5">`;
                                data.skippedPOs.forEach(po => {
                                    html += `<li>${po}</li>`;
                                });
                                if (data.skippedCount > data.skippedPOs.length) {
                                    html += `<li class="font-semibold">... และอีก ${data.skippedCount - data.skippedPOs.length} รายการ</li>`;
                                }
                                html += `</ul></div>`;
                            }

                            Swal.fire({
                                icon: data.insertCount > 0 ? 'success' : 'info',
                                title: data.insertCount > 0 ? 'บันทึกสำเร็จ!' : 'ไม่มีรายการใหม่',
                                html: html,
                                showCancelButton: true,
                                confirmButtonText: 'ไปดูรายงาน',
                                cancelButtonText: 'อัปโหลดไฟล์เพิ่ม',
                                confirmButtonColor: '#00288e',
                                cancelButtonColor: '#94a3b8',
                                allowOutsideClick: false,
                                width: '600px'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = "/Report";
                                } else {
                                    window.location.reload();
                                }
                            });
                        } else {
                            Swal.fire('Error', data.error, 'error');
                        }
                    })
                    .catch(err => {
                        Swal.fire('Error', err.message, 'error');
                    });
            });
        });
    </script>
}
