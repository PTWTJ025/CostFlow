@{
    ViewData["Title"] = "เปรียบเทียบข้อมูล";
    ViewData["HeaderTitle"] = "เปรียบเทียบข้อมูล";
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-container-max mx-auto w-full">
    <!-- Header Card -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-lg">
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-md">เปรียบเทียบข้อมูล</h3>
        <p class="text-secondary mb-lg">อัปโหลดไฟล์ใบสั่งงานผลิตชิ้นส่วน (mcsAppvProduct) และไฟล์แผนผลิตประจำสัปดาห์ เพื่อนำข้อมูลมาจับคู่เปรียบเทียบร่วมกัน</p>
        
        <!-- Dual Upload Section -->
        <div class="flex flex-col lg:flex-row gap-lg items-stretch mb-xl">
            <!-- Slot A: Part PO -->
            <div id="container-a" class="flex-1 border border-outline-variant rounded p-lg flex flex-col justify-between bg-surface-container-low/30">
                <div>
                    <h4 class="font-bold text-on-surface mb-xs">ไฟล์ใบสั่งงานผลิตชิ้นส่วน (mcsAppvProduct)</h4>
                    <p class="text-xs text-secondary mb-md">ข้อมูลสั่งผลิตหลักที่ใช้สำหรับอ้างอิงเปรียบเทียบ</p>
                </div>
                
                <!-- Upload Dropzone A -->
                <div id="dropzone-a" class="border-2 border-dashed border-outline-variant rounded p-md flex flex-col items-center justify-center bg-white hover:bg-slate-50 transition-colors cursor-pointer min-h-[180px] text-center my-md">
                    <svg class="w-8 h-8 text-primary mb-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 a5.25 5.25 0 0 1 10.233-2.33 a3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
                    </svg>
                    <span class="text-xs font-semibold text-on-surface mb-1">ลากไฟล์มาวาง หรือ คลิกเพื่ออัปโหลด</span>
                    <span class="text-[10px] text-secondary">รองรับ .xlsx, .csv (สูงสุด 25 MB)</span>
                </div>
                
                <!-- Input Element A (hidden) -->
                <input type="file" id="input-a" class="hidden" accept=".xlsx,.csv" />
                
                <!-- Status Box A -->
                <div id="status-a" class="hidden text-center py-sm">
                    <!-- Spinner State -->
                    <div id="loading-a" class="hidden flex flex-col items-center">
                        <div class="w-6 h-6 border-2 border-slate-200 border-t-primary rounded-full animate-spin mb-sm"></div>
                        <span class="text-xs text-secondary font-medium">กำลังประมวลผล...</span>
                    </div>
                    <!-- Success State -->
                    <div id="success-a" class="hidden flex flex-col items-center">
                        <div class="w-8 h-8 bg-green-50 text-green-600 rounded-full flex items-center justify-center border border-green-200/50 mb-xs">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        </div>
                        <span class="text-xs font-bold text-slate-800" id="filename-a"></span>
                        <span class="text-[10px] text-secondary" id="details-a"></span>
                        <button type="button" id="reset-a" class="text-[10px] text-primary underline mt-2 hover:text-primary/80">เปลี่ยนไฟล์</button>
                    </div>
                    <!-- Error State -->
                    <div id="error-a" class="hidden flex flex-col items-center">
                        <span class="text-xs text-error font-bold mb-1">โหลดไม่สำเร็จ</span>
                        <span class="text-[10px] text-secondary px-sm mb-2" id="errormsg-a"></span>
                        <button type="button" id="retry-a" class="text-[10px] text-primary underline hover:text-primary/80">ลองใหม่</button>
                    </div>
                </div>
            </div>
            
            <!-- Connection indicator -->
            <div class="flex items-center justify-center py-2 lg:py-0">
                <svg class="w-6 h-6 text-secondary rotate-90 lg:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0-4.5 4.5M21 7.5H7.5" />
                </svg>
            </div>
            
            <!-- Slot B: Weekly Production Plan -->
            <div id="container-b" class="flex-1 border border-outline-variant rounded p-lg flex flex-col justify-between bg-surface-container-low/30">
                <div>
                    <h4 class="font-bold text-on-surface mb-xs">ไฟล์แผนผลิตประจำสัปดาห์ (Weekly Production Plan)</h4>
                    <p class="text-xs text-secondary mb-md">ข้อมูลแผนผลิตรายสัปดาห์ที่นำมาเปรียบเทียบจับคู่ (เช่น แผนผลิตประจำสัปดาห์ KC 30-6-69.xlsx)</p>
                </div>
                
                <!-- Upload Dropzone B -->
                <div id="dropzone-b" class="border-2 border-dashed border-outline-variant rounded p-md flex flex-col items-center justify-center bg-white hover:bg-slate-50 transition-colors cursor-pointer min-h-[180px] text-center my-md">
                    <svg class="w-8 h-8 text-primary mb-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 a5.25 5.25 0 0 1 10.233-2.33 a3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
                    </svg>
                    <span class="text-xs font-semibold text-on-surface mb-1">ลากไฟล์มาวาง หรือ คลิกเพื่ออัปโหลด</span>
                    <span class="text-[10px] text-secondary">รองรับ .xlsx, .csv (สูงสุด 25 MB)</span>
                </div>
                
                <!-- Input Element B (hidden) -->
                <input type="file" id="input-b" class="hidden" accept=".xlsx,.csv" />
                
                <!-- Status Box B -->
                <div id="status-b" class="hidden text-center py-sm">
                    <!-- Spinner State -->
                    <div id="loading-b" class="hidden flex flex-col items-center">
                        <div class="w-6 h-6 border-2 border-slate-200 border-t-primary rounded-full animate-spin mb-sm"></div>
                        <span class="text-xs text-secondary font-medium">กำลังประมวลผล...</span>
                    </div>
                    <!-- Success State -->
                    <div id="success-b" class="hidden flex flex-col items-center">
                        <div class="w-8 h-8 bg-green-50 text-green-600 rounded-full flex items-center justify-center border border-green-200/50 mb-xs">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        </div>
                        <span class="text-xs font-bold text-slate-800" id="filename-b"></span>
                        <span class="text-[10px] text-secondary" id="details-b"></span>
                        <button type="button" id="reset-b" class="text-[10px] text-primary underline mt-2 hover:text-primary/80">เปลี่ยนไฟล์</button>
                    </div>
                    <!-- Error State -->
                    <div id="error-b" class="hidden flex flex-col items-center">
                        <span class="text-xs text-error font-bold mb-1">โหลดไม่สำเร็จ</span>
                        <span class="text-[10px] text-secondary px-sm mb-2" id="errormsg-b"></span>
                        <button type="button" id="retry-b" class="text-[10px] text-primary underline hover:text-primary/80">ลองใหม่</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Row -->
        <div class="flex justify-end border-t border-slate-200 pt-lg gap-sm">
            <button type="button" id="cancel-btn" class="border border-outline-variant hover:bg-slate-50 text-secondary font-semibold text-sm px-5 py-2.5 rounded transition-colors bg-white">
                ยกเลิก
            </button>
            <button type="button" id="merge-btn" disabled class="bg-primary text-on-primary font-semibold text-sm px-6 py-2.5 rounded transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                เปรียบเทียบข้อมูล
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // DOM Cache for Slot A
    const dropzoneA = document.getElementById("dropzone-a");
    const inputA = document.getElementById("input-a");
    const statusA = document.getElementById("status-a");
    const loadingA = document.getElementById("loading-a");
    const successA = document.getElementById("success-a");
    const errorA = document.getElementById("error-a");
    const filenameA = document.getElementById("filename-a");
    const detailsA = document.getElementById("details-a");
    const errormsgA = document.getElementById("errormsg-a");
    const resetA = document.getElementById("reset-a");
    const retryA = document.getElementById("retry-a");

    // DOM Cache for Slot B
    const dropzoneB = document.getElementById("dropzone-b");
    const inputb = document.getElementById("input-b");
    const statusB = document.getElementById("status-b");
    const loadingB = document.getElementById("loading-b");
    const successB = document.getElementById("success-b");
    const errorB = document.getElementById("error-b");
    const filenameB = document.getElementById("filename-b");
    const detailsB = document.getElementById("details-b");
    const errormsgB = document.getElementById("errormsg-b");
    const resetB = document.getElementById("reset-b");
    const retryB = document.getElementById("retry-b");

    const mergeBtn = document.getElementById("merge-btn");
    const cancelBtn = document.getElementById("cancel-btn");

    let sessionIdA = null;
    let sessionIdB = null;

    let abortA = null;
    let abortB = null;

    // --- SETUP SLOT A ---
    dropzoneA.addEventListener("click", () => inputA.click());
    dropzoneA.addEventListener("dragover", (e) => { e.preventDefault(); dropzoneA.classList.add("bg-slate-100"); });
    dropzoneA.addEventListener("dragleave", (e) => { e.preventDefault(); dropzoneA.classList.remove("bg-slate-100"); });
    dropzoneA.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzoneA.classList.remove("bg-slate-100");
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            validateAndUpload(e.dataTransfer.files[0], 'A');
        }
    });
    inputA.addEventListener("change", () => {
        if (inputA.files && inputA.files.length > 0) {
            validateAndUpload(inputA.files[0], 'A');
        }
    });

    // --- SETUP SLOT B ---
    dropzoneB.addEventListener("click", () => inputb.click());
    dropzoneB.addEventListener("dragover", (e) => { e.preventDefault(); dropzoneB.classList.add("bg-slate-100"); });
    dropzoneB.addEventListener("dragleave", (e) => { e.preventDefault(); dropzoneB.classList.remove("bg-slate-100"); });
    dropzoneB.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzoneB.classList.remove("bg-slate-100");
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            validateAndUpload(e.dataTransfer.files[0], 'B');
        }
    });
    inputb.addEventListener("change", () => {
        if (inputb.files && inputb.files.length > 0) {
            validateAndUpload(inputb.files[0], 'B');
        }
    });

    // Reset handlers
    resetA.addEventListener("click", () => clearSlot('A'));
    retryA.addEventListener("click", () => clearSlot('A'));
    resetB.addEventListener("click", () => clearSlot('B'));
    retryB.addEventListener("click", () => clearSlot('B'));

    cancelBtn.addEventListener("click", () => {
        clearSlot('A');
        clearSlot('B');
        window.location.href = "/Home";
    });

    function validateAndUpload(file, slot) {
        const allowedExtensions = [".xlsx", ".csv"];
        const fileName = file.name;
        const fileExt = fileName.substring(fileName.lastIndexOf(".")).toLowerCase();

        if (!allowedExtensions.includes(fileExt)) {
            showSlotError(slot, "ไม่รองรับไฟล์ประเภทนี้ กรุณาเลือก .xlsx หรือ .csv");
            return;
        }

        const maxFileSize = 25 * 1024 * 1024;
        if (file.size > maxFileSize) {
            showSlotError(slot, "ไฟล์มีขนาดใหญ่เกินไป (สูงสุด 25 MB)");
            return;
        }

        uploadFile(file, slot);
    }

    function uploadFile(file, slot) {
        showSlotLoading(slot);

        const controller = new AbortController();
        if (slot === 'A') abortA = controller;
        else abortB = controller;

        const formData = new FormData();
        formData.append("file", file);

        fetch("/FileImport/UploadFile", {
            method: "POST",
            body: formData,
            signal: controller.signal
        })
        .then(response => {
            if (!response.ok) throw new Error("HTTP error " + response.status);
            return response.json();
        })
        .then(data => {
            if (data.success) {
                showSlotSuccess(slot, file.name, data);
            } else {
                showSlotError(slot, data.error);
            }
        })
        .catch(err => {
            if (err.name !== 'AbortError') {
                showSlotError(slot, "เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์");
            }
        });
    }

    function showSlotLoading(slot) {
        if (slot === 'A') {
            dropzoneA.classList.add("hidden");
            statusA.classList.remove("hidden");
            loadingA.classList.remove("hidden");
            successA.classList.add("hidden");
            errorA.classList.add("hidden");
        } else {
            dropzoneB.classList.add("hidden");
            statusB.classList.remove("hidden");
            loadingB.classList.remove("hidden");
            successB.classList.add("hidden");
            errorB.classList.add("hidden");
        }
    }

    function showSlotSuccess(slot, name, data) {
        if (slot === 'A') {
            sessionIdA = data.sessionId;
            loadingA.classList.add("hidden");
            successA.classList.remove("hidden");
            filenameA.textContent = name;
            detailsA.textContent = data.fileType === "csv" ? `พบ ${data.totalRows} แถว` : `พบ ${data.sheetCount} ชีท`;
        } else {
            sessionIdB = data.sessionId;
            loadingB.classList.add("hidden");
            successB.classList.remove("hidden");
            filenameB.textContent = name;
            detailsB.textContent = data.fileType === "csv" ? `พบ ${data.totalRows} แถว` : `พบ ${data.sheetCount} ชีท`;
        }
        checkMergeState();
    }

    function showSlotError(slot, msg) {
        if (slot === 'A') {
            dropzoneA.classList.add("hidden");
            statusA.classList.remove("hidden");
            loadingA.classList.add("hidden");
            successA.classList.add("hidden");
            errorA.classList.remove("hidden");
            errormsgA.textContent = msg;
        } else {
            dropzoneB.classList.add("hidden");
            statusB.classList.remove("hidden");
            loadingB.classList.add("hidden");
            successB.classList.add("hidden");
            errorB.classList.remove("hidden");
            errormsgB.textContent = msg;
        }
        checkMergeState();
    }

    function clearSlot(slot) {
        if (slot === 'A') {
            if (abortA) abortA.abort();
            sessionIdA = null;
            inputA.value = "";
            dropzoneA.classList.remove("hidden");
            statusA.classList.add("hidden");
        } else {
            if (abortB) abortB.abort();
            sessionIdB = null;
            inputb.value = "";
            dropzoneB.classList.remove("hidden");
            statusB.classList.add("hidden");
        }
        checkMergeState();
    }

    function checkMergeState() {
        if (sessionIdA && sessionIdB) {
            mergeBtn.disabled = false;
        } else {
            mergeBtn.disabled = true;
        }
    }

    // Handle Merge Click
    mergeBtn.addEventListener("click", () => {
        if (sessionIdA && sessionIdB) {
            // Redirect to merge action / step 2 wizard
            window.location.href = `/FileMerge/ProcessMerge?sessionIdA=${sessionIdA}&sessionIdB=${sessionIdB}`;
        }
    });

    // Reset file uploads on page show or history back
    window.addEventListener("pageshow", function (event) {
        clearSlot('A');
        clearSlot('B');
    });
});
</script>
