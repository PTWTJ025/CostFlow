@model List<CostFlow.Models.MergeResult>
@{
    ViewData["Title"] = "เปรียบเทียบข้อมูล";
    ViewData["HeaderTitle"] = "เปรียบเทียบข้อมูล";
    
    int matchedCount = Model.Count(r => r.IsMatched);
    int unmatchedCount = Model.Count(r => !r.IsMatched);

    // C# helper to insert <br/> after "นัดตอบเป้าหมาย" for cleaner layout
    string FormatDeliveryCell(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "-";
        val = val.Trim();
        if (val.StartsWith("นัดตอบเป้าหมาย"))
        {
            string rest = val.Substring("นัดตอบเป้าหมาย".Length).Trim();
            if (string.IsNullOrEmpty(rest)) return "นัดตอบเป้าหมาย";
            return "นัดตอบเป้าหมาย<br/>" + rest;
        }
        return val;
    }
}

<div class="flex-1 p-md md:p-lg lg:p-xl flex flex-col gap-lg max-w-[88vw] mx-auto w-full">
    <!-- Summary Banner & Table Card -->
    <div class="bg-white rounded border border-outline-variant shadow-sm p-md md:p-lg lg:p-xl">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs">ผลการเปรียบเทียบข้อมูลแผนและคำสั่งจัดซื้อ</h3>
                <p class="text-xs text-secondary">
                    ไฟล์หลัก: <span class="font-semibold text-slate-700">@ViewData["FileNameA"]</span> | 
                    ไฟล์เปรียบเทียบ: <span class="font-semibold text-slate-700">@ViewData["FileNameB"]</span>
                </p>
            </div>
            
            <div class="flex gap-sm">
                <span class="inline-flex items-center px-3 py-1 rounded text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                    ตรงตามแผนผลิต: @matchedCount รายการ
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                    ไม่มีการสั่งซื้อ: @unmatchedCount รายการ
                </span>
            </div>
        </div>

        <!-- Filter & Search Panel -->
        <div class="flex flex-col md:flex-row justify-between gap-md p-md bg-slate-50 border border-slate-200/60 rounded mb-lg items-center">
            <div class="flex flex-wrap gap-lg">
                <label class="inline-flex items-center gap-sm cursor-pointer select-none">
                    <input type="checkbox" id="show-unmatched-only" class="rounded border-slate-300 text-primary focus:ring-primary w-4 h-4" />
                    <span class="text-xs font-semibold text-slate-700">แสดงเฉพาะไม่มีการสั่งซื้อ</span>
                </label>
                <label class="inline-flex items-center gap-sm cursor-pointer select-none">
                    <input type="checkbox" id="show-matched-only" class="rounded border-slate-300 text-primary focus:ring-primary w-4 h-4" />
                    <span class="text-xs font-semibold text-slate-700">แสดงเฉพาะตรงตามแผนผลิต</span>
                </label>
            </div>
            
            <!-- Quick Highlight / Search and Scroll-to -->
            <div class="relative flex max-w-xs w-full gap-2 z-30">
                <div class="relative flex-1">
                    <input id="merge-search-input" class="w-full pl-3 pr-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-semibold text-slate-700" placeholder="ค้นหาเลขที่อนุมัติ..." type="text" autocomplete="off" />
                    
                    <!-- Search Suggestions List -->
                    <div id="search-suggestions" class="hidden absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded shadow-lg z-50 max-h-48 overflow-y-auto divide-y divide-slate-100 font-mono text-xs text-left"></div>
                </div>
                <button id="find-btn" class="bg-primary hover:bg-primary/95 text-on-primary text-xs font-bold px-4 py-2 rounded transition-colors shadow-sm whitespace-nowrap">
                    ค้นหา
                </button>
            </div>
        </div>

        <!-- High-density Data Table -->
        <div class="overflow-x-auto border border-outline-variant rounded mb-lg max-h-[700px] overflow-y-auto">
            <table class="min-w-full divide-y divide-slate-200 text-center" id="comparison-table">
                <thead class="bg-slate-100 sticky top-0 z-10 text-xs text-slate-500 font-bold">
                    <tr class="border-b border-slate-200">
                        <th class="px-3 py-2.5 w-14 text-center">#</th>
                        <th class="px-3 py-2.5 text-left">เลขที่อนุมัติ<br/>(สั่งผลิต)</th>
                        <th class="px-3 py-2.5 text-left">เลขที่อนุมัติ<br/>(แผนผลิต)</th>
                        <th class="px-3 py-2.5 text-center">วันที่อนุมัติ</th>
                        <th class="px-3 py-2.5 text-center">ปภ.ความเร่งด่วน</th>
                        <th class="px-3 py-2.5 text-center">จำนวนชิ้น</th>
                        <th class="px-3 py-2.5 text-right">ราคาที่ผู้ผลิตเสนอ</th>
                        <th class="px-3 py-2.5 text-left">หมายเหตุเพิ่มเติม</th>
                        <th class="px-3 py-2.5 w-[140px] bg-slate-100 border-l border-slate-200 text-primary text-center">เป้าหมายส่งมอบ</th>
                        <th class="px-3 py-2.5 w-[80px] text-center">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200 text-xs text-slate-800" id="table-body">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var row = Model[i];
                        string displayPoNo = !string.IsNullOrEmpty(row.PoNumber) ? row.PoNumber.Trim() : "";
                        string displayPlanNo = !string.IsNullOrEmpty(row.PlanOrderNo) ? row.PlanOrderNo.Trim() : "";
                        string displayApprovedDate = row.ApprovedDate.HasValue ? row.ApprovedDate.Value.ToString("dd/MM/yyyy") : "";
                        string displayQty = row.Quantity.HasValue ? row.Quantity.Value.ToString("F0") : "";
                        string displayAmount = row.Amount.HasValue ? row.Amount.Value.ToString("F2") : "";
                        string displayDeliveryDate = row.DeliveryTargetDate ?? "";
                        
                        <tr class="table-row hover:bg-slate-50/50 transition-colors cursor-pointer select-none" 
                            data-matched="@(row.IsMatched ? "true" : "false")"
                            data-index="@i"
                            data-po="@displayPoNo"
                            data-plan="@displayPlanNo"
                            data-approved="@displayApprovedDate"
                            data-urgency="@(row.Urgency ?? "")"
                            data-qty="@displayQty"
                            data-amount="@displayAmount"
                            data-remarks="@(row.Remarks ?? "")"
                            data-delivery="@displayDeliveryDate"
                            ondblclick="openEditModal(@i)">
                            
                            <td class="px-3 py-2.5 text-center text-slate-400 font-mono">@(i + 1)</td>
                            <!-- 1. ใบขออนุมัติ -->
                            <td class="px-3 py-2.5 text-left font-mono font-bold text-primary cell-po">@(string.IsNullOrEmpty(displayPoNo) ? "-" : displayPoNo)</td>
                            <!-- 2. เลขที่อนุมัติ -->
                            <td class="px-3 py-2.5 text-left font-mono text-slate-700 cell-plan">@(string.IsNullOrEmpty(displayPlanNo) ? "-" : displayPlanNo)</td>
                            <!-- 3. วันที่อนุมัติขอสั่งผลิต -->
                            <td class="px-3 py-2.5 text-center font-mono text-slate-600 cell-approved">@(string.IsNullOrEmpty(displayApprovedDate) ? "-" : displayApprovedDate)</td>
                            <!-- 4. ความเร่งด่วน -->
                            <td class="px-3 py-2.5 text-center text-slate-500 cell-urgency">@(string.IsNullOrEmpty(row.Urgency) ? "-" : row.Urgency)</td>
                            <!-- 5. จำนวนชิ้น -->
                            <td class="px-3 py-2.5 text-center font-mono font-bold text-slate-900 cell-qty">@(string.IsNullOrEmpty(displayQty) ? "-" : displayQty)</td>
                            <!-- 6. มูลค่าสั่งผลิต -->
                            <td class="px-3 py-2.5 text-right font-mono text-slate-700 cell-amount">@(string.IsNullOrEmpty(displayAmount) ? "-" : "฿" + Convert.ToDecimal(displayAmount).ToString("N2"))</td>
                            <!-- 7. หมายเหตุเพิ่มเติม -->
                            <td class="px-3 py-2.5 text-left cell-remarks truncate max-w-[180px] text-slate-500" title="@row.Remarks">@(string.IsNullOrEmpty(row.Remarks) ? "-" : row.Remarks)</td>
                            <!-- 8. เป้าหมายส่งมอบ -->
                            <td class="px-3 py-2.5 text-center border-l border-slate-200 font-mono cell-delivery @(row.IsMatched ? "text-green-700 bg-green-50/20 font-bold" : "text-slate-500 bg-slate-50/20")">
                                @Html.Raw(FormatDeliveryCell(displayDeliveryDate))
                            </td>
                            <!-- 9. ปุ่มจัดการ -->
                            <td class="px-3 py-2.5 text-center">
                                <button type="button" onclick="openEditModal(@i); event.stopPropagation();" class="text-primary hover:underline font-bold text-[11px] inline-flex items-center gap-xs justify-center w-full">
                                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                                    </svg>
                                    แก้ไข
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Action Row -->
        <div class="flex flex-col md:flex-row justify-between items-stretch md:items-center border-t border-slate-200 pt-lg gap-md">
            <button type="button" onclick="window.location.href='/FileMerge'" class="border border-outline-variant hover:bg-slate-50 text-slate-700 font-semibold text-sm px-5 py-2.5 rounded transition-colors bg-white flex items-center justify-center gap-xs self-start">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                ย้อนกลับ
            </button>
            
            <div class="flex flex-col md:flex-row gap-sm items-stretch md:items-center">
                <div class="flex items-center gap-xs">
                    <span class="text-xs font-bold text-slate-700 whitespace-nowrap">ชื่อรายงาน:</span>
                    <input type="text" id="report-name-input" class="px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none w-72" placeholder="ตั้งชื่อรายงานนี้ (เช่น รายงานจัดซื้อประจำรอบ)" value="รายงานการเปรียบเทียบ - @DateTime.Now.ToString("dd MMM yyyy HH:mm น.", new System.Globalization.CultureInfo("th-TH"))" />
                </div>
                
                <div class="flex items-center justify-end gap-sm mt-sm md:mt-0">
                    <div id="save-spinner" class="hidden flex items-center gap-xs text-xs text-slate-500 mr-2">
                        <div class="w-4 h-4 border-2 border-slate-200 border-t-primary rounded-full animate-spin"></div>
                        กำลังบันทึกข้อมูล...
                    </div>
                    <button type="button" id="save-btn" class="bg-primary hover:bg-primary-container text-on-primary font-semibold text-sm px-6 py-2.5 rounded transition-colors shadow-sm">
                        ยืนยันบันทึกข้อมูลลงระบบ
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Premium Frosted Glass Edit Modal -->
<div id="edit-modal" class="fixed inset-0 z-50 flex items-center justify-center p-md bg-slate-900/50 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-lg shadow-xl border border-slate-100 max-w-lg w-full overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col">
        <!-- Modal Header -->
        <div class="px-lg py-md border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-xs">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-primary">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                </svg>
                แก้ไขข้อมูลรายการแถวที่ <span id="modal-row-num" class="font-mono text-primary font-bold">1</span>
            </h3>
            <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-lg flex flex-col gap-md max-h-[70vh] overflow-y-auto">
            <input type="hidden" id="modal-row-index" />
            
            <div class="grid grid-cols-2 gap-md">
                <!-- 1. เลขที่อนุมัติ (สั่งผลิต) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">เลขที่อนุมัติ (สั่งผลิต)</label>
                    <input type="text" id="modal-po" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-mono" />
                </div>
                <!-- 2. เลขที่อนุมัติ (แผนผลิต) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">เลขที่อนุมัติ (แผนผลิต)</label>
                    <input type="text" id="modal-plan" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-mono" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-md">
                <!-- 3. วันที่อนุมัติ -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">วันที่อนุมัติ (dd/mm/yyyy)</label>
                    <input type="text" id="modal-approved" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-mono" placeholder="dd/mm/yyyy" />
                </div>
                <!-- 4. ความเร่งด่วน -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">ปภ.ความเร่งด่วน</label>
                    <input type="text" id="modal-urgency" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-md">
                <!-- 5. จำนวนชิ้น -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">จำนวนชิ้น</label>
                    <input type="number" id="modal-qty" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-mono" />
                </div>
                <!-- 6. ราคาที่ผู้ผลิตเสนอ -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">ราคาที่ผู้ผลิตเสนอ (บาท)</label>
                    <input type="number" step="0.01" id="modal-amount" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-mono" />
                </div>
            </div>

            <!-- 7. หมายเหตุเพิ่มเติม -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">หมายเหตุเพิ่มเติม</label>
                <textarea id="modal-remarks" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none h-16 resize-none leading-normal"></textarea>
            </div>

            <!-- 8. เป้าหมายส่งมอบ -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">เป้าหมายส่งมอบ (ระบุวันที่ หรือรายละเอียดนัดหมาย)</label>
                <input type="text" id="modal-delivery" class="w-full px-3 py-2 border border-slate-200 rounded text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none font-mono text-primary font-bold" placeholder="เช่น 26/05/2026 หรือ นัดตอบเป้าหมาย7/7/26" />
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-lg py-md border-t border-slate-100 flex justify-end gap-sm bg-slate-50/30">
            <button type="button" onclick="closeEditModal()" class="px-4 py-2 border border-slate-200 rounded text-xs font-semibold text-slate-600 hover:bg-slate-50 transition-colors">
                ยกเลิก
            </button>
            <button type="button" onclick="saveModalChanges()" class="bg-primary hover:bg-primary-container text-on-primary text-xs font-semibold px-5 py-2 rounded transition-colors shadow-sm">
                บันทึกการแก้ไข
            </button>
        </div>
    </div>
</div>

<script>
// Custom alert helper to avoid browser alert() Kestrel popups
function showCustomAlert(message, title = "แจ้งข้อความ") {
    let modal = document.getElementById("custom-alert-modal");
    if (!modal) {
        modal = document.createElement("div");
        modal.id = "custom-alert-modal";
        modal.className = "fixed inset-0 z-50 flex items-center justify-center p-md bg-slate-900/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 hidden";
        modal.innerHTML = `
            <div class="bg-white rounded-lg shadow-xl border border-slate-100 max-w-sm w-full overflow-hidden transform scale-95 transition-all duration-300">
                <div class="px-lg py-md border-b border-slate-100 bg-slate-50/50">
                    <h3 class="font-bold text-slate-800 text-sm" id="custom-alert-title"></h3>
                </div>
                <div class="p-lg text-xs text-slate-600 leading-normal" id="custom-alert-message"></div>
                <div class="px-lg py-md border-t border-slate-100 flex justify-end bg-slate-50/30">
                    <button type="button" id="custom-alert-ok" class="bg-primary hover:bg-primary-container text-on-primary text-xs font-semibold px-5 py-2 rounded transition-colors shadow-sm">ตกลง</button>
                </div>
            </div>
        `;
        document.body.appendChild(modal);
    }
    
    document.getElementById("custom-alert-title").textContent = title;
    document.getElementById("custom-alert-message").innerHTML = message;
    
    modal.classList.remove("hidden");
    setTimeout(() => {
        modal.classList.add("opacity-100");
        modal.querySelector("div").classList.remove("scale-95");
        modal.querySelector("div").classList.add("scale-100");
    }, 10);
    
    return new Promise((resolve) => {
        document.getElementById("custom-alert-ok").onclick = () => {
            modal.classList.remove("opacity-100");
            modal.querySelector("div").classList.remove("scale-100");
            modal.querySelector("div").classList.add("scale-95");
            setTimeout(() => {
                modal.classList.add("hidden");
                resolve();
            }, 300);
        };
    });
}

document.addEventListener("DOMContentLoaded", function() {
    const showUnmatchedCheckbox = document.getElementById("show-unmatched-only");
    const showMatchedCheckbox = document.getElementById("show-matched-only");
    const tableRows = document.querySelectorAll(".table-row");
    const saveBtn = document.getElementById("save-btn");
    const saveSpinner = document.getElementById("save-spinner");
    
    const searchInput = document.getElementById("merge-search-input");
    const findBtn = document.getElementById("find-btn");
    const reportNameInput = document.getElementById("report-name-input");
    const suggestionsDropdown = document.getElementById("search-suggestions");

    // Gather unique search keys from the table for autocomplete suggestions
    function getSearchTerms() {
        const terms = new Set();
        tableRows.forEach(row => {
            const po = row.getAttribute("data-po");
            const plan = row.getAttribute("data-plan");
            if (po && po !== "-") terms.add(po.trim());
            if (plan && plan !== "-") terms.add(plan.trim());
        });
        return Array.from(terms).sort();
    }

    // Autocomplete dropdown input handler
    searchInput.addEventListener("input", function() {
        const query = this.value.trim().toLowerCase();
        if (!query) {
            suggestionsDropdown.classList.add("hidden");
            suggestionsDropdown.innerHTML = "";
            return;
        }

        const terms = getSearchTerms();
        const matches = terms.filter(t => t.toLowerCase().includes(query)).slice(0, 10);

        if (matches.length > 0) {
            suggestionsDropdown.innerHTML = "";
            matches.forEach(match => {
                const item = document.createElement("div");
                item.className = "px-3 py-2 text-xs hover:bg-slate-50 cursor-pointer transition-colors text-left text-slate-700 font-mono";
                item.textContent = match;
                item.addEventListener("click", function() {
                    searchInput.value = match;
                    suggestionsDropdown.classList.add("hidden");
                    doFind();
                });
                suggestionsDropdown.appendChild(item);
            });
            suggestionsDropdown.classList.remove("hidden");
        } else {
            suggestionsDropdown.classList.add("hidden");
        }
    });

    // Close suggestions on click outside
    document.addEventListener("click", function(e) {
        if (!searchInput.contains(e.target) && !suggestionsDropdown.contains(e.target)) {
            suggestionsDropdown.classList.add("hidden");
        }
    });

    // Scroll to & highlight row
    function doFind() {
        const query = searchInput.value.trim().toLowerCase();
        if (!query) return;

        let found = false;
        tableRows.forEach(row => {
            const poNum = row.getAttribute("data-po").toLowerCase();
            const planNo = row.getAttribute("data-plan").toLowerCase();

            if (poNum.includes(query) || planNo.includes(query)) {
                // Remove highlight from all other rows
                tableRows.forEach(r => r.style.backgroundColor = "");
                
                // Make sure the found row is visible
                row.classList.remove("hidden");
                
                // Scroll to target row smoothly
                row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                
                // Highlight row
                row.style.backgroundColor = "#FEF08A"; // Tailwind yellow-200
                setTimeout(() => {
                    row.style.transition = "background-color 1s ease";
                    row.style.backgroundColor = "";
                }, 4000);
                
                found = true;
            }
        });

        if (!found) {
            showCustomAlert("ไม่พบข้อมูลใบขออนุมัติหรือเลขที่อนุมัติที่ระบุในตารางนี้", "ไม่พบผลลัพธ์");
        }
    }

    findBtn.addEventListener("click", doFind);
    searchInput.addEventListener("keypress", function(e) {
        if (e.key === "Enter") {
            doFind();
        }
    });

    function applyRowFilter() {
        const showOnlyUnmatched = showUnmatchedCheckbox.checked;
        const showOnlyMatched = showMatchedCheckbox.checked;

        tableRows.forEach(row => {
            const isMatched = row.getAttribute("data-matched") === "true";

            if (showOnlyUnmatched) {
                row.classList.toggle("hidden", isMatched);
                return;
            }

            if (showOnlyMatched) {
                row.classList.toggle("hidden", !isMatched);
                return;
            }

            row.classList.remove("hidden");
        });
    }

    // Live filtering
    showUnmatchedCheckbox.addEventListener("change", function() {
        if (this.checked) {
            showMatchedCheckbox.checked = false;
        }
        applyRowFilter();
    });

    showMatchedCheckbox.addEventListener("change", function() {
        if (this.checked) {
            showUnmatchedCheckbox.checked = false;
        }
        applyRowFilter();
    });

    // Handle DB Save POST
    saveBtn.addEventListener("click", function() {
        const reportName = reportNameInput.value.trim();
        if (!reportName) {
            showCustomAlert("กรุณากรอกชื่อรายงานการเปรียบเทียบก่อนกดยืนยันบันทึก", "กรอกข้อมูลไม่ครบ");
            reportNameInput.focus();
            return;
        }

        saveBtn.disabled = true;
        saveSpinner.classList.remove("hidden");

        // Gather all rows
        const rowsData = [];
        tableRows.forEach(row => {
            rowsData.push({
                PoNumber: row.getAttribute("data-po"),
                PlanOrderNo: row.getAttribute("data-plan"),
                ApprovedDate: row.getAttribute("data-approved"),
                Urgency: row.getAttribute("data-urgency"),
                Quantity: row.getAttribute("data-qty"),
                Amount: row.getAttribute("data-amount"),
                Remarks: row.getAttribute("data-remarks"),
                DeliveryTargetDate: row.getAttribute("data-delivery"),
                IsMatched: row.getAttribute("data-matched") === "true"
            });
        });

        const payload = {
            SessionIdA: "@ViewData["SessionIdA"]",
            SessionIdB: "@ViewData["SessionIdB"]",
            FileNameA: "@Html.Raw(ViewData["FileNameA"])",
            FileNameB: "@Html.Raw(ViewData["FileNameB"])",
            ReportName: reportName,
            Rows: rowsData
        };

        fetch("/FileMerge/SaveMergeResult", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.href = data.redirectUrl;
            } else {
                showCustomAlert(data.error || "เกิดข้อผิดพลาดในการบันทึกข้อมูล", "บันทึกไม่สำเร็จ");
                saveBtn.disabled = false;
                saveSpinner.classList.add("hidden");
            }
        })
        .catch(err => {
            showCustomAlert("ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์หลักได้ในขณะนี้", "ข้อผิดพลาดระบบ");
            saveBtn.disabled = false;
            saveSpinner.classList.add("hidden");
        });
    });
});

// Helper function to format DeliveryTargetDate string in JavaScript
function formatDeliveryCell(val) {
    if (!val) return "-";
    val = val.trim();
    if (val.startsWith("นัดตอบเป้าหมาย")) {
        let rest = val.substring("นัดตอบเป้าหมาย".length).trim();
        if (!rest) return "นัดตอบเป้าหมาย";
        return "นัดตอบเป้าหมาย<br/>" + rest;
    }
    return val;
}

// Modal open/close actions
function openEditModal(index) {
    const row = document.querySelector(`.table-row[data-index="${index}"]`);
    if (!row) return;

    // Set values to modal fields
    document.getElementById("modal-row-index").value = index;
    document.getElementById("modal-row-num").textContent = index + 1;
    
    document.getElementById("modal-po").value = row.getAttribute("data-po");
    document.getElementById("modal-plan").value = row.getAttribute("data-plan");
    document.getElementById("modal-approved").value = row.getAttribute("data-approved");
    document.getElementById("modal-urgency").value = row.getAttribute("data-urgency");
    document.getElementById("modal-qty").value = row.getAttribute("data-qty");
    document.getElementById("modal-amount").value = row.getAttribute("data-amount");
    document.getElementById("modal-remarks").value = row.getAttribute("data-remarks");
    document.getElementById("modal-delivery").value = row.getAttribute("data-delivery");

    const modal = document.getElementById("edit-modal");
    modal.classList.remove("hidden");
    setTimeout(() => {
        modal.classList.add("opacity-100");
        modal.querySelector("div").classList.remove("scale-95");
        modal.querySelector("div").classList.add("scale-100");
    }, 10);
}

// Close Modal
function closeEditModal() {
    const modal = document.getElementById("edit-modal");
    modal.classList.remove("opacity-100");
    modal.querySelector("div").classList.remove("scale-100");
    modal.querySelector("div").classList.add("scale-95");
    setTimeout(() => {
        modal.classList.add("hidden");
    }, 300);
}

function saveModalChanges() {
    const index = document.getElementById("modal-row-index").value;
    const row = document.querySelector(`.table-row[data-index="${index}"]`);
    if (!row) return;

    // Get input values
    const poVal = document.getElementById("modal-po").value.trim();
    const planVal = document.getElementById("modal-plan").value.trim();
    const approvedVal = document.getElementById("modal-approved").value.trim();
    const urgencyVal = document.getElementById("modal-urgency").value.trim();
    const qtyVal = document.getElementById("modal-qty").value.trim();
    const amountVal = document.getElementById("modal-amount").value.trim();
    const remarksVal = document.getElementById("modal-remarks").value.trim();
    const deliveryVal = document.getElementById("modal-delivery").value.trim();

    // Update row attributes
    row.setAttribute("data-po", poVal);
    row.setAttribute("data-plan", planVal);
    row.setAttribute("data-approved", approvedVal);
    row.setAttribute("data-urgency", urgencyVal);
    row.setAttribute("data-qty", qtyVal);
    row.setAttribute("data-amount", amountVal);
    row.setAttribute("data-remarks", remarksVal);
    row.setAttribute("data-delivery", deliveryVal);

    // Update visible cells text
    row.querySelector(".cell-po").textContent = poVal || "-";
    row.querySelector(".cell-plan").textContent = planVal || "-";
    row.querySelector(".cell-approved").textContent = approvedVal || "-";
    row.querySelector(".cell-urgency").textContent = urgencyVal || "-";
    row.querySelector(".cell-qty").textContent = qtyVal || "-";
    
    if (amountVal) {
        row.querySelector(".cell-amount").textContent = "฿" + Number(amountVal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    } else {
        row.querySelector(".cell-amount").textContent = "-";
    }
    
    row.querySelector(".cell-remarks").textContent = remarksVal || "-";
    row.querySelector(".cell-remarks").setAttribute("title", remarksVal);
    
    // Format delivery with br tag
    row.querySelector(".cell-delivery").innerHTML = formatDeliveryCell(deliveryVal);

    closeEditModal();
}
</script>
